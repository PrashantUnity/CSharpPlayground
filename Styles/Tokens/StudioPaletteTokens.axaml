            <SolidColorBrush x:Key="ServerMethodDeleteBorderBrush" Color="#DC2626" />
            <SolidColorBrush x:Key="ServerMethodPatchBgBrush" Color="#2C1542" />
            <SolidColorBrush x:Key="ServerMethodPatchFgBrush" Color="#C084FC" />
            <SolidColorBrush x:Key="ServerMethodPatchBorderBrush" Color="#9333EA" />
