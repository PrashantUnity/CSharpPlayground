<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================================================== -->
    <!-- Modern Developer Dashboard Palette (Nexus / GitHub Dark & Light)       -->
    <!-- Canonical tokens used across the entire C# Code Studio IDE.            -->
    <!-- Theme-variant aware (Dark and Light).                                  -->
    <!-- ===================================================================== -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="DsBgBrush" Color="#0D1117" />
            <SolidColorBrush x:Key="DsSurfaceBrush" Color="#161B22" />
            <SolidColorBrush x:Key="DsSurfaceHoverBrush" Color="#21262D" />
            <SolidColorBrush x:Key="DsSurfaceHighBrush" Color="#1C2128" />
            <SolidColorBrush x:Key="DsBorderBrush" Color="#21262D" />
            <SolidColorBrush x:Key="DsBorderSubtleBrush" Color="#171B22" />
            <SolidColorBrush x:Key="DsTextBrush" Color="#C9D1D9" />
            <SolidColorBrush x:Key="DsTextWhiteBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DsOnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DsSyntaxStringBrush" Color="#A5D6FF" />
            <SolidColorBrush x:Key="DsMutedBrush" Color="#8B949E" />
            <SolidColorBrush x:Key="DsPrimaryBrush" Color="#2F81F7" />
            <SolidColorBrush x:Key="DsPrimaryHoverBrush" Color="#1F6FEB" />
            <SolidColorBrush x:Key="DsPrimarySubtleBrush" Color="#1A2F81F7" />
            <SolidColorBrush x:Key="DsSelectionBrush" Color="#992F81F7" />
            <SolidColorBrush x:Key="DsFocusBorderBrush" Color="#8C2F81F7" />
            <SolidColorBrush x:Key="DsPrimaryBorderSubtleBrush" Color="#332F81F7" />
            <SolidColorBrush x:Key="DsJupyterBrush" Color="#E34C26" />
            <SolidColorBrush x:Key="DsJupyterSubtleBrush" Color="#26E34C26" />
            <SolidColorBrush x:Key="DsLinqBrush" Color="#238636" />
            <SolidColorBrush x:Key="DsLinqSubtleBrush" Color="#26238636" />
            <SolidColorBrush x:Key="DsGreenBrush" Color="#2EA043" />
            <SolidColorBrush x:Key="DsGlassBgBrush" Color="#E6161B22" />
            <SolidColorBrush x:Key="DsHoverOverlayBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="DsScrimBrush" Color="#85000000" />
            <BoxShadows x:Key="DsModalShadow">0 24 64 0 #B0000000</BoxShadows>
            <BoxShadows x:Key="DsFloatingShadow">0 8 24 0 #60000000</BoxShadows>
            <BoxShadows x:Key="DsBottomBarShadow">0 -4 16 0 #40000000</BoxShadows>
            <BoxShadows x:Key="DsGlowPrimaryShadow">0 0 24 0 #4D2F81F7</BoxShadows>
            <LinearGradientBrush x:Key="DsAvatarGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="#2F81F7" />
                <GradientStop Offset="1" Color="#7C3AED" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="DsAmbientGlowBrush" Center="100%,0%" GradientOrigin="100%,0%" RadiusX="100%" RadiusY="100%">
                <GradientStop Offset="0" Color="#1A2F81F7" />
                <GradientStop Offset="1" Color="#002F81F7" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="DsBlindAmbientGlowBrush" Center="100%,0%" GradientOrigin="100%,0%" RadiusX="100%" RadiusY="100%">
                <GradientStop Offset="0" Color="#18F59E0B" />
                <GradientStop Offset="1" Color="#00F59E0B" />
            </RadialGradientBrush>

            <!-- Sidebar Navigation Category Brushes (Dark) -->
            <SolidColorBrush x:Key="NavHomeFgBrush" Color="#38BDF8" />
            <SolidColorBrush x:Key="NavHomeBgBrush" Color="#1A38BDF8" />
            <SolidColorBrush x:Key="NavProjectsFgBrush" Color="#818CF8" />
