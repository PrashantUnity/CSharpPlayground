    <!-- Global Typography Tokens -->
    <FontFamily x:Key="DsCodeFontFamily">Cascadia Code, JetBrains Mono, Fira Code, Menlo, Consolas, monospace</FontFamily>
    <FontFamily x:Key="DsUiFontFamily">Inter, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif</FontFamily>

</ResourceDictionary>
