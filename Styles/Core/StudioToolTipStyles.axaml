<Styles xmlns:lt="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Extensibility.Theming.Layout;assembly=CSharpEditorPlugin" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ -->
    <!-- GLOBAL TOOLTIP STYLES & ERGONOMIC PLACEMENT                   -->
    <!-- Authentic VS Code dark surface, elevation shadow & offsets   -->
    <!-- ============================================================ -->

    <!-- Smart non-colliding default placement on all controls -->
    <Style Selector=":is(Control)">
        <Setter Property="ToolTip.Placement" Value="Bottom" />
        <Setter Property="ToolTip.VerticalOffset" Value="6" />
        <Setter Property="ToolTip.ShowDelay" Value="350" />
    </Style>

    <!-- Global ToolTip Visual Design -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHighBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
        <Setter Property="lt:Tokens.BorderThickness" Value="DsBorderThin" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusMD" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="lt:Tokens.FontSize" Value="DsFontSize250" />
        <Setter Property="lt:Tokens.FontWeight" Value="DsWeightBody" />
        <Setter Property="MaxWidth" Value="380" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.08" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        lt:Tokens.BoxShadow="DsFloatingShadow">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="ToolTip TextBlock">
        <Setter Property="lt:Tokens.FontSize" Value="DsFontSize250" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</Styles>
