<Styles xmlns:lt="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Extensibility.Theming.Layout;assembly=CSharpEditorPlugin"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ -->
    <!-- CORE: SLIDER CONTROL STYLES & ERGONOMICS                     -->
    <!-- Uncluttered compact track, centered circular thumb, zero     -->
    <!-- clipping margin, consistent hover & focus states             -->
    <!-- ============================================================ -->

    <Styles.Resources>
        <GridLength x:Key="SliderPreContentMargin">0</GridLength>
        <GridLength x:Key="SliderPostContentMargin">0</GridLength>
        <x:Double x:Key="SliderHorizontalHeight">20</x:Double>
        <x:Double x:Key="SliderVerticalWidth">20</x:Double>
        <x:Double x:Key="SliderHorizontalThumbWidth">14</x:Double>
        <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
        <x:Double x:Key="SliderVerticalThumbWidth">14</x:Double>
        <x:Double x:Key="SliderVerticalThumbHeight">14</x:Double>
        <CornerRadius x:Key="SliderThumbCornerRadius">7</CornerRadius>
        <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>
    </Styles.Resources>

    <Style Selector="Slider">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource DsPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
    </Style>

    <!-- Track centering and height -->
    <Style Selector="Slider:horizontal /template/ Track#PART_Track">
        <Setter Property="MinHeight" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Inactive track background -->
    <Style Selector="Slider /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
    </Style>
    <Style Selector="Slider:pointerover /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="{DynamicResource DsBorderBrush}" />
    </Style>

    <!-- Active track background (filled progress) -->
    <Style Selector="Slider /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{DynamicResource DsPrimaryBrush}" />
    </Style>
    <Style Selector="Slider:pointerover /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{DynamicResource DsPrimaryHoverBrush}" />
    </Style>

    <!-- Thumb circle: fully centered, crisp border, no bottom-clip -->
    <Style Selector="Slider:horizontal /template/ Thumb#thumb">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{DynamicResource DsPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsTextWhiteBrush}" />
        <Setter Property="lt:Tokens.BorderThickness" Value="=1.5" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusFull" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Slider:horizontal:pointerover /template/ Thumb#thumb">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusFull" />
        <Setter Property="Background" Value="{DynamicResource DsPrimaryHoverBrush}" />
        <Setter Property="lt:Tokens.BorderThickness" Value="=2" />
    </Style>

    <Style Selector="Slider:horizontal:pressed /template/ Thumb#thumb">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusFull" />
        <Setter Property="Background" Value="{DynamicResource DsPrimaryBrush}" />
        <Setter Property="lt:Tokens.BorderThickness" Value="=2" />
    </Style>

    <!-- Scrubber Slider Specific Tuning -->
    <Style Selector="Slider.scrubber-slider">
        <Setter Property="Height" Value="22" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</Styles>
