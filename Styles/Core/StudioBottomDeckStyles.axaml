<Styles xmlns:lt="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Extensibility.Theming.Layout;assembly=CSharpEditorPlugin" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

    <!-- ============================================================ -->
    <!-- ZONE 4: BOTTOM DECK / TOOL PANEL STYLES                      -->
    <!-- Tabbed panel: Problems, Output, Terminal, Debug, .Dump, Tests-->
    <!-- ============================================================ -->

    <Style Selector="Button.ide-tab-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource DsMutedBrush}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="lt:Tokens.BorderThickness" Value="=0" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusMD" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="lt:Tokens.FontSize" Value="DsFontSize300" />
        <Setter Property="lt:Tokens.FontWeight" Value="DsWeightLabel" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <BrushTransition Property="Foreground" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.ide-tab-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
    </Style>
    <Style Selector="Button.ide-tab-btn.active">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHighBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
        <Setter Property="lt:Tokens.FontWeight" Value="DsWeightEmphasis" />
    </Style>

    <Style Selector="Border.ide-tab-badge">
        <Setter Property="Height" Value="16" />
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusLG" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.ide-tab-badge > TextBlock">
        <Setter Property="lt:Tokens.FontSize" Value="DsFontSize075" />
        <Setter Property="lt:Tokens.FontWeight" Value="DsWeightStrong" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,1,0,0" />
    </Style>

    <!-- Cell Output Tabs (in Bottom Deck and Notebooks) -->
    <Style Selector="Button.cell-output-tab-btn">
        <Setter Property="ScrollViewer.BringIntoViewOnFocusChange" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource DsMutedBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="lt:Tokens.BorderThickness" Value="DsBorderThin" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusSM" />
        <Setter Property="Height" Value="22" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="lt:Tokens.FontSize" Value="DsFontSize150" />
        <Setter Property="lt:Tokens.FontWeight" Value="DsWeightLabel" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1" />
                <BrushTransition Property="Foreground" Duration="0:0:0.1" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.cell-output-tab-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
    </Style>
    <Style Selector="Button.cell-output-tab-btn.active">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHighBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryBorderSubtleBrush}" />
    </Style>
    <Style Selector="Button.cell-output-tab-btn.active materialIcons|MaterialIcon">
        <Setter Property="Foreground" Value="{DynamicResource DsPrimaryBrush}" />
    </Style>

    <Style Selector="Border.cell-output-tab-badge">
        <Setter Property="Height" Value="14" />
        <Setter Property="MinHeight" Value="14" />
        <Setter Property="MinWidth" Value="14" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusMD" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHighBrush}" />
    </Style>
    <Style Selector="Border.cell-output-tab-badge > TextBlock">
        <Setter Property="lt:Tokens.FontSize" Value="DsFontSize075" />
        <Setter Property="lt:Tokens.FontWeight" Value="DsWeightStrong" />
        <Setter Property="Foreground" Value="{DynamicResource DsMutedBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,1,0,0" />
    </Style>
    <Style Selector="Button.cell-output-tab-btn.active Border.cell-output-tab-badge">
        <Setter Property="Background" Value="{DynamicResource DsPrimaryBrush}" />
    </Style>
    <Style Selector="Button.cell-output-tab-btn.active Border.cell-output-tab-badge > TextBlock">
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

</Styles>
