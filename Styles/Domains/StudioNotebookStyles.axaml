<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:controls1="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Notebooks">

    <Styles.Resources>
        <CornerRadius x:Key="NotebookTabTopRadius">4,4,0,0</CornerRadius>
    </Styles.Resources>

    <!-- ============================================================ -->
    <!-- DOMAIN: NOTEBOOK STUDIO STYLES                               -->
    <!-- Cells, gutter buttons, insert dividers, tabs, outputs        -->
    <!-- ============================================================ -->


        <!-- Explorer selection accent override for Notebook -->
        <Style Selector="Button.explorer-item-btn.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource NotebookAmberBrush}" />
        </Style>

        <!-- Document Studio Tab Item -->
        <Style Selector="Border.studio-tab-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="CornerRadius" Value="{DynamicResource NotebookTabTopRadius}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.studio-tab-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
        </Style>
        <Style Selector="Border.studio-tab-item.active">
            <Setter Property="Background" Value="{DynamicResource DsSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
        </Style>
        <Style Selector="Border.studio-tab-item TextBlock.tab-title">
            <Setter Property="Foreground" Value="{DynamicResource DsMutedBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Border.studio-tab-item.active TextBlock.tab-title">
            <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <!-- Notebook Toolbar Action Buttons -->
        <Style Selector="Border.compact TextBlock.toolbar-label">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="Button.nb-action-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nb-action-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DsPrimaryBrush}" />
        </Style>
        <Style Selector="Button.nb-action-btn:pointerover materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource DsPrimaryBrush}" />
        </Style>

        <!-- Notebook Canvas Buttons: Prevent focus-steal and auto-scroll on click -->
        <Style Selector="controls1|NotebookCanvasScrollViewer Button">
            <Setter Property="ScrollViewer.BringIntoViewOnFocusChange" Value="False" />
        </Style>

        <!-- Cell Hover Action Icons -->
        <Style Selector="Button.cell-tool-btn">
            <Setter Property="ScrollViewer.BringIntoViewOnFocusChange" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource DsMutedBrush}" />
        </Style>
        <Style Selector="Button.cell-tool-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
        </Style>
        <Style Selector="Button.cell-tool-btn.delete-tool:pointerover">
            <Setter Property="Background" Value="{DynamicResource NavPinnedBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource NavPinnedFgBrush}" />
        </Style>
        <Style Selector="Button.cell-tool-btn.delete-tool:pointerover materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource NavPinnedFgBrush}" />
        </Style>

        <!-- Gutter Run Play Button -->
        <Style Selector="Button.gutter-run-btn">
            <Setter Property="ScrollViewer.BringIntoViewOnFocusChange" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="Button.gutter-run-btn:pointerover">
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
        </Style>

        <!-- Gutter Menu Button -->
        <Style Selector="Button.gutter-menu-btn">
            <Setter Property="ScrollViewer.BringIntoViewOnFocusChange" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="18" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="Button.gutter-menu-btn:pointerover">
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
        </Style>

        <!-- Unified Notebook Cell Card (Sleek dark container) -->
        <Style Selector="Border.notebook-cell-card">
            <Setter Property="Background" Value="{DynamicResource DsSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.notebook-cell-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource DsMutedBrush}" />
        </Style>
        <Style Selector="Border.notebook-cell-card.active">
            <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryBorderSubtleBrush}" />
        </Style>

        <!-- Dedicated Notebook Cell Output Card (VS Code Authentic) -->
        <Style Selector="Border.notebook-output-card">
            <Setter Property="Background" Value="{DynamicResource DsBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.notebook-output-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource DsMutedBrush}" />
        </Style>

        <!-- Between-Cell Interactive Insertion Divider -->
        <Style Selector="Border.cell-insert-divider">
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="56,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.cell-insert-divider StackPanel.insert-pill-group">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.cell-insert-divider:pointerover StackPanel.insert-pill-group">
            <Setter Property="Opacity" Value="1.0" />
        </Style>
        <Style Selector="Border.cell-insert-divider Rectangle.divider-line">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.cell-insert-divider:pointerover Rectangle.divider-line">
            <Setter Property="Opacity" Value="1.0" />
        </Style>

        <Style Selector="Button.insert-cell-pill">
            <Setter Property="ScrollViewer.BringIntoViewOnFocusChange" Value="False" />
            <Setter Property="Background" Value="{DynamicResource DsSurfaceHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerFull}" />
            <Setter Property="Height" Value="20" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource DsMutedBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.insert-cell-pill:pointerover">
            <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DsPrimaryBrush}" />
        </Style>

        <!-- Floating Cell Action Capsule -->
        <Style Selector="Border.cell-floating-toolbar">
            <Setter Property="Background" Value="{DynamicResource DsSurfaceHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.notebook-cell-card:pointerover Border.cell-floating-toolbar">
            <Setter Property="Opacity" Value="1.0" />
        </Style>
        <Style Selector="Border.notebook-cell-card.active Border.cell-floating-toolbar">
            <Setter Property="Opacity" Value="1.0" />
        </Style>
        <Style Selector="Border.cell-floating-toolbar:pointerover">
            <Setter Property="Opacity" Value="1.0" />
        </Style>

        <!-- Collapsed Input & Output Banners -->
        <Style Selector="Border.notebook-collapsed-banner">
            <Setter Property="Background" Value="{DynamicResource DsSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.notebook-collapsed-banner:pointerover">
            <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryBrush}" />
        </Style>

        <Style Selector="Border.notebook-collapsed-output-banner">
            <Setter Property="Background" Value="{DynamicResource DsSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.notebook-collapsed-output-banner:pointerover">
            <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryBrush}" />
        </Style>

        <!-- Collapsed Banner Button -->
        <Style Selector="Button.collapsed-banner-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Gutter Fold Button -->
        <Style Selector="Button.gutter-fold-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.gutter-fold-btn:pointerover">
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
        </Style>

        <!-- Scrolled Output ScrollViewer -->
        <Style Selector="ScrollViewer.notebook-output-scroll.scrolled">
            <Setter Property="MaxHeight" Value="360" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    
</Styles>
