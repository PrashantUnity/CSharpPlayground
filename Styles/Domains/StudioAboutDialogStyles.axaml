<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ -->
    <!-- ABOUT FRYSHARP DIALOG STYLES                                 -->
    <!-- Sponsor button, action buttons, and close button             -->
    <!-- ============================================================ -->

    <!-- Sponsor Hero Button -->
    <Style Selector="Button.about-sponsor-btn">
        <Setter Property="Background" Value="#1AEA4AAA" />
        <Setter Property="BorderBrush" Value="#60EA4AAA" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.about-sponsor-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#33EA4AAA" />
        <Setter Property="BorderBrush" Value="#EA4AAA" />
    </Style>
    <Style Selector="Button.about-sponsor-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#4DEA4AAA" />
    </Style>

    <!-- Standard Action Buttons (Documentation, GitHub) -->
    <Style Selector="Button.about-action-btn">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHighBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.about-action-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryBorderSubtleBrush}" />
    </Style>
    <Style Selector="Button.about-action-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceBrush}" />
    </Style>

    <!-- Primary Filled Close Button -->
    <Style Selector="Button.about-close-btn">
        <Setter Property="Background" Value="{DynamicResource DsPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="76" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.about-close-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DsPrimaryHoverBrush}" />
    </Style>
    <Style Selector="Button.about-close-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DsPrimarySubtleBrush}" />
    </Style>

</Styles>
