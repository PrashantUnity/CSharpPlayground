<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

    <!-- ===================================================================== -->
    <!-- Documentation & Learning Center Styles                                -->
    <!-- Consumed by CSharpDocsView, DocsNavRailControl, DocsOutlinePanelControl-->
    <!-- Adheres to strict VS Code layout & Developer Studio tokens            -->
    <!-- ===================================================================== -->

    <!-- ── 1. Category Header Button (Button.doc-category-btn) ─────────────── -->
    <Style Selector="Button.doc-category-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                <BrushTransition Property="Foreground" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.doc-category-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource DsHoverOverlayBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
    </Style>
    <Style Selector="Button.doc-category-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DsHoverOverlayBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
    </Style>

    <Style Selector="Button.doc-category-btn.selected, Button.doc-category-btn.active">
        <Setter Property="Background" Value="{DynamicResource DsPrimarySubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryBorderSubtleBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.doc-category-btn.selected /template/ ContentPresenter#PART_ContentPresenter,
                     Button.doc-category-btn.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DsPrimarySubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryBorderSubtleBrush}" />
    </Style>

    <!-- ── 2. Collapsible Article Item (Button.doc-article-item) ────────────── -->
    <Style Selector="Button.doc-article-item">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                <BrushTransition Property="Foreground" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.doc-article-item:pointerover">
        <Setter Property="Background" Value="{DynamicResource DsHoverOverlayBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
    </Style>
    <Style Selector="Button.doc-article-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DsHoverOverlayBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
    </Style>

    <Style Selector="Button.doc-article-item:pointerover materialIcons|MaterialIcon">
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
    </Style>

    <Style Selector="Button.doc-article-item.active, Button.doc-article-item.selected">
        <Setter Property="Background" Value="{DynamicResource DsPrimarySubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryBorderSubtleBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.doc-article-item.active /template/ ContentPresenter#PART_ContentPresenter,
                     Button.doc-article-item.selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DsPrimarySubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryBorderSubtleBrush}" />
    </Style>

    <Style Selector="Button.doc-article-item.active TextBlock, Button.doc-article-item.selected TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.doc-article-item.active materialIcons|MaterialIcon,
                     Button.doc-article-item.selected materialIcons|MaterialIcon">
        <Setter Property="Foreground" Value="{DynamicResource DsPrimaryBrush}" />
    </Style>

    <!-- ── 3. Outline Section Item (Border.doc-article-item) ────────────────── -->
    <Style Selector="Border.doc-article-item">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.doc-article-item:pointerover">
        <Setter Property="Background" Value="{DynamicResource DsHoverOverlayBrush}" />
    </Style>

</Styles>
