<Styles xmlns:lt="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Extensibility.Theming.Layout;assembly=CSharpEditorPlugin" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

    <!-- Blind 75 page: category chips, segmented filters, the problem table and its row actions.
         Consumes modern developer dashboard palette tokens (Ds*Brush) matching Manager and Docs. -->

    <!-- ── Category filter chips ─────────────────────────────────────────────── -->
    <Style Selector="Button.filter-chip">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextBrush}" />
        <Setter Property="lt:Tokens.BorderThickness" Value="DsBorderThin" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadius2XL" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="10,0,6,0" />
        <Setter Property="lt:Tokens.FontSize" Value="DsFontSize250" />
        <Setter Property="lt:Tokens.FontWeight" Value="DsWeightLabel" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                <BrushTransition Property="Foreground" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.filter-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.filter-chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DsHoverOverlayBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
    </Style>
    <Style Selector="Button.filter-chip.selected">
        <Setter Property="Background" Value="{DynamicResource DsPrimarySubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryBorderSubtleBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
        <Setter Property="lt:Tokens.FontWeight" Value="DsWeightEmphasis" />
    </Style>
    <Style Selector="Button.filter-chip.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.filter-chip.selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DsPrimarySubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
    </Style>
    <Style Selector="Button.filter-chip Border.chip-count">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHighBrush}" />
        <Setter Property="Height" Value="16" />
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusLG" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.filter-chip Border.chip-count > TextBlock">
        <Setter Property="lt:Tokens.FontSize" Value="DsFontSize075" />
        <Setter Property="lt:Tokens.FontWeight" Value="DsWeightStrong" />
        <Setter Property="Foreground" Value="{DynamicResource DsMutedBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,1,0,0" />
    </Style>
    <Style Selector="Button.filter-chip.selected Border.chip-count">
        <Setter Property="Background" Value="{DynamicResource DsPrimaryBrush}" />
    </Style>
    <Style Selector="Button.filter-chip.selected Border.chip-count > TextBlock">
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- ── Search box ───────────────────────────────────────────────────────── -->
    <Style Selector="Border.search-box">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHighBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
        <Setter Property="lt:Tokens.BorderThickness" Value="DsBorderThin" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusLG" />
    </Style>
    <Style Selector="Border.search-box:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
    </Style>
    <Style Selector="Border.search-box:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryBrush}" />
        <Setter Property="lt:Tokens.BoxShadow" Value="=0 0 0 1 #332F81F7" />
    </Style>
    <Style Selector="Border.search-box TextBox /template/ Border#PART_BorderElement,
                     Border.search-box TextBox:pointerover /template/ Border#PART_BorderElement,
                     Border.search-box TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="lt:Tokens.BorderThickness" Value="=0" />
    </Style>

    <!-- ── Segmented filters (difficulty, solved status) ─────────────────────── -->
    <Style Selector="Border.segmented">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHighBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
        <Setter Property="lt:Tokens.BorderThickness" Value="DsBorderThin" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusLG" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.segment">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="lt:Tokens.BorderThickness" Value="=0" />
        <Setter Property="Foreground" Value="{DynamicResource DsMutedBrush}" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusMD" />
        <Setter Property="Height" Value="26" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="lt:Tokens.FontSize" Value="DsFontSize250" />
        <Setter Property="lt:Tokens.FontWeight" Value="DsWeightLabel" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <BrushTransition Property="Foreground" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.segment:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DsHoverOverlayBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
    </Style>
    <Style Selector="Button.segment.selected">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
        <Setter Property="lt:Tokens.FontWeight" Value="DsWeightStrong" />
    </Style>
    <Style Selector="Button.segment.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.segment.selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
    </Style>

    <!-- ── Problem table ─────────────────────────────────────────────────────── -->
    <Style Selector="TextBlock.column-label">
        <Setter Property="lt:Tokens.FontSize" Value="DsFontSize200" />
        <Setter Property="lt:Tokens.FontWeight" Value="DsWeightStrong" />
        <Setter Property="lt:Tokens.LetterSpacing" Value="DsTracking080" />
        <Setter Property="Foreground" Value="{DynamicResource DsMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.column-header">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="lt:Tokens.BorderThickness" Value="=0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.column-header:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.column-header:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.column-header:pointerover TextBlock.column-label">
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
    </Style>
    <Style Selector="Button.column-header.sorted TextBlock.column-label">
        <Setter Property="Foreground" Value="{DynamicResource DsPrimaryBrush}" />
    </Style>

    <Style Selector="Border.column-divider">
        <Setter Property="Width" Value="9" />
        <Setter Property="Margin" Value="-5,0,0,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeWestEast" />
        <Setter Property="ZIndex" Value="1" />
    </Style>
    <Style Selector="Border.column-divider > Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource DsBorderBrush}" />
    </Style>
    <Style Selector="Border.column-divider:pointerover > Border, Border.column-divider.dragging > Border">
        <Setter Property="Width" Value="2" />
        <Setter Property="Height" Value="NaN" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource DsPrimaryBrush}" />
    </Style>

    <Style Selector="Border.problem-row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
        <Setter Property="lt:Tokens.BorderThickness" Value="DsBorderBottom" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.problem-row:pointerover">
        <Setter Property="Background" Value="{DynamicResource DsHoverOverlayBrush}" />
    </Style>
    <Style Selector="Border.problem-row.selected">
        <Setter Property="Background" Value="{DynamicResource DsPrimarySubtleBrush}" />
    </Style>

    <Style Selector="Button.title-link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="lt:Tokens.BorderThickness" Value="=0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.title-link:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.title-link:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.title-link > TextBlock">
        <Setter Property="lt:Tokens.FontSize" Value="DsFontSize400" />
        <Setter Property="lt:Tokens.FontWeight" Value="DsWeightLabel" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Button.title-link:pointerover > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DsPrimaryBrush}" />
        <Setter Property="TextDecorations" Value="Underline" />
    </Style>

    <Style Selector="Button.row-action">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="lt:Tokens.BorderThickness" Value="=0" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusMD" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.row-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
    </Style>
    <Style Selector="Button.row-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHighBrush}" />
    </Style>
    <Style Selector="Button.row-action materialIcons|MaterialIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>

    <Style Selector="Border.category-pill">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHighBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
        <Setter Property="lt:Tokens.BorderThickness" Value="DsBorderThin" />
        <Setter Property="Height" Value="20" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusSM" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.problem-row.selected Border.category-pill">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
    </Style>
    <Style Selector="Border.category-pill > TextBlock">
        <Setter Property="lt:Tokens.FontSize" Value="DsFontSize150" />
        <Setter Property="Foreground" Value="{DynamicResource DsMutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,1,0,0" />
    </Style>
</Styles>
