<Styles xmlns:lt="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Extensibility.Theming.Layout;assembly=CSharpEditorPlugin" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

    <!-- ============================================================ -->
    <!-- DOMAIN: DATA STRUCTURE & ALGORITHM VISUALIZER STYLES         -->
    <!-- Canvas resize grips, chrome tools, playback watch cells     -->
    <!-- ============================================================ -->

    <!-- Drag handle under the inline canvas -->
    <Style Selector="Border.canvas-resize-grip">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeNorthSouth" />
    </Style>
    <Style Selector="Border.canvas-resize-grip > Border">
        <Setter Property="Background" Value="{DynamicResource M3OutlineVariantBrush}" />
    </Style>
    <Style Selector="Border.canvas-resize-grip:pointerover > Border">
        <Setter Property="Background" Value="{DynamicResource M3PrimaryBrush}" />
    </Style>

    <!-- Chrome Tool Buttons (Full Screen, Reset, Options) -->
    <Style Selector="Button.chrome-tool-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
        <Setter Property="lt:Tokens.BorderThickness" Value="DsBorderThin" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusSM" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chrome-tool-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
    </Style>

    <!-- Visualizer Playback Watch Cells -->
    <Style Selector="Border.watch-cell">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
        <Setter Property="lt:Tokens.BorderThickness" Value="DsBorderThin" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusXS" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="Margin" Value="0,1,4,1" />
    </Style>
    <Style Selector="Border.watch-cell.added">
        <Setter Property="BorderBrush" Value="#a3e635" />
        <Setter Property="Background" Value="#26a3e635" />
    </Style>
    <Style Selector="Border.watch-cell.marker">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="lt:Tokens.BorderThickness" Value="=0" />
        <Setter Property="Padding" Value="0,1" />
    </Style>
    <Style Selector="Border.watch-cell TextBlock">
        <Setter Property="lt:Tokens.FontSize" Value="DsFontSize100" />
        <Setter Property="lt:Tokens.FontFamily" Value="DsCodeFontFamily" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
    </Style>
    <Style Selector="Border.watch-cell.marker TextBlock">
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
    </Style>

    <!-- Legacy Button Compatibility Aliases -->
    <Style Selector="Button.m3-icon-btn, ToggleButton.m3-icon-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource DsMutedBrush}" />
        <Setter Property="lt:Tokens.BorderThickness" Value="=0" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusFull" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.m3-icon-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.m3-icon-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
    </Style>
    <Style Selector="Button.m3-icon-btn:pointerover, ToggleButton.m3-icon-btn:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
    </Style>
    <Style Selector="Button.m3-icon-btn:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.m3-icon-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceBrush}" />
    </Style>

    <Style Selector="Button.m3-tonal-btn">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHighBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
        <Setter Property="lt:Tokens.BorderThickness" Value="DsBorderThin" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusMD" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="lt:Tokens.FontSize" Value="DsFontSize300" />
        <Setter Property="lt:Tokens.FontWeight" Value="DsWeightEmphasis" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.m3-tonal-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryBorderSubtleBrush}" />
    </Style>
    <Style Selector="Button.m3-tonal-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceBrush}" />
    </Style>

    <Style Selector="Button.m3-filled-btn">
        <Setter Property="Background" Value="{DynamicResource DsPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
        <Setter Property="lt:Tokens.BorderThickness" Value="=0" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusMD" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="lt:Tokens.FontSize" Value="DsFontSize350" />
        <Setter Property="lt:Tokens.FontWeight" Value="DsWeightEmphasis" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.m3-filled-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DsPrimaryHoverBrush}" />
    </Style>
    <Style Selector="Button.m3-filled-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DsPrimarySubtleBrush}" />
    </Style>

</Styles>
