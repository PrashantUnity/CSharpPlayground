<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.Studio.StudioImageViewerControl"
             x:CompileBindings="False">

    <UserControl.Resources>
        <!-- Authentic transparency checkerboard pattern -->
        <DrawingBrush x:Key="CheckerboardBrush" TileMode="Tile" SourceRect="0,0,16,16" DestinationRect="0,0,16,16">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#181A1F">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#21252B">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8" />
                                <RectangleGeometry Rect="8,8,8,8" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://CSharpEditorPlugin/Controls/SharedStudioStyles.axaml" />
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource DsBgBrush}">
        <!-- Top Toolbar / Info Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource DsSurfaceBrush}"
                BorderBrush="{DynamicResource DsBorderBrush}"
                BorderThickness="0,0,0,1"
                Height="32"
                Padding="12,0,8,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left: File Metadata Badges -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="ImageOutline" Width="14" Height="14" Foreground="#C586C0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Script.Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Format Pill -->
                    <Border Background="{DynamicResource DsSurfaceHighBrush}"
                            BorderBrush="{DynamicResource DsBorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="6,2"
                            IsVisible="{Binding ImageFormatText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding ImageFormatText}" FontSize="10" FontWeight="SemiBold" Foreground="#C586C0" />
                    </Border>

                    <!-- Dimensions Pill -->
                    <Border Background="{DynamicResource DsSurfaceHighBrush}"
                            BorderBrush="{DynamicResource DsBorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="6,2"
                            IsVisible="{Binding ImageDimensionsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding ImageDimensionsText}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource DsTextWhiteBrush}" />
                    </Border>

                    <!-- File Size Pill -->
                    <Border Background="{DynamicResource DsSurfaceHighBrush}"
                            BorderBrush="{DynamicResource DsBorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="6,2"
                            IsVisible="{Binding ImageFileSizeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding ImageFileSizeText}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource DsMutedBrush}" />
                    </Border>
                </StackPanel>

                <!-- Right: Zoom & Quick Action Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <!-- Zoom Out -->
                    <Button Command="{Binding ImageZoomOutCommand}" Classes="cs-toolbar-icon" ToolTip.Tip="Zoom Out">
                        <materialIcons:MaterialIcon Kind="Minus" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                    </Button>

                    <!-- Zoom Percentage Text / Reset -->
                    <Button Command="{Binding ImageResetZoomCommand}" Classes="cs-toolbar-tonal" Height="24" Padding="6,0" ToolTip.Tip="Reset Zoom (100%)">
                        <TextBlock Text="{Binding ImageZoomPercentageText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                    </Button>

                    <!-- Zoom In -->
                    <Button Command="{Binding ImageZoomInCommand}" Classes="cs-toolbar-icon" ToolTip.Tip="Zoom In">
                        <materialIcons:MaterialIcon Kind="Plus" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                    </Button>

                    <!-- Fit Toggle -->
                    <Button Command="{Binding ImageToggleFitCommand}" Classes="cs-toolbar-icon" ToolTip.Tip="Toggle Fit to Window">
                        <materialIcons:MaterialIcon Kind="FitToPageOutline" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="{DynamicResource DsBorderBrush}" Margin="4,0" />

                    <!-- Copy Relative Path -->
                    <Button Command="{Binding CopyActiveImageRelativePathCommand}" Classes="cs-toolbar-tonal" Height="24" Padding="6,0" ToolTip.Tip="Copy Relative Path to Clipboard">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <materialIcons:MaterialIcon Kind="ContentCopy" Width="12" Height="12" Foreground="{DynamicResource DsPrimaryBrush}" />
                            <TextBlock Text="Copy Path" FontSize="10.5" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Code Snippets Toggle -->
                    <ToggleButton IsChecked="{Binding ShowImageCodeDrawer, Mode=TwoWay}" Classes="cs-toolbar-icon" ToolTip.Tip="Toggle C# and Python Loading Code Snippets">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <materialIcons:MaterialIcon Kind="CodeBraces" Width="13" Height="13" Foreground="{DynamicResource DsPrimaryBrush}" />
                            <TextBlock Text="Code" FontSize="10.5" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Center: Checkerboard Canvas with Actual Visual Image -->
        <Border Grid.Row="1" Background="{StaticResource CheckerboardBrush}" ClipToBounds="True">
            <Panel>
                <!-- Normal Visual Image Display -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding ImageErrorText, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                        <!-- Fit Mode Image -->
                        <Image Source="{Binding ActiveImageBitmap}"
                               IsVisible="{Binding ImageFitToWindow}"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />

                        <!-- Zoom Mode Image -->
                        <Image Source="{Binding ActiveImageBitmap}"
                               IsVisible="{Binding !ImageFitToWindow}"
                               Width="{Binding ImageDisplayWidth}"
                               Height="{Binding ImageDisplayHeight}"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                    </Grid>
                </ScrollViewer>

                <!-- Error Display (corrupted / unreadable image) -->
                <Border Background="{DynamicResource DsSurfaceBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24"
                        MaxWidth="450"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding ImageErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="36" Height="36" Foreground="#EF4444" HorizontalAlignment="Center" />
                        <TextBlock Text="Unable to Display Image Preview" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource DsTextWhiteBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ImageErrorText}" FontSize="12" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button Command="{Binding CopyActiveImagePathCommand}" Classes="cs-toolbar-tonal" Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
                                    <TextBlock Text="Copy Path" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Panel>
        </Border>

        <!-- Bottom: Collapsible Code References & Snippets Drawer -->
        <Border Grid.Row="2"
                IsVisible="{Binding ShowImageCodeDrawer}"
                Background="{DynamicResource DsSurfaceBrush}"
                BorderBrush="{DynamicResource DsBorderBrush}"
                BorderThickness="0,1,0,0"
                MaxHeight="260"
                Padding="16,10,16,14">
            <Grid RowDefinitions="Auto,*">
                <!-- Drawer Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="CodeTags" Width="15" Height="15" Foreground="{DynamicResource DsPrimaryBrush}" />
                        <TextBlock Text="Script Integration Snippets" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="(Click any card to copy code to clipboard)" FontSize="10.5" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding ToggleImageCodeDrawerCommand}" Classes="explorer-tool-btn" Width="20" Height="20">
                        <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="{DynamicResource DsMutedBrush}" />
                    </Button>
                </Grid>

                <!-- Snippet Cards Grid -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,2">
                        <!-- Card 1: C# SkiaSharp -->
                        <Border Grid.Row="0" Grid.Column="0" Margin="4"
                                Background="{DynamicResource DsSurfaceHighBrush}"
                                BorderBrush="{DynamicResource DsBorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="10">
                            <Grid RowDefinitions="Auto,Auto">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                    <TextBlock Grid.Column="0" Text="C# (SkiaSharp)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DsPrimaryBrush}" />
                                    <Button Grid.Column="1" Command="{Binding CopyImageCodeSnippetCommand}" CommandParameter="skia" Classes="snippet-action-btn" Height="20" Padding="6,0">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="ContentCopy" Width="10" Height="10" />
                                            <TextBlock Text="Copy" FontSize="9.5" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Text="using SkiaSharp;&#x0a;using var stream = File.OpenRead(...);&#x0a;using var bitmap = SKBitmap.Decode(stream);"
                                           FontFamily="JetBrains Mono, Menlo, monospace" FontSize="10"
                                           Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <!-- Card 2: C# Raw Bytes -->
                        <Border Grid.Row="0" Grid.Column="1" Margin="4"
                                Background="{DynamicResource DsSurfaceHighBrush}"
                                BorderBrush="{DynamicResource DsBorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="10">
                            <Grid RowDefinitions="Auto,Auto">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                    <TextBlock Grid.Column="0" Text="C# (Raw Bytes)" FontSize="11" FontWeight="Bold" Foreground="#58A6FF" />
                                    <Button Grid.Column="1" Command="{Binding CopyImageCodeSnippetCommand}" CommandParameter="bytes" Classes="snippet-action-btn" Height="20" Padding="6,0">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="ContentCopy" Width="10" Height="10" />
                                            <TextBlock Text="Copy" FontSize="9.5" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Text="byte[] bytes = File.ReadAllBytes(...);"
                                           FontFamily="JetBrains Mono, Menlo, monospace" FontSize="10"
                                           Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <!-- Card 3: C# Avalonia Bitmap -->
                        <Border Grid.Row="1" Grid.Column="0" Margin="4"
                                Background="{DynamicResource DsSurfaceHighBrush}"
                                BorderBrush="{DynamicResource DsBorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="10">
                            <Grid RowDefinitions="Auto,Auto">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                    <TextBlock Grid.Column="0" Text="C# (Avalonia UI)" FontSize="11" FontWeight="Bold" Foreground="#CB88FF" />
                                    <Button Grid.Column="1" Command="{Binding CopyImageCodeSnippetCommand}" CommandParameter="avalonia" Classes="snippet-action-btn" Height="20" Padding="6,0">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="ContentCopy" Width="10" Height="10" />
                                            <TextBlock Text="Copy" FontSize="9.5" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Text="using var stream = File.OpenRead(...);&#x0a;var bitmap = new Avalonia.Media.Imaging.Bitmap(stream);"
                                           FontFamily="JetBrains Mono, Menlo, monospace" FontSize="10"
                                           Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <!-- Card 4: Python Pillow -->
                        <Border Grid.Row="1" Grid.Column="1" Margin="4"
                                Background="{DynamicResource DsSurfaceHighBrush}"
                                BorderBrush="{DynamicResource DsBorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="10">
                            <Grid RowDefinitions="Auto,Auto">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                    <TextBlock Grid.Column="0" Text="Python (PIL / Pillow)" FontSize="11" FontWeight="Bold" Foreground="#4EC9B0" />
                                    <Button Grid.Column="1" Command="{Binding CopyImageCodeSnippetCommand}" CommandParameter="python" Classes="snippet-action-btn" Height="20" Padding="6,0">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="ContentCopy" Width="10" Height="10" />
                                            <TextBlock Text="Copy" FontSize="9.5" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Text="from PIL import Image&#x0a;img = Image.open(...)"
                                           FontFamily="JetBrains Mono, Menlo, monospace" FontSize="10"
                                           Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
