<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.CodeStudio;assembly=CSharpEditorPlugin"
             xmlns:git="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Models.Git;assembly=CSharpEditorPlugin"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.Studio.StudioDiffViewerControl"
             x:DataType="vm:CSharpCodeStudioViewModel"
             Background="{DynamicResource DsBgBrush}">

    <UserControl.Styles>
        <StyleInclude Source="avares://CSharpEditorPlugin/Styles/StudioStyles.axaml" />
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Background="{DynamicResource DsBgBrush}">
        <!-- Toolbar Strip -->
        <Border Grid.Row="0" Background="{DynamicResource DsSurfaceBrush}"
                BorderBrush="{DynamicResource DsBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6" Height="38">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left: File Details & Comparison Pill -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="SourceCommit" Width="16" Height="16"
                                                Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ActiveDiffDocument.FileName}" FontWeight="Bold" FontSize="12"
                               Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ActiveDiffDocument.RelativePath}" FontSize="10.5"
                               Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />

                    <!-- Comparison Mode Pill -->
                    <Border Background="{DynamicResource DsSurfaceHighBrush}" CornerRadius="3" Padding="6,2" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="HEAD" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource DsMutedBrush}" />
                            <TextBlock Text="↔" FontSize="9.5" Foreground="{DynamicResource DsMutedBrush}" />
                            <TextBlock Text="{Binding ActiveDiffDocument.IsStaged, Converter={x:Static ObjectConverters.IsNull}}"
                                       FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource DsPrimaryBrush}"
                                       IsVisible="False" />
                            <TextBlock Text="Working Tree" FontSize="9.5" FontWeight="Bold"
                                       Foreground="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Additions / Deletions Stats -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="6,0,0,0">
                        <TextBlock Text="{Binding ActiveDiffDocument.AdditionsCount, StringFormat='+{0}'}"
                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ActiveDiffDocument.DeletionsCount, StringFormat='-{0}'}"
                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DsErrorBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: Actions & View Switcher -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Layout Toggle (Side by Side vs Inline) -->
                    <Button Command="{Binding ToggleDiffLayoutCommand}" Classes="diff-action-btn"
                            ToolTip.Tip="Toggle Diff Layout (Side-by-Side vs Inline)">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <materialIcons:MaterialIcon Kind="ViewSplitVertical" Width="13" Height="13"
                                                        Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding IsSideBySideDiff, Converter={x:Static ObjectConverters.IsNull}}"
                                       IsVisible="False" />
                            <TextBlock Text="Toggle View" FontSize="10.5" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Stage / Unstage Action -->
                    <Button Command="{Binding StageActiveDiffCommand}" Classes="diff-action-btn"
                            IsVisible="{Binding !ActiveDiffDocument.IsStaged}"
                            ToolTip.Tip="Stage Changes for this file">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <materialIcons:MaterialIcon Kind="Plus" Width="13" Height="13" Foreground="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Stage" FontSize="10.5" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding UnstageActiveDiffCommand}" Classes="diff-action-btn"
                            IsVisible="{Binding ActiveDiffDocument.IsStaged}"
                            ToolTip.Tip="Unstage Changes for this file">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <materialIcons:MaterialIcon Kind="Minus" Width="13" Height="13" Foreground="{DynamicResource DsErrorBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Unstage" FontSize="10.5" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Discard Changes Action -->
                    <Button Command="{Binding DiscardActiveDiffCommand}" Classes="diff-action-btn"
                            IsVisible="{Binding !ActiveDiffDocument.IsStaged}"
                            ToolTip.Tip="Discard Changes (revert to HEAD)">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <materialIcons:MaterialIcon Kind="Undo" Width="13" Height="13" Foreground="{DynamicResource DsWarningBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Discard" FontSize="10.5" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Open Real Source File -->
                    <Button Command="{Binding OpenActiveDiffSourceFileCommand}" Classes="diff-action-btn"
                            ToolTip.Tip="Open Source File in Regular Editor">
                        <materialIcons:MaterialIcon Kind="OpenInApp" Width="13" Height="13"
                                                    Foreground="{DynamicResource DsMutedBrush}" />
                    </Button>

                    <!-- Close Diff Tab -->
                    <Button Command="{Binding CloseActiveDiffTabCommand}" Classes="diff-action-btn"
                            ToolTip.Tip="Close Diff View">
                        <materialIcons:MaterialIcon Kind="Close" Width="13" Height="13"
                                                    Foreground="{DynamicResource DsMutedBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Diff Area -->
        <Panel Grid.Row="1">
            <!-- Mode 1: Side by Side Diff -->
            <Grid ColumnDefinitions="*,1,*" IsVisible="{Binding IsSideBySideDiff}">
                <!-- Left Pane: HEAD / Previous -->
                <Grid Grid.Column="0" RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Background="{DynamicResource DsSurfaceHighBrush}" Padding="10,4"
                            BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="HEAD (Previous / Original)" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource DsMutedBrush}" />
                    </Border>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ActiveDiffDocument.SideBySideRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="git:GitDiffSideBySideRow">
                                    <Border Padding="6,1"
                                            Classes.diff-deletion="{Binding OldKind, Converter={x:Static ObjectConverters.IsNull}}"
                                            Background="{Binding OldKind, Converter={x:Static ObjectConverters.IsNull}}"
                                            IsVisible="{Binding HasOldContent}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Grid.Column="0" Text="{Binding OldLineDisplay}" Classes="diff-line-num" />
                                            <TextBlock Grid.Column="1" Text="{Binding OldText}" Classes="diff-code"
                                                       Foreground="{DynamicResource DsTextWhiteBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Divider -->
                <Border Grid.Column="1" Background="{DynamicResource DsBorderBrush}" />

                <!-- Right Pane: Working Tree / Modified -->
                <Grid Grid.Column="2" RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Background="{DynamicResource DsSurfaceHighBrush}" Padding="10,4"
                            BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Working Tree (Modified)" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource DsPrimaryBrush}" />
                    </Border>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ActiveDiffDocument.SideBySideRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="git:GitDiffSideBySideRow">
                                    <Border Padding="6,1"
                                            IsVisible="{Binding HasNewContent}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Grid.Column="0" Text="{Binding NewLineDisplay}" Classes="diff-line-num" />
                                            <TextBlock Grid.Column="1" Text="{Binding NewText}" Classes="diff-code"
                                                       Foreground="{DynamicResource DsTextWhiteBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Mode 2: Inline Diff -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding !IsSideBySideDiff}">
                <ItemsControl ItemsSource="{Binding ActiveDiffDocument.InlineLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="git:GitDiffLine">
                            <Border Padding="8,1"
                                    Classes.diff-addition="{Binding IsAddition}"
                                    Classes.diff-deletion="{Binding IsDeletion}"
                                    Classes.diff-header="{Binding IsHeader}">
                                <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                                    <TextBlock Grid.Column="0" Text="{Binding OldLineDisplay}" Classes="diff-line-num" />
                                    <TextBlock Grid.Column="1" Text="{Binding NewLineDisplay}" Classes="diff-line-num" />
                                    <TextBlock Grid.Column="2" Text="{Binding Marker}" Classes="diff-code"
                                               Width="18" TextAlignment="Center" Margin="0,0,6,0"
                                               Foreground="{Binding IsAddition, Converter={x:Static ObjectConverters.IsNull}}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Text}" Classes="diff-code"
                                               Foreground="{DynamicResource DsTextWhiteBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty / No Diff Fallback -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                        IsVisible="{Binding !ActiveDiffDocument.HasChanges}">
                <materialIcons:MaterialIcon Kind="FileCheckOutline" Width="36" Height="36"
                                            Foreground="{DynamicResource DsMutedBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="No differences detected. File matches HEAD."
                           FontSize="12" Foreground="{DynamicResource DsMutedBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Panel>
    </Grid>
</UserControl>
