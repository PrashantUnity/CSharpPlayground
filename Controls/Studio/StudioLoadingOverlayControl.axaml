<UserControl xmlns:lt="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Extensibility.Theming.Layout;assembly=CSharpEditorPlugin" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.Studio.StudioLoadingOverlayControl"
             x:Name="LoadingRoot"
             IsVisible="{Binding #LoadingRoot.IsLoading}">

    <!-- Full-screen backdrop / scrim capturing clicks and dimming the background -->
    <Grid Background="{DynamicResource DsScrimBrush}"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          ZIndex="1000">

        <!-- Centered Floating Popup Card -->
        <Border Classes="studio-loading-card"
                MinWidth="360"
                MaxWidth="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource DsSurfaceBrush}"
                BorderBrush="{DynamicResource DsBorderBrush}"
                lt:Tokens.BorderThickness="DsCardBorder"
                lt:Tokens.CornerRadius="DsRadius3XL"
                lt:Tokens.BoxShadow="DsModalShadow"
                Padding="28,24">
            <StackPanel lt:Tokens.Spacing="DsSpace18" HorizontalAlignment="Center">

                <!-- Logo Badge with Animated Orbital Rings & Ambient Glow -->
                <Grid Width="76" Height="76" HorizontalAlignment="Center">

                    <!-- 1. Ambient Breathing Aura Pulse -->
                    <Border x:Name="AuraPulseBorder"
                            Width="64" Height="64"
                            CornerRadius="32"
                            Background="{DynamicResource DsPrimarySubtleBrush}"
                            BoxShadow="{DynamicResource DsGlowPrimaryShadow}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Classes="loading-pulse-glow" />

                    <!-- 2. Counter-Orbiting Outer Whisper Ring (74px) -->
                    <Border x:Name="OuterRingBorder"
                            Width="74" Height="74"
                            CornerRadius="37"
                            BorderThickness="1.5,0,0,0"
                            BorderBrush="{DynamicResource DsSyntaxStringBrush}"
                            Opacity="0.5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RenderTransformOrigin="50%,50%"
                            Classes="loading-spinner-outer-ring">
                        <Border.RenderTransform>
                            <RotateTransform Angle="0" />
                        </Border.RenderTransform>
                    </Border>

                    <!-- 3. Primary Orbital Spinner Ring (68px) with Accent Arc -->
                    <Border x:Name="SpinnerRingBorder"
                            Width="68" Height="68"
                            CornerRadius="34"
                            BorderThickness="2.5,2.5,0,0"
                            BorderBrush="{DynamicResource DsPrimaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RenderTransformOrigin="50%,50%"
                            Classes="loading-spinner-ring">
                        <Border.RenderTransform>
                            <RotateTransform Angle="0" />
                        </Border.RenderTransform>
                    </Border>

                    <!-- 4. Inner Circular Badge (56px) with Dragon Logo or Fallback Material Icon -->
                    <Border Width="56" Height="56"
                            CornerRadius="28"
                            Background="{DynamicResource DsOnAccentBrush}"
                            BorderBrush="{DynamicResource DsPrimaryBrush}"
                            lt:Tokens.BorderThickness="DsBorderMedium"
                            lt:Tokens.BoxShadow="DsFloatingShadow"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ClipToBounds="True">
                        <Panel>
                            <Image x:Name="LogoImage"
                                   Width="48" Height="48"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapInterpolationMode="HighQuality"
                                   IsVisible="{Binding #LoadingRoot.ShowLogo}" />
                            <materialIcons:MaterialIcon Kind="{Binding #LoadingRoot.IconKind}"
                                                        Width="28" Height="28"
                                                        Foreground="{DynamicResource DsPrimaryBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding !#LoadingRoot.ShowLogo}" />
                        </Panel>
                    </Border>
                </Grid>

                <!-- Titles & Secondary Info -->
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding #LoadingRoot.LoadingTitle}"
                               lt:Tokens.FontSize="DsFontSize600"
                               lt:Tokens.FontWeight="DsWeightStrong"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="{DynamicResource DsTextWhiteBrush}" />

                    <TextBlock Text="{Binding #LoadingRoot.LoadingSubtitle}"
                               lt:Tokens.FontSize="DsFontSize300"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="{DynamicResource DsMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="380"
                               IsVisible="{Binding #LoadingRoot.LoadingSubtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <!-- Indeterminate Sleek Glowing Progress Bar Track -->
                <Border Width="260"
                        Height="4"
                        lt:Tokens.CornerRadius="DsRadiusXS"
                        Background="{DynamicResource DsBgBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        lt:Tokens.BorderThickness="DsBorderThin"
                        ClipToBounds="True"
                        HorizontalAlignment="Center">
                    <Canvas Width="260" Height="4" ClipToBounds="True">
                        <!-- Primary traveling beam -->
                        <Border x:Name="PrimaryBeamBorder"
                                Classes="indeterminate-track-glow-primary"
                                Width="110"
                                Height="4"
                                lt:Tokens.CornerRadius="DsRadiusXS"
                                Background="{DynamicResource DsLoadingBeamPrimary}">
                            <Border.RenderTransform>
                                <TranslateTransform X="-110" />
                            </Border.RenderTransform>
                        </Border>

                        <!-- Secondary trailing accent beam -->
                        <Border x:Name="SecondaryBeamBorder"
                                Classes="indeterminate-track-glow-secondary"
                                Width="55"
                                Height="4"
                                lt:Tokens.CornerRadius="DsRadiusXS"
                                Background="{DynamicResource DsLoadingBeamSecondary}">
                            <Border.RenderTransform>
                                <TranslateTransform X="-55" />
                            </Border.RenderTransform>
                        </Border>
                    </Canvas>
                </Border>

                <!-- Blocking work the user may stop (switching workspace) -->
                <Button Content="Cancel"
                        HorizontalAlignment="Center"
                        lt:Tokens.FontSize="DsFontSize300"
                        Padding="16,4"
                        Command="{Binding #LoadingRoot.CancelCommand}"
                        IsVisible="{Binding #LoadingRoot.ShowCancel}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
