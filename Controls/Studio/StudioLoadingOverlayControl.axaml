<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.Studio.StudioLoadingOverlayControl"
             x:Name="LoadingRoot"
             IsVisible="{Binding #LoadingRoot.IsLoading}">

    <!-- Full-screen backdrop / scrim capturing clicks and dimming the background -->
    <Grid Background="#85000000"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          ZIndex="1000">

        <!-- Centered Floating Popup Card -->
        <Border Classes="studio-loading-card"
                MinWidth="360"
                MaxWidth="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource DsSurfaceBrush}"
                BorderBrush="{DynamicResource DsBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                BoxShadow="0 24 64 0 #B0000000"
                Padding="28,24">
            <StackPanel Spacing="18" HorizontalAlignment="Center">

                <!-- Official Brand Dragon Logo in Circular Badge with Glow -->
                <Border Width="56" Height="56"
                        CornerRadius="28"
                        Background="#FFFFFF"
                        BorderBrush="{DynamicResource DsPrimaryBrush}"
                        BorderThickness="2"
                        BoxShadow="0 0 24 0 #4D007ACC"
                        HorizontalAlignment="Center"
                        ClipToBounds="True"
                        IsVisible="{Binding #LoadingRoot.ShowLogo}">
                    <Image x:Name="LogoImage"
                           Width="50" Height="50"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                </Border>

                <!-- Titles & Secondary Info -->
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding #LoadingRoot.LoadingTitle}"
                               FontSize="15"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="{DynamicResource DsTextWhiteBrush}" />

                    <TextBlock Text="{Binding #LoadingRoot.LoadingSubtitle}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="{DynamicResource DsMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="380"
                               IsVisible="{Binding #LoadingRoot.LoadingSubtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <!-- Indeterminate Sleek Progress Bar -->
                <ProgressBar IsIndeterminate="True"
                             Height="3"
                             Width="260"
                             CornerRadius="1.5"
                             Background="{DynamicResource DsBgBrush}"
                             Foreground="{DynamicResource DsPrimaryBrush}"
                             HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
