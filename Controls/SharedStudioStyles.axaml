<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

    <!-- ============================================================ -->
    <!-- 1. ACTIVITY BAR STYLES (Zone 1)                              -->
    <!-- ============================================================ -->
    <Style Selector="Button.activity-bar-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
                <BrushTransition Property="Foreground" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.activity-bar-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
    </Style>
    <Style Selector="Button.activity-bar-btn.active">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource M3PrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}" />
    </Style>

    <!-- ============================================================ -->
    <!-- 2. VS CODE MULTI-TAB STRIP STYLES (Zone 3)                   -->
    <!-- ============================================================ -->
    <Style Selector="Border.vscode-tab">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowBrush}" />
        <Setter Property="BorderThickness" Value="0,2,1,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
        <Setter Property="Padding" Value="12,0,8,0" />
        <Setter Property="Height" Value="35" />
    </Style>
    <Style Selector="Border.vscode-tab.active">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowestBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}" />
    </Style>

    <Style Selector="Button.vscode-tab-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.vscode-tab-close">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerExtraSmall}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.vscode-tab-close:pointerover">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
    </Style>

    <!-- ============================================================ -->
    <!-- 3. BOTTOM DECK TAB STYLES (Zone 4)                           -->
    <!-- ============================================================ -->
    <Style Selector="Button.ide-tab-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerSmall}" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <BrushTransition Property="Foreground" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.ide-tab-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
    </Style>
    <Style Selector="Button.ide-tab-btn.active">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
    </Style>

    <Style Selector="Border.ide-tab-badge">
        <Setter Property="Height" Value="16" />
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.ide-tab-badge > TextBlock">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- ============================================================ -->
    <!-- 4. TOOLBAR BUTTON STYLES                                     -->
    <!-- ============================================================ -->
    <Style Selector="Button.cs-toolbar-filled, Button.cs-toolbar-tonal, Button.cs-toolbar-outlined">
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerSmall}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.cs-toolbar-filled">
        <Setter Property="Background" Value="{DynamicResource M3SuccessBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSuccessBrush}" />
    </Style>
    <Style Selector="Button.cs-toolbar-filled:pointerover">
        <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.cs-toolbar-tonal">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.cs-toolbar-tonal:pointerover">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighestBrush}" />
    </Style>
    <Style Selector="Button.cs-toolbar-outlined">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.cs-toolbar-outlined:pointerover">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowBrush}" />
    </Style>
    <Style Selector="Button.cs-toolbar-icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerSmall}" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.cs-toolbar-icon:pointerover">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
    </Style>

    <!-- ============================================================ -->
    <!-- 5. SIDEBAR & EXPLORER STYLES (Zone 2)                        -->
    <!-- ============================================================ -->
    <Style Selector="TextBox.sidebar-search-box">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowestBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerSmall}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBox.explorer-rename-box">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowestBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerExtraSmall}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Height" Value="22" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{DynamicResource M3PrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource M3PrimaryBrush}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource M3OnPrimaryBrush}" />
    </Style>
    <Style Selector="TextBox.explorer-rename-box /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowestBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerExtraSmall}" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="ToggleButton.sidebar-option-toggle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerExtraSmall}" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
    </Style>
    <Style Selector="ToggleButton.sidebar-option-toggle:checked">
        <Setter Property="Background" Value="{DynamicResource M3PrimaryContainerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource M3PrimaryBrush}" />
    </Style>

    <Style Selector="Button.explorer-item-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerExtraSmall}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.explorer-item-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowBrush}" />
    </Style>
    <Style Selector="Button.explorer-item-btn.selected">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
    </Style>

</Styles>
