<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:common="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.Common"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.Activities.ActivityToastHost"
             x:DataType="common:ActivityPresenterViewModel"
             HorizontalAlignment="Right"
             VerticalAlignment="Bottom"
             Margin="0,0,16,36"
             IsVisible="{Binding HasToasts}">

    <!-- Long work that can be cancelled or reports progress, and failures. Never modal: the studio stays usable. -->
    <ItemsControl ItemsSource="{Binding Toasts}" Width="340">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="common:ActivityToastViewModel">
                <Border Background="{DynamicResource DsSurfaceBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        BoxShadow="{DynamicResource DsFloatingShadow}"
                        Padding="12,10">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                        <materialIcons:MaterialIcon Grid.RowSpan="2" Kind="ProgressClock" Width="16" Height="16" VerticalAlignment="Top"
                                                    Foreground="{DynamicResource DsPrimaryBrush}"
                                                    IsVisible="{Binding !IsError}" />
                        <materialIcons:MaterialIcon Grid.RowSpan="2" Kind="AlertCircleOutline" Width="16" Height="16" VerticalAlignment="Top"
                                                    Foreground="{DynamicResource DsErrorBrush}"
                                                    IsVisible="{Binding IsError}" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource DsTextWhiteBrush}" />
                        <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap" MaxLines="3"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource DsMutedBrush}"
                                   IsVisible="{Binding HasDetail}" />
                        <ProgressBar Grid.Column="1" Grid.Row="2" Height="3" MinHeight="3" Minimum="0" Maximum="100"
                                     Value="{Binding ProgressValue}"
                                     Foreground="{DynamicResource DsPrimaryBrush}"
                                     Background="{DynamicResource DsBgBrush}"
                                     IsVisible="{Binding HasProgress}" />
                        <StackPanel Grid.Column="2" Grid.RowSpan="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                            <Button Content="Cancel" FontSize="11" Padding="8,2"
                                    Command="{Binding CancelCommand}"
                                    IsVisible="{Binding IsCancellable}" />
                            <Button Padding="4" Background="Transparent" BorderThickness="0"
                                    ToolTip.Tip="Hide"
                                    Command="{Binding DismissCommand}">
                                <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="{DynamicResource DsMutedBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
