<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="22"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.StudioStatusBarControl"
             x:CompileBindings="False">


    <UserControl.Styles>
        <StyleInclude Source="avares://CSharpEditorPlugin/Controls/SharedStudioStyles.axaml" />
    </UserControl.Styles>

    <Border Background="{DynamicResource M3SurfaceContainerLowBrush}"
            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
            BorderThickness="0,1,0,0"
            Height="22"
            Padding="8,1">
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <!-- Left: Remote Pill & Problems Badge -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- VS Code Remote-Style Accent Pill -->
                <Border Background="{DynamicResource M3PrimaryBrush}" CornerRadius="2" Padding="5,1">
                    <TextBlock Text="&gt;&lt; C# Studio" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource M3OnPrimaryBrush}" VerticalAlignment="Center" />
                </Border>

                <!-- Problems Quick Button -->
                <Button Command="{Binding ShowProblemsTabCommand}" Classes="status-item" ToolTip.Tip="Errors and warnings (Ctrl+Shift+M)">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="12" Height="12" Foreground="{DynamicResource M3ErrorBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ErrorCount}" FontSize="10" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                        <materialIcons:MaterialIcon Kind="AlertOutline" Width="12" Height="12" Foreground="{DynamicResource M3WarningBrush}" VerticalAlignment="Center" Margin="2,0,0,0" />
                        <TextBlock Text="{Binding WarningCount}" FontSize="10" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Roslyn Compiler Status -->
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="12" Height="12" Foreground="{DynamicResource M3SuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CompilerStatusText}" FontSize="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- Center: Execution Time -->
            <TextBlock Grid.Column="1" Text="{Binding ExecutionTimeText, StringFormat='{}⏱ {0}'}"
                       FontSize="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                       Margin="14,0,0,0" VerticalAlignment="Center"
                       IsVisible="{Binding ExecutionTimeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- Right: Ln, Col, Indentation, Encoding, Language, Bottom Deck Toggle -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <!-- Clickable Ln, Col -> Go To Line Dialog -->
                <Button Command="{Binding ShowGoToLineCommand}"
                        Classes="status-item"
                        ToolTip.Tip="Go to Line/Column (Ctrl+G)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding CaretLine, StringFormat='{}Ln {0}'}" FontSize="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CaretColumn, StringFormat='{}, Col {0}'}" FontSize="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Indentation Toggle Button -->
                <Button Command="{Binding ToggleIndentationCommand}"
                        Classes="status-item"
                        ToolTip.Tip="Toggle Indentation (2 vs 4 Spaces)">
                    <TextBlock Text="{Binding IndentationStatusText}" FontSize="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                </Button>

                <TextBlock Text="UTF-8" FontSize="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" Margin="5,0" />

                <!-- Language Mode Selector Flyout -->
                <Button Classes="status-item"
                        IsVisible="{Binding SupportsExecutionModes}"
                        ToolTip.Tip="Select C# Execution Mode">
                    <Button.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedRight">
                            <MenuItem Header="C# Top-Level Statements" Command="{Binding SetLanguageModeCommand}" CommandParameter="0" />
                            <MenuItem Header="C# Program with Main()" Command="{Binding SetLanguageModeCommand}" CommandParameter="1" />
                            <MenuItem Header="C# Single Expression" Command="{Binding SetLanguageModeCommand}" CommandParameter="2" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <TextBlock Text="{Binding LanguageModeStatusText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
                </Button>

                <!-- Toolchain picker (e.g. which Python runs .py files), for a language that runs with an installed toolchain -->
                <Button Classes="status-item"
                        IsVisible="{Binding HasToolchain}"
                        Command="{Binding RefreshToolchainsCommand}"
                        ToolTip.Tip="Choose which installed toolchain runs this file">
                    <Button.Flyout>
                        <Flyout Placement="TopEdgeAlignedRight">
                            <StackPanel Spacing="2" MinWidth="300" MaxWidth="460">
                                <TextBlock Text="Run with" FontSize="11" FontWeight="SemiBold" Margin="8,4,8,2" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                <ItemsControl ItemsSource="{Binding ToolchainChoices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding Command}" Classes="status-item" Height="NaN" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4">
                                                <Grid ColumnDefinitions="18,*">
                                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="Check" Width="13" Height="13" IsVisible="{Binding IsSelected}"
                                                                                Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="1">
                                                        <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                                        <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Separator Margin="4,2" />
                                <ItemsControl ItemsSource="{Binding ToolchainActions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding Command}" Classes="status-item" Height="NaN" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Padding="8,4" ToolTip.Tip="{Binding Description}">
                                                <TextBlock Text="{Binding Label}" FontSize="11.5" Margin="18,0,0,0" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Command="{Binding RefreshToolchainsCommand}" Classes="status-item" Height="NaN" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4">
                                    <TextBlock Text="Look again for installed toolchains" FontSize="11.5" Margin="18,0,0,0" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <materialIcons:MaterialIcon Kind="AlertOutline" Width="12" Height="12" IsVisible="{Binding IsToolchainMissing}"
                                                    Foreground="{DynamicResource M3WarningBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LanguageStatusText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Bottom Deck Toggle Button -->
                <Button Command="{Binding ToggleBottomDeckCommand}" Classes="status-item" Padding="4,0" ToolTip.Tip="Toggle Terminal Panel (Ctrl+J)">
                    <materialIcons:MaterialIcon Kind="DockBottom" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                </Button>

                <!-- Light/Dark Theme Toggle Button -->
                <Button Command="{Binding ToggleThemeCommand}" Classes="status-item" Padding="4,0" ToolTip.Tip="Toggle Light/Dark Theme">
                    <materialIcons:MaterialIcon Kind="ThemeLightDark" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
