<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.DocsOutlinePanelControl"
             x:DataType="vm:CSharpDocsViewModel"
             Width="260" Margin="36,0,0,0" VerticalAlignment="Top">

    <StackPanel Spacing="14">
        <!-- On This Page Navigation Card -->
        <Border Background="{DynamicResource M3SurfaceContainerLowBrush}"
                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="FormatListBulleted" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="ON THIS PAGE" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Rectangle Height="1" Fill="{DynamicResource M3OutlineVariantBrush}" />
                <ItemsControl ItemsSource="{Binding SelectedArticle.Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:DocSection">
                            <TextBlock Text="{Binding Heading}" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceBrush}" Margin="0,3" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Heading}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Quick Studio Jump Card -->
        <Border Background="{DynamicResource M3SurfaceContainerLowBrush}"
                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel Spacing="10">
                <TextBlock Text="QUICK ACTIONS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                <Button Command="{Binding OpenCodeStudioCommand}" Classes="snippet-action-btn" HorizontalAlignment="Stretch" Padding="8,6">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="CodeBraces" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                        <TextBlock Text="Open Script Studio" FontSize="11.5" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenNotebookStudioCommand}" Classes="snippet-action-btn" HorizontalAlignment="Stretch" Padding="8,6">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="BookOpenVariantOutline" Width="14" Height="14" Foreground="{DynamicResource M3SuccessBrush}" />
                        <TextBlock Text="Open Notebook" FontSize="11.5" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
