<UserControl xmlns:lt="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Extensibility.Theming.Layout;assembly=CSharpEditorPlugin" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:settings="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.Settings"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.Settings.ExecutionSettingsSectionControl"
             x:DataType="settings:CSharpSettingsViewModel"
             Background="Transparent">



    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,20,28,28" ColumnDefinitions="*,380" ColumnSpacing="20">
            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- LEFT MAIN COLUMN: CONFIGURATION CONTROLS                   -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Column="0" lt:Tokens.Spacing="DsSpace16">

                <!-- 1. HERO HEADER CARD -->
                <Border Background="{DynamicResource DsSurfaceBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        lt:Tokens.BorderThickness="DsCardBorder"
                        lt:Tokens.CornerRadius="DsRadiusCard"
                        lt:Tokens.Padding="DsCardPadding" lt:Tokens.BoxShadow="DsCardShadow">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Width="44" Height="44" lt:Tokens.CornerRadius="DsRadiusLG"
                                Background="{DynamicResource DsSurfaceHighBrush}"
                                BorderBrush="{DynamicResource DsBorderBrush}"
                                lt:Tokens.BorderThickness="DsBorderThin"
                                VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Console" Width="24" Height="24"
                                                        Foreground="{DynamicResource DsGreenBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="Execution &amp; Terminal Deck" lt:Tokens.FontSize="DsFontSize600" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsTextWhiteBrush}" />
                            <TextBlock Text="Script execution timeouts, interactive stdin streaming, and stdout/stderr buffers" lt:Tokens.FontSize="DsFontSize300" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Grid.Column="2" Background="{DynamicResource DsSurfaceHighBrush}"
                                BorderBrush="{DynamicResource DsBorderBrush}"
                                lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadius3XL" Padding="12,5" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource DsGreenBrush}" />
                                <TextBlock Text="Interactive Console" lt:Tokens.FontSize="DsFontSize250" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 2. TIMEOUTS & EXECUTION CONTROLS -->
                <Border Background="{DynamicResource DsSurfaceBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        lt:Tokens.BorderThickness="DsCardBorder"
                        lt:Tokens.CornerRadius="DsRadiusCard"
                        lt:Tokens.Padding="DsCardPadding" lt:Tokens.BoxShadow="DsCardShadow">
                    <StackPanel lt:Tokens.Spacing="DsSpace14">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="TimerOutline" Width="18" Height="18" Foreground="{DynamicResource DsPrimaryBrush}" />
                            <TextBlock Text="EXECUTION LIFECYCLE &amp; TIMEOUTS" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsMutedBrush}" lt:Tokens.LetterSpacing="DsTracking080" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Execution Timeout -->
                        <Grid ColumnDefinitions="*,130">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Execution Timeout (seconds)" lt:Tokens.FontSize="DsFontSize400" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                <TextBlock Text="Maximum seconds before halting execution automatically. 0 = unlimited / manual stop (Shift+F5)." lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <NumericUpDown Grid.Column="1" Value="{Binding ExecutionTimeoutSeconds, Mode=TwoWay}" Minimum="0" Maximum="600" Increment="5" FormatString="0" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. TERMINAL BUFFER & CONSOLE -->
                <Border Background="{DynamicResource DsSurfaceBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        lt:Tokens.BorderThickness="DsCardBorder"
                        lt:Tokens.CornerRadius="DsRadiusCard"
                        lt:Tokens.Padding="DsCardPadding" lt:Tokens.BoxShadow="DsCardShadow">
                    <StackPanel lt:Tokens.Spacing="DsSpace14">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="ConsoleLine" Width="18" Height="18" Foreground="{DynamicResource DsPrimaryBrush}" />
                            <TextBlock Text="TERMINAL CONSOLE BUFFER" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsMutedBrush}" lt:Tokens.LetterSpacing="DsTracking080" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Auto Clear Console -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Auto-Clear Console Before Run" lt:Tokens.FontSize="DsFontSize400" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                <TextBlock Text="Automatically clear previous terminal scrollback and stdout/stderr buffer upon starting a new execution or debug session." lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoClearConsoleOnRun, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" />
                        </Grid>

                        <Rectangle Height="1" Fill="{DynamicResource DsBorderBrush}" />

                        <!-- Max Buffer Lines -->
                        <Grid ColumnDefinitions="*,130">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Max Terminal Buffer Lines" lt:Tokens.FontSize="DsFontSize400" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                <TextBlock Text="Maximum scrollback lines preserved in stdout/stderr output stream buffer." lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <NumericUpDown Grid.Column="1" Value="{Binding MaxTerminalOutputLines, Mode=TwoWay}" Minimum="500" Maximum="50000" Increment="1000" FormatString="0" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- RIGHT COLUMN: RUNTIME ARCHITECTURE & INSPECTOR             -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Column="1" lt:Tokens.Spacing="DsSpace16">

                <!-- 1. ZERO UI-FREEZE & PROCESS SAFETY -->
                <Border Background="{DynamicResource DsSurfaceBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        lt:Tokens.BorderThickness="DsCardBorder"
                        lt:Tokens.CornerRadius="DsRadiusCard"
                        lt:Tokens.Padding="DsCardPadding" lt:Tokens.BoxShadow="DsCardShadow">
                    <StackPanel lt:Tokens.Spacing="DsSpace12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="ShieldCheckOutline" Width="18" Height="18" Foreground="{DynamicResource DsGreenBrush}" />
                            <TextBlock Text="PROCESS SAFETY &amp; LIFECYCLE" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsMutedBrush}" lt:Tokens.LetterSpacing="DsTracking080" VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Background="{DynamicResource DsBgBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusMD" Padding="12,10">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="16" Height="16" Foreground="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="ProcessRegistry Tree Tracking" lt:Tokens.FontSize="DsFontSize350" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="All child processes are launched through IProcessLauncher and registered in ProcessRegistry. On Stop, tab close, or plugin unload, process groups (Unix) and Job Objects (Windows) cleanly terminate entire process trees."
                                           lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource DsBgBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusMD" Padding="12,10">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="16" Height="16" Foreground="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Zero UI-Thread Freeze" lt:Tokens.FontSize="DsFontSize350" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Compilation, package resolution, and external toolchain processes execute strictly in Task.Run off the UI thread to guarantee 60 FPS responsiveness."
                                           lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 2. INTERACTIVE STDIN PROTOCOL -->
                <Border Background="{DynamicResource DsSurfaceBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        lt:Tokens.BorderThickness="DsCardBorder"
                        lt:Tokens.CornerRadius="DsRadiusCard"
                        lt:Tokens.Padding="DsCardPadding" lt:Tokens.BoxShadow="DsCardShadow">
                    <StackPanel lt:Tokens.Spacing="DsSpace10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="ConsoleNetworkOutline" Width="18" Height="18" Foreground="{DynamicResource DsPrimaryBrush}" />
                            <TextBlock Text="INTERACTIVE STDIN STREAMING" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsMutedBrush}" lt:Tokens.LetterSpacing="DsTracking080" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Scripts requesting user input (e.g. input() in Python or Console.ReadLine() in C#) stream standard input in real time from the Terminal prompt directly to the running process without deadlock."
                                   lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />

                        <Border Background="{DynamicResource DsBgBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusMD" Padding="10,8">
                            <Grid ColumnDefinitions="Auto,*">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="KeyboardOutline" Width="16" Height="16" Foreground="{DynamicResource DsPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="F5 (Run) • Shift+F5 (Stop) • Ctrl+J (Console)" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontFamily="DsCodeFontFamily" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
