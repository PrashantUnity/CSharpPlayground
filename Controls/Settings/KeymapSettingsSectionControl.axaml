<UserControl xmlns:lt="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Extensibility.Theming.Layout;assembly=CSharpEditorPlugin" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:settings="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.Settings"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="850"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.Settings.KeymapSettingsSectionControl"
             x:DataType="settings:CSharpSettingsViewModel"
             Background="Transparent">



    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28" lt:Tokens.Spacing="DsSpace16">

            <!-- 1. HERO HEADER CARD WITH FILTER BAR -->
            <Border Background="{DynamicResource DsSurfaceBrush}"
                    BorderBrush="{DynamicResource DsBorderBrush}"
                    lt:Tokens.BorderThickness="DsCardBorder"
                    lt:Tokens.CornerRadius="DsRadiusCard"
                    lt:Tokens.Padding="DsCardPadding" lt:Tokens.BoxShadow="DsCardShadow">
                <Grid RowDefinitions="Auto,16,Auto">
                    <!-- Title & Badge -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Width="44" Height="44" lt:Tokens.CornerRadius="DsRadiusLG"
                                Background="{DynamicResource DsSurfaceHighBrush}"
                                BorderBrush="{DynamicResource DsBorderBrush}"
                                lt:Tokens.BorderThickness="DsBorderThin"
                                VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="KeyboardOutline" Width="24" Height="24"
                                                        Foreground="{DynamicResource DsPrimaryBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="Keyboard Shortcuts &amp; Keymap" lt:Tokens.FontSize="DsFontSize600" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsTextWhiteBrush}" />
                            <TextBlock Text="Standard Visual Studio Code keyboard bindings registered across editor, side bar, and bottom tool deck" lt:Tokens.FontSize="DsFontSize300" Foreground="{DynamicResource DsMutedBrush}" />
                        </StackPanel>

                        <Border Grid.Column="2" Background="{DynamicResource DsSurfaceHighBrush}"
                                BorderBrush="{DynamicResource DsBorderBrush}"
                                lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadius3XL" Padding="12,5" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource DsPrimaryBrush}" />
                                <TextBlock Text="VS Code Standard" lt:Tokens.FontSize="DsFontSize250" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Filter Controls: Search & Category Chips -->
                    <Grid Grid.Row="2" ColumnDefinitions="280,16,*">
                        <!-- Keymap Search Input -->
                        <TextBox Grid.Column="0"
                                 Text="{Binding KeymapSearchQuery, Mode=TwoWay}"
                                 PlaceholderText="Filter shortcuts (e.g. F5, debug, side bar)…"
                                 Classes="nexus-search-input"
                                 lt:Tokens.FontSize="DsFontSize300" lt:Tokens.Height="DsControlHeight300">
                            <TextBox.InnerLeftContent>
                                <materialIcons:MaterialIcon Kind="Magnify" Width="16" Height="16" Margin="8,0,0,0" Foreground="{DynamicResource DsMutedBrush}" />
                            </TextBox.InnerLeftContent>
                        </TextBox>

                        <!-- Category Filter Chips -->
                        <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding KeymapCategoryChips}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="settings:KeymapCategoryChip">
                                        <Button Command="{Binding ((settings:CSharpSettingsViewModel)DataContext).SelectKeymapCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue={x:Null}}"
                                                CommandParameter="{Binding}"
                                                Classes="snippet-action-btn"
                                                Classes.active="{Binding IsSelected}"
                                                lt:Tokens.Height="DsControlHeight200" Padding="12,0" VerticalContentAlignment="Center">
                                            <TextBlock Text="{Binding Name}" lt:Tokens.FontSize="DsFontSize250" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- 2. SHORTCUTS TABLE CARD -->
            <Border Background="{DynamicResource DsSurfaceBrush}"
                    BorderBrush="{DynamicResource DsBorderBrush}"
                    lt:Tokens.BorderThickness="DsCardBorder"
                    lt:Tokens.CornerRadius="DsRadiusCard"
                    lt:Tokens.Padding="DsCardPadding" lt:Tokens.BoxShadow="DsCardShadow">
                <StackPanel lt:Tokens.Spacing="DsSpace10">
                    <Grid ColumnDefinitions="180,240,*">
                        <TextBlock Grid.Column="0" Text="COMMAND / ACTION" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsMutedBrush}" lt:Tokens.LetterSpacing="DsTracking080" />
                        <TextBlock Grid.Column="1" Text="KEYBINDING" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsMutedBrush}" lt:Tokens.LetterSpacing="DsTracking080" />
                        <TextBlock Grid.Column="2" Text="DESCRIPTION &amp; SCOPE" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsMutedBrush}" lt:Tokens.LetterSpacing="DsTracking080" />
                    </Grid>

                    <Border Background="{DynamicResource DsBgBrush}"
                            BorderBrush="{DynamicResource DsBorderBrush}"
                            lt:Tokens.BorderThickness="DsBorderThin"
                            lt:Tokens.CornerRadius="DsRadiusMD">
                        <ItemsControl ItemsSource="{Binding FilteredShortcuts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="settings:KeymapShortcutItem">
                                    <Border BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderBottom" Padding="14,10">
                                        <Grid ColumnDefinitions="180,240,*">
                                            <!-- Action Name & Category Badge -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Text="{Binding Action}" lt:Tokens.FontSize="DsFontSize350" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                                <Border Background="{DynamicResource DsSurfaceHighBrush}"
                                                        BorderBrush="{DynamicResource DsBorderBrush}"
                                                        lt:Tokens.BorderThickness="DsBorderThin"
                                                        Height="18" MinHeight="18" lt:Tokens.CornerRadius="DsRadiusXS" Padding="6,0"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Category}" lt:Tokens.FontSize="DsFontSize075" Foreground="{DynamicResource DsMutedBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0,1,0,0" />
                                                </Border>
                                            </StackPanel>

                                            <!-- Formatted Keycap Pill -->
                                            <Border Grid.Column="1" Background="{DynamicResource DsSurfaceHighBrush}"
                                                    BorderBrush="{DynamicResource DsBorderBrush}"
                                                    lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusSM"
                                                    Height="24" MinHeight="24"
                                                    Padding="9,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Shortcut}" lt:Tokens.FontSize="DsFontSize250" lt:Tokens.FontFamily="DsCodeFontFamily" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsPrimaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0,1,0,0" />
                                            </Border>

                                            <!-- Description -->
                                            <TextBlock Grid.Column="2" Text="{Binding Description}" lt:Tokens.FontSize="DsFontSize300" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
