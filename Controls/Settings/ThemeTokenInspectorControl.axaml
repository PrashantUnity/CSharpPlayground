<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:settings="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.Settings"
             xmlns:common="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Common"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="500"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.Settings.ThemeTokenInspectorControl"
             x:DataType="settings:CSharpSettingsViewModel">

    <UserControl.Styles>
        <Style Selector="Button.category-pill-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{DynamicResource DsMutedBrush}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.category-pill-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
        </Style>
        <Style Selector="Button.category-pill-btn.category-pill-active">
            <Setter Property="Background" Value="{DynamicResource DsPrimarySubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DsPrimaryBrush}" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource DsSurfaceBrush}" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,16">
        <StackPanel Spacing="12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="FormatListCheckbox" Width="17" Height="17" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="ALL VARIABLE COLORS &amp; RUNTIME TOKENS" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource DsMutedBrush}" LetterSpacing="0.8" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource DsSurfaceHighBrush}" CornerRadius="10" Padding="8,2" Margin="6,0,0,0">
                        <TextBlock Text="{Binding MatchingTokensCount, StringFormat='{}{0} tokens'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <TextBox Grid.Column="2" Text="{Binding TokenSearchQuery, Mode=TwoWay}" PlaceholderText="Search tokens or #hex…" Classes="nexus-search-input" Width="220" Height="28" FontSize="11.5">
                    <TextBox.InnerLeftContent><materialIcons:MaterialIcon Kind="Magnify" Width="14" Height="14" Margin="6,0,0,0" Foreground="{DynamicResource DsMutedBrush}" /></TextBox.InnerLeftContent>
                </TextBox>
            </Grid>

            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding CategoryFilters}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="settings:CategoryFilterItemViewModel">
                            <Button Command="{Binding ((settings:CSharpSettingsViewModel)DataContext).SelectTokenCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Name}" Classes="category-pill-btn" Classes.category-pill-active="{Binding IsSelected}">
                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Background="{DynamicResource DsSurfaceHighBrush}" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Padding="12,6">
                <Grid ColumnDefinitions="28,210,105,*,95,32">
                    <TextBlock Grid.Column="0" Text="CHIP" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="TOKEN KEY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" Margin="8,0" />
                    <TextBlock Grid.Column="2" Text="CATEGORY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="ROLE &amp; USAGE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" Margin="8,0" />
                    <TextBlock Grid.Column="4" Text="HEX VALUE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" Margin="8,0" />
                    <TextBlock Grid.Column="5" Text="COPY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Grid>
            </Border>

            <Border Background="{DynamicResource DsBgBrush}" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1" CornerRadius="0,0,6,6" Padding="0">
                <ItemsControl ItemsSource="{Binding FilteredColorTokens}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="settings:ColorTokenItemViewModel">
                            <Border BorderBrush="{DynamicResource DsBorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="12,6" Background="Transparent">
                                <Grid ColumnDefinitions="28,210,105,*,95,32">
                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="4" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1" Background="{Binding CurrentHex, Converter={x:Static common:HexToBrushConverter.Instance}}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock Text="{Binding Key}" FontSize="11.5" FontWeight="SemiBold" FontFamily="Cascadia Code, Consolas, monospace" Foreground="{DynamicResource DsTextWhiteBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{DynamicResource DsSurfaceHighBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DsMutedBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="11" Foreground="{DynamicResource DsTextBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource DsMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="4" Background="{DynamicResource DsSurfaceHighBrush}" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="8,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding CurrentHex}" FontSize="11" FontFamily="Cascadia Code, Consolas, monospace" Foreground="{DynamicResource DsPrimaryBrush}" FontWeight="SemiBold" />
                                    </Border>
                                    <Button Grid.Column="5" Command="{Binding ((settings:CSharpSettingsViewModel)DataContext).CopyTokenHexCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Classes="cs-toolbar-outlined" Padding="5,3" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip.Tip="Copy hex code to clipboard">
                                        <materialIcons:MaterialIcon Kind="ContentCopy" Width="12" Height="12" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
