<UserControl xmlns:lt="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Extensibility.Theming.Layout;assembly=CSharpEditorPlugin" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:settings="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.Settings"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="850"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.Settings.EditorSettingsSectionControl"
             x:DataType="settings:CSharpSettingsViewModel"
             Background="Transparent">



    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,20,28,28" ColumnDefinitions="*,380" ColumnSpacing="20">

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- LEFT MAIN COLUMN: EDITOR PREFERENCES                      -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Column="0" lt:Tokens.Spacing="DsSpace16">

                <!-- 1. HERO HEADER CARD -->
                <Border Background="{DynamicResource DsSurfaceBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        lt:Tokens.BorderThickness="DsCardBorder"
                        lt:Tokens.CornerRadius="DsRadiusCard"
                        lt:Tokens.Padding="DsCardPadding" lt:Tokens.BoxShadow="DsCardShadow">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Width="44" Height="44" lt:Tokens.CornerRadius="DsRadiusLG"
                                Background="{DynamicResource DsSurfaceHighBrush}"
                                BorderBrush="{DynamicResource DsBorderBrush}"
                                lt:Tokens.BorderThickness="DsBorderThin"
                                VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="CodeBraces" Width="24" Height="24"
                                                        Foreground="{DynamicResource DsPrimaryBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="Editor &amp; Formatting Preferences" lt:Tokens.FontSize="DsFontSize600" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsTextWhiteBrush}" />
                            <TextBlock Text="AvaloniaEdit code canvas geometry, typography, indentation, and Roslyn compiler options" lt:Tokens.FontSize="DsFontSize300" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Grid.Column="2" Background="{DynamicResource DsSurfaceHighBrush}"
                                BorderBrush="{DynamicResource DsBorderBrush}"
                                lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadius3XL" Padding="12,5" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource DsPrimaryBrush}" />
                                <TextBlock Text="AvaloniaEdit Engine" lt:Tokens.FontSize="DsFontSize250" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 2. CANVAS TYPOGRAPHY & DISPLAY -->
                <Border Background="{DynamicResource DsSurfaceBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        lt:Tokens.BorderThickness="DsCardBorder"
                        lt:Tokens.CornerRadius="DsRadiusCard"
                        lt:Tokens.Padding="DsCardPadding" lt:Tokens.BoxShadow="DsCardShadow">
                    <StackPanel lt:Tokens.Spacing="DsSpace14">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="FormatSize" Width="18" Height="18" Foreground="{DynamicResource DsPrimaryBrush}" />
                            <TextBlock Text="CODE CANVAS &amp; TYPOGRAPHY" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsMutedBrush}" lt:Tokens.LetterSpacing="DsTracking080" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Font Size -->
                        <Grid ColumnDefinitions="*,130">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Editor Font Size" lt:Tokens.FontSize="DsFontSize400" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                <TextBlock Text="Font size in device-independent pixels for AvaloniaEdit code canvas." lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <NumericUpDown Grid.Column="1" Value="{Binding FontSize, Mode=TwoWay}" Minimum="9" Maximum="28" Increment="0.5" FormatString="0.0" VerticalAlignment="Center" />
                        </Grid>

                        <Rectangle Height="1" Fill="{DynamicResource DsBorderBrush}" />

                        <!-- Line Numbers -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Line Numbers" lt:Tokens.FontSize="DsFontSize400" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                <TextBlock Text="Display sequential line numbers in the left margin gutter of the editor canvas." lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowLineNumbers, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" />
                        </Grid>

                        <Rectangle Height="1" Fill="{DynamicResource DsBorderBrush}" />

                        <!-- Word Wrap -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Word Wrap" lt:Tokens.FontSize="DsFontSize400" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                <TextBlock Text="Wrap lines that exceed the editor viewport width instead of horizontal scrolling." lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding WordWrap, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" />
                        </Grid>

                        <Rectangle Height="1" Fill="{DynamicResource DsBorderBrush}" />

                        <!-- Syntax Highlighting -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Syntax Highlighting" lt:Tokens.FontSize="DsFontSize400" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                <TextBlock Text="Apply language-aware colour themes to keywords, strings, and identifiers. Disable for a plain-text experience." lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableSyntaxHighlighting, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" />
                        </Grid>

                        <Rectangle Height="1" Fill="{DynamicResource DsBorderBrush}" />

                        <!-- Auto Completion -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Auto Completion" lt:Tokens.FontSize="DsFontSize400" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                <TextBlock Text="Show IntelliSense completion suggestions while typing. Disable to get more screen space and fewer interruptions." lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableAutoCompletion, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. INDENTATION & TABS -->
                <Border Background="{DynamicResource DsSurfaceBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        lt:Tokens.BorderThickness="DsCardBorder"
                        lt:Tokens.CornerRadius="DsRadiusCard"
                        lt:Tokens.Padding="DsCardPadding" lt:Tokens.BoxShadow="DsCardShadow">
                    <StackPanel lt:Tokens.Spacing="DsSpace14">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="FormatAlignLeft" Width="18" Height="18" Foreground="{DynamicResource DsPrimaryBrush}" />
                            <TextBlock Text="INDENTATION &amp; TABS" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsMutedBrush}" lt:Tokens.LetterSpacing="DsTracking080" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Tab Size -->
                        <Grid ColumnDefinitions="*,130">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Tab Size" lt:Tokens.FontSize="DsFontSize400" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                <TextBlock Text="Number of visual spaces each Tab character or indent level represents." lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <NumericUpDown Grid.Column="1" Value="{Binding TabSize, Mode=TwoWay}" Minimum="1" Maximum="16" Increment="1" FormatString="0" VerticalAlignment="Center" />
                        </Grid>

                        <Rectangle Height="1" Fill="{DynamicResource DsBorderBrush}" />

                        <!-- Insert Spaces -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Insert Spaces" lt:Tokens.FontSize="DsFontSize400" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                <TextBlock Text="Insert spaces when pressing the Tab key instead of a literal tab character." lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ConvertTabsToSpaces, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. ROSLYN C# COMPILER OPTIONS -->
                <Border Background="{DynamicResource DsSurfaceBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        lt:Tokens.BorderThickness="DsCardBorder"
                        lt:Tokens.CornerRadius="DsRadiusCard"
                        lt:Tokens.Padding="DsCardPadding" lt:Tokens.BoxShadow="DsCardShadow">
                    <StackPanel lt:Tokens.Spacing="DsSpace14">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="Microsoft" Width="18" Height="18" Foreground="{DynamicResource DsPrimaryBrush}" />
                            <TextBlock Text="ROSLYN C# COMPILER OPTIONS" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsMutedBrush}" lt:Tokens.LetterSpacing="DsTracking080" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Nullable Reference Checks -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Nullable Reference Types" lt:Tokens.FontSize="DsFontSize400" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                <TextBlock Text="Enable nullable static analysis diagnostics (#nullable enable) in Roslyn compilations." lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding NullableChecksEnabled, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" />
                        </Grid>

                        <Rectangle Height="1" Fill="{DynamicResource DsBorderBrush}" />

                        <!-- Language Version -->
                        <Grid ColumnDefinitions="*,140">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="C# Language Version" lt:Tokens.FontSize="DsFontSize400" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                <TextBlock Text="Target C# compiler language specification (e.g. 13.0, preview)." lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Text="{Binding LanguageVersion, Mode=TwoWay}"
                                     lt:Tokens.FontFamily="DsCodeFontFamily" lt:Tokens.FontSize="DsFontSize300"
                                     HorizontalContentAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- RIGHT COLUMN: LIVE CANVAS PREVIEW & CHEATSHEET            -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Column="1" lt:Tokens.Spacing="DsSpace16">

                <!-- 1. LIVE CANVAS PREVIEW CARD -->
                <Border Background="{DynamicResource DsSurfaceBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        lt:Tokens.BorderThickness="DsCardBorder"
                        lt:Tokens.CornerRadius="DsRadiusCard"
                        lt:Tokens.Padding="DsCardPadding" lt:Tokens.BoxShadow="DsCardShadow">
                    <StackPanel lt:Tokens.Spacing="DsSpace12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="EyeOutline" Width="18" Height="18" Foreground="{DynamicResource DsPrimaryBrush}" />
                            <TextBlock Text="LIVE CANVAS PREVIEW" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsMutedBrush}" lt:Tokens.LetterSpacing="DsTracking080" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Simulated Editor Preview -->
                        <Border Background="{DynamicResource DsBgBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusLG" Padding="12" ClipToBounds="True">
                            <Grid ColumnDefinitions="Auto,*">
                                <!-- Line Numbers Gutter -->
                                <Border Grid.Column="0" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderRight" Padding="0,0,8,0" Margin="0,0,10,0" IsVisible="{Binding ShowLineNumbers}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="1" lt:Tokens.FontFamily="DsCodeFontFamily" FontSize="{Binding FontSize}" Foreground="{DynamicResource DsMutedBrush}" TextAlignment="Right" />
                                        <TextBlock Text="2" lt:Tokens.FontFamily="DsCodeFontFamily" FontSize="{Binding FontSize}" Foreground="{DynamicResource DsMutedBrush}" TextAlignment="Right" />
                                        <TextBlock Text="3" lt:Tokens.FontFamily="DsCodeFontFamily" FontSize="{Binding FontSize}" Foreground="{DynamicResource DsMutedBrush}" TextAlignment="Right" />
                                        <TextBlock Text="4" lt:Tokens.FontFamily="DsCodeFontFamily" FontSize="{Binding FontSize}" Foreground="{DynamicResource DsMutedBrush}" TextAlignment="Right" />
                                        <TextBlock Text="5" lt:Tokens.FontFamily="DsCodeFontFamily" FontSize="{Binding FontSize}" Foreground="{DynamicResource DsMutedBrush}" TextAlignment="Right" />
                                        <TextBlock Text="6" lt:Tokens.FontFamily="DsCodeFontFamily" FontSize="{Binding FontSize}" Foreground="{DynamicResource DsMutedBrush}" TextAlignment="Right" />
                                        <TextBlock Text="7" lt:Tokens.FontFamily="DsCodeFontFamily" FontSize="{Binding FontSize}" Foreground="{DynamicResource DsMutedBrush}" TextAlignment="Right" />
                                    </StackPanel>
                                </Border>

                                <!-- Code Lines -->
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock lt:Tokens.FontFamily="DsCodeFontFamily" FontSize="{Binding FontSize}" xml:space="preserve"><Run Foreground="{DynamicResource DsPrimaryBrush}" Text="using " /><Run Foreground="{DynamicResource DsTextWhiteBrush}" Text="System;" /></TextBlock>
                                    <TextBlock Text="" lt:Tokens.FontFamily="DsCodeFontFamily" FontSize="{Binding FontSize}" />
                                    <TextBlock lt:Tokens.FontFamily="DsCodeFontFamily" FontSize="{Binding FontSize}" xml:space="preserve"><Run Foreground="{DynamicResource DsMutedBrush}" Text="// Live editor preview canvas" /></TextBlock>
                                    <TextBlock lt:Tokens.FontFamily="DsCodeFontFamily" FontSize="{Binding FontSize}" xml:space="preserve"><Run Foreground="{DynamicResource DsPrimaryBrush}" Text="string " /><Run Foreground="{DynamicResource DsTextWhiteBrush}" Text="msg " /><Run Foreground="{DynamicResource DsMutedBrush}" Text="= " /><Run Foreground="{DynamicResource DsSyntaxStringBrush}" Text="&quot;Hello, FryPDF&quot;" /><Run Foreground="{DynamicResource DsMutedBrush}" Text=";" /></TextBlock>
                                    <TextBlock lt:Tokens.FontFamily="DsCodeFontFamily" FontSize="{Binding FontSize}" xml:space="preserve"><Run Foreground="{DynamicResource DsTextWhiteBrush}" Text="Console" /><Run Foreground="{DynamicResource DsMutedBrush}" Text="." /><Run Foreground="{DynamicResource DsPrimaryBrush}" Text="WriteLine" /><Run Foreground="{DynamicResource DsMutedBrush}" Text="(" /><Run Foreground="{DynamicResource DsTextWhiteBrush}" Text="msg" /><Run Foreground="{DynamicResource DsMutedBrush}" Text=");" /></TextBlock>
                                    <TextBlock lt:Tokens.FontFamily="DsCodeFontFamily" FontSize="{Binding FontSize}" xml:space="preserve"><Run Foreground="{DynamicResource DsTextWhiteBrush}" Text="Display" /><Run Foreground="{DynamicResource DsMutedBrush}" Text="." /><Run Foreground="{DynamicResource DsPrimaryBrush}" Text="Dump" /><Run Foreground="{DynamicResource DsMutedBrush}" Text="(" /><Run Foreground="{DynamicResource DsTextWhiteBrush}" Text="msg" /><Run Foreground="{DynamicResource DsMutedBrush}" Text=");" /></TextBlock>
                                    <TextBlock Text="" lt:Tokens.FontFamily="DsCodeFontFamily" FontSize="{Binding FontSize}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="Preview automatically updates when adjusting font size, line numbers, or indentation settings."
                                   lt:Tokens.FontSize="DsFontSize200" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 2. QUICK SHORTCUTS CARD -->
                <Border Background="{DynamicResource DsSurfaceBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        lt:Tokens.BorderThickness="DsCardBorder"
                        lt:Tokens.CornerRadius="DsRadiusCard"
                        lt:Tokens.Padding="DsCardPadding" lt:Tokens.BoxShadow="DsCardShadow">
                    <StackPanel lt:Tokens.Spacing="DsSpace10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="KeyboardOutline" Width="18" Height="18" Foreground="{DynamicResource DsPrimaryBrush}" />
                            <TextBlock Text="EDITOR SHORTCUTS" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsMutedBrush}" lt:Tokens.LetterSpacing="DsTracking080" VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Background="{DynamicResource DsBgBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusMD" Padding="10,8">
                            <StackPanel Spacing="7">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Format Document" lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsTextBrush}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{DynamicResource DsSurfaceHighBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusSM" Padding="6,2">
                                        <TextBlock Text="Shift+Alt+F" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontFamily="DsCodeFontFamily" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsPrimaryBrush}" />
                                    </Border>
                                </Grid>
                                <Rectangle Height="1" Fill="{DynamicResource DsBorderBrush}" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Hover Quick Info" lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsTextBrush}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{DynamicResource DsSurfaceHighBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusSM" Padding="6,2">
                                        <TextBlock Text="Ctrl+K Ctrl+I" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontFamily="DsCodeFontFamily" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsPrimaryBrush}" />
                                    </Border>
                                </Grid>
                                <Rectangle Height="1" Fill="{DynamicResource DsBorderBrush}" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Find &amp; Replace" lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsTextBrush}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{DynamicResource DsSurfaceHighBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusSM" Padding="6,2">
                                        <TextBlock Text="Ctrl+F" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontFamily="DsCodeFontFamily" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsPrimaryBrush}" />
                                    </Border>
                                </Grid>
                                <Rectangle Height="1" Fill="{DynamicResource DsBorderBrush}" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Zoom In / Out" lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsTextBrush}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{DynamicResource DsSurfaceHighBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusSM" Padding="6,2">
                                        <TextBlock Text="Ctrl+= / Ctrl+-" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontFamily="DsCodeFontFamily" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsPrimaryBrush}" />
                                    </Border>
                                </Grid>
                                <Rectangle Height="1" Fill="{DynamicResource DsBorderBrush}" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Reset Zoom (100%)" lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsTextBrush}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{DynamicResource DsSurfaceHighBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusSM" Padding="6,2">
                                        <TextBlock Text="Ctrl+0" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontFamily="DsCodeFontFamily" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsPrimaryBrush}" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
