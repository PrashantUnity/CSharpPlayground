<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:settings="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.Settings"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="200"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.Settings.RuntimeVerificationCardControl"
             x:DataType="settings:LanguageSettingItemViewModel">

    <Border Background="{DynamicResource DsSurfaceBrush}"
            BorderBrush="{DynamicResource DsBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="18,16">
        <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="16" Height="16" Foreground="{DynamicResource DsGreenBrush}" />
                        <TextBlock Text="RUNTIME HEALTH &amp; HELLO WORLD CHECK" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DsMutedBrush}" LetterSpacing="0.8" />
                    </StackPanel>
                    <TextBlock Text="Execute a quick 'Hello World' program using the selected runtime configuration to verify execution and output."
                               FontSize="11.5" Foreground="{DynamicResource DsMutedBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding TestHelloWorldCommand}"
                        IsEnabled="{Binding !IsTestingHelloWorld}"
                        Classes="cs-toolbar-filled"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="PlayCircleOutline" Width="15" Height="15" />
                        <TextBlock Text="{Binding TestButtonFullLabel}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11.5" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Test Results Drawer -->
            <Border Background="{DynamicResource DsBgBrush}"
                    BorderBrush="{DynamicResource DsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    IsVisible="{Binding HasHelloWorldResult}">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="{DynamicResource DsSurfaceHighBrush}"
                                    BorderBrush="{Binding HelloWorldStatusColor}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="8,3">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Fill="{Binding HelloWorldStatusColor}" />
                                    <TextBlock Text="{Binding HelloWorldStatusBadge}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding HelloWorldExecutionMessage}" FontSize="11.5" Foreground="{DynamicResource DsTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="{DynamicResource DsSurfaceBrush}"
                                    BorderBrush="{DynamicResource DsBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="5,2"
                                    IsVisible="{Binding HelloWorldEngineDetails.Length}">
                                <TextBlock Text="{Binding HelloWorldEngineDetails}" FontSize="10" FontFamily="Consolas,Menlo,monospace" Foreground="{DynamicResource DsMutedBrush}" />
                            </Border>
                            <TextBlock Text="{Binding HelloWorldElapsedText}" FontSize="11" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                            <Button Command="{Binding ClearHelloWorldResultCommand}" Classes="snippet-action-btn" Padding="4,2" ToolTip.Tip="Clear output">
                                <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="{DynamicResource DsMutedBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource DsSurfaceBrush}"
                            BorderBrush="{DynamicResource DsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            IsVisible="{Binding HelloWorldOutput.Length}">
                        <SelectableTextBlock Text="{Binding HelloWorldOutput}"
                                             FontFamily="Consolas,Menlo,monospace"
                                             FontSize="11.5"
                                             Foreground="{DynamicResource DsTextWhiteBrush}"
                                             TextWrapping="Wrap"
                                             MaxHeight="140" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
