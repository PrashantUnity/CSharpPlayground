<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             xmlns:vm="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.Server"
             xmlns:common="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Common"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="38"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.Server.FryServerMasterBarControl"
             x:DataType="vm:FryServerStudioViewModel">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CSharpEditorPlugin/Styles/Tokens/StudioPaletteTokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://CSharpEditorPlugin/Styles/StudioStyles.axaml" />
    </UserControl.Styles>

    <!-- Professional 38px VS Code Master Bar with Responsive Collapse -->
    <Border common:CompactWhenCrowded.IsEnabled="True"
            Background="{DynamicResource DsSurfaceBrush}"
            BorderBrush="{DynamicResource DsBorderBrush}"
            BorderThickness="0,0,0,1"
            Height="38"
            Padding="12,0"
            ClipToBounds="True">
        <Grid ColumnDefinitions="Auto,*,Auto">
            <!-- Left: Add Cell Segmented Pill + Server Engine Controls + Save + Outline -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <!-- Segmented Cell Creation Pill (Notebook Style) -->
                <Border Background="{DynamicResource DsSurfaceHighBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="2"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <!-- + Endpoint -->
                        <Button Command="{Binding AddEndpointCellCommand}" Classes="nb-action-btn" Height="26" Padding="8,0" ToolTip.Tip="Add Endpoint Cell">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Plus" Width="13" Height="13" Foreground="{DynamicResource DsPrimaryBrush}" />
                                <TextBlock Text="Endpoint" Classes="toolbar-label" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- + Middleware -->
                        <Button Command="{Binding AddMiddlewareCellCommand}" Classes="nb-action-btn" Height="26" Padding="8,0" ToolTip.Tip="Add Pipeline Middleware Cell">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="FilterVariant" Width="13" Height="13" Foreground="{DynamicResource NavHomeFgBrush}" />
                                <TextBlock Text="Middleware" Classes="toolbar-label" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- More Menu (+ Startup, + Scenario, + Markdown) -->
                        <Button Classes="nb-action-btn" Height="26" Padding="4,0" ToolTip.Tip="More Cell Types">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuItem Header="Add Startup Cell (Database/Seed)" Command="{Binding AddStartupCellCommand}">
                                        <MenuItem.Icon>
                                            <materialIcons:MaterialIcon Kind="DatabasePlus" Width="14" Height="14" Foreground="{DynamicResource NavScriptsFgBrush}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Add Integration Test Scenario" Command="{Binding AddScenarioCellCommand}">
                                        <MenuItem.Icon>
                                            <materialIcons:MaterialIcon Kind="TestTube" Width="14" Height="14" Foreground="{DynamicResource DsGreenBrush}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Add Documentation (Markdown)" Command="{Binding AddMarkdownCellCommand}">
                                        <MenuItem.Icon>
                                            <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="14" Height="14" Foreground="{DynamicResource NavTemplatesFgBrush}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </Button.Flyout>
                            <materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Border>

                <Rectangle Width="1" Height="16" Fill="{DynamicResource DsBorderBrush}" Margin="2,0" VerticalAlignment="Center" />

                <!-- Start Server (when stopped) -->
                <Button Command="{Binding StartServerCommand}"
                        IsVisible="{Binding !IsServerRunning}"
                        Classes="nb-action-btn"
                        Height="26"
                        Padding="8,0"
                        ToolTip.Tip="Start Live HTTP Server (F5)">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="Play" Width="13" Height="13" Foreground="{DynamicResource DsGreenBrush}" />
                        <TextBlock Text="Start" Classes="toolbar-label" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Stop Server (when running) -->
                <Button Command="{Binding StopServerCommand}"
                        IsVisible="{Binding IsServerRunning}"
                        Classes="nb-action-btn"
                        Height="26"
                        Padding="8,0"
                        ToolTip.Tip="Stop Running Server (Shift+F5)">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="Stop" Width="13" Height="13" Foreground="{DynamicResource NavPinnedFgBrush}" />
                        <TextBlock Text="Stop" Classes="toolbar-label" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource NavPinnedFgBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Restart Server -->
                <Button Command="{Binding RestartServerCommand}"
                        IsVisible="{Binding IsServerRunning}"
                        Classes="nb-action-btn"
                        Height="26"
                        Padding="6,0"
                        ToolTip.Tip="Restart Server">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="Restart" Width="12" Height="12" Foreground="{DynamicResource DsMutedBrush}" />
                        <TextBlock Text="Restart" Classes="toolbar-label" FontSize="11" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Height="16" Fill="{DynamicResource DsBorderBrush}" Margin="2,0" VerticalAlignment="Center" />

                <!-- Save -->
                <Button Command="{Binding SaveDocumentCommand}"
                        Classes="nb-action-btn"
                        Height="26"
                        Padding="6,0"
                        ToolTip.Tip="Save Document (Ctrl+S)">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                        <TextBlock Text="Save" Classes="toolbar-label" FontSize="11" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Outline Toggle -->
                <Button Command="{Binding ToggleSideBarCommand}"
                        Classes="nb-action-btn"
                        Height="26"
                        Padding="6,0"
                        ToolTip.Tip="Toggle Endpoints Outline (Ctrl+B)">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="FormatListBulleted" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                        <TextBlock Text="Outline" Classes="toolbar-label" FontSize="11" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Middle Spacer: Prevents left and right groups from colliding -->
            <Border Grid.Column="1" MinWidth="8" />

            <!-- Right: Port Configuration Capsule (unified with conflict alert), Export Menu & Logs Toggle -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <!-- Port Conflict Alert Capsule (Only when !IsServerRunning && HasPortConflict) -->
                <Button Command="{Binding ApplySuggestedPortCommand}"
                        IsVisible="{Binding ShowPortConflict}"
                        Classes="conflict-pill-btn"
                        ToolTip.Tip="Port is in use. Click to switch to next available port">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="12" Height="12" Foreground="{DynamicResource NavPinnedFgBrush}" />
                        <TextBlock Text="{Binding SuggestedPort, StringFormat='Port Conflict • Use :{0}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource NavPinnedFgBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Unified Server Host & Port Status Pill (Only when !ShowPortConflict) -->
                <Border IsVisible="{Binding !ShowPortConflict}"
                        Background="{DynamicResource DsSurfaceHighBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Height="26"
                        Padding="8,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- Status Indicator Dot -->
                        <Border Width="6" Height="6" CornerRadius="3"
                                Background="{DynamicResource DsGreenBrush}"
                                IsVisible="{Binding IsServerRunning}"
                                VerticalAlignment="Center" />
                        <Border Width="6" Height="6" CornerRadius="3"
                                Background="{DynamicResource DsMutedBrush}"
                                Opacity="0.5"
                                IsVisible="{Binding !IsServerRunning}"
                                VerticalAlignment="Center" />

                        <!-- When Running: Base URL + Copy -->
                        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsServerRunning}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding BaseUrl}"
                                       FontFamily="Consolas, Monaco, monospace"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource DsTextWhiteBrush}"
                                       MaxWidth="180"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding BaseUrl}"
                                       VerticalAlignment="Center" />
                            <Button Command="{Binding CopyBaseUrlCommand}"
                                    Classes="cell-tool-btn"
                                    Width="16" Height="16"
                                    ToolTip.Tip="Copy Server Base URL">
                                <materialIcons:MaterialIcon Kind="ContentCopy" Width="10" Height="10" Foreground="{DynamicResource DsMutedBrush}" />
                            </Button>
                        </StackPanel>

                        <!-- When Stopped: Port Configuration -->
                        <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding !IsServerRunning}" VerticalAlignment="Center">
                            <TextBlock Text="Port:" FontSize="11" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding PortInput, Mode=TwoWay}"
                                     FontFamily="Consolas, Monaco, monospace"
                                     FontSize="11"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource DsTextWhiteBrush}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     Margin="0,1,0,0"
                                     Width="38"
                                     Height="18"
                                     MinHeight="0"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Export Menu -->
                <Button Classes="nb-action-btn"
                        Height="26"
                        Padding="6,0"
                        ToolTip.Tip="Export Server Specification">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="Export ASP.NET Core Minimal API (Program.cs)" Command="{Binding ExportMinimalApiCommand}">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="LanguageCsharp" Width="14" Height="14" Foreground="{DynamicResource NavScriptsFgBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Export OpenAPI 3.0 (Swagger JSON)" Command="{Binding ExportOpenApiCommand}">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="FileCodeOutline" Width="14" Height="14" Foreground="{DynamicResource DsGreenBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Copy cURL Command Collection" Command="{Binding ExportCurlCommand}">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="Console" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="ExportVariant" Width="13" Height="13" Foreground="{DynamicResource DsPrimaryBrush}" />
                        <TextBlock Text="Export" Classes="toolbar-label" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <materialIcons:MaterialIcon Kind="ChevronDown" Width="9" Height="9" Foreground="{DynamicResource DsMutedBrush}" />
                    </StackPanel>
                </Button>

                <!-- Logs Panel Toggle Button with Badge -->
                <Button Command="{Binding ToggleBottomPanelCommand}"
                        Classes="nb-action-btn"
                        Height="26"
                        Padding="6,0"
                        ToolTip.Tip="Toggle Server Logs Panel (Ctrl+J)">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="SwapVertical" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                        <TextBlock Text="Logs" Classes="toolbar-label" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource DsPrimaryBrush}" CornerRadius="6" Padding="4,0" Height="14" IsVisible="{Binding TrafficLog.Count}">
                            <TextBlock Text="{Binding TrafficLog.Count}" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
