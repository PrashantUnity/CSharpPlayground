<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:models="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.QuickOpenOverlayControl"
             x:DataType="vm:QuickOpenViewModel"
             IsVisible="{Binding IsOpen}">

    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource M3PrimaryContainerBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- Full Screen Scrim to Capture Outside Clicks -->
    <Grid Background="#70000000"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          PointerPressed="OnBackdropPointerPressed">

        <!-- Centered Floating Palette Card -->
        <Border Width="620"
                MaxHeight="450"
                VerticalAlignment="Top"
                Margin="0,50,0,0"
                Background="{DynamicResource M3SurfaceContainerBrush}"
                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                BorderThickness="1"
                CornerRadius="10"
                BoxShadow="0 16 48 0 #90000000"
                PointerPressed="OnPaletteCardPointerPressed">
            <Grid RowDefinitions="Auto,Auto,*">
                <!-- Search Box Header -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="10,8,10,8" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Grid.Column="0" Kind="Magnify" Width="20" Height="20"
                                                Foreground="{DynamicResource M3PrimaryBrush}"
                                                Margin="6,0,8,0" VerticalAlignment="Center" />

                    <TextBox Grid.Column="1"
                             x:Name="SearchBox"
                             Text="{Binding SearchText, Mode=TwoWay}"
                             PlaceholderText="{Binding Placeholder}"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="14"
                             FontFamily="Cascadia Code, Consolas, Menlo, monospace"
                             Foreground="{DynamicResource M3OnSurfaceBrush}"
                             VerticalAlignment="Center"
                             KeyDown="OnSearchBoxKeyDown" />

                    <Button Grid.Column="2"
                            Command="{Binding CloseCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4"
                            Cursor="Hand"
                            ToolTip.Tip="Close (Escape)">
                        <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16"
                                                    Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                    </Button>
                </Grid>

                <!-- Divider -->
                <Border Grid.Row="1" Height="1" Background="{DynamicResource M3OutlineVariantBrush}" />

                <!-- Results List -->
                <ScrollViewer Grid.Row="2" MaxHeight="380"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ListBox ItemsSource="{Binding FilteredItems}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="6,4"
                             DoubleTapped="OnListBoxDoubleTapped"
                             KeyDown="OnListBoxKeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:QuickOpenItem">
                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                    <!-- Leading Icon -->
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6"
                                            Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                            Margin="0,0,10,0" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="{Binding IconKind}"
                                                                    Width="16" Height="16"
                                                                    Foreground="{Binding IconColorHex}"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Title and Subtitle -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource M3OnSurfaceBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>

                                    <!-- Category & Shortcut Hint Badges -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0,4,0">
                                        <Border Background="{DynamicResource M3SurfaceContainerHighestBrush}"
                                                CornerRadius="4" Padding="6,2"
                                                IsVisible="{Binding Category, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="{Binding Category}"
                                                       FontSize="10"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                        </Border>

                                        <Border Background="{DynamicResource M3SurfaceVariantBrush}"
                                                CornerRadius="4" Padding="6,2"
                                                IsVisible="{Binding ShortcutHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="{Binding ShortcutHint}"
                                                       FontSize="10"
                                                       FontFamily="Cascadia Code, Consolas, Menlo, monospace"
                                                       Foreground="{DynamicResource M3PrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
