<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="700"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.StudioDependenciesPanelControl"
             x:CompileBindings="False">

    <UserControl.Styles>
        <StyleInclude Source="avares://CSharpEditorPlugin/Controls/SharedStudioStyles.axaml" />
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10,8" Spacing="10">

            <!-- NuGet Search Section -->
            <Border Background="{DynamicResource M3SurfaceContainerBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="8">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="NUGET PACKAGES" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Command="{Binding SearchNuGetPackagesCommand}" Classes="explorer-tool-btn"
                                Width="20" Height="20" ToolTip.Tip="Search NuGet">
                            <materialIcons:MaterialIcon Kind="Magnify" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                        </Button>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding NuGetSearchQuery, Mode=TwoWay}"
                                 Classes="sidebar-search-box" PlaceholderText="Search NuGet packages...">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SearchNuGetPackagesCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1" Command="{Binding SearchNuGetPackagesCommand}"
                                Classes="cs-toolbar-filled" Background="{DynamicResource M3PrimaryBrush}"
                                Foreground="{DynamicResource M3OnPrimaryBrush}"
                                Height="26" MinHeight="0" Margin="4,0,0,0" Padding="8,0"
                                ToolTip.Tip="Search">
                            <TextBlock Text="Search" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <!-- Status Message / Loading -->
                    <TextBlock Text="{Binding NuGetStatusMessage}" FontSize="10"
                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding NuGetStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <!-- Search Results -->
                    <ItemsControl ItemsSource="{Binding NuGetSearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NuGetPackageItem">
                                <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,2">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{Binding Id}" FontWeight="Bold" FontSize="11"
                                                           Foreground="{DynamicResource M3PrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="9.5"
                                                           Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="9.5"
                                                       Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                       MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Command="{Binding $parent[UserControl].DataContext.AddNuGetPackageCommand}"
                                                CommandParameter="{Binding}" Classes="cs-toolbar-tonal"
                                                Height="22" MinHeight="0" Padding="6,0" VerticalAlignment="Center" Margin="4,0,0,0"
                                                ToolTip.Tip="Add reference to script">
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <materialIcons:MaterialIcon Kind="Plus" Width="11" Height="11" />
                                                <TextBlock Text="Add" FontSize="10" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Active Script NuGet Directives -->
            <Border Background="{DynamicResource M3SurfaceContainerBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="8"
                    IsVisible="{Binding DocumentNuGetPackages.Count}">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="SCRIPT DIRECTIVES (#r nuget)" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Background="{DynamicResource M3SurfaceContainerHighBrush}" CornerRadius="4" Padding="4,1">
                            <TextBlock Text="{Binding DocumentNuGetPackages.Count}" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource M3PrimaryBrush}" />
                        </Border>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding DocumentNuGetPackages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                    <TextBlock Grid.Column="0" Text="{Binding}" FontFamily="Consolas, monospace" FontSize="10"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Command="{Binding $parent[UserControl].DataContext.RemoveNuGetPackageCommand}"
                                            CommandParameter="{Binding}" Classes="explorer-tool-btn" Width="18" Height="18"
                                            ToolTip.Tip="Remove from script">
                                        <materialIcons:MaterialIcon Kind="Close" Width="10" Height="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Assembly References Section -->
            <Border Background="{DynamicResource M3SurfaceContainerBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="8">
                <StackPanel Spacing="6">
                    <TextBlock Text="ASSEMBLY REFERENCES" FontSize="10.5" FontWeight="Bold"
                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,0,0,2" />

                    <ItemsControl ItemsSource="{Binding References}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AssemblyReferenceViewModel">
                                <Border Padding="6,4" Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource M3ShapeCornerSmall}" Margin="0,1">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <materialIcons:MaterialIcon Grid.Column="0" Kind="PackageVariant" Width="13" Height="13"
                                                                    Foreground="{DynamicResource M3PrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                            <TextBlock Text="{Binding AssemblyPath}" FontSize="9" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" IsChecked="{Binding IsEnabled}" IsEnabled="{Binding !IsSystem}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
