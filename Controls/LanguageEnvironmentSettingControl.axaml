<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:toolchains="using:PdfEditorApp.Plugins.CSharpEditor.Services.Toolchains"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="700"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.LanguageEnvironmentSettingControl"
             x:DataType="vm:LanguageSettingItemViewModel"
             Background="Transparent">

    <UserControl.Styles>
        <StyleInclude Source="avares://CSharpEditorPlugin/Controls/SharedStudioStyles.axaml" />
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="24,18,24,24" MaxWidth="820" HorizontalAlignment="Left">

            <!-- 1. HEADER CARD: Brand Icon, Name, Status Badge & Quick Refresh -->
            <Border Background="{DynamicResource M3SurfaceContainerLowBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18,16">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Language Icon -->
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8"
                            Background="{DynamicResource M3SurfaceContainerHighestBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="{Binding IconKind}" Width="26" Height="26"
                                                    Foreground="{Binding AccentHex}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Language Title & Runtime Description -->
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                            <Border Background="{DynamicResource M3SurfaceContainerHighestBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveVersion}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding RuntimeDescription}" FontSize="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                    </StackPanel>

                    <!-- Live Status Badge & Refresh -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="10,5">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" />
                                <TextBlock Text="{Binding StatusBadge}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. MISSING TOOLCHAIN BANNER & INSTALL INSTRUCTIONS (Visible when missing) -->
            <Border Background="#2B1A1A"
                    BorderBrush="#F85149"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    IsVisible="{Binding IsMissing}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="20" Height="20" Foreground="#F85149" />
                        <TextBlock Text="{Binding MissingTitle}" FontSize="14" FontWeight="Bold" Foreground="#F85149" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding MissingSummary}" FontSize="12.5" Foreground="#E6EDF3" TextWrapping="Wrap" />

                    <!-- Steps List -->
                    <ItemsControl ItemsSource="{Binding MissingSteps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,3">
                                    <SelectableTextBlock Text="{Binding}" FontFamily="Consolas,Menlo,monospace" FontSize="11.5" Foreground="#7EE787" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 3. INTERPRETER / TOOLCHAIN CONFIGURATION CARD (For Toolchain Languages) -->
            <Border Background="{DynamicResource M3SurfaceContainerLowBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18,16"
                    IsVisible="{Binding IsToolchainLanguage}">
                <StackPanel Spacing="14">
                    <TextBlock Text="INTERPRETER CONFIGURATION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" LetterSpacing="0.8" />

                    <!-- Mode Toggle: Auto-Detect vs Custom -->
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <RadioButton GroupName="ToolchainMode"
                                     Content="Auto-detect (System, Virtualenv, Homebrew, PATH)"
                                     IsChecked="{Binding IsAutoDetect, Mode=TwoWay}"
                                     FontSize="12.5" />
                        <RadioButton GroupName="ToolchainMode"
                                     Content="Custom Executable Path"
                                     IsChecked="{Binding !IsAutoDetect, Mode=OneWay}"
                                     Click="OnCustomModeRadioClick"
                                     FontSize="12.5" />
                    </StackPanel>

                    <!-- Discovered Toolchains List (When Auto-Detect) -->
                    <StackPanel Spacing="8" IsVisible="{Binding IsAutoDetect}">
                        <TextBlock Text="Detected Runtimes on this Machine:" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                        <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ItemsControl ItemsSource="{Binding DiscoveredToolchains}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="toolchains:ToolchainInfo">
                                        <Border BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="0,0,0,1" Padding="12,9">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="CheckCircleOutline" Width="16" Height="16" Foreground="#4EBA6F" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                                    <SelectableTextBlock Text="{Binding ExecutablePath}" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" FontFamily="Consolas,Menlo,monospace" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="{DynamicResource M3SurfaceContainerHighBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Source}" FontSize="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <!-- Custom Path Input (When Custom Mode) -->
                    <StackPanel Spacing="8" IsVisible="{Binding !IsAutoDetect}">
                        <TextBlock Text="Executable / Binary Path:" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding CustomPath, Mode=TwoWay}"
                                     PlaceholderText="/path/to/executable"
                                     FontFamily="Consolas,Menlo,monospace" FontSize="12" />
                            <Button Grid.Column="1" Click="OnBrowseExecutableClick"
                                    Classes="cs-toolbar-outlined"
                                    Margin="8,0,0,0"
                                    ToolTip.Tip="Browse filesystem for executable">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" />
                                    <TextBlock Text="Browse…" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 4. ENVIRONMENT ACTIONS & SETUP CARD (e.g. Create Studio Environment) -->
            <Border Background="{DynamicResource M3SurfaceContainerLowBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18,16"
                    IsVisible="{Binding AvailableActions.Count}">
                <StackPanel Spacing="12">
                    <TextBlock Text="ENVIRONMENT ACTIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" LetterSpacing="0.8" />
                    <ItemsControl ItemsSource="{Binding AvailableActions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="toolchains:ToolchainAction">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                        <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Click="OnRunActionClick"
                                            Classes="snippet-action-btn"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <materialIcons:MaterialIcon Kind="LightningBoltOutline" Width="15" Height="15" />
                                            <TextBlock Text="Execute" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Real-Time Output Drawer -->
                    <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="12"
                            IsVisible="{Binding ActionOutputLog.Length}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding ActionStatusMessage}" FontSize="11.5" FontWeight="SemiBold" Foreground="#58A6FF" />
                            <SelectableTextBlock Text="{Binding ActionOutputLog}"
                                                 FontFamily="Consolas,Menlo,monospace"
                                                 FontSize="11" Foreground="#C9D1D9"
                                                 TextWrapping="Wrap" MaxHeight="140" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 5. ENVIRONMENT INTROSPECTION TABLE -->
            <Border Background="{DynamicResource M3SurfaceContainerLowBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18,16">
                <StackPanel Spacing="10">
                    <TextBlock Text="ENVIRONMENT INTROSPECTION &amp; RUNTIME PROPERTIES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" LetterSpacing="0.8" />
                    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <ItemsControl ItemsSource="{Binding EnvironmentDetails}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EnvironmentPropertyItem">
                                    <Border BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                                        <Grid ColumnDefinitions="180,*">
                                            <TextBlock Grid.Column="0" Text="{Binding Key}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                            <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11.5" FontFamily="Consolas,Menlo,monospace" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
