<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="42"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.BlindProblemsCategoryBarControl"
             x:DataType="vm:CSharpBlindProblemsViewModel">

    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
            BorderThickness="0,0,0,1"
            Padding="14,6">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:BlindCategorySummary">
                        <Button Command="{Binding $parent[UserControl].((vm:CSharpBlindProblemsViewModel)DataContext).SetCategoryCommand}"
                                CommandParameter="{Binding Name}"
                                Classes="snippet-action-btn"
                                Padding="10,4"
                                CornerRadius="14"
                                Background="{Binding IsSelected, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="{Binding IconKind}" Width="14" Height="14"
                                                            Foreground="{DynamicResource M3PrimaryBrush}" />
                                <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource M3SurfaceContainerHighBrush}" CornerRadius="8" Padding="5,1">
                                    <TextBlock Text="{Binding BadgeText}" FontSize="9.5"
                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</UserControl>
