<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="60"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.BlindProblemsTopBarControl"
             x:DataType="vm:CSharpBlindProblemsViewModel">

    <Border Background="{DynamicResource M3SurfaceContainerLowBrush}"
            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
            BorderThickness="0,0,0,1"
            Padding="14,8">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
            <!-- 1. Back to Hub -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{Binding BackToHubCommand}"
                        Classes="snippet-action-btn"
                        ToolTip.Tip="Return to Hub (Esc)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="ArrowLeft" Width="16" Height="16" />
                        <TextBlock Text="Hub" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Rectangle Width="1" Height="20" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="4,0" />
            </StackPanel>

            <!-- 2. Page Title & Badge -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="6,0,16,0">
                <Border Width="28" Height="28" CornerRadius="6" Background="#1A2F81F7" BorderBrush="#2F81F7" BorderThickness="1">
                    <materialIcons:MaterialIcon Kind="TrophyOutline" Width="16" Height="16" Foreground="#58A6FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Blind 75" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                <Border Background="{DynamicResource M3PrimaryContainerBrush}" BorderBrush="{DynamicResource M3PrimaryBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                    <TextBlock Text="C# .NET 10" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource M3OnPrimaryContainerBrush}" />
                </Border>
            </StackPanel>

            <!-- 3. Search Box ("Search questions") matching Screenshot -->
            <Border Grid.Column="2"
                    Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Height="34"
                    MaxWidth="400"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="8,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <materialIcons:MaterialIcon Grid.Column="0" Kind="Magnify" Width="16" Height="16"
                                                Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                Margin="10,0,6,0" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Text="{Binding SearchQuery, Mode=TwoWay}"
                             PlaceholderText="Search questions..."
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="12"
                             VerticalAlignment="Center" />
                    <Button Grid.Column="2"
                            Command="{Binding ClearSearchCommand}"
                            IsVisible="{Binding HasSearchQuery}"
                            Background="Transparent" BorderThickness="0"
                            Padding="8,0" Cursor="Hand">
                        <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- 4. Difficulty Quick Filter Pills -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0">
                <Button Command="{Binding SetDifficultyCommand}" CommandParameter="All"
                        Classes="snippet-action-btn" Padding="8,4">
                    <TextBlock Text="All Diff" FontSize="11" />
                </Button>
                <Button Command="{Binding SetDifficultyCommand}" CommandParameter="Easy"
                        Classes="snippet-action-btn" Padding="8,4">
                    <TextBlock Text="Easy" Foreground="#00B8A3" FontSize="11" FontWeight="SemiBold" />
                </Button>
                <Button Command="{Binding SetDifficultyCommand}" CommandParameter="Med"
                        Classes="snippet-action-btn" Padding="8,4">
                    <TextBlock Text="Med" Foreground="#FFC01E" FontSize="11" FontWeight="SemiBold" />
                </Button>
                <Button Command="{Binding SetDifficultyCommand}" CommandParameter="Hard"
                        Classes="snippet-action-btn" Padding="8,4">
                    <TextBlock Text="Hard" Foreground="#EF4444" FontSize="11" FontWeight="SemiBold" />
                </Button>
            </StackPanel>

            <!-- 5. Random "Pick One" (Shuffle) Button matching LeetCode -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Command="{Binding PickRandomUnsolvedProblemCommand}"
                        Classes="snippet-action-btn"
                        ToolTip.Tip="Pick a random unsolved problem (Shuffle)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="ShuffleVariant" Width="16" Height="16" Foreground="#E3B341" />
                        <TextBlock Text="Pick One" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
