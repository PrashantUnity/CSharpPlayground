<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="60"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.BlindProblemsTopBarControl"
             x:DataType="vm:CSharpBlindProblemsViewModel">

    <Border Background="{DynamicResource M3SurfaceContainerLowBrush}"
            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
            BorderThickness="0,0,0,1"
            Padding="14,8">
        <!-- The search box grows up to 420px and stays left; the spare column keeps the filters on the right. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MaxWidth="444" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- 1. Back to Hub -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{Binding BackToHubCommand}"
                        Classes="snippet-action-btn"
                        ToolTip.Tip="Return to Hub (Esc)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="ArrowLeft" Width="16" Height="16" />
                        <TextBlock Text="Hub" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Rectangle Width="1" Height="20" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="4,0" />
            </StackPanel>

            <!-- 2. Page Title & Badge -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="6,0,16,0">
                <Border Width="28" Height="28" CornerRadius="6" Background="#1A2F81F7" BorderBrush="#2F81F7" BorderThickness="1">
                    <materialIcons:MaterialIcon Kind="TrophyOutline" Width="16" Height="16" Foreground="#58A6FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Blind 75" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                <Border Background="{DynamicResource M3PrimaryContainerBrush}" BorderBrush="{DynamicResource M3PrimaryBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                    <TextBlock Text="C# .NET 10" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource M3OnPrimaryContainerBrush}" />
                </Border>
            </StackPanel>

            <!-- 3. Search: number, title, category or tag -->
            <Border Grid.Column="2"
                    Classes="search-box"
                    Height="32"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Margin="8,0,16,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <materialIcons:MaterialIcon Grid.Column="0" Kind="Magnify" Width="16" Height="16"
                                                Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                Margin="10,0,4,0" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Text="{Binding SearchQuery, Mode=TwoWay}"
                             PlaceholderText="Search by number, title or topic"
                             FontSize="12"
                             MinHeight="0"
                             Padding="4,0"
                             VerticalAlignment="Stretch"
                             VerticalContentAlignment="Center" />
                    <Button Grid.Column="2"
                            Classes="row-action"
                            Width="24" Height="24" Margin="0,0,4,0"
                            Command="{Binding ClearSearchCommand}"
                            IsVisible="{Binding HasSearchQuery}"
                            ToolTip.Tip="Clear search">
                        <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- 4. Difficulty filter -->
            <Border Grid.Column="4" Classes="segmented" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="segment" Classes.selected="{Binding IsDifficultyAll}"
                            Command="{Binding SetDifficultyCommand}" CommandParameter="All"
                            ToolTip.Tip="Every difficulty">
                        <TextBlock Text="All" />
                    </Button>
                    <Button Classes="segment" Classes.selected="{Binding IsDifficultyEasy}"
                            Command="{Binding SetDifficultyCommand}" CommandParameter="Easy">
                        <TextBlock Text="Easy" Foreground="#00B8A3" />
                    </Button>
                    <Button Classes="segment" Classes.selected="{Binding IsDifficultyMedium}"
                            Command="{Binding SetDifficultyCommand}" CommandParameter="Med"
                            ToolTip.Tip="Medium">
                        <TextBlock Text="Med" Foreground="#FFC01E" />
                    </Button>
                    <Button Classes="segment" Classes.selected="{Binding IsDifficultyHard}"
                            Command="{Binding SetDifficultyCommand}" CommandParameter="Hard">
                        <TextBlock Text="Hard" Foreground="#EF4444" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- 5. Random "Pick One" (Shuffle) Button matching LeetCode -->
            <Button Grid.Column="5" Command="{Binding PickRandomUnsolvedProblemCommand}"
                    Classes="snippet-action-btn" VerticalAlignment="Center"
                    ToolTip.Tip="Open a random unsolved problem">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="ShuffleVariant" Width="16" Height="16" Foreground="#E3B341" />
                    <TextBlock Text="Pick One" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
