<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:views="using:PdfEditorApp.Plugins.CSharpEditor.Views"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             xmlns:output="using:PdfEditorApp.Plugins.CSharpEditor.Visuals.Output"
             xmlns:notebooks="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.Notebooks"
             xmlns:common="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Common"
             xmlns:visuals="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Visuals"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="200"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.Notebooks.NotebookCellOutputControl"
             x:DataType="notebooks:NotebookCellViewModel">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CSharpEditorPlugin/Views/CSharpManagerPaletteTokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://CSharpEditorPlugin/Views/CSharpManagerStyles.axaml" />
        <StyleInclude Source="avares://CSharpEditorPlugin/Controls/SharedStudioStyles.axaml" />
    </UserControl.Styles>

    <StackPanel Spacing="4">
        <!-- Collapsed Output Banner -->
        <Border Classes="notebook-collapsed-output-banner"
                IsVisible="{Binding IsOutputCollapsedBarVisible}">
            <Button Command="{Binding ToggleOutputCollapseCommand}"
                    Classes="collapsed-banner-btn"
                    ToolTip.Tip="Click to expand cell output"
                    HorizontalAlignment="Stretch">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <materialIcons:MaterialIcon Grid.Column="0"
                                                Kind="ChevronRight"
                                                Width="14" Height="14"
                                                Foreground="{DynamicResource DsPrimaryBrush}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0" />

                    <materialIcons:MaterialIcon Grid.Column="1"
                                                Kind="Console"
                                                Width="14" Height="14"
                                                Foreground="{DynamicResource DsMutedBrush}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding OutputCollapsedSummaryText}"
                               FontSize="11.5"
                               Foreground="{DynamicResource DsTextWhiteBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />

                    <Border Grid.Column="3"
                            Background="{DynamicResource DsSurfaceHighBrush}"
                            BorderBrush="{DynamicResource DsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,2"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ArrowExpandVertical" Width="12" Height="12" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Expand Output" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Button>
        </Border>

        <!-- Active Output Stream Container (Visible when IsOutputVisible) -->
        <StackPanel Spacing="4" IsVisible="{Binding IsOutputVisible}">
            <!-- Output Control & Tab Bar -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,1,0,2">
                <!-- Left: Tabs when multiple outputs exist, or single output status when 1 exists -->
                <Panel Grid.Column="0" VerticalAlignment="Center">
                    <!-- Single Output Kind Header (e.g. only Console or only Table) -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                IsVisible="{Binding !HasMultipleOutputKinds}">
                        <materialIcons:MaterialIcon Kind="{Binding SingleOutputIconKind}" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SingleOutputTitle}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Multiple Output Kinds: Sleek Segmented Tab Strip -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  BringIntoViewOnFocusChange="False"
                                  ScrollViewer.BringIntoViewOnFocusChange="False"
                                  IsVisible="{Binding HasMultipleOutputKinds}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <!-- Tab: Table (.Dump) -->
                            <Button Command="{Binding SetOutputTabCommand}" CommandParameter="Table"
                                    Classes="cell-output-tab-btn"
                                    Classes.active="{Binding IsTableTabSelected}"
                                    IsVisible="{Binding HasTableOutput}"
                                    ToolTip.Tip="Switch to Visual Table Output">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <materialIcons:MaterialIcon Kind="Table" Width="12" Height="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Table" VerticalAlignment="Center" />
                                    <Border Classes="cell-output-tab-badge" IsVisible="{Binding TableRowCountText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding TableRowCountText}" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <!-- Tab: Console / Raw Text -->
                            <Button Command="{Binding SetOutputTabCommand}" CommandParameter="Console"
                                    Classes="cell-output-tab-btn"
                                    Classes.active="{Binding IsConsoleTabSelected}"
                                    IsVisible="{Binding HasTextOutput}"
                                    ToolTip.Tip="Switch to Console / Text Output">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <materialIcons:MaterialIcon Kind="Console" Width="12" Height="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Console" VerticalAlignment="Center" />
                                    <Border Classes="cell-output-tab-badge" IsVisible="{Binding ConsoleLineCountText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding ConsoleLineCountText}" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <!-- Tab: Object Inspector -->
                            <Button Command="{Binding SetOutputTabCommand}" CommandParameter="Inspector"
                                    Classes="cell-output-tab-btn"
                                    Classes.active="{Binding IsInspectorTabSelected}"
                                    IsVisible="{Binding HasInspectorOutput}"
                                    ToolTip.Tip="Switch to Object Inspector Tree">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <materialIcons:MaterialIcon Kind="CodeJson" Width="12" Height="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Inspector" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Tab: Image / Graphic -->
                            <Button Command="{Binding SetOutputTabCommand}" CommandParameter="Image"
                                    Classes="cell-output-tab-btn"
                                    Classes.active="{Binding IsImageTabSelected}"
                                    IsVisible="{Binding HasImageOutput}"
                                    ToolTip.Tip="Switch to Graphic / Image Output">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <materialIcons:MaterialIcon Kind="ImageOutline" Width="12" Height="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Image" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Tab: Interactive UI Widget -->
                            <Button Command="{Binding SetOutputTabCommand}" CommandParameter="Widget"
                                    Classes="cell-output-tab-btn"
                                    Classes.active="{Binding IsWidgetTabSelected}"
                                    IsVisible="{Binding HasInteractiveControl}"
                                    ToolTip.Tip="Switch to Interactive UI Widget">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <materialIcons:MaterialIcon Kind="ApplicationOutline" Width="12" Height="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Widget" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Tab: Interactive Chart -->
                            <Button Command="{Binding SetOutputTabCommand}" CommandParameter="Chart"
                                    Classes="cell-output-tab-btn"
                                    Classes.active="{Binding IsChartTabSelected}"
                                    IsVisible="{Binding HasChartOutput}"
                                    ToolTip.Tip="Switch to Interactive Chart Output">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <materialIcons:MaterialIcon Kind="ChartLine" Width="12" Height="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Chart" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Tab: Interactive Visualizer -->
                            <Button Command="{Binding SetOutputTabCommand}" CommandParameter="Visualizer"
                                    Classes="cell-output-tab-btn"
                                    Classes.active="{Binding IsVisualizerTabSelected}"
                                    IsVisible="{Binding HasVisualizerOutput}"
                                    ToolTip.Tip="Switch to Algorithmic Data Structure Visualizer">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <materialIcons:MaterialIcon Kind="Grid" Width="12" Height="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Visualizer" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Tab: Interactive 3D Plot -->
                            <Button Command="{Binding SetOutputTabCommand}" CommandParameter="Plot3D"
                                    Classes="cell-output-tab-btn"
                                    Classes.active="{Binding IsPlot3DTabSelected}"
                                    IsVisible="{Binding HasPlot3DOutput}"
                                    ToolTip.Tip="Switch to Interactive 3D Visualization">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <materialIcons:MaterialIcon Kind="CubeOutline" Width="12" Height="12" VerticalAlignment="Center" />
                                    <TextBlock Text="3D Plot" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Tab: HTML Content -->
                            <Button Command="{Binding SetOutputTabCommand}" CommandParameter="Html"
                                    Classes="cell-output-tab-btn"
                                    Classes.active="{Binding IsHtmlTabSelected}"
                                    IsVisible="{Binding HasHtmlContent}"
                                    ToolTip.Tip="Switch to HTML / Markdown Output">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <materialIcons:MaterialIcon Kind="LanguageHtml5" Width="12" Height="12" VerticalAlignment="Center" />
                                    <TextBlock Text="HTML" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Tab: All Outputs (Stacked) -->
                            <Button Command="{Binding SetOutputTabCommand}" CommandParameter="All"
                                    Classes="cell-output-tab-btn"
                                    Classes.active="{Binding IsAllTabSelected}"
                                    ToolTip.Tip="Show all available outputs stacked simultaneously">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <materialIcons:MaterialIcon Kind="ViewAgendaOutline" Width="12" Height="12" VerticalAlignment="Center" />
                                    <TextBlock Text="All" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Panel>

                <!-- Right: Output Toolbar Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Command="{Binding CopyOutputCommand}"
                            Classes="cell-tool-btn"
                            Width="20" Height="20"
                            IsVisible="{Binding HasTextOutput}"
                            ToolTip.Tip="Copy Console Text">
                        <materialIcons:MaterialIcon Kind="ContentCopy" Width="12" Height="12" Foreground="{DynamicResource DsMutedBrush}" />
                    </Button>
                    <Button Command="{Binding ToggleOutputScrolledCommand}"
                            Classes="cell-tool-btn"
                            Width="20" Height="20"
                            ToolTip.Tip="{Binding OutputScrolledTooltip}">
                        <Panel Width="12" Height="12">
                            <materialIcons:MaterialIcon Kind="FormatLineSpacing" IsVisible="{Binding IsOutputScrolled}" Width="12" Height="12" Foreground="{DynamicResource DsPrimaryBrush}" />
                            <materialIcons:MaterialIcon Kind="UnfoldMoreHorizontal" IsVisible="{Binding !IsOutputScrolled}" Width="12" Height="12" Foreground="{DynamicResource DsMutedBrush}" />
                        </Panel>
                    </Button>
                    <Button Command="{Binding ToggleOutputCollapseCommand}"
                            Classes="cell-tool-btn"
                            Width="20" Height="20"
                            ToolTip.Tip="Collapse Output">
                        <materialIcons:MaterialIcon Kind="ChevronUp" Width="12" Height="12" Foreground="{DynamicResource DsMutedBrush}" />
                    </Button>
                    <Button Command="{Binding ClearOutputCommand}"
                            Classes="cell-tool-btn"
                            Width="20" Height="20"
                            ToolTip.Tip="Clear Output">
                        <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="{DynamicResource DsMutedBrush}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Output Elements -->
            <ScrollViewer Classes="notebook-output-scroll"
                          Classes.scrolled="{Binding IsOutputScrolled}"
                          BringIntoViewOnFocusChange="False"
                          ScrollViewer.BringIntoViewOnFocusChange="False">
                <StackPanel Spacing="6">
                    <!-- Missing Variable Smart Hint (CS0103) -->
                    <Border IsVisible="{Binding HasMissingVariableError}"
                            Background="{DynamicResource DsSurfaceHighBrush}"
                            BorderBrush="#D29922"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,0,2">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <materialIcons:MaterialIcon Grid.Column="0" Kind="LightbulbAlertOutline" Width="16" Height="16" Foreground="#E3B341" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding MissingVariableHintTitle}" FontSize="11" FontWeight="SemiBold" Foreground="#E3B341" />
                                <TextBlock Text="This variable may be defined in an earlier cell. Run previous cells to initialize it in this session."
                                           FontSize="10.5" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Command="{Binding RunCellAndAboveCommand}"
                                    Classes="cell-output-tab-btn active"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Execute all cells from the top down to this cell">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <materialIcons:MaterialIcon Kind="FastForward" Width="12" Height="12" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Run All Above" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Missing package hint (Python's ModuleNotFoundError): install it, then the cell runs again -->
                    <Border IsVisible="{Binding HasMissingDependency}"
                            Background="{DynamicResource DsSurfaceHighBrush}"
                            BorderBrush="#D29922"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,0,2">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <materialIcons:MaterialIcon Grid.Column="0" Kind="PackageVariantClosed" Width="16" Height="16" Foreground="#E3B341" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding MissingDependencyHintTitle}" FontSize="11" FontWeight="SemiBold" Foreground="#E3B341" />
                                <TextBlock Text="{Binding MissingDependencyHintDetail}"
                                           FontSize="10.5" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Command="{Binding InstallMissingDependencyCommand}"
                                    Classes="cell-output-tab-btn active"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Install the package, then run this cell again">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <materialIcons:MaterialIcon Kind="Download" Width="12" Height="12" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding InstallMissingDependencyLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 1. Interactive Object Inspector Tree -->
                    <Border IsVisible="{Binding IsInspectorTabActive}" Margin="0,1,0,3">
                        <common:LazyContent IsActive="{Binding IsInspectorTabActive}">
                            <common:LazyContent.ContentTemplate>
                                <DataTemplate x:DataType="notebooks:NotebookCellViewModel">
                                    <views:ObjectInspectorView DataContext="{Binding InspectorNode}" />
                                </DataTemplate>
                            </common:LazyContent.ContentTemplate>
                        </common:LazyContent>
                    </Border>

                    <!-- 2. Dark Terminal Card for Console Stdout Output -->
                    <Border Background="{DynamicResource DsBgBrush}"
                            BorderBrush="{DynamicResource DsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            IsVisible="{Binding IsConsoleTabActive}">
                        <SelectableTextBlock Text="{Binding OutputText, Mode=OneWay}"
                                 FontFamily="Consolas, Menlo, Monaco, Cascadia Code, monospace"
                                 FontSize="{Binding ((notebooks:CSharpNotebookStudioViewModel)DataContext).EditorFontSize, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=12.0}"
                                 Foreground="{DynamicResource DsTextWhiteBrush}"
                                 TextWrapping="Wrap" />
                    </Border>

                    <!-- 3. Tabular Output (.Dump()) -->
                    <Border IsVisible="{Binding IsTableTabActive}">
                        <common:LazyContent IsActive="{Binding IsTableTabActive}">
                            <common:LazyContent.ContentTemplate>
                                <DataTemplate x:DataType="notebooks:NotebookCellViewModel">
                                    <views:DumpTableView DataContext="{Binding TableResult}" />
                                </DataTemplate>
                            </common:LazyContent.ContentTemplate>
                        </common:LazyContent>
                    </Border>

                    <!-- 3b-3d. Charts, visualizers and 3D plots: every one the cell showed, in order, each drawn from its spec -->
                    <Border IsVisible="{Binding IsChartTabActive}"
                            Background="{DynamicResource DsSurfaceBrush}"
                            BorderBrush="{DynamicResource DsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8">
                        <common:LazyContent IsActive="{Binding IsChartTabActive}">
                            <common:LazyContent.ContentTemplate>
                                <DataTemplate x:DataType="notebooks:NotebookCellViewModel">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{Binding VisualsNotice}" IsVisible="{Binding VisualsNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" FontSize="11" Foreground="{DynamicResource DsMutedBrush}" />
                                        <ItemsControl ItemsSource="{Binding ChartVisuals}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="output:VisualOutput">
                                                    <visuals:VisualOutputView Output="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </common:LazyContent.ContentTemplate>
                        </common:LazyContent>
                    </Border>

                    <Border IsVisible="{Binding IsVisualizerTabActive}"
                            Background="{DynamicResource DsSurfaceBrush}"
                            BorderBrush="{DynamicResource DsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8">
                        <common:LazyContent IsActive="{Binding IsVisualizerTabActive}">
                            <common:LazyContent.ContentTemplate>
                                <DataTemplate x:DataType="notebooks:NotebookCellViewModel">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{Binding VisualsNotice}" IsVisible="{Binding VisualsNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" FontSize="11" Foreground="{DynamicResource DsMutedBrush}" />
                                        <ItemsControl ItemsSource="{Binding VisualizerVisuals}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="output:VisualOutput">
                                                    <visuals:VisualOutputView Output="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </common:LazyContent.ContentTemplate>
                        </common:LazyContent>
                    </Border>

                    <Border IsVisible="{Binding IsPlot3DTabActive}"
                            Background="{DynamicResource DsSurfaceBrush}"
                            BorderBrush="{DynamicResource DsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8">
                        <common:LazyContent IsActive="{Binding IsPlot3DTabActive}">
                            <common:LazyContent.ContentTemplate>
                                <DataTemplate x:DataType="notebooks:NotebookCellViewModel">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{Binding VisualsNotice}" IsVisible="{Binding VisualsNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" FontSize="11" Foreground="{DynamicResource DsMutedBrush}" />
                                        <ItemsControl ItemsSource="{Binding Plot3DVisuals}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="output:VisualOutput">
                                                    <visuals:VisualOutputView Output="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </common:LazyContent.ContentTemplate>
                        </common:LazyContent>
                    </Border>

                    <!-- 4. Rendered Graphic / Image Output -->
                    <Border IsVisible="{Binding IsImageTabActive}"
                            Background="{DynamicResource DsSurfaceBrush}"
                            BorderBrush="{DynamicResource DsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10">
                        <Grid RowDefinitions="Auto,*">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="ImageOutline" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}" />
                                    <TextBlock Text="Rendered Graphic" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                </StackPanel>
                                <Border Grid.Column="1" HorizontalAlignment="Left" Margin="8,0,0,0"
                                        Background="{DynamicResource DsSurfaceHighBrush}"
                                        BorderBrush="{DynamicResource DsBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4" Padding="6,1">
                                    <TextBlock Text="{Binding ImageDimensionsText}" FontSize="10" Foreground="{DynamicResource DsPrimaryBrush}" />
                                </Border>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Command="{Binding CopyImageCommand}" Classes="cell-tool-btn" Width="24" Height="24" ToolTip.Tip="Copy Image">
                                        <materialIcons:MaterialIcon Kind="ContentCopy" Width="12" Height="12" />
                                    </Button>
                                    <Button Command="{Binding SaveImageCommand}" Classes="cell-tool-btn" Width="24" Height="24" ToolTip.Tip="Save PNG">
                                        <materialIcons:MaterialIcon Kind="DownloadOutline" Width="12" Height="12" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1"
                                    Background="{DynamicResource DsBgBrush}"
                                    BorderBrush="{DynamicResource DsBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8"
                                    HorizontalAlignment="Stretch">
                                <Image Source="{Binding ImageOutputBitmap}"
                                       MaxHeight="450"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 5. Interactive Avalonia UI Control -->
                    <Border IsVisible="{Binding IsWidgetTabActive}"
                            Background="{DynamicResource DsSurfaceBrush}"
                            BorderBrush="{DynamicResource DsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8">
                        <Grid RowDefinitions="Auto,*">
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="ApplicationOutline" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}" />
                                <TextBlock Text="Interactive UI Widget" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DsTextWhiteBrush}" />
                            </StackPanel>
                            <ContentControl Grid.Row="1" Content="{Binding InteractiveControl}" HorizontalAlignment="Stretch" />
                        </Grid>
                    </Border>

                    <!-- 5b. Interactive Control Placeholder -->
                    <Border IsVisible="{Binding InteractiveControlPlaceholderVisible}"
                            Background="{DynamicResource DsSurfaceBrush}"
                            BorderBrush="{DynamicResource DsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,10">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ReloadAlert" Width="16" Height="16" Foreground="{DynamicResource DsMutedBrush}" />
                            <TextBlock Text="Interactive widget / animation not restored — re-run this cell to bring it back."
                                       FontSize="11.5"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource DsMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- 6. HTML / Markdown Rich Output -->
                    <Border IsVisible="{Binding IsHtmlTabActive}"
                            Background="{DynamicResource DsSurfaceBrush}"
                            BorderBrush="{DynamicResource DsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8">
                        <Grid RowDefinitions="Auto,*">
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="LanguageHtml5" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}" />
                                <TextBlock Text="HTML / Markdown Output" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DsTextWhiteBrush}" />
                            </StackPanel>
                            <common:LazyContent Grid.Row="1" IsActive="{Binding IsHtmlTabActive}">
                                <common:LazyContent.ContentTemplate>
                                    <DataTemplate x:DataType="notebooks:NotebookCellViewModel">
                                        <views:RichHtmlView DataContext="{Binding HtmlContent}" />
                                    </DataTemplate>
                                </common:LazyContent.ContentTemplate>
                            </common:LazyContent>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </StackPanel>
</UserControl>
