<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.DocsOutlinePanelControl"
             x:DataType="vm:CSharpDocsViewModel"
             Width="260" Margin="32,0,0,0" VerticalAlignment="Top">

    <StackPanel Spacing="16">
        <!-- On This Page Navigation Card -->
        <Border Background="{DynamicResource DsSurfaceBrush}"
                BorderBrush="{DynamicResource DsBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <materialIcons:MaterialIcon Kind="FormatListBulleted" Width="15" Height="15" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="ON THIS PAGE" FontSize="10" FontWeight="Bold" LetterSpacing="1.2" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Rectangle Height="1" Fill="{DynamicResource DsBorderBrush}" />
                <ItemsControl ItemsSource="{Binding SelectedArticle.Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:DocSection">
                            <Border Classes="doc-article-item" Padding="6,4" Margin="0,1">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Grid.Column="0" Width="4" Height="4" CornerRadius="2"
                                            Background="{DynamicResource DsPrimaryBrush}"
                                            VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Heading}" FontSize="11.5"
                                               Foreground="{DynamicResource DsTextBrush}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Heading}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Quick Studio Jump Card -->
        <Border Background="{DynamicResource DsSurfaceBrush}"
                BorderBrush="{DynamicResource DsBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14">
            <StackPanel Spacing="10">
                <TextBlock Text="QUICK ACTIONS" FontSize="10" FontWeight="Bold" LetterSpacing="1.2" Foreground="{DynamicResource DsMutedBrush}" />
                <Rectangle Height="1" Fill="{DynamicResource DsBorderBrush}" />

                <Button Command="{Binding OpenCodeStudioCommand}" Classes="nexus-nav-item" Padding="8,6">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="{DynamicResource NavScriptsBgBrush}">
                            <materialIcons:MaterialIcon Kind="CodeBraces" Width="14" Height="14" Foreground="{DynamicResource NavScriptsFgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="Open Script Studio" FontSize="12" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <Button Command="{Binding OpenNotebookStudioCommand}" Classes="nexus-nav-item" Padding="8,6">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="{DynamicResource NavNotebooksBgBrush}">
                            <materialIcons:MaterialIcon Kind="NotebookOutline" Width="14" Height="14" Foreground="{DynamicResource NavNotebooksFgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="Open Notebook" FontSize="12" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
