<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:docs="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.Docs"
             mc:Ignorable="d"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.Docs.DocsNavRailControl"
             x:DataType="docs:CSharpDocsViewModel">

    <Border Background="{DynamicResource DsSurfaceBrush}"
            BorderBrush="{DynamicResource DsBorderBrush}"
            BorderThickness="0,0,1,0">
        <Grid RowDefinitions="*,Auto">
            <!-- Scrollable Categories Rail -->
            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="4" Margin="10,12,10,16">

                    <!-- Search Results View (shown when search box has text) -->
                    <StackPanel IsVisible="{Binding HasSearchQuery}" Spacing="4">
                        <TextBlock Text="{Binding FilteredArticles.Count, StringFormat='SEARCH RESULTS ({0})'}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   LetterSpacing="1.2"
                                   Foreground="{DynamicResource DsMutedBrush}"
                                   Margin="10,4,10,8" />

                        <ItemsControl ItemsSource="{Binding FilteredArticles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DocArticle">
                                    <Button Command="{Binding $parent[UserControl].((docs:CSharpDocsViewModel)DataContext).SelectArticleCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="doc-article-item"
                                            Classes.active="{Binding IsSelected}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6"
                                                    Background="{DynamicResource DsPrimarySubtleBrush}"
                                                    Margin="0,0,8,0" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="14" Height="14"
                                                                            Foreground="{DynamicResource DsPrimaryBrush}"
                                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Medium"
                                                           Foreground="{DynamicResource DsTextWhiteBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10.5"
                                                           Foreground="{DynamicResource DsMutedBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding ReadingTime}" FontSize="10"
                                                       Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" Margin="6,0,2,0" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border IsVisible="{Binding !FilteredArticles.Count}"
                                Background="{DynamicResource DsSurfaceHighBrush}"
                                BorderBrush="{DynamicResource DsBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16" Margin="4,8">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="FileSearchOutline" Width="26" Height="26"
                                                            Foreground="{DynamicResource DsMutedBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="No matching topics" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DsTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Try a different search query" FontSize="10.5"
                                           Foreground="{DynamicResource DsMutedBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Standard Documentation Tree (shown when not searching) -->
                    <StackPanel IsVisible="{Binding !HasSearchQuery}" Spacing="2">
                        <!-- Section Label: DOCUMENTATION TOPICS (Matches MENU in Manager Sidebar) -->
                        <TextBlock Text="DOCUMENTATION TOPICS"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   LetterSpacing="1.2"
                                   Foreground="{DynamicResource DsMutedBrush}"
                                   Margin="10,4,10,8" />

                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DocCategory">
                                    <StackPanel Spacing="2" Margin="0,0,0,3">
                                        <!-- Category Item Button (Matches Manager nav-item) -->
                                        <Button Command="{Binding $parent[UserControl].((docs:CSharpDocsViewModel)DataContext).ToggleCategoryCommand}"
                                                CommandParameter="{Binding}"
                                                Classes="doc-category-btn"
                                                Classes.selected="{Binding IsSelected}"
                                                ToolTip.Tip="{Binding Description}">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <!-- Icon Box: 28x28, CornerRadius 7, translucent colored bg, vibrant icon -->
                                                <Border Grid.Column="0" Classes="nav-icon-box"
                                                        Width="28" Height="28" CornerRadius="7"
                                                        Background="{Binding AccentBgColor}">
                                                    <materialIcons:MaterialIcon Kind="{Binding IconKind}" Width="16" Height="16"
                                                                                Foreground="{Binding AccentColor}"
                                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Title -->
                                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                           Margin="8,0,4,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource DsTextWhiteBrush}"
                                                           TextTrimming="CharacterEllipsis" />

                                                <!-- Badge Pill: Matches nexus-badge-pill in Manager Sidebar -->
                                                <Border Grid.Column="2" Classes="nexus-badge-pill"
                                                        Background="{Binding AccentBgColor}"
                                                        BorderBrush="{Binding AccentColor}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding Badge}" Foreground="{Binding AccentColor}" />
                                                </Border>

                                                <!-- Chevron Indicator -->
                                                <Panel Grid.Column="3" Margin="6,0,2,0" VerticalAlignment="Center">
                                                    <materialIcons:MaterialIcon Kind="ChevronDown" Width="14" Height="14"
                                                                                IsVisible="{Binding IsExpanded}"
                                                                                Foreground="{DynamicResource DsMutedBrush}" />
                                                    <materialIcons:MaterialIcon Kind="ChevronRight" Width="14" Height="14"
                                                                                IsVisible="{Binding !IsExpanded}"
                                                                                Foreground="{DynamicResource DsMutedBrush}" />
                                                </Panel>
                                            </Grid>
                                        </Button>

                                        <!-- Collapsible Articles under Category with elegant tree guideline -->
                                        <Border IsVisible="{Binding IsExpanded}"
                                                BorderBrush="{DynamicResource DsBorderBrush}"
                                                BorderThickness="1,0,0,0"
                                                Margin="22,2,0,6"
                                                Padding="4,2,0,2">
                                            <ItemsControl ItemsSource="{Binding Articles}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:DocArticle">
                                                        <Button Command="{Binding $parent[UserControl].((docs:CSharpDocsViewModel)DataContext).SelectArticleCommand}"
                                                                CommandParameter="{Binding}"
                                                                Classes="doc-article-item"
                                                                Classes.active="{Binding IsSelected}">
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="FileDocumentOutline" Width="14" Height="14"
                                                                                            Foreground="{DynamicResource DsMutedBrush}"
                                                                                            Margin="2,0,8,0" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                <!-- Active indicator pill on right -->
                                                                <Border Grid.Column="2" Width="6" Height="6" CornerRadius="3"
                                                                        Background="{DynamicResource DsPrimaryBrush}"
                                                                        IsVisible="{Binding IsSelected}"
                                                                        VerticalAlignment="Center" Margin="6,0,4,0" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Actions Footer (Matches Hub Sidebar Footer) -->
            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource DsBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="12,12">
                <StackPanel Spacing="8">
                    <!-- Back to Hub Button -->
                    <Button Command="{Binding BackToHubCommand}"
                            Classes="nexus-nav-item"
                            ToolTip.Tip="Return to FrySharp Hub (Esc)">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="nav-icon-box" Width="28" Height="28" CornerRadius="7" Background="{DynamicResource NavFrySharpBgBrush}">
                                <materialIcons:MaterialIcon Kind="ArrowLeft" Width="16" Height="16" Foreground="{DynamicResource NavFrySharpFgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Return to Hub" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Info Card -->
                    <Border Background="{DynamicResource DsSurfaceHighBrush}"
                            BorderBrush="{DynamicResource DsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6" Background="{DynamicResource NavDocsBgBrush}">
                                <materialIcons:MaterialIcon Kind="BookOpenVariantOutline" Width="14" Height="14" Foreground="{DynamicResource NavDocsFgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Interactive Docs" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                <TextBlock Text=".NET 10 • Roslyn" FontSize="10" Foreground="{DynamicResource DsMutedBrush}" />
                            </StackPanel>
                            <Border Grid.Column="2" Width="7" Height="7" CornerRadius="3.5"
                                    Background="{DynamicResource DsGreenBrush}" VerticalAlignment="Center"
                                    ToolTip.Tip="Documentation runtime ready" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
