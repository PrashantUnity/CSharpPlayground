<UserControl xmlns:lt="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Extensibility.Theming.Layout;assembly=CSharpEditorPlugin" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.Editor.QuickInfoTipControl"
             Foreground="{DynamicResource M3OnSurfaceBrush}">

    <!-- The hover card for a symbol: signature, where it's declared, then its documentation. Filled in code (SetQuickInfo). -->
    <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
            lt:Tokens.BorderThickness="DsBorderThin"
            lt:Tokens.CornerRadius="DsRadiusLG"
            lt:Tokens.BoxShadow="DsModalShadow"
            MaxWidth="640"
            MaxHeight="440"
            ClipToBounds="True">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,9,12,10">
                <SelectableTextBlock Name="SignatureText"
                                     lt:Tokens.FontFamily="DsCodeFontFamily"
                                     lt:Tokens.FontSize="DsFontSize350"
                                     LineHeight="18"
                                     TextWrapping="Wrap" />

                <!-- "in class System.Console", then one "T is int" line per type argument -->
                <SelectableTextBlock Name="DetailsText"
                                     Margin="0,2,0,0"
                                     lt:Tokens.FontFamily="DsCodeFontFamily"
                                     lt:Tokens.FontSize="DsFontSize300"
                                     LineHeight="17"
                                     TextWrapping="Wrap"
                                     IsVisible="False" />

                <Border Name="DocumentationSeparator"
                        Height="1"
                        Margin="-12,9,-12,0"
                        Background="{DynamicResource M3OutlineVariantBrush}"
                        IsVisible="False" />

                <StackPanel Name="DocumentationPanel" Margin="0,9,0,0" Spacing="7" IsVisible="False" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
