<UserControl xmlns:lt="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Extensibility.Theming.Layout;assembly=CSharpEditorPlugin" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.Visuals.VisualChromeControl">


    <Border Background="{DynamicResource M3SurfaceContainerLowBrush}"
            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
            lt:Tokens.BorderThickness="DsBorderThin"
            lt:Tokens.CornerRadius="DsRadiusMD"
            Padding="12,10">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
            <!-- Header Toolbar -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8" VerticalAlignment="Center">
                <!-- Left: Title, Icon, Subtitle, Notice -->
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon x:Name="HeaderIcon" Kind="ChartLine" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="TitleText" Text="Visual" lt:Tokens.FontSize="DsFontSize250" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />

                        <!-- Stats Pill -->
                        <Border x:Name="StatsPillBorder"
                                Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                lt:Tokens.BorderThickness="DsBorderThin"
                                lt:Tokens.CornerRadius="DsRadiusXS"
                                Padding="6,2"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="StatsSummaryText" Text="N: 0" lt:Tokens.FontSize="DsFontSize100" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="SubtitleText" IsVisible="False" lt:Tokens.FontSize="DsFontSize150" TextWrapping="Wrap" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                    <TextBlock x:Name="NoticeText" IsVisible="False" lt:Tokens.FontSize="DsFontSize100" TextWrapping="Wrap" Foreground="{DynamicResource M3PrimaryBrush}" FontStyle="Italic" />
                </StackPanel>

                <!-- Right: Kind-Specific & Shared Toolbars -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <!-- Kind-Specific Tools Slot -->
                    <ContentControl x:Name="KindToolsHost" VerticalAlignment="Center" />

                    <!-- Shared Actions Toolbar -->
                    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            lt:Tokens.BorderThickness="DsBorderThin"
                            lt:Tokens.CornerRadius="DsRadiusSM"
                            Padding="2">
                        <StackPanel Orientation="Horizontal" Spacing="1">
                            <!-- Reset / Fit -->
                            <Button x:Name="ResetFitBtn" Classes="chrome-tool-btn" ToolTip.Tip="Reset / Fit View">
                                <materialIcons:MaterialIcon Kind="HomeOutline" Width="12" Height="12" />
                            </Button>

                            <!-- Copy Spec (MIME bundle) -->
                            <Button x:Name="CopySpecBtn" Classes="chrome-tool-btn" ToolTip.Tip="Copy Spec (MIME bundle for Display.show)">
                                <materialIcons:MaterialIcon Kind="CodeJson" Width="13" Height="13" />
                            </Button>

                            <!-- Copy Data (CSV) -->
                            <Button x:Name="CopyDataBtn" Classes="chrome-tool-btn" ToolTip.Tip="Copy Data as CSV">
                                <materialIcons:MaterialIcon Kind="ContentCopy" Width="12" Height="12" />
                            </Button>

                            <!-- Save PNG -->
                            <Button x:Name="SavePngBtn" Classes="chrome-tool-btn" ToolTip.Tip="Save as PNG image">
                                <materialIcons:MaterialIcon Kind="ImageOutline" Width="12" Height="12" />
                            </Button>

                            <!-- Fullscreen -->
                            <Button x:Name="FullscreenBtn" Classes="chrome-tool-btn" ToolTip.Tip="Fullscreen / Pop-Out">
                                <materialIcons:MaterialIcon x:Name="FullscreenIcon" Kind="Fullscreen" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Canvas Host Slot -->
            <Border Grid.Row="1"
                    x:Name="CanvasContainerBorder"
                    Background="{DynamicResource VisCanvasBgBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    lt:Tokens.BorderThickness="DsBorderThin"
                    lt:Tokens.CornerRadius="DsRadiusSM"
                    Padding="4"
                    ClipToBounds="True"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <ContentControl x:Name="CanvasHost"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
            </Border>

            <!-- Resize Grip (drag to resize canvas, double-click to reset) -->
            <Border Grid.Row="2"
                    x:Name="ResizeGrip"
                    Classes="canvas-resize-grip"
                    Focusable="True"
                    Height="10"
                    Margin="0,2,0,2"
                    ToolTip.Tip="Drag to resize • double-click to reset">
                <Border Width="36" Height="3" CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Footer Slot -->
            <ContentControl Grid.Row="3" x:Name="FooterHost" Margin="0,4,0,0" IsVisible="False" />
        </Grid>
    </Border>
</UserControl>
