<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.Visuals.CollectionViewControl">

    <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
            BorderThickness="1"
            CornerRadius="8"
            BoxShadow="0 12 40 0 #A0000000"
            MinWidth="480"
            MaxWidth="680"
            MinHeight="300"
            MaxHeight="480"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <!-- 1. Window Header Bar -->
            <Border Grid.Row="0" Background="{DynamicResource M3SurfaceContainerHighestBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="0,0,0,1" Padding="10,6">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Left: Badge & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Background="#E53935" CornerRadius="3" Padding="4,1">
                            <TextBlock Text="RD" FontSize="9.5" FontWeight="Bold" Foreground="White" />
                        </Border>
                        <TextBlock Name="TitleText" Text="Collection View: SampleData" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" FontFamily="JetBrains Mono, Menlo, monospace" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Right: Row count, export, close -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Name="RowCountText" Text="0 rows" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />

                        <!-- Copy / Export button -->
                        <Button Name="CopyTableButton" Classes="m3-icon-btn" Width="24" Height="24" ToolTip.Tip="Copy table (TSV) to clipboard">
                            <materialIcons:MaterialIcon Kind="ContentCopy" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                        </Button>

                        <!-- Close button -->
                        <Button Name="CloseButton" Classes="m3-icon-btn" Width="24" Height="24" ToolTip.Tip="Close (Esc)">
                            <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Filter / Search Bar -->
            <Border Grid.Row="1" Background="{DynamicResource M3SurfaceContainerLowestBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                <Grid ColumnDefinitions="Auto,*">
                    <materialIcons:MaterialIcon Grid.Column="0" Kind="FilterOutline" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" Margin="2,0,6,0" />
                    <TextBox Grid.Column="1" Name="FilterTextBox" Classes="sidebar-search-box" PlaceholderText="Where x => x. (Filter rows...)" FontSize="11" FontFamily="JetBrains Mono, monospace" BorderThickness="0" Background="Transparent" />
                </Grid>
            </Border>

            <!-- 3. Dynamic Grid Table -->
            <Grid Grid.Row="2" Background="{DynamicResource M3SurfaceContainerLowestBrush}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="TableContentPanel" Margin="6,4" />
                </ScrollViewer>
            </Grid>

            <!-- 4. Footer -->
            <Border Grid.Row="3" Background="{DynamicResource M3SurfaceContainerBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="0,1,0,0" Padding="10,4">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Interactive Collection Inspector" FontSize="9.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Click Copy to export as TSV" FontSize="9.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
