<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.AI"
             xmlns:ai="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Models.AI"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.AI.StudioFloatingComposerControl"
             x:DataType="vm:AiComposerViewModel"
             IsVisible="{Binding IsVisible}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CSharpEditorPlugin/Views/CSharpManagerPaletteTokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.composer-window">
            <Setter Property="Background" Value="{DynamicResource DsSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BoxShadow" Value="0 14 36 0 #70000000, 0 2 8 0 #30000000" />
        </Style>
        <Style Selector="Button.composer-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.composer-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource DsHoverOverlayBrush}" />
        </Style>
        <Style Selector="Button.close-btn:pointerover">
            <Setter Property="Background" Value="#DC2626" />
        </Style>
        <Style Selector="Button.close-btn:pointerover materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Pill Badges & Chips (Inspired by Side Panel nexus-badge-pill) -->
        <Style Selector="Button.composer-pill-btn">
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.composer-pill-btn">
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.composer-pill-btn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.04)" />
        </Style>
        <Style Selector="Button.composer-pill-btn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <!-- Mode Toggle Switcher Pill in Header (Chat / Agent) -->
        <Style Selector="ToggleButton.composer-mode-toggle">
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#158B949E" />
            <Setter Property="BorderBrush" Value="#252D3B" />
            <Setter Property="Foreground" Value="#8B949E" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.composer-mode-toggle /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="11" />
        </Style>
        <Style Selector="ToggleButton.composer-mode-toggle:checked">
            <Setter Property="Background" Value="#1A38BDF8" />
            <Setter Property="BorderBrush" Value="#38BDF8" />
            <Setter Property="Foreground" Value="#38BDF8" />
        </Style>
        <Style Selector="ToggleButton.composer-mode-toggle:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1A38BDF8" />
            <Setter Property="BorderBrush" Value="#38BDF8" />
        </Style>
        <Style Selector="ToggleButton.composer-mode-toggle:checked materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="#38BDF8" />
        </Style>
        <Style Selector="ToggleButton.composer-mode-toggle:checked TextBlock">
            <Setter Property="Foreground" Value="#38BDF8" />
        </Style>
        <Style Selector="ToggleButton.composer-mode-toggle:pointerover">
            <Setter Property="BorderBrush" Value="#38BDF8" />
        </Style>

        <!-- Primary Action Send Button (Sleek modern button matching app primary style) -->
        <Style Selector="Button.action-send">
            <Setter Property="Background" Value="{DynamicResource DsPrimaryBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryHoverBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.action-send /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DsPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryHoverBrush}" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="Button.action-send:pointerover">
            <Setter Property="Background" Value="{DynamicResource DsPrimaryHoverBrush}" />
            <Setter Property="RenderTransform" Value="scale(1.06)" />
        </Style>
        <Style Selector="Button.action-send:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DsPrimaryHoverBrush}" />
        </Style>
        <Style Selector="Button.action-send materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Autocomplete Mention Item -->
        <Style Selector="Button.composer-mention-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.composer-mention-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource DsSurfaceBrush}" />
        </Style>

        <!-- Stop Generation Button -->
        <Style Selector="Button.action-stop">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#EF4444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.action-stop /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="BorderBrush" Value="#EF4444" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="Button.action-stop:pointerover">
            <Setter Property="Background" Value="#B91C1C" />
            <Setter Property="RenderTransform" Value="scale(1.06)" />
        </Style>
        <Style Selector="Button.action-stop:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#B91C1C" />
        </Style>
        <Style Selector="Button.action-stop materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Diff & Change Acceptance Buttons -->
        <Style Selector="Button.action-accept">
            <Setter Property="Background" Value="{DynamicResource DsPrimaryBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryHoverBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.action-accept:pointerover">
            <Setter Property="Background" Value="{DynamicResource DsPrimaryHoverBrush}" />
        </Style>
        <Style Selector="Button.action-reject">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F87171" />
            <Setter Property="BorderBrush" Value="#4B2323" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.action-reject:pointerover">
            <Setter Property="Background" Value="#251212" />
            <Setter Property="BorderBrush" Value="#DC2626" />
        </Style>
    </UserControl.Styles>

    <!-- Overlay Host Container -->
    <Panel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <!-- ======================================================== -->
        <!-- 1. MINIMIZED FLOATING CAPSULE BUTTON (Bottom Right)      -->
        <!-- ======================================================== -->
        <Border IsVisible="{Binding CanShowMinimizedCapsule}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,24"
                Background="{DynamicResource DsSurfaceBrush}"
                BorderBrush="{DynamicResource DsPrimaryBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="16" Padding="12,7"
                BoxShadow="0 8 24 0 #60000000">
            <Button Command="{Binding ToggleMinimizeCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource DsPrimarySubtleBrush}">
                        <materialIcons:MaterialIcon Kind="AutoFix" Width="13" Height="13" Foreground="{DynamicResource DsPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Fry AI Agent" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                    <Border IsVisible="{Binding IsGenerating}"
                            Width="8" Height="8" CornerRadius="4" Background="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Border>

        <!-- ======================================================== -->
        <!-- 2. EXPANDED FLOATING COMPOSER WINDOW                     -->
        <!-- ======================================================== -->
        <Border Name="ComposerContainer"
                IsVisible="{Binding !IsMinimized}"
                Classes="composer-window"
                Background="{DynamicResource DsSurfaceBrush}"
                Opacity="{Binding WindowOpacity}">
            <Panel>
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

                <!-- Header Bar (Draggable Title Rail) -->
                <Border Name="HeaderBar" Grid.Row="0" Height="40"
                        Background="{DynamicResource DsSurfaceBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="9,9,0,0"
                        Padding="12,0,8,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Icon, Title & Agent Mode Switcher Pill -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource DsPrimarySubtleBrush}">
                                <materialIcons:MaterialIcon Kind="AutoFix" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Composer" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />

                            <ToggleButton Classes="composer-mode-toggle"
                                          IsChecked="{Binding IsAgentMode, Mode=TwoWay}"
                                          Margin="6,0,0,0"
                                          ToolTip.Tip="Toggle Agent mode (autonomous tools) vs Chat mode">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="RobotOutline" Width="12" Height="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Agent" FontSize="10.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>

                            <!-- Server Address & Auto-Discovery Pill Button -->
                            <Button Command="{Binding ToggleConnectionDrawerCommand}"
                                    Classes="composer-pill-btn"
                                    Margin="6,0,0,0" Height="22" Padding="6,1"
                                    ToolTip.Tip="Configure Server Address &amp; Auto-Detect Local LLM"
                                    Background="{DynamicResource DsSurfaceBrush}"
                                    BorderBrush="{DynamicResource DsBorderBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="LanConnect" Width="11" Height="11" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Server" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DsTextBrush}" VerticalAlignment="Center" />
                                    <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Draggable rail empty space -->
                        <Border Grid.Column="1" Background="Transparent" />

                        <!-- Action Toolbar & Window Controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                            <!-- Dynamic Actions Injected by Extensions -->
                            <StackPanel Name="DynamicActionsHost" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />

                            <!-- Clear Chat -->
                            <Button Command="{Binding ClearChatCommand}" Classes="composer-btn" ToolTip.Tip="Clear Conversation"
                                    Width="26" Height="26" Padding="0">
                                <materialIcons:MaterialIcon Kind="Broom" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                            </Button>

                            <!-- Screen Capture Protection Toggle -->
                            <Button Command="{Binding ToggleCaptureProtectionCommand}" Classes="composer-btn"
                                    ToolTip.Tip="Toggle Screen Capture Protection (Hide window from recording/screenshots)"
                                    Width="26" Height="26" Padding="0">
                                <Panel>
                                    <materialIcons:MaterialIcon Kind="ShieldCheck" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}"
                                                                IsVisible="{Binding IsProtectedFromCapture}" />
                                    <materialIcons:MaterialIcon Kind="ShieldOutline" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}"
                                                                IsVisible="{Binding !IsProtectedFromCapture}" />
                                </Panel>
                            </Button>

                            <!-- Vertical Divider -->
                            <Border Width="1" Height="14" Background="{DynamicResource DsBorderBrush}" Margin="3,0" />

                            <!-- Docking Controls -->
                            <!-- When Extracted: Re-dock to main window -->
                            <Button Command="{Binding ReDockCommand}" Classes="composer-btn" ToolTip.Tip="Re-dock into Studio"
                                    Width="26" Height="26" Padding="0" IsVisible="{Binding IsExtracted}">
                                <materialIcons:MaterialIcon Kind="DockWindow" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}" />
                            </Button>

                            <!-- When Docked in SideBar/Bottom: Float as Overlay -->
                            <Button Command="{Binding DockToFloatingCommand}" Classes="composer-btn" ToolTip.Tip="Float as Overlay"
                                    Width="26" Height="26" Padding="0" IsVisible="{Binding CanDockToFloating}">
                                <materialIcons:MaterialIcon Kind="LayersOutline" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}" />
                            </Button>

                            <!-- When Not Extracted: Extract to OS Window (Screen Tearing) -->
                            <Button Command="{Binding ExtractToWindowCommand}" Classes="composer-btn" ToolTip.Tip="Tear Out into Floating Window"
                                    Width="26" Height="26" Padding="0" IsVisible="{Binding CanExtractToWindow}">
                                <materialIcons:MaterialIcon Kind="OpenInNew" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                            </Button>

                            <!-- Dock to SideBar -->
                            <Button Command="{Binding DockToSideBarCommand}" Classes="composer-btn" ToolTip.Tip="Dock into Right Panel (Secondary Side Bar)"
                                    Width="26" Height="26" Padding="0" IsVisible="{Binding CanDockToSideBar}">
                                <materialIcons:MaterialIcon Kind="DockRight" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                            </Button>

                            <!-- Dock to Bottom Deck -->
                            <Button Command="{Binding DockToBottomDeckCommand}" Classes="composer-btn" ToolTip.Tip="Dock into Bottom Panel / Deck"
                                    Width="26" Height="26" Padding="0" IsVisible="{Binding CanDockToBottomDeck}">
                                <materialIcons:MaterialIcon Kind="DockBottom" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                            </Button>

                            <!-- Vertical Divider -->
                            <Border Width="1" Height="14" Background="{DynamicResource DsBorderBrush}" Margin="3,0"
                                    IsVisible="{Binding CanMaximizeAndMinimize}" />

                            <!-- Window Management (Maximize, Minimize, Close) -->
                            <Button Name="MaximizeRestoreButton" Classes="composer-btn" ToolTip.Tip="Maximize / Restore"
                                    Width="26" Height="26" Padding="0" IsVisible="{Binding CanMaximizeAndMinimize}">
                                <materialIcons:MaterialIcon Name="MaximizeIcon" Kind="WindowMaximize" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                            </Button>

                            <Button Command="{Binding ToggleMinimizeCommand}" Classes="composer-btn" ToolTip.Tip="Minimize to Pill"
                                    Width="26" Height="26" Padding="0" IsVisible="{Binding CanMaximizeAndMinimize}">
                                <materialIcons:MaterialIcon Kind="Minus" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                            </Button>

                            <Button Command="{Binding CloseCommand}" Classes="composer-btn close-btn" ToolTip.Tip="Close (Cmd+I)"
                                    Width="26" Height="26" Padding="0">
                                <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Drawers (Row 1): Server Address & Auto-Discovery Drawer + System Prompt & Persona Drawer -->
                <StackPanel Grid.Row="1">
                    <!-- 1. Endpoint Address & LLM Auto-Discovery Drawer -->
                    <Border Background="{DynamicResource DsSurfaceHighBrush}"
                            BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="0,0,0,1"
                            Padding="12,10" IsVisible="{Binding IsConnectionDrawerOpen}">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="LanConnect" Width="13" Height="13" Foreground="{DynamicResource DsPrimaryBrush}" />
                                    <TextBlock Text="SERVER ADDRESS &amp; LOCAL LLM DISCOVERY" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource DsMutedBrush}" LetterSpacing="0.8" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding ToggleConnectionDrawerCommand}" Classes="composer-btn" Padding="2" ToolTip.Tip="Close connection drawer">
                                    <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                            </Grid>

                            <!-- Address Input + Ping + Auto-Detect -->
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBox Grid.Column="0" Text="{Binding EndpointUrl, Mode=TwoWay}"
                                         FontFamily="{DynamicResource JetBrainsMonoFontFamily}"
                                         FontSize="11" Height="28" Padding="8,4"
                                         Background="{DynamicResource DsBgBrush}"
                                         Foreground="{DynamicResource DsTextWhiteBrush}"
                                         BorderBrush="{DynamicResource DsBorderBrush}"
                                         BorderThickness="1" CornerRadius="6"
                                         PlaceholderText="Endpoint Address (e.g. http://localhost:11434)" />

                                <Button Grid.Column="1" Command="{Binding PingEndpointCommand}" Classes="composer-pill-btn"
                                        Margin="6,0,0,0" Height="28" Padding="8,2"
                                        ToolTip.Tip="Ping this address and test latency"
                                        Background="{DynamicResource NavHomeBgBrush}" BorderBrush="{DynamicResource NavHomeFgBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="Pulse" Width="12" Height="12" Foreground="{DynamicResource NavHomeFgBrush}" />
                                        <TextBlock Text="Ping" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource NavHomeFgBrush}" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2" Command="{Binding AutoDetectLocalServiceCommand}" Classes="action-accept"
                                        Margin="6,0,0,0" Height="28" Padding="10,2"
                                        ToolTip.Tip="Auto-detect running Ollama or LM Studio servers on local ports (1234, 11434, 11443)">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="AutoFix" Width="12" Height="12" Foreground="#FFFFFF" />
                                        <TextBlock Text="Auto-Detect" FontSize="10.5" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Status & Latency Strip -->
                            <Border Background="{DynamicResource DsBgBrush}" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding EndpointStatusText}" FontSize="10.5" Foreground="{DynamicResource DsTextBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="Model:" FontSize="10" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedModel}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Studio UI Freedom & Extensibility Quick Presets -->
                            <StackPanel Spacing="4" Margin="0,2,0,0">
                                <TextBlock Text="STUDIO UI FREEDOM &amp; EXTENSIBILITY:" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource DsMutedBrush}" LetterSpacing="0.6" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Command="{Binding PresetCustomizeThemeCommand}" Classes="composer-pill-btn" Margin="0,1,6,1" Padding="7,2"
                                            Background="{DynamicResource NavBlind75BgBrush}" BorderBrush="{DynamicResource NavBlind75FgBrush}"
                                            ToolTip.Tip="Ask agent to modify studio theme colors and styles">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="PaletteOutline" Width="11" Height="11" Foreground="{DynamicResource NavBlind75FgBrush}" />
                                            <TextBlock Text="Customize Theme" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource NavBlind75FgBrush}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding PresetInjectWidgetCommand}" Classes="composer-pill-btn" Margin="0,1,6,1" Padding="7,2"
                                            Background="{DynamicResource NavToolchainsBgBrush}" BorderBrush="{DynamicResource NavToolchainsFgBrush}"
                                            ToolTip.Tip="Ask agent to inject a custom XAML widget into EditorToolbar">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="PuzzleOutline" Width="11" Height="11" Foreground="{DynamicResource NavToolchainsFgBrush}" />
                                            <TextBlock Text="Inject Widget" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource NavToolchainsFgBrush}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding PresetInspectUiCommand}" Classes="composer-pill-btn" Margin="0,1,6,1" Padding="7,2"
                                            Background="{DynamicResource NavKernelsBgBrush}" BorderBrush="{DynamicResource NavKernelsFgBrush}"
                                            ToolTip.Tip="Ask agent to inspect running studio visual tree">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="ViewDashboardOutline" Width="11" Height="11" Foreground="{DynamicResource NavKernelsFgBrush}" />
                                            <TextBlock Text="Inspect UI Tree" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource NavKernelsFgBrush}" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 2. Prompt & Persona Customization Drawer -->
                    <Border Background="{DynamicResource DsSurfaceHighBrush}"
                            BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="0,0,0,1"
                            Padding="12,10" IsVisible="{Binding IsPromptEditorOpen}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Tune" Width="13" Height="13" Foreground="{DynamicResource DsPrimaryBrush}" />
                                <TextBlock Text="SYSTEM PROMPT &amp; PERSONA" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource DsMutedBrush}" LetterSpacing="0.8" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding TogglePromptEditorCommand}" Classes="composer-btn" Padding="2" ToolTip.Tip="Close prompt editor">
                                <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="{DynamicResource DsMutedBrush}" />
                            </Button>
                        </Grid>

                        <!-- Presets Row -->
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="Presets:" FontSize="10.5" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button Command="{Binding SetComposerDefaultPromptCommand}" Classes="composer-pill-btn" Margin="0,1,6,1" Padding="8,2" ToolTip.Tip="Autonomous agent with Roslyn, bash &amp; tools"
                                    Background="{DynamicResource NavHomeBgBrush}" BorderBrush="{DynamicResource NavHomeFgBrush}">
                                <TextBlock Text="Agent" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NavHomeFgBrush}" />
                            </Button>
                            <Button Command="{Binding SetComposerConcisePromptCommand}" Classes="composer-pill-btn" Margin="0,1,6,1" Padding="8,2" ToolTip.Tip="Concise code diffs with minimal prose"
                                    Background="{DynamicResource NavKernelsBgBrush}" BorderBrush="{DynamicResource NavKernelsFgBrush}">
                                <TextBlock Text="Concise" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NavKernelsFgBrush}" />
                            </Button>
                            <Button Command="{Binding SetComposerReviewerPromptCommand}" Classes="composer-pill-btn" Margin="0,1,6,1" Padding="8,2" ToolTip.Tip="Code review, memory leaks, performance &amp; security"
                                    Background="{DynamicResource NavTemplatesBgBrush}" BorderBrush="{DynamicResource NavTemplatesFgBrush}">
                                <TextBlock Text="Reviewer" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NavTemplatesFgBrush}" />
                            </Button>
                            <Button Command="{Binding SetComposerTddPromptCommand}" Classes="composer-pill-btn" Margin="0,1,6,1" Padding="8,2" ToolTip.Tip="Test-driven development, xUnit &amp; edge cases"
                                    Background="{DynamicResource NavToolchainsBgBrush}" BorderBrush="{DynamicResource NavToolchainsFgBrush}">
                                <TextBlock Text="TDD" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NavToolchainsFgBrush}" />
                            </Button>
                        </WrapPanel>

                        <!-- Multi-line Prompt Editor -->
                        <TextBox Text="{Binding CustomSystemPrompt, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="78"
                                 FontFamily="{DynamicResource JetBrainsMonoFontFamily}"
                                 FontSize="11"
                                 Background="{DynamicResource DsBgBrush}"
                                 Foreground="{DynamicResource DsTextWhiteBrush}"
                                 BorderBrush="{DynamicResource DsBorderBrush}"
                                 BorderThickness="1"
                                 CornerRadius="6"
                                 Padding="8,6" />

                        <!-- Drawer Footer -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding CustomPromptLength, StringFormat='{}{0:N0} characters'}" FontSize="10" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button Command="{Binding ResetComposerPromptCommand}" Classes="composer-btn" Padding="6,2" ToolTip.Tip="Reset to Default System Prompt">
                                    <TextBlock Text="Reset" FontSize="10.5" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                                <Button Command="{Binding ApplyCustomPromptCommand}" Classes="action-accept" Padding="10,2" ToolTip.Tip="Apply Prompt to Agent">
                                    <TextBlock Text="Apply" FontSize="10.5" FontWeight="SemiBold" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                </StackPanel>

                <!-- Touched Files Strip (Row 2, Visible when files modified) -->
                <Border Grid.Row="2" Background="{DynamicResource DsSurfaceBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="0,0,0,1"
                        Padding="10,6" IsVisible="{Binding HasModifiedFiles}">
                    <Grid ColumnDefinitions="*,Auto">
                        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding SessionModifiedFiles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="ai:ModifiedFileItem">
                                        <Border Background="{DynamicResource DsPrimarySubtleBrush}"
                                                BorderBrush="{DynamicResource DsPrimaryBorderSubtleBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="7,3">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <materialIcons:MaterialIcon Kind="FileCodeOutline" Width="12" Height="12" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding SummaryText}" FontSize="10" Foreground="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Accept All / Reject All Actions -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
                            <Button Command="{Binding AcceptAllChangesCommand}" Classes="action-accept" ToolTip.Tip="Accept All Changes (Cmd+Enter)">
                                <TextBlock Text="Accept All" FontWeight="SemiBold" />
                            </Button>
                            <Button Command="{Binding RejectAllChangesCommand}" Classes="action-reject" ToolTip.Tip="Reject All Changes">
                                <TextBlock Text="Reject" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Conversation Messages Scroll Area (Row 3) -->
                <Border Grid.Row="3" Background="{DynamicResource DsBgBrush}">
                    <ScrollViewer Name="MessagesScrollViewer"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  Padding="12,8">
                    <StackPanel Spacing="12">
                        <!-- Welcome / Empty Prompt Placeholder -->
                        <Border Background="{DynamicResource DsSurfaceBrush}"
                                BorderBrush="{DynamicResource DsBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8" Padding="14" Margin="0,8"
                                IsVisible="{Binding !Messages.Count}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="✨ What would you like to build or automate?" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                <TextBlock Text="Fry AI can explore your workspace, create or edit scripts, fix compiler errors, and customize the studio UI."
                                           FontSize="11.5" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />
                                <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Command="{Binding InsertMentionCommand}" CommandParameter="@Files"
                                            Classes="composer-pill-btn" Margin="0,2,6,2" Padding="8,3"
                                            Background="{DynamicResource NavHomeBgBrush}" BorderBrush="{DynamicResource NavHomeFgBrush}"
                                            ToolTip.Tip="Attach full workspace file listing">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="FolderMultipleOutline" Width="11" Height="11" Foreground="{DynamicResource NavHomeFgBrush}" />
                                            <TextBlock Text="@Files" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NavHomeFgBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding InsertMentionCommand}" CommandParameter="@Problems"
                                            Classes="composer-pill-btn" Margin="0,2,6,2" Padding="8,3"
                                            Background="{DynamicResource NavKernelsBgBrush}" BorderBrush="{DynamicResource NavKernelsFgBrush}"
                                            ToolTip.Tip="Attach active compiler diagnostics &amp; errors">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="11" Height="11" Foreground="{DynamicResource NavKernelsFgBrush}" />
                                            <TextBlock Text="@Problems" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NavKernelsFgBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding InsertMentionCommand}" CommandParameter="@Docs"
                                            Classes="composer-pill-btn" Margin="0,2,6,2" Padding="8,3"
                                            Background="{DynamicResource NavTemplatesBgBrush}" BorderBrush="{DynamicResource NavTemplatesFgBrush}"
                                            ToolTip.Tip="Attach studio API documentation &amp; SDK reference">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="BookOpenOutline" Width="11" Height="11" Foreground="{DynamicResource NavTemplatesFgBrush}" />
                                            <TextBlock Text="@Docs" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NavTemplatesFgBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding InsertMentionCommand}" CommandParameter="@UI"
                                            Classes="composer-pill-btn" Margin="0,2,6,2" Padding="8,3"
                                            Background="{DynamicResource NavToolchainsBgBrush}" BorderBrush="{DynamicResource NavToolchainsFgBrush}"
                                            ToolTip.Tip="Inspect live studio visual tree hierarchy">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="ViewDashboardOutline" Width="11" Height="11" Foreground="{DynamicResource NavToolchainsFgBrush}" />
                                            <TextBlock Text="@UI" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NavToolchainsFgBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding InsertMentionCommand}" CommandParameter="@Theme"
                                            Classes="composer-pill-btn" Margin="0,2,6,2" Padding="8,3"
                                            Background="{DynamicResource NavBlind75BgBrush}" BorderBrush="{DynamicResource NavBlind75FgBrush}"
                                            ToolTip.Tip="Customize studio styling &amp; theme tokens">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="PaletteOutline" Width="11" Height="11" Foreground="{DynamicResource NavBlind75FgBrush}" />
                                            <TextBlock Text="@Theme" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NavBlind75FgBrush}" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Chat Messages List -->
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="ai:ChatMessageItem">
                                    <StackPanel Spacing="6" Margin="0,4">
                                        <!-- User Message Bubble -->
                                        <Border IsVisible="{Binding IsUser}"
                                                Background="#1C2E47" BorderBrush="#293F5F" BorderThickness="1"
                                                CornerRadius="8" Padding="12,8"
                                                HorizontalAlignment="Right" MaxWidth="440">
                                            <TextBlock Text="{Binding Content}" FontSize="12" Foreground="{DynamicResource DsTextWhiteBrush}" TextWrapping="Wrap" />
                                        </Border>

                                        <!-- Assistant Message Bubble -->
                                        <StackPanel IsVisible="{Binding IsAssistant}" Spacing="6">
                                            <!-- Steps Accordion (ReAct plan progression) -->
                                            <ItemsControl ItemsSource="{Binding Steps}" IsVisible="{Binding HasSteps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="ai:AgentStepItem">
                                                        <Border Background="{DynamicResource DsBgBrush}" CornerRadius="6" Padding="8,5" Margin="0,2"
                                                                BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1">
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding StatusIconKind}" Foreground="{Binding StatusColorHex}" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource DsTextBrush}" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Thinking / Reasoning Accordion (Brain icon & collapsible thoughts) -->
                                            <Border IsVisible="{Binding HasReasoning}"
                                                    Background="{DynamicResource DsSurfaceHighBrush}" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1"
                                                    CornerRadius="8" Padding="8,5" Margin="0,2,0,2">
                                                <StackPanel Spacing="4">
                                                    <ToggleButton IsChecked="{Binding IsReasoningExpanded, Mode=TwoWay}"
                                                                  Classes="composer-btn"
                                                                  HorizontalAlignment="Left"
                                                                  Padding="4,2">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <materialIcons:MaterialIcon Kind="Brain" Width="13" Height="13" Foreground="{DynamicResource NavKernelsFgBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="Thinking Process" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NavKernelsFgBrush}" VerticalAlignment="Center" />
                                                            <materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <Border IsVisible="{Binding IsReasoningExpanded}" Background="{DynamicResource DsBgBrush}"
                                                            BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1"
                                                            CornerRadius="6" Padding="8" Margin="0,2,0,0">
                                                        <ScrollViewer MaxHeight="140" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                            <SelectableTextBlock Text="{Binding ReasoningContent}"
                                                                                 FontSize="10.5"
                                                                                 FontStyle="Italic"
                                                                                 Foreground="{DynamicResource DsTextBrush}"
                                                                                 TextWrapping="Wrap"
                                                                                 FontFamily="Consolas, Menlo, Monaco, monospace" />
                                                        </ScrollViewer>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <!-- Assistant Text Content -->
                                            <Border Background="{DynamicResource DsSurfaceBrush}"
                                                    BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1"
                                                    CornerRadius="8" Padding="12,10">
                                                <StackPanel Spacing="6">
                                                    <SelectableTextBlock Text="{Binding Content}" FontSize="12" Foreground="{DynamicResource DsTextBrush}"
                                                                         TextWrapping="Wrap" />

                                                    <!-- Error Notice -->
                                                    <Border IsVisible="{Binding HasError}" Background="#450A0A" CornerRadius="4" Padding="8" Margin="0,4">
                                                        <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="#FCA5A5" TextWrapping="Wrap" />
                                                    </Border>

                                                    <!-- Inline Touched Files & Diff Cards -->
                                                    <ItemsControl ItemsSource="{Binding ModifiedFiles}" IsVisible="{Binding ModifiedFiles.Count}">
                                                        <ItemsControl.ItemTemplate>
                                                             <DataTemplate x:DataType="ai:ModifiedFileItem">
                                                                <Border Background="{DynamicResource DsSurfaceHighBrush}" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,4,0,2" Padding="8">
                                                                    <StackPanel Spacing="6">
                                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                                                            <materialIcons:MaterialIcon Grid.Column="0" Kind="FileDocumentEditOutline" Width="14" Height="14" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource DsTextBrush}" VerticalAlignment="Center" />
                                                                            <TextBlock Grid.Column="2" Text="{Binding SummaryText}" FontSize="10.5" Foreground="#4ADE80" VerticalAlignment="Center" Margin="8,0" />

                                                                            <!-- Apply to Editor Button -->
                                                                            <Button Grid.Column="3"
                                                                                    Command="{Binding $parent[UserControl].((vm:AiComposerViewModel)DataContext).ApplyModifiedFileCommand}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Classes="composer-pill-btn" Height="22" Padding="6,1" Margin="4,0"
                                                                                    ToolTip.Tip="Apply changes to active document in editor">
                                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                                    <materialIcons:MaterialIcon Kind="Check" Width="12" Height="12" Foreground="#4ADE80" />
                                                                                    <TextBlock Text="Apply" FontSize="10" Foreground="#4ADE80" FontWeight="SemiBold" />
                                                                                </StackPanel>
                                                                            </Button>

                                                                            <ToggleButton Grid.Column="4" IsChecked="{Binding IsDiffExpanded, Mode=TwoWay}"
                                                                                          Classes="composer-btn" Padding="4,2" Height="22" Width="22">
                                                                                <materialIcons:MaterialIcon Kind="CodeBraces" Width="13" Height="13" Foreground="#94A3B8" />
                                                                            </ToggleButton>
                                                                        </Grid>

                                                                        <!-- Expandable Unified Diff Viewer with Line-by-Line Syntax Highlighting -->
                                                                        <Border IsVisible="{Binding IsDiffExpanded}" Background="{DynamicResource DsBgBrush}" CornerRadius="4" Padding="4,4" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1">
                                                                            <StackPanel Spacing="4">
                                                                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="220">
                                                                                    <ItemsControl ItemsSource="{Binding DiffLines}">
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate x:DataType="ai:DiffLine">
                                                                                                <Border Background="{Binding BackgroundHex}" Padding="8,1" Margin="0,0.5" CornerRadius="2">
                                                                                                    <SelectableTextBlock Text="{Binding Text}"
                                                                                                                         FontFamily="Consolas, Menlo, Monaco, monospace"
                                                                                                                         FontSize="10.5"
                                                                                                                         Foreground="{Binding ForegroundHex}" />
                                                                                                </Border>
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                    </ItemsControl>
                                                                                </ScrollViewer>

                                                                                <!-- Insert at Caret Option -->
                                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,2,2,2">
                                                                                    <Button Command="{Binding $parent[UserControl].((vm:AiComposerViewModel)DataContext).InsertCodeAtCursorCommand}"
                                                                                            CommandParameter="{Binding ModifiedContent}"
                                                                                            Classes="composer-pill-btn" Height="20" Padding="6,1"
                                                                                            ToolTip.Tip="Insert modified code at current cursor position">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                                                            <materialIcons:MaterialIcon Kind="CursorDefaultClickOutline" Width="11" Height="11" Foreground="{DynamicResource DsPrimaryBrush}" />
                                                                                            <TextBlock Text="Insert at Caret" FontSize="9.5" Foreground="{DynamicResource DsTextBrush}" />
                                                                                        </StackPanel>
                                                                                    </Button>
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                </Border>

                <!-- Status Strip (Row 4) -->
                <Border Grid.Row="4" Background="{DynamicResource DsSurfaceBrush}" Height="22" Padding="12,0" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Width="6" Height="6" CornerRadius="3"
                                    Background="{Binding IsGenerating, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <TextBlock Text="{Binding StatusText}" FontSize="10.5" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Cmd+I: Toggle • Cmd+Enter: Accept" FontSize="10" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Bottom Prompt Input Deck (Row 5) -->
                <Border Name="PromptDeckBorder" Grid.Row="5"
                        Background="{DynamicResource DsSurfaceBrush}"
                        CornerRadius="0,0,9,9"
                        Padding="12,10,12,12"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel Spacing="6">
                        <!-- @ Mention Autocomplete Popup Deck -->
                        <Border IsVisible="{Binding IsMentionPopupOpen}"
                                Background="{DynamicResource DsSurfaceHighBrush}"
                                BorderBrush="{DynamicResource DsBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                MaxHeight="160"
                                BoxShadow="0 -4 16 0 #40000000">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FilteredMentions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="ai:MentionSuggestionItem">
                                            <Button Command="{Binding ((vm:AiComposerViewModel)DataContext).InsertMentionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Prefix}"
                                                    Classes="composer-mention-item"
                                                    HorizontalAlignment="Stretch"
                                                    Padding="8,5"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand">
                                                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding IconKind}" Width="13" Height="13" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Prefix}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Description}" FontSize="10.5" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <Border Grid.Column="3" Background="{DynamicResource DsSurfaceBrush}" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding Category}" FontSize="9" Foreground="{DynamicResource DsMutedBrush}" />
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <Border Background="{DynamicResource DsBgBrush}"
                                BorderBrush="{DynamicResource DsBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8,8,8">
                            <Grid RowDefinitions="*,Auto">
                                <!-- Multi-line Prompt Text Box -->
                                <TextBox Name="PromptTextBox" Grid.Row="0"
                                         Text="{Binding PromptText, Mode=TwoWay}"
                                         AcceptsReturn="True" MinHeight="40" MaxHeight="120"
                                         Background="Transparent" Foreground="{DynamicResource DsTextWhiteBrush}"
                                         BorderThickness="0"
                                         FontSize="12.5" Padding="2"
                                         PlaceholderForeground="{DynamicResource DsMutedBrush}"
                                         PlaceholderText="Ask Fry AI or describe code changes (@file, /fix)..."
                                         KeyDown="OnPromptTextBoxKeyDown" />

                                <!-- Composer Bottom Toolbar Inside Prompt Box -->
                                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
                                    <!-- Left: Model Selector, Refresh, Connection & Persona -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <!-- Model Selector Dropdown -->
                                        <ComboBox ItemsSource="{Binding AvailableModels}"
                                                  SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                                  Height="24" FontSize="11" MinWidth="90" MaxWidth="150" Padding="6,1"
                                                  Background="{DynamicResource DsSurfaceBrush}"
                                                  BorderBrush="{DynamicResource DsBorderBrush}"
                                                  CornerRadius="6"
                                                  ToolTip.Tip="{Binding SelectedModel, StringFormat='Active Model: {0}'}" />

                                        <!-- Refresh Models Button -->
                                        <Button Command="{Binding RefreshModelsCommand}" Classes="composer-btn"
                                                ToolTip.Tip="Refresh Available Models" Width="22" Height="22" Padding="0">
                                            <materialIcons:MaterialIcon Kind="Refresh" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                        </Button>

                                        <!-- Server Connection Pill Button -->
                                        <Button Command="{Binding ToggleConnectionDrawerCommand}" Classes="composer-pill-btn"
                                                ToolTip.Tip="{Binding EndpointStatusText, StringFormat='Server: {0} (Click to configure &amp; auto-detect)'}"
                                                Height="22" Padding="6,1"
                                                Background="{DynamicResource DsSurfaceBrush}"
                                                BorderBrush="{DynamicResource DsBorderBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="LanConnect" Width="11" Height="11" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                                <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Persona Preset Button (Pill Badge style inspired by Side Panel) -->
                                        <Button Command="{Binding TogglePromptEditorCommand}"
                                                Classes="composer-pill-btn"
                                                ToolTip.Tip="Customize System Prompt &amp; Persona"
                                                Height="22" Padding="6,1"
                                                Background="{DynamicResource NavHomeBgBrush}"
                                                BorderBrush="{DynamicResource NavHomeFgBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="Tune" Width="11" Height="11" Foreground="{DynamicResource NavHomeFgBrush}" />
                                                <TextBlock Text="{Binding ActivePromptPresetName}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NavHomeFgBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                <!-- Center Spacer -->
                                <Border Grid.Column="1" Background="Transparent" />

                                <!-- Right: Fast Provider Switchers & Send / Stop Button -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Command="{Binding SwitchToLmStudioCommand}" Classes="composer-pill-btn"
                                            ToolTip.Tip="Switch to LM Studio (1234)" Height="22" Padding="6,1"
                                            Background="{DynamicResource NavKernelsBgBrush}"
                                            BorderBrush="{DynamicResource NavKernelsFgBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Laptop" Width="11" Height="11" Foreground="{DynamicResource NavKernelsFgBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="LM" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource NavKernelsFgBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SwitchToOllamaCommand}" Classes="composer-pill-btn"
                                            ToolTip.Tip="Switch to Ollama (11434)" Height="22" Padding="6,1"
                                            Background="{DynamicResource NavHomeBgBrush}"
                                            BorderBrush="{DynamicResource NavHomeFgBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Server" Width="11" Height="11" Foreground="{DynamicResource NavHomeFgBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="Ollama" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource NavHomeFgBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Send / Stop Action Button -->
                                    <Button Command="{Binding StopGenerationCommand}" Classes="action-stop"
                                            Height="24" Width="24"
                                            IsVisible="{Binding IsGenerating}" ToolTip.Tip="Stop Generation">
                                        <materialIcons:MaterialIcon Kind="Stop" Width="12" Height="12" Foreground="#FFFFFF" />
                                    </Button>
                                    <Button Command="{Binding SendMessageCommand}" Classes="action-send"
                                            Height="24" Width="24"
                                            IsVisible="{Binding !IsGenerating}" ToolTip.Tip="Send Prompt (Enter)">
                                        <materialIcons:MaterialIcon Kind="Send" Width="12" Height="12" Foreground="#FFFFFF" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    </StackPanel>
                </Border>

                </Grid>

                <!-- ======================================================== -->
                <!-- FLOATING RESIZE HANDLES & CORNER GRIP                    -->
                <!-- ======================================================== -->
                <!-- Left Border Resize Handle -->
                <Border Name="ResizeHandleLeft" Width="8"
                        HorizontalAlignment="Left" VerticalAlignment="Stretch"
                        Background="Transparent" Cursor="SizeWestEast" />

                <!-- Right Border Resize Handle -->
                <Border Name="ResizeHandleRight" Width="8"
                        HorizontalAlignment="Right" VerticalAlignment="Stretch"
                        Background="Transparent" Cursor="SizeWestEast" />

                <!-- Bottom Border Resize Handle -->
                <Border Name="ResizeHandleBottom" Height="8"
                        HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                        Background="Transparent" Cursor="SizeNorthSouth" />

                <!-- Top Border Resize Handle -->
                <Border Name="ResizeHandleTop" Height="5"
                        HorizontalAlignment="Stretch" VerticalAlignment="Top"
                        Background="Transparent" Cursor="SizeNorthSouth" />

                <!-- Bottom-Left Resize Grip Handle -->
                <Border Name="ResizeHandleBottomLeft" Width="20" Height="20"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Background="Transparent" Cursor="BottomLeftCorner" />

                <!-- Bottom-Right Resize Grip Handle & Visual Indicator -->
                <Border Name="ResizeHandleBottomRight" Width="22" Height="22"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Background="Transparent" Cursor="BottomRightCorner">
                    <materialIcons:MaterialIcon Kind="ResizeBottomRight"
                                                Width="12" Height="12"
                                                Foreground="#475569"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Margin="0,0,3,3" />
                </Border>
            </Panel>
        </Border>

    </Panel>
</UserControl>
