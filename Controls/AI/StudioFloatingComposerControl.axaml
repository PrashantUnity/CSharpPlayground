<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.AI"
             xmlns:ai="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Models.AI"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.AI.StudioFloatingComposerControl"
             x:DataType="vm:AiComposerViewModel"
             IsVisible="{Binding IsVisible}">

    <UserControl.Styles>
        <Style Selector="Border.composer-window">
            <Setter Property="Background" Value="#1E1E26" />
            <Setter Property="BorderBrush" Value="#3B3B4F" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BoxShadow" Value="0 10 30 0 #50000000" />
        </Style>
        <Style Selector="Button.composer-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.composer-btn:pointerover">
            <Setter Property="Background" Value="#323246" />
        </Style>
        <Style Selector="Button.close-btn:pointerover">
            <Setter Property="Background" Value="#DC2626" />
        </Style>
        <Style Selector="Button.close-btn:pointerover materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.action-accept">
            <Setter Property="Background" Value="#166534" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.action-reject">
            <Setter Property="Background" Value="#7F1D1D" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Styles>

    <!-- Overlay Host Container -->
    <Panel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <!-- ======================================================== -->
        <!-- 1. MINIMIZED FLOATING CAPSULE BUTTON (Bottom Right)      -->
        <!-- ======================================================== -->
        <Border IsVisible="{Binding CanShowMinimizedCapsule}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,24"
                Background="#232332" BorderBrush="#38BDF8" BorderThickness="1.5"
                CornerRadius="20" Padding="12,8"
                BoxShadow="0 4 16 0 #60000000">
            <Button Command="{Binding ToggleMinimizeCommand}" Background="Transparent" BorderThickness="0" Padding="0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="AutoFix" Width="16" Height="16" Foreground="#38BDF8" />
                    <TextBlock Text="Fry AI Agent" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    <Border IsVisible="{Binding IsGenerating}"
                            Width="8" Height="8" CornerRadius="4" Background="#22C55E" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Border>

        <!-- ======================================================== -->
        <!-- 2. EXPANDED FLOATING COMPOSER WINDOW                     -->
        <!-- ======================================================== -->
        <Border Name="ComposerContainer"
                IsVisible="{Binding !IsMinimized}"
                Classes="composer-window"
                Opacity="{Binding WindowOpacity}">
            <Panel>
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

                <!-- Header Bar (Draggable Title Rail) -->
                <Border Name="HeaderBar" Grid.Row="0" Height="40" Background="#282838" CornerRadius="9,9,0,0"
                        Padding="12,0,8,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Icon, Title & Agent Mode Switcher Pill -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="AutoFix" Width="15" Height="15" Foreground="#38BDF8" VerticalAlignment="Center" />
                            <TextBlock Text="Composer" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" />

                            <Border Background="#1E1E28" CornerRadius="4" Padding="2" Margin="4,0,0,0">
                                <ToggleButton Content="Agent" IsChecked="{Binding IsAgentMode, Mode=TwoWay}"
                                              FontSize="10.5" Padding="7,2" Height="22" CornerRadius="3"
                                              ToolTip.Tip="Toggle Agent mode (autonomous tools) vs Chat mode" />
                            </Border>
                        </StackPanel>

                        <!-- Draggable rail empty space -->
                        <Border Grid.Column="1" Background="Transparent" />

                        <!-- Action Toolbar & Window Controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                            <!-- Dynamic Actions Injected by Extensions -->
                            <StackPanel Name="DynamicActionsHost" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />

                            <!-- Clear Chat -->
                            <Button Command="{Binding ClearChatCommand}" Classes="composer-btn" ToolTip.Tip="Clear Conversation"
                                    Width="26" Height="26" Padding="0">
                                <materialIcons:MaterialIcon Kind="Broom" Width="14" Height="14" Foreground="#94A3B8" />
                            </Button>

                            <!-- Screen Capture Protection Toggle -->
                            <Button Command="{Binding ToggleCaptureProtectionCommand}" Classes="composer-btn"
                                    ToolTip.Tip="Toggle Screen Capture Protection (Hide window from recording/screenshots)"
                                    Width="26" Height="26" Padding="0">
                                <Panel>
                                    <materialIcons:MaterialIcon Kind="ShieldCheck" Width="14" Height="14" Foreground="#38BDF8"
                                                                IsVisible="{Binding IsProtectedFromCapture}" />
                                    <materialIcons:MaterialIcon Kind="ShieldOutline" Width="14" Height="14" Foreground="#94A3B8"
                                                                IsVisible="{Binding !IsProtectedFromCapture}" />
                                </Panel>
                            </Button>

                            <!-- Vertical Divider -->
                            <Border Width="1" Height="14" Background="#3E3E52" Margin="3,0" />

                            <!-- Docking Controls -->
                            <!-- When Extracted: Re-dock to main window -->
                            <Button Command="{Binding ReDockCommand}" Classes="composer-btn" ToolTip.Tip="Re-dock into Studio"
                                    Width="26" Height="26" Padding="0" IsVisible="{Binding IsExtracted}">
                                <materialIcons:MaterialIcon Kind="DockWindow" Width="14" Height="14" Foreground="#38BDF8" />
                            </Button>

                            <!-- When Docked in SideBar/Bottom: Float as Overlay -->
                            <Button Command="{Binding DockToFloatingCommand}" Classes="composer-btn" ToolTip.Tip="Float as Overlay"
                                    Width="26" Height="26" Padding="0" IsVisible="{Binding CanDockToFloating}">
                                <materialIcons:MaterialIcon Kind="LayersOutline" Width="14" Height="14" Foreground="#38BDF8" />
                            </Button>

                            <!-- When Not Extracted: Extract to OS Window (Screen Tearing) -->
                            <Button Command="{Binding ExtractToWindowCommand}" Classes="composer-btn" ToolTip.Tip="Tear Out into Floating Window"
                                    Width="26" Height="26" Padding="0" IsVisible="{Binding CanExtractToWindow}">
                                <materialIcons:MaterialIcon Kind="OpenInNew" Width="14" Height="14" Foreground="#94A3B8" />
                            </Button>

                            <!-- Dock to SideBar -->
                            <Button Command="{Binding DockToSideBarCommand}" Classes="composer-btn" ToolTip.Tip="Dock into Right Panel (Secondary Side Bar)"
                                    Width="26" Height="26" Padding="0" IsVisible="{Binding CanDockToSideBar}">
                                <materialIcons:MaterialIcon Kind="DockRight" Width="14" Height="14" Foreground="#94A3B8" />
                            </Button>

                            <!-- Dock to Bottom Deck -->
                            <Button Command="{Binding DockToBottomDeckCommand}" Classes="composer-btn" ToolTip.Tip="Dock into Bottom Panel / Deck"
                                    Width="26" Height="26" Padding="0" IsVisible="{Binding CanDockToBottomDeck}">
                                <materialIcons:MaterialIcon Kind="DockBottom" Width="14" Height="14" Foreground="#94A3B8" />
                            </Button>

                            <!-- Vertical Divider -->
                            <Border Width="1" Height="14" Background="#3E3E52" Margin="3,0"
                                    IsVisible="{Binding CanMaximizeAndMinimize}" />

                            <!-- Window Management (Maximize, Minimize, Close) -->
                            <Button Name="MaximizeRestoreButton" Classes="composer-btn" ToolTip.Tip="Maximize / Restore"
                                    Width="26" Height="26" Padding="0" IsVisible="{Binding CanMaximizeAndMinimize}">
                                <materialIcons:MaterialIcon Name="MaximizeIcon" Kind="WindowMaximize" Width="13" Height="13" Foreground="#94A3B8" />
                            </Button>

                            <Button Command="{Binding ToggleMinimizeCommand}" Classes="composer-btn" ToolTip.Tip="Minimize to Pill"
                                    Width="26" Height="26" Padding="0" IsVisible="{Binding CanMaximizeAndMinimize}">
                                <materialIcons:MaterialIcon Kind="Minus" Width="14" Height="14" Foreground="#94A3B8" />
                            </Button>

                            <Button Command="{Binding CloseCommand}" Classes="composer-btn close-btn" ToolTip.Tip="Close (Cmd+I)"
                                    Width="26" Height="26" Padding="0">
                                <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="#94A3B8" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Prompt & Persona Customization Drawer (Row 1) -->
                <Border Grid.Row="1" Background="#1D1D2B" BorderBrush="#38BDF8" BorderThickness="0,0,0,1"
                        Padding="10,8" IsVisible="{Binding IsPromptEditorOpen}">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Tune" Width="13" Height="13" Foreground="#38BDF8" />
                                <TextBlock Text="SYSTEM PROMPT &amp; PERSONA" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" LetterSpacing="0.6" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding TogglePromptEditorCommand}" Classes="composer-btn" Padding="2" ToolTip.Tip="Close prompt editor">
                                <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="#94A3B8" />
                            </Button>
                        </Grid>

                        <!-- Presets Row -->
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="Presets:" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button Command="{Binding SetComposerDefaultPromptCommand}" Classes="composer-btn" Margin="0,1,4,1" Padding="6,2" ToolTip.Tip="Autonomous agent with Roslyn, bash &amp; tools">
                                <TextBlock Text="Agent" FontSize="10" Foreground="#38BDF8" />
                            </Button>
                            <Button Command="{Binding SetComposerConcisePromptCommand}" Classes="composer-btn" Margin="0,1,4,1" Padding="6,2" ToolTip.Tip="Concise code diffs with minimal prose">
                                <TextBlock Text="Concise" FontSize="10" Foreground="#A78BFA" />
                            </Button>
                            <Button Command="{Binding SetComposerReviewerPromptCommand}" Classes="composer-btn" Margin="0,1,4,1" Padding="6,2" ToolTip.Tip="Code review, memory leaks, performance &amp; security">
                                <TextBlock Text="Reviewer" FontSize="10" Foreground="#F59E0B" />
                            </Button>
                            <Button Command="{Binding SetComposerTddPromptCommand}" Classes="composer-btn" Margin="0,1,4,1" Padding="6,2" ToolTip.Tip="Test-driven development, xUnit &amp; edge cases">
                                <TextBlock Text="TDD" FontSize="10" Foreground="#10B981" />
                            </Button>
                        </WrapPanel>

                        <!-- Multi-line Prompt Editor -->
                        <TextBox Text="{Binding CustomSystemPrompt, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="78"
                                 FontFamily="{DynamicResource JetBrainsMonoFontFamily}"
                                 FontSize="11"
                                 Background="#14141E"
                                 Foreground="#F1F5F9"
                                 BorderBrush="#2D2D3D"
                                 BorderThickness="1"
                                 CornerRadius="4"
                                 Padding="6,4" />

                        <!-- Drawer Footer -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding CustomPromptLength, StringFormat='{}{0:N0} characters'}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Button Command="{Binding ResetComposerPromptCommand}" Classes="composer-btn" Padding="6,2" ToolTip.Tip="Reset to Default System Prompt">
                                    <TextBlock Text="Reset" FontSize="10.5" Foreground="#94A3B8" />
                                </Button>
                                <Button Command="{Binding ApplyCustomPromptCommand}" Classes="action-accept" Padding="8,2" ToolTip.Tip="Apply Prompt to Agent">
                                    <TextBlock Text="Apply" FontSize="10.5" FontWeight="SemiBold" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Touched Files Strip (Row 2, Visible when files modified) -->
                <Border Grid.Row="2" Background="#191924" BorderBrush="#2D2D3D" BorderThickness="0,0,0,1"
                        Padding="10,6" IsVisible="{Binding HasModifiedFiles}">
                    <Grid ColumnDefinitions="*,Auto">
                        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding SessionModifiedFiles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="ai:ModifiedFileItem">
                                        <Border Background="#2A2A3C" CornerRadius="4" Padding="6,2" BorderBrush="#38BDF8" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <materialIcons:MaterialIcon Kind="FileCodeOutline" Width="12" Height="12" Foreground="#38BDF8" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding SummaryText}" FontSize="10" Foreground="#22C55E" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Accept All / Reject All Actions -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                            <Button Command="{Binding AcceptAllChangesCommand}" Classes="action-accept" ToolTip.Tip="Accept All Changes (Cmd+Enter)">
                                <TextBlock Text="Accept All" FontWeight="SemiBold" />
                            </Button>
                            <Button Command="{Binding RejectAllChangesCommand}" Classes="action-reject" ToolTip.Tip="Reject All Changes">
                                <TextBlock Text="Reject" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Conversation Messages Scroll Area (Row 3) -->
                <ScrollViewer Name="MessagesScrollViewer" Grid.Row="3"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              Padding="12,8">
                    <StackPanel Spacing="12">
                        <!-- Welcome / Empty Prompt Placeholder -->
                        <Border Background="#242436" CornerRadius="8" Padding="14" Margin="0,8"
                                IsVisible="{Binding !Messages.Count}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="✨ What would you like to build or automate?" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" />
                                <TextBlock Text="Fry AI can explore your workspace, create or edit scripts, fix compiler errors, and customize the studio UI."
                                           FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                    <Border Background="#1E1E28" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="@Files" FontSize="10" Foreground="#38BDF8" />
                                    </Border>
                                    <Border Background="#1E1E28" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="@Problems" FontSize="10" Foreground="#38BDF8" />
                                    </Border>
                                    <Border Background="#1E1E28" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="@Docs" FontSize="10" Foreground="#38BDF8" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Chat Messages List -->
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="ai:ChatMessageItem">
                                    <StackPanel Spacing="6" Margin="0,4">
                                        <!-- User Message Bubble -->
                                        <Border IsVisible="{Binding IsUser}"
                                                Background="#2B2B3F" CornerRadius="8" Padding="10,8"
                                                HorizontalAlignment="Right" MaxWidth="440">
                                            <TextBlock Text="{Binding Content}" FontSize="12" Foreground="#FFFFFF" TextWrapping="Wrap" />
                                        </Border>

                                        <!-- Assistant Message Bubble -->
                                        <StackPanel IsVisible="{Binding IsAssistant}" Spacing="6">
                                            <!-- Steps Accordion (ReAct plan progression) -->
                                            <ItemsControl ItemsSource="{Binding Steps}" IsVisible="{Binding HasSteps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="ai:AgentStepItem">
                                                        <Border Background="#1B1B26" CornerRadius="4" Padding="8,4" Margin="0,2"
                                                                BorderBrush="#2E2E42" BorderThickness="1">
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding StatusIconKind}" Foreground="{Binding StatusColorHex}" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Thinking / Reasoning Accordion (Brain icon & collapsible thoughts) -->
                                            <Border IsVisible="{Binding HasReasoning}"
                                                    Background="#191724" BorderBrush="#382E54" BorderThickness="1"
                                                    CornerRadius="6" Padding="8,5" Margin="0,2,0,2">
                                                <StackPanel Spacing="4">
                                                    <ToggleButton IsChecked="{Binding IsReasoningExpanded, Mode=TwoWay}"
                                                                  Classes="composer-btn"
                                                                  HorizontalAlignment="Left"
                                                                  Padding="4,2">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <materialIcons:MaterialIcon Kind="Brain" Width="13" Height="13" Foreground="#A78BFA" VerticalAlignment="Center" />
                                                            <TextBlock Text="Thinking Process" FontSize="11" FontWeight="SemiBold" Foreground="#A78BFA" VerticalAlignment="Center" />
                                                            <materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <Border IsVisible="{Binding IsReasoningExpanded}" Background="#0F0E17" CornerRadius="4" Padding="8" Margin="0,2,0,0">
                                                        <ScrollViewer MaxHeight="140" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                            <SelectableTextBlock Text="{Binding ReasoningContent}"
                                                                                 FontSize="10.5"
                                                                                 FontStyle="Italic"
                                                                                 Foreground="#CBD5E1"
                                                                                 TextWrapping="Wrap"
                                                                                 FontFamily="Consolas, Menlo, Monaco, monospace" />
                                                        </ScrollViewer>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <!-- Assistant Text Content -->
                                            <Border Background="#212130" CornerRadius="8" Padding="12,10">
                                                <StackPanel Spacing="6">
                                                    <SelectableTextBlock Text="{Binding Content}" FontSize="12" Foreground="#F1F5F9"
                                                                         TextWrapping="Wrap" />

                                                    <!-- Error Notice -->
                                                    <Border IsVisible="{Binding HasError}" Background="#450A0A" CornerRadius="4" Padding="8" Margin="0,4">
                                                        <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="#FCA5A5" TextWrapping="Wrap" />
                                                    </Border>

                                                    <!-- Inline Touched Files & Diff Cards -->
                                                    <ItemsControl ItemsSource="{Binding ModifiedFiles}" IsVisible="{Binding ModifiedFiles.Count}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="ai:ModifiedFileItem">
                                                                <Border Background="#161624" BorderBrush="#2D2D42" BorderThickness="1" CornerRadius="6" Margin="0,4,0,2" Padding="8">
                                                                    <StackPanel Spacing="6">
                                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                                            <materialIcons:MaterialIcon Grid.Column="0" Kind="FileDocumentEditOutline" Width="14" Height="14" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="11.5" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center" />
                                                                            <TextBlock Grid.Column="2" Text="{Binding SummaryText}" FontSize="10.5" Foreground="#4ADE80" VerticalAlignment="Center" Margin="8,0" />
                                                                            <ToggleButton Grid.Column="3" IsChecked="{Binding IsDiffExpanded, Mode=TwoWay}"
                                                                                          Classes="composer-btn" Padding="4,2" Height="22" Width="22">
                                                                                <materialIcons:MaterialIcon Kind="CodeBraces" Width="13" Height="13" Foreground="#94A3B8" />
                                                                            </ToggleButton>
                                                                        </Grid>

                                                                        <!-- Expandable Unified Diff Viewer with Line-by-Line Syntax Highlighting -->
                                                                        <Border IsVisible="{Binding IsDiffExpanded}" Background="#0E0E17" CornerRadius="4" Padding="4,4" BorderBrush="#232336" BorderThickness="1">
                                                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="220">
                                                                                <ItemsControl ItemsSource="{Binding DiffLines}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate x:DataType="ai:DiffLine">
                                                                                            <Border Background="{Binding BackgroundHex}" Padding="8,1" Margin="0,0.5" CornerRadius="2">
                                                                                                <SelectableTextBlock Text="{Binding Text}"
                                                                                                                     FontFamily="Consolas, Menlo, Monaco, monospace"
                                                                                                                     FontSize="10.5"
                                                                                                                     Foreground="{Binding ForegroundHex}" />
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </ScrollViewer>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Status Strip (Row 4) -->
                <Border Grid.Row="4" Background="#1B1B26" Height="22" Padding="12,0" BorderBrush="#2D2D3D" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Width="6" Height="6" CornerRadius="3"
                                    Background="{Binding IsGenerating, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <TextBlock Text="{Binding StatusText}" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Cmd+I: Toggle • Cmd+Enter: Accept" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Bottom Prompt Input Deck (Row 5) -->
                <Border Name="PromptDeckBorder" Grid.Row="5" Background="#242436" CornerRadius="0,0,9,9" Padding="10,8,10,10" BorderBrush="#3B3B4F" BorderThickness="0,1,0,0">
                    <Border Background="#1A1A26" BorderBrush="#3B3B4F" BorderThickness="1" CornerRadius="6" Padding="8,8,8,6">
                        <Grid RowDefinitions="*,Auto">
                            <!-- Multi-line Prompt Text Box -->
                            <TextBox Name="PromptTextBox" Grid.Row="0"
                                     Text="{Binding PromptText, Mode=TwoWay}"
                                     AcceptsReturn="True" MinHeight="38" MaxHeight="120"
                                     Background="Transparent" Foreground="#FFFFFF"
                                     BorderThickness="0"
                                     FontSize="12" Padding="2"
                                     PlaceholderText="Ask Fry AI or describe code changes (@file, /fix)..."
                                     KeyDown="OnPromptTextBoxKeyDown" />

                            <!-- Composer Bottom Toolbar Inside Prompt Box -->
                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,6,0,0">
                                <!-- Left: Model Selector, Refresh & Persona -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <!-- Model Selector Dropdown -->
                                    <ComboBox ItemsSource="{Binding AvailableModels}"
                                              SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                              Height="24" FontSize="11" MinWidth="130" MaxWidth="190" Padding="6,1"
                                              Background="#242434" BorderBrush="#35354A" CornerRadius="4"
                                              ToolTip.Tip="{Binding SelectedModel, StringFormat='Active Model: {0}'}" />

                                    <!-- Refresh Models Button -->
                                    <Button Command="{Binding RefreshModelsCommand}" Classes="composer-btn"
                                            ToolTip.Tip="Refresh Available Models" Width="24" Height="24" Padding="0">
                                        <materialIcons:MaterialIcon Kind="Refresh" Width="12" Height="12" Foreground="#94A3B8" />
                                    </Button>

                                    <!-- Persona Preset Button -->
                                    <Button Command="{Binding TogglePromptEditorCommand}" Classes="composer-btn"
                                            ToolTip.Tip="Customize System Prompt &amp; Persona" Height="24" Padding="6,2"
                                            Background="#242434" CornerRadius="4">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Tune" Width="12" Height="12" Foreground="#38BDF8" />
                                            <TextBlock Text="{Binding ActivePromptPresetName}" FontSize="10.5" Foreground="#38BDF8" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Center: Fast Provider Switchers -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Button Command="{Binding SwitchToLmStudioCommand}" Classes="composer-btn"
                                            ToolTip.Tip="Switch to LM Studio (1234)" Height="22" Padding="5,1"
                                            Background="#1E1E28" CornerRadius="3">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="Laptop" Width="11" Height="11" Foreground="#A78BFA" />
                                            <TextBlock Text="LM" FontSize="9.5" FontWeight="SemiBold" Foreground="#A78BFA" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SwitchToOllamaCommand}" Classes="composer-btn"
                                            ToolTip.Tip="Switch to Ollama (11434)" Height="22" Padding="5,1"
                                            Background="#1E1E28" CornerRadius="3">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="Server" Width="11" Height="11" Foreground="#38BDF8" />
                                            <TextBlock Text="Ollama" FontSize="9.5" FontWeight="SemiBold" Foreground="#38BDF8" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Right: Send / Stop Action Button -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Command="{Binding StopGenerationCommand}" Classes="action-reject" Height="26" Width="26" Padding="0"
                                            IsVisible="{Binding IsGenerating}" ToolTip.Tip="Stop Generation">
                                        <materialIcons:MaterialIcon Kind="Stop" Width="13" Height="13" Foreground="#FFFFFF" />
                                    </Button>
                                    <Button Command="{Binding SendMessageCommand}" Classes="action-accept" Height="26" Width="26" Padding="0"
                                            IsVisible="{Binding !IsGenerating}" ToolTip.Tip="Send Prompt (Enter)">
                                        <materialIcons:MaterialIcon Kind="Send" Width="13" Height="13" Foreground="#FFFFFF" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Border>

                </Grid>

                <!-- ======================================================== -->
                <!-- FLOATING RESIZE HANDLES & CORNER GRIP                    -->
                <!-- ======================================================== -->
                <!-- Left Border Resize Handle -->
                <Border Name="ResizeHandleLeft" Width="8"
                        HorizontalAlignment="Left" VerticalAlignment="Stretch"
                        Background="Transparent" Cursor="SizeWestEast" />

                <!-- Right Border Resize Handle -->
                <Border Name="ResizeHandleRight" Width="8"
                        HorizontalAlignment="Right" VerticalAlignment="Stretch"
                        Background="Transparent" Cursor="SizeWestEast" />

                <!-- Bottom Border Resize Handle -->
                <Border Name="ResizeHandleBottom" Height="8"
                        HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                        Background="Transparent" Cursor="SizeNorthSouth" />

                <!-- Top Border Resize Handle -->
                <Border Name="ResizeHandleTop" Height="5"
                        HorizontalAlignment="Stretch" VerticalAlignment="Top"
                        Background="Transparent" Cursor="SizeNorthSouth" />

                <!-- Bottom-Left Resize Grip Handle -->
                <Border Name="ResizeHandleBottomLeft" Width="20" Height="20"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Background="Transparent" Cursor="BottomLeftCorner" />

                <!-- Bottom-Right Resize Grip Handle & Visual Indicator -->
                <Border Name="ResizeHandleBottomRight" Width="22" Height="22"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Background="Transparent" Cursor="BottomRightCorner">
                    <materialIcons:MaterialIcon Kind="ResizeBottomRight"
                                                Width="12" Height="12"
                                                Foreground="#475569"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Margin="0,0,3,3" />
                </Border>
            </Panel>
        </Border>

    </Panel>
</UserControl>
