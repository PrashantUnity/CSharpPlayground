<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="700"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.KeymapSettingsSectionControl"
             x:DataType="vm:CSharpSettingsViewModel"
             Background="Transparent">

    <UserControl.Styles>
        <StyleInclude Source="avares://CSharpEditorPlugin/Controls/SharedStudioStyles.axaml" />
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="24,18,24,24" MaxWidth="820" HorizontalAlignment="Left">

            <Border Background="{DynamicResource M3SurfaceContainerLowBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18,16">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <materialIcons:MaterialIcon Kind="KeyboardOutline" Width="20" Height="20" Foreground="{DynamicResource M3PrimaryBrush}" />
                        <TextBlock Text="KEYBOARD SHORTCUTS &amp; COMMANDS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" LetterSpacing="0.8" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Standard Visual Studio Code &amp; JetBrains compatible keybindings registered in C# Code Studio." FontSize="12.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />

                    <!-- Shortcuts Table -->
                    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <ItemsControl ItemsSource="{Binding Shortcuts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:KeymapShortcutItem">
                                    <Border BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                                        <Grid ColumnDefinitions="140,200,*">
                                            <!-- Action Name -->
                                            <TextBlock Grid.Column="0" Text="{Binding Action}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />

                                            <!-- Shortcut Key Pill -->
                                            <Border Grid.Column="1" Background="{DynamicResource M3SurfaceContainerHighBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Shortcut}" FontSize="11.5" FontFamily="Consolas,Menlo,monospace" FontWeight="Bold" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            </Border>

                                            <!-- Description -->
                                            <TextBlock Grid.Column="2" Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
