<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             xmlns:views="using:PdfEditorApp.Plugins.CSharpEditor.Views"
             xmlns:services="using:PdfEditorApp.Plugins.CSharpEditor.Services"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="300"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.StudioBottomDeckControl"
             x:CompileBindings="False">


    <UserControl.Styles>
        <StyleInclude Source="avares://CSharpEditorPlugin/Controls/SharedStudioStyles.axaml" />
    </UserControl.Styles>

    <Border MinHeight="100"
            VerticalAlignment="Stretch"
            Background="{DynamicResource M3SurfaceContainerLowBrush}"
            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
            BorderThickness="0,1,0,0">
        <Grid RowDefinitions="Auto,*">
            <!-- Bottom Deck Tab Bar -->
            <Border Grid.Row="0" Background="{DynamicResource M3SurfaceContainerBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <!-- Tab 0: Results (.Dump) -->
                        <Button Command="{Binding SetBottomTabCommand}" CommandParameter="0"
                                Classes="ide-tab-btn"
                                Classes.active="{Binding SelectedBottomTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Table" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                <TextBlock Text="Results (.Dump)" VerticalAlignment="Center" />
                                <Border Classes="ide-tab-badge"
                                        Background="{DynamicResource M3PrimaryBrush}"
                                        IsVisible="{Binding DumpResults.Count}">
                                    <TextBlock Text="{Binding DumpResults.Count}" Foreground="{DynamicResource M3OnPrimaryBrush}" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- Tab 1: Terminal / Console -->
                        <Button Command="{Binding SetBottomTabCommand}" CommandParameter="1"
                                Classes="ide-tab-btn"
                                Classes.active="{Binding SelectedBottomTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=1}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Console" Width="14" Height="14" />
                                <TextBlock Text="Terminal / Console" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Tab 2: Problems -->
                        <Button Command="{Binding SetBottomTabCommand}" CommandParameter="2"
                                Classes="ide-tab-btn"
                                Classes.active="{Binding SelectedBottomTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=2}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="14" Height="14" Foreground="{DynamicResource M3WarningBrush}" />
                                <TextBlock Text="Problems" VerticalAlignment="Center" />
                                <Border Classes="ide-tab-badge"
                                        Background="{DynamicResource M3ErrorBrush}"
                                        IsVisible="{Binding ErrorCount}">
                                    <TextBlock Text="{Binding ErrorCount}" Foreground="{DynamicResource M3OnErrorBrush}" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- Tab 3: Test Cases -->
                        <Button Command="{Binding SetBottomTabCommand}" CommandParameter="3"
                                Classes="ide-tab-btn"
                                IsVisible="{Binding SupportsTestCases}"
                                Classes.active="{Binding SelectedBottomTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=3}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="CheckboxMarkedCircleOutline" Width="14" Height="14" />
                                <TextBlock Text="Test Cases" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Tab 4: Interactive Debugger (REPL) -->
                        <Button Command="{Binding SetBottomTabCommand}" CommandParameter="4"
                                Classes="ide-tab-btn"
                                IsVisible="{Binding SupportsDebugging}"
                                Classes.active="{Binding SelectedBottomTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=4}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="BugOutline" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                <TextBlock Text="Debug Console" VerticalAlignment="Center" />
                                <Border Classes="ide-tab-badge"
                                        Background="{DynamicResource M3WarningBrush}"
                                        Padding="5,0"
                                        IsVisible="{Binding IsPaused}">
                                    <TextBlock Text="PAUSED" FontSize="8.5" Foreground="{DynamicResource M3OnWarningBrush}" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right Actions: Clear, Minimize -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Button Command="{Binding ClearResultsCommand}" Classes="cs-toolbar-icon" ToolTip.Tip="Clear Results">
                            <materialIcons:MaterialIcon Kind="TableRemove" Width="15" Height="15" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                        </Button>
                        <Button Command="{Binding ClearConsoleCommand}" Classes="cs-toolbar-icon" ToolTip.Tip="Clear Console">
                            <materialIcons:MaterialIcon Kind="Eraser" Width="15" Height="15" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                        </Button>
                        <Button Command="{Binding ToggleBottomDeckCommand}" Classes="cs-toolbar-icon" ToolTip.Tip="Minimize Deck (Ctrl+J)">
                            <materialIcons:MaterialIcon Kind="ChevronDown" Width="16" Height="16" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bottom Deck Content -->
            <Carousel Grid.Row="1" SelectedIndex="{Binding SelectedBottomTabIndex}">
                <!-- Tab 0: Results (.Dump) -->
                <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}" Padding="12,10">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <Border IsVisible="{Binding HasNoResults}" Padding="24,30" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="TableLarge" Width="36" Height="36" Foreground="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="No Visual Dumps Yet" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Call .Dump() on any variable, collection, or object to inspect it in a rich interactive table." FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding DumpResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DumpTableResult">
                                        <views:DumpTableView />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- The kinds drawn here are the ones CSharpCodeStudioViewModel.HasNoResults counts; keep them in step. -->
                            <ItemsControl ItemsSource="{Binding RichOutputs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="services:RichCellOutput">
                                        <StackPanel Spacing="0">
                                            <Border IsVisible="{Binding IsImageKind}" Background="#080C11" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,12" HorizontalAlignment="Left">
                                                <Image Source="{Binding DecodedImage}" MaxHeight="450" Stretch="Uniform" HorizontalAlignment="Center" />
                                            </Border>
                                            <Border IsVisible="{Binding IsControlKind}" Background="{DynamicResource M3SurfaceContainerLowBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                                                <ContentControl Content="{Binding InteractiveControl}" HorizontalAlignment="Stretch" />
                                            </Border>
                                            <Border IsVisible="{Binding IsInspectorKind}" Margin="0,0,0,12">
                                                <views:ObjectInspectorView DataContext="{Binding InspectorNode}" />
                                            </Border>
                                            <Border IsVisible="{Binding IsHtmlKind}">
                                                <views:RichHtmlView DataContext="{Binding HtmlContent}" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Tab 1: Terminal / Console Output, and an input line while the running program reads input -->
                <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}" Padding="12,8">
                    <Grid RowDefinitions="*,Auto">
                        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding ConsoleOutput, Mode=OneWay}"
                                     FontFamily="Consolas, Menlo, Monaco, Roboto Mono, monospace" FontSize="12"
                                     Background="Transparent" Foreground="{DynamicResource M3PrimaryBrush}"
                                     BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" />
                        </ScrollViewer>
                        <Border Grid.Row="1" IsVisible="{Binding IsAcceptingProgramInput}"
                                BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,4,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="ChevronRight" Width="14" Height="14"
                                                            Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox Grid.Column="1" Text="{Binding ProgramInputText, Mode=TwoWay}"
                                         controls:FocusOnTrueBehavior.IsActive="{Binding IsAcceptingProgramInput}"
                                         FontFamily="Consolas, Menlo, Monaco, Roboto Mono, monospace" FontSize="12"
                                         PlaceholderText="Type input for the program, then Enter"
                                         Background="Transparent" BorderThickness="0" MinHeight="22">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding SendProgramInputCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <Button Grid.Column="2" Command="{Binding SendProgramInputCommand}" Classes="cs-toolbar-icon" ToolTip.Tip="Send (Enter)">
                                    <materialIcons:MaterialIcon Kind="KeyboardReturn" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Tab 2: Problems / Diagnostics -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,8">
                        <TextBlock Text="No problems detected in script." FontSize="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="10" IsVisible="{Binding !Diagnostics.Count}" />
                        <ItemsControl ItemsSource="{Binding Diagnostics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DiagnosticItemViewModel">
                                    <Border Background="Transparent" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                                        <Button Command="{Binding NavigateCommand}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Cursor="Hand">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding SeverityIconKind}" Foreground="{Binding SeverityColorHex}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Id}" FontWeight="Bold" FontSize="11.5" Foreground="{Binding SeverityColorHex}" />
                                                    <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{DynamicResource M3OnSurfaceBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Command="{Binding QuickFixCommand}" IsVisible="{Binding HasQuickFix}"
                                                        Classes="cs-toolbar-tonal" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <materialIcons:MaterialIcon Kind="PackageDown" Width="13" Height="13" />
                                                        <TextBlock Text="{Binding QuickFixLabel}" FontSize="11" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>
                                                <TextBlock Grid.Column="3" Text="{Binding LocationString}" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </Grid>
                                        </Button>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Tab 3: Test Cases. Each case is a Check("name", answer, "expected") line in the script; every run
                     reads its ✅/❌ line back into the card. -->
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="14,7" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="Test Cases" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TestCasesSummary}" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Command="{Binding GenerateTestCasesCommand}" IsVisible="{Binding CanGenerateTestCases}" Classes="cs-toolbar-tonal"
                                        ToolTip.Tip="Add this problem's examples and edge cases (empty input, duplicates, negatives...), every answer verified">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <materialIcons:MaterialIcon Kind="AutoFix" Width="13" Height="13" Foreground="#EAB308" />
                                        <TextBlock Text="Generate" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RunAllTestCasesCommand}" IsVisible="{Binding HasTestCases}" Classes="cs-toolbar-tonal"
                                        ToolTip.Tip="Run the script once and check every case">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <materialIcons:MaterialIcon Kind="Play" Width="13" Height="13" Foreground="{DynamicResource M3SuccessBrush}" />
                                        <TextBlock Text="Run All" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding AddTestCaseCommand}" Classes="cs-toolbar-tonal" ToolTip.Tip="Check a value of your own">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <materialIcons:MaterialIcon Kind="Plus" Width="13" Height="13" />
                                        <TextBlock Text="Add Test Case" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14,10" Spacing="8">
                            <TextBlock Text="{Binding TestCasesStatus}" IsVisible="{Binding TestCasesStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />

                            <!-- New case: what to check and the answer expected -->
                            <Border IsVisible="{Binding IsAddingTestCase}" Background="{DynamicResource M3SurfaceContainerBrush}"
                                    BorderBrush="{DynamicResource M3PrimaryBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="New test case" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    <Grid ColumnDefinitions="72,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                        <TextBlock Grid.Row="0" Text="Name" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewTestCaseName, Mode=TwoWay}" Classes="sidebar-search-box" />
                                        <TextBlock Grid.Row="1" Text="Check" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewTestCaseCall, Mode=TwoWay}" Classes="sidebar-search-box"
                                                 FontFamily="Consolas, Menlo, Monaco, monospace"
                                                 PlaceholderText="The C# expression to check, e.g. sol.MaxArea(new[] { 1, 1 })" />
                                        <TextBlock Grid.Row="2" Text="Expected" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto">
                                            <TextBox Text="{Binding NewTestCaseExpected, Mode=TwoWay}" Classes="sidebar-search-box"
                                                     FontFamily="Consolas, Menlo, Monaco, monospace"
                                                     PlaceholderText="As LeetCode prints it: 49, true, [0,1], &quot;bab&quot;" />
                                            <CheckBox Grid.Column="1" IsChecked="{Binding NewTestCaseAnyOrder, Mode=TwoWay}" Margin="10,0,0,0"
                                                      ToolTip.Tip="Accept the answer's elements in any order">
                                                <TextBlock Text="Any order" FontSize="11" />
                                            </CheckBox>
                                        </Grid>
                                    </Grid>
                                    <TextBlock Text="{Binding TestCaseFormError}" IsVisible="{Binding TestCaseFormError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               FontSize="11" Foreground="{DynamicResource M3ErrorBrush}" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Adds a Check(...) line to the script; Run or F5 shows whether it passes."
                                                   FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0">
                                            <Button Command="{Binding CancelAddTestCaseCommand}" Classes="cs-toolbar-outlined">
                                                <TextBlock Text="Cancel" FontSize="11" />
                                            </Button>
                                            <Button Command="{Binding ConfirmAddTestCaseCommand}" Classes="cs-toolbar-filled">
                                                <TextBlock Text="Add" FontSize="11" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock IsVisible="{Binding !HasTestCases}" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                       Text="No test cases yet. Add one to check a value your code computes; for a Blind 75 problem, Generate brings in its examples and edge cases." />

                            <ItemsControl ItemsSource="{Binding TestCases}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:TestCaseItem">
                                        <Border Background="{DynamicResource M3SurfaceContainerBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <!-- Passed, failed, running, or not run yet -->
                                                <Panel Grid.Column="0" Width="18" Height="18" VerticalAlignment="Top" Margin="0,0,10,0">
                                                    <materialIcons:MaterialIcon Kind="CheckCircle" Foreground="#22C55E" IsVisible="{Binding IsPassed}" ToolTip.Tip="Passed" />
                                                    <materialIcons:MaterialIcon Kind="CloseCircle" Foreground="#EF4444" IsVisible="{Binding IsFailed}" ToolTip.Tip="Failed" />
                                                    <materialIcons:MaterialIcon Kind="TimerSand" Foreground="{DynamicResource M3PrimaryBrush}" IsVisible="{Binding IsRunning}" ToolTip.Tip="Running" />
                                                    <materialIcons:MaterialIcon Kind="CircleOutline" Foreground="{DynamicResource M3OutlineBrush}" IsVisible="{Binding IsNotRun}" ToolTip.Tip="Not run yet" />
                                                </Panel>
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                    <TextBlock Text="{Binding Input, StringFormat='{}Input: {0}'}" FontSize="11" Foreground="{DynamicResource M3OnSurfaceBrush}" TextWrapping="Wrap"
                                                               IsVisible="{Binding Input, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                    <TextBlock Text="{Binding Call, StringFormat='{}Checks: {0}'}" FontSize="11" FontFamily="Consolas, Menlo, Monaco, monospace" Foreground="{DynamicResource M3OnSurfaceBrush}" TextWrapping="Wrap"
                                                               IsVisible="{Binding ShowsCall}" />
                                                    <TextBlock Text="{Binding ExpectedOutput, StringFormat='{}Expected: {0}'}" FontSize="11" FontFamily="Consolas, Menlo, Monaco, monospace" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap"
                                                               IsVisible="{Binding ExpectedOutput, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                    <TextBlock Text="{Binding ActualOutput, StringFormat='{}Output: {0}'}" FontSize="11" FontFamily="Consolas, Menlo, Monaco, monospace" Foreground="#22C55E" TextWrapping="Wrap"
                                                               IsVisible="{Binding IsPassed}" />
                                                    <TextBlock Text="{Binding ActualOutput, StringFormat='{}Output: {0}'}" FontSize="11" FontFamily="Consolas, Menlo, Monaco, monospace" Foreground="#EF4444" TextWrapping="Wrap"
                                                               IsVisible="{Binding IsFailed}" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Command="{Binding $parent[UserControl].DataContext.DeleteTestCaseCommand}" CommandParameter="{Binding}" Classes="cs-toolbar-icon"
                                                        VerticalAlignment="Top" Margin="8,0,0,0" ToolTip.Tip="Remove this case (and the Check line the panel added for it)">
                                                    <materialIcons:MaterialIcon Kind="DeleteOutline" Width="15" Height="15" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <!-- Tab 4: Debug Console & Immediate REPL -->
                <Grid ColumnDefinitions="*,4,*">
                    <!-- Left: Locals Inspection -->
                    <Border Grid.Column="0" Padding="10,8" Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="0,0,1,0">
                        <Grid RowDefinitions="Auto,*">
                            <!-- Same 20px header row as the REPL pane, so both titles sit on one line. -->
                            <Grid Grid.Row="0" MinHeight="20" Margin="0,0,0,4">
                                <TextBlock Text="LOCAL VARIABLES" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Row="1" IsVisible="{Binding !Locals.Count}"
                                       Text="Start debugging (F5) and stop at a breakpoint to see the local variables here."
                                       FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Locals}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:DebugVariableItem">
                                            <Border Background="{DynamicResource M3SurfaceContainerBrush}" CornerRadius="4" Padding="6,3" Margin="0,0,0,3">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource M3PrimaryBrush}" Margin="0,0,6,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding TypeName}" FontSize="9.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,0,6,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding ValueDisplay}" FontFamily="Consolas, monospace" FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Classes="studio-sash" Width="4" ResizeDirection="Columns" />

                    <!-- Right: Immediate REPL Console -->
                    <Border Grid.Column="2" Padding="10,8" Background="{DynamicResource M3SurfaceContainerLowestBrush}">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                <TextBlock Grid.Column="0" Text="IMMEDIATE REPL CONSOLE" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding ClearImmediateCommand}" Classes="cs-toolbar-icon" Width="20" Height="20">
                                    <materialIcons:MaterialIcon Kind="Eraser" Width="12" Height="12" />
                                </Button>
                            </Grid>

                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ImmediateOutput}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas, monospace" FontSize="10.5" Foreground="{DynamicResource M3PrimaryBrush}" TextWrapping="Wrap" Margin="0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <TextBox Grid.Column="0" Text="{Binding ImmediateInputText, Mode=TwoWay}"
                                         FontFamily="Consolas, monospace" FontSize="11"
                                         Classes="sidebar-search-box" PlaceholderText="> Evaluate C# expression...">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding EvaluateImmediateCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <Button Grid.Column="1" Command="{Binding EvaluateImmediateCommand}" Classes="cs-toolbar-tonal" Height="28" MinHeight="0" Margin="4,0,0,0">
                                    <TextBlock Text="Eval" FontSize="10" FontWeight="Bold" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

            </Carousel>
        </Grid>
    </Border>
</UserControl>
