<UserControl xmlns:lt="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Extensibility.Theming.Layout;assembly=CSharpEditorPlugin" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:blindProblems="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.BlindProblems"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="54"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.BlindProblems.BlindProblemsStatsControl"
             x:DataType="blindProblems:CSharpBlindProblemsViewModel">

    <Border Background="{DynamicResource DsSurfaceBrush}"
            BorderBrush="{DynamicResource DsBorderBrush}"
            lt:Tokens.BorderThickness="DsBorderBottom"
            Padding="16,8">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
            <!-- 1. Progress Summary Text -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" lt:Tokens.Spacing="DsSpace10" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="18" Height="18" Foreground="{DynamicResource BadgeEasyFgBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ProgressSummaryText}"
                           lt:Tokens.FontSize="DsFontSize350" lt:Tokens.FontWeight="DsWeightStrong"
                           Foreground="{DynamicResource DsTextWhiteBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- 2. Breakdown Badges -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="24,0,0,0">
                <!-- Easy -->
                <Border Background="{DynamicResource BadgeEasyBgBrush}" BorderBrush="{DynamicResource BadgeEasyBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin"
                        Height="20" MinHeight="20" lt:Tokens.CornerRadius="DsRadiusXL" Padding="8,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Easy:" lt:Tokens.FontSize="DsFontSize150" Foreground="{DynamicResource BadgeEasyFgBrush}" lt:Tokens.FontWeight="DsWeightStrong" VerticalAlignment="Center" Margin="0,1,0,0" />
                        <TextBlock Text="{Binding EasySummaryText}" lt:Tokens.FontSize="DsFontSize150" Foreground="{DynamicResource BadgeEasyFgBrush}" VerticalAlignment="Center" Margin="0,1,0,0" />
                    </StackPanel>
                </Border>

                <!-- Medium -->
                <Border Background="{DynamicResource BadgeMediumBgBrush}" BorderBrush="{DynamicResource BadgeMediumBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin"
                        Height="20" MinHeight="20" lt:Tokens.CornerRadius="DsRadiusXL" Padding="8,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Med:" lt:Tokens.FontSize="DsFontSize150" Foreground="{DynamicResource BadgeMediumFgBrush}" lt:Tokens.FontWeight="DsWeightStrong" VerticalAlignment="Center" Margin="0,1,0,0" />
                        <TextBlock Text="{Binding MediumSummaryText}" lt:Tokens.FontSize="DsFontSize150" Foreground="{DynamicResource BadgeMediumFgBrush}" VerticalAlignment="Center" Margin="0,1,0,0" />
                    </StackPanel>
                </Border>

                <!-- Hard -->
                <Border Background="{DynamicResource BadgeHardBgBrush}" BorderBrush="{DynamicResource BadgeHardBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin"
                        Height="20" MinHeight="20" lt:Tokens.CornerRadius="DsRadiusXL" Padding="8,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Hard:" lt:Tokens.FontSize="DsFontSize150" Foreground="{DynamicResource BadgeHardFgBrush}" lt:Tokens.FontWeight="DsWeightStrong" VerticalAlignment="Center" Margin="0,1,0,0" />
                        <TextBlock Text="{Binding HardSummaryText}" lt:Tokens.FontSize="DsFontSize150" Foreground="{DynamicResource BadgeHardFgBrush}" VerticalAlignment="Center" Margin="0,1,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 3. Mini Progress Bar -->
            <ProgressBar Grid.Column="2"
                         Minimum="0" Maximum="100"
                         Value="{Binding ProgressPercentage}"
                         Height="5"
                         CornerRadius="2.5"
                         Foreground="{DynamicResource BadgeEasyFgBrush}"
                         Background="{DynamicResource DsSurfaceHighBrush}"
                         VerticalAlignment="Center"
                         Margin="24,0" />

            <!-- 4. Status filter: All, Solved, Unsolved, Saved (bookmarked) -->
            <Border Grid.Column="3" Classes="segmented">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="segment" Classes.selected="{Binding IsStatusAll}"
                            Command="{Binding SetStatusFilterCommand}" CommandParameter="All">
                        <TextBlock Text="All" />
                    </Button>
                    <Button Classes="segment" Classes.selected="{Binding IsStatusSolved}"
                            Command="{Binding SetStatusFilterCommand}" CommandParameter="Solved">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <materialIcons:MaterialIcon Kind="Check" Width="13" Height="13" Foreground="{DynamicResource BadgeEasyFgBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Solved" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="segment" Classes.selected="{Binding IsStatusUnsolved}"
                            Command="{Binding SetStatusFilterCommand}" CommandParameter="Unsolved">
                        <TextBlock Text="Unsolved" />
                    </Button>
                    <Button Classes="segment" Classes.selected="{Binding IsStatusBookmarked}"
                            Command="{Binding SetStatusFilterCommand}" CommandParameter="Bookmarked"
                            ToolTip.Tip="Problems you saved for later">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <materialIcons:MaterialIcon Kind="Bookmark" Width="13" Height="13" Foreground="{DynamicResource BadgeMediumFgBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Saved" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
