<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             mc:Ignorable="d"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.HubWelcomeSectionControl"
             x:DataType="vm:CSharpManagerViewModel">
    <UserControl.Styles>
        <Style Selector="StackPanel.hub-welcome-actions">
            <Setter Property="Grid.Column" Value="2" />
        </Style>
        <Style Selector="Border.compact StackPanel.hub-welcome-actions">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
    </UserControl.Styles>

                            <!-- ============================================================ -->
                            <!-- SECTION 1: WELCOME & QUICK ACTIONS                           -->
                            <!-- ============================================================ -->
                            <!-- Title and buttons side by side, or (compact, when they'd overlap) the buttons on a second row. -->
                            <Border controls:CompactWhenCrowded.IsEnabled="True">
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,24,0">
                                    <TextBlock Text="Welcome back, Developer" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                    <TextBlock Text="Pick up where you left off, open an existing project, or start a new workspace." FontSize="13" Foreground="{DynamicResource DsMutedBrush}" />
                                </StackPanel>

                                <StackPanel Classes="hub-welcome-actions" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <!-- Blind 75 Challenge -->
                                    <Button Command="{Binding NavigateToBlindProblemsCommand}"
                                            Classes="nexus-btn-surface"
                                            ToolTip.Tip="Practice top 75 coding interview questions with interactive C# 10 execution">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="TrophyOutline" Width="16" Height="16" Foreground="#E3B341" VerticalAlignment="Center" />
                                            <TextBlock Text="Blind 75" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- New Notebook (Primary Blue) -->
                                    <Button Command="{Binding CreateNewNotebookCommand}"
                                            Classes="nexus-btn-primary"
                                            ToolTip.Tip="Create an interactive cell notebook">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="New Notebook" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- New Script (Surface Button) -->
                                    <Button Command="{Binding CreateNewScriptCommand}"
                                            Classes="nexus-btn-surface"
                                            ToolTip.Tip="Create a new C# automation script">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="FileCodeOutline" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="New Script" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Open Project / Document (Surface Dropdown) -->
                                    <Button Name="OpenProjectButton"
                                            Classes="nexus-btn-surface"
                                            ToolTip.Tip="Open existing project, file, or folder from disk (Ctrl+O / ⌘O)">
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuItem Header="Open Project / Document File..." Click="OnOpenProjectFileClick">
                                                    <MenuItem.Icon>
                                                        <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="16" Height="16" Foreground="{DynamicResource DsPrimaryBrush}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Open Project Folder..." Click="OnOpenProjectFolderClick">
                                                    <MenuItem.Icon>
                                                        <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" Foreground="#E3B341" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" Foreground="#E3B341" VerticalAlignment="Center" />
                                            <TextBlock Text="Open..." VerticalAlignment="Center" />
                                            <materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            </Border>
</UserControl>
