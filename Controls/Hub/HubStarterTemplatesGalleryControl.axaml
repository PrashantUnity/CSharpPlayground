<UserControl xmlns:lt="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Extensibility.Theming.Layout;assembly=CSharpEditorPlugin" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             xmlns:hub="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.Hub"
             xmlns:common="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Common"
             mc:Ignorable="d"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.Hub.HubStarterTemplatesGalleryControl"
             x:DataType="hub:CSharpManagerViewModel">

    <UserControl.Resources>
        <!-- Template Card in Nexus Style with Direct Action Button & Double Click -->
        <DataTemplate x:Key="TemplateCardTemplate" x:DataType="models:CodeTemplate">
            <Button Command="{Binding $parent[UserControl].((hub:CSharpManagerViewModel)DataContext).SelectTemplateCommand}"
                    CommandParameter="{Binding}"
                    Classes="nexus-card-btn"
                    Margin="0,0,16,16">
                <Border Width="252" Height="158"
                        Classes="nexus-glass-card"
                        Classes.selected="{Binding IsSelected}"
                        DoubleTapped="OnCardDoubleTapped">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <!-- Top: Icon badge + Kind label -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Width="36" Height="36"
                                    lt:Tokens.CornerRadius="DsRadiusLG"
                                    Background="{DynamicResource DsPrimarySubtleBrush}"
                                    BorderBrush="{DynamicResource DsPrimaryBorderSubtleBrush}"
                                    lt:Tokens.BorderThickness="DsBorderThin">
                                <materialIcons:MaterialIcon Kind="{Binding IconKind}"
                                                            Width="18" Height="18"
                                                            Foreground="{DynamicResource DsPrimaryBrush}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <Border Grid.Column="2" Background="{DynamicResource DsBgBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin"
                                    Height="18" MinHeight="18" lt:Tokens.CornerRadius="DsRadiusSM" Padding="6,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding KindBadgeText}" lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightEmphasis"
                                           Foreground="{DynamicResource DsMutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0,1,0,0" />
                            </Border>
                        </Grid>

                        <!-- Body: Title & Description -->
                        <StackPanel Grid.Row="1" Spacing="4" Margin="0,10,0,0">
                            <TextBlock Text="{Binding Title}"
                                       lt:Tokens.FontWeight="DsWeightEmphasis" lt:Tokens.FontSize="DsFontSize400"
                                       Foreground="{DynamicResource DsTextWhiteBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Title}" />
                            <TextBlock Text="{Binding Description}"
                                       lt:Tokens.FontSize="DsFontSize250"
                                       Foreground="{DynamicResource DsMutedBrush}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="2"
                                       ToolTip.Tip="{Binding Description}" />
                        </StackPanel>

                        <!-- Footer: Tags on Left + Direct "Use" Action Button on Right -->
                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,8,0,0" VerticalAlignment="Center">
                            <!-- Tags -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ClipToBounds="True">
                                <ItemsControl ItemsSource="{Binding VisibleTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="nexus-tag-pill">
                                                <TextBlock Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Classes="nexus-tag-pill overflow" IsVisible="{Binding HasOverflowTags}">
                                    <TextBlock Text="{Binding OverflowTagLabel}" />
                                </Border>
                            </StackPanel>

                            <!-- Direct "Use" Action Button -->
                            <Button Grid.Column="1"
                                    Command="{Binding $parent[UserControl].((hub:CSharpManagerViewModel)DataContext).LaunchTemplateCommand}"
                                    CommandParameter="{Binding}"
                                    Classes="nexus-card-use-btn"
                                    ToolTip.Tip="Launch template now (or double-click card)">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Use" lt:Tokens.FontWeight="DsWeightEmphasis" lt:Tokens.FontSize="DsFontSize200" />
                                    <materialIcons:MaterialIcon Kind="ArrowRight" Width="12" Height="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel lt:Tokens.Spacing="DsSpace16">
        <!-- Header: Title, Category Filter Chips & Search -->
        <Border common:CompactWhenCrowded.IsEnabled="True">
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
                    <materialIcons:MaterialIcon Kind="LightningBoltOutline" Width="16" Height="16" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="STARTER TEMPLATES" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Category Filter Chips -->
                <StackPanel Classes="hub-filter-chips" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- All -->
                    <Button Command="{Binding SetSelectedTemplateCategoryCommand}" CommandParameter="All"
                            Classes="nexus-filter-chip"
                            Classes.active="{Binding IsAllTemplateCategoryActive}">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="All" />
                            <TextBlock Text="{Binding StarterTemplates.Count}" lt:Tokens.FontSize="DsFontSize100" Opacity="0.7" />
                        </StackPanel>
                    </Button>

                    <!-- Algorithms -->
                    <Button Command="{Binding SetSelectedTemplateCategoryCommand}" CommandParameter="Algorithms"
                            Classes="nexus-filter-chip"
                            Classes.active="{Binding IsAlgorithmsTemplateCategoryActive}">
                        <TextBlock Text="Algorithms" />
                    </Button>

                    <!-- Visualizers -->
                    <Button Command="{Binding SetSelectedTemplateCategoryCommand}" CommandParameter="Visualizers"
                            Classes="nexus-filter-chip"
                            Classes.active="{Binding IsVisualizersTemplateCategoryActive}">
                        <TextBlock Text="Visualizers" />
                    </Button>

                    <!-- Data Structures -->
                    <Button Command="{Binding SetSelectedTemplateCategoryCommand}" CommandParameter="Data Structures"
                            Classes="nexus-filter-chip"
                            Classes.active="{Binding IsDataStructuresTemplateCategoryActive}">
                        <TextBlock Text="Data Structures" />
                    </Button>

                    <!-- Notebooks -->
                    <Button Command="{Binding SetSelectedTemplateCategoryCommand}" CommandParameter="Notebooks"
                            Classes="nexus-filter-chip"
                            Classes.active="{Binding IsNotebooksTemplateCategoryActive}">
                        <TextBlock Text="Notebooks" />
                    </Button>

                    <!-- Scripts -->
                    <Button Command="{Binding SetSelectedTemplateCategoryCommand}" CommandParameter="Scripts"
                            Classes="nexus-filter-chip"
                            Classes.active="{Binding IsScriptsTemplateCategoryActive}">
                        <TextBlock Text="Scripts" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Inline Search & Filter Bar for Templates -->
        <Border Background="{DynamicResource DsSurfaceBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin"
                lt:Tokens.CornerRadius="DsRadiusLG" Height="36" Padding="10,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <materialIcons:MaterialIcon Grid.Column="0" Kind="Magnify" Width="16" Height="16" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" Text="{Binding SearchQuery, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         MinHeight="0" lt:Tokens.Height="DsControlHeight150" Padding="0"
                         lt:Tokens.FontSize="DsFontSize350" Foreground="{DynamicResource DsTextWhiteBrush}"
                         VerticalAlignment="Center" VerticalContentAlignment="Center"
                         PlaceholderText="Filter templates by title, description, or tags..." />
                <Button Grid.Column="2" Command="{Binding ClearSearchCommand}"
                        IsVisible="{Binding HasSearchQuery}"
                        Classes="nexus-btn-ghost" Width="24" Height="24" Padding="0" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="15" Height="15" Foreground="{DynamicResource DsMutedBrush}" />
                </Button>
            </Grid>
        </Border>

        <!-- Empty State When No Templates Match Filter -->
        <Border IsVisible="{Binding !HasMatchingTemplates}"
                Background="{DynamicResource DsSurfaceBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsCardBorder"
                lt:Tokens.CornerRadius="DsRadius2XL" Padding="32,40" lt:Tokens.BoxShadow="DsCardShadow">
            <StackPanel HorizontalAlignment="Center" lt:Tokens.Spacing="DsSpace12">
                <Border Width="48" Height="48" lt:Tokens.CornerRadius="DsRadius4XL" Background="{DynamicResource DsSurfaceHoverBrush}" HorizontalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="LightningBoltOutline" Width="24" Height="24" Foreground="{DynamicResource DsMutedBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="No starter templates found" lt:Tokens.FontSize="DsFontSize600" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="No templates match your current filter or search criteria." lt:Tokens.FontSize="DsFontSize300" Foreground="{DynamicResource DsMutedBrush}" HorizontalAlignment="Center" />
                <Button Command="{Binding ResetTemplateFiltersCommand}" Classes="nexus-btn-surface" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <TextBlock Text="Reset Template Filters" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Templates Content Lists -->
        <StackPanel lt:Tokens.Spacing="DsSpace24" IsVisible="{Binding HasMatchingTemplates}">
            <!-- Script Templates Group -->
            <StackPanel lt:Tokens.Spacing="DsSpace12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="C# Automation Scripts" lt:Tokens.FontSize="DsFontSize500" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" />
                    <TextBlock Text="— runs top to bottom" lt:Tokens.FontSize="DsFontSize300" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding ScriptTemplates}" ItemTemplate="{StaticResource TemplateCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <!-- Notebook Templates Group -->
            <StackPanel lt:Tokens.Spacing="DsSpace12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Interactive C# Notebooks" lt:Tokens.FontSize="DsFontSize500" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" />
                    <TextBlock Text="— multi-cell interactive exploration" lt:Tokens.FontSize="DsFontSize300" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding NotebookTemplates}" ItemTemplate="{StaticResource TemplateCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
