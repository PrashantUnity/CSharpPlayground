<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13</LangVersion>
    <AssemblyName>FrySharp</AssemblyName>
    <RootNamespace>PdfEditorApp.Plugins.CSharpEditor.Runner</RootNamespace>
    <PackageId>CodeFryDev.FrySharp</PackageId>
    <Product>FrySharp</Product>
    <Title>FrySharp - C# Code Studio</Title>
    <Version>1.0.1</Version>
    <Company>Code Fry Dev</Company>
    <Copyright>Copyright © 2026 Code Fry Dev</Copyright>
    <Description>Interactive C# Development Studio and Script Automation Workspace</Description>
    <ApplicationIcon>Assets/app-logo.ico</ApplicationIcon>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSharpEditorPlugin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local copies of M3 Expressive tokens and styles (no longer depends on FryPdf.Runner.Shared) -->
    <AvaloniaResource Include="Material3ExpressiveTokens.axaml" />
    <AvaloniaResource Include="Material3ExpressiveStyles.axaml" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="FryPdf.PluginSdk" Version="0.1.0" />
  </ItemGroup>
</Project>
