<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

    <!-- =================================================================== -->
    <!-- Google Material Design 3 Expressive (M3 Expressive) Component Suite -->
    <!-- =================================================================== -->

    <Styles.Resources>
        <!-- M3 Expressive Compact RepeatButton for ButtonSpinner -->
        <ControlTheme x:Key="M3ButtonSpinnerRepeatButton" TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerSmall}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Padding="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_ButtonBorder">
                <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighestBrush}" />
            </Style>
            <Style Selector="^:pressed /template/ Border#PART_ButtonBorder">
                <Setter Property="Background" Value="{DynamicResource M3PrimaryContainerBrush}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.35" />
            </Style>
        </ControlTheme>

        <!-- M3 Expressive ButtonSpinner ControlTheme (Compact Vertical Chevrons) -->
        <ControlTheme x:Key="{x:Type ButtonSpinner}" TargetType="ButtonSpinner">
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowestBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerMedium}" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <DataValidationErrors>
                        <Border Name="PART_SpinnerBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                MinHeight="{TemplateBinding MinHeight}"
                                ClipToBounds="True">
                            <DockPanel>
                                <!-- Vertical Chevrons Spinner Container (Fixed 18px compact width) -->
                                <Border Name="PART_SpinnerContainer"
                                        DockPanel.Dock="Right"
                                        Width="18"
                                        Margin="0,1,2,1"
                                        IsVisible="{TemplateBinding ShowButtonSpinner}">
                                    <Grid RowDefinitions="*,*">
                                        <RepeatButton Name="PART_IncreaseButton"
                                                      Grid.Row="0"
                                                      Theme="{StaticResource M3ButtonSpinnerRepeatButton}"
                                                      IsTabStop="False"
                                                      Focusable="False"
                                                      ToolTip.Tip="Increase">
                                            <Path Data="M 1 4.5 L 4.5 1 L 8 4.5"
                                                  Stroke="{DynamicResource M3OnSurfaceVariantBrush}"
                                                  StrokeThickness="1.4"
                                                  StrokeLineCap="Round"
                                                  StrokeJoin="Round"
                                                  Width="9" Height="5.5"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </RepeatButton>
                                        <RepeatButton Name="PART_DecreaseButton"
                                                      Grid.Row="1"
                                                      Theme="{StaticResource M3ButtonSpinnerRepeatButton}"
                                                      IsTabStop="False"
                                                      Focusable="False"
                                                      ToolTip.Tip="Decrease">
                                            <Path Data="M 1 1 L 4.5 4.5 L 8 1"
                                                  Stroke="{DynamicResource M3OnSurfaceVariantBrush}"
                                                  StrokeThickness="1.4"
                                                  StrokeLineCap="Round"
                                                  StrokeJoin="Round"
                                                  Width="9" Height="5.5"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </RepeatButton>
                                    </Grid>
                                </Border>

                                <ContentPresenter Name="PART_ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Padding="{TemplateBinding Padding}" />
                            </DockPanel>
                        </Border>
                    </DataValidationErrors>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:left /template/ Border#PART_SpinnerContainer">
                <Setter Property="DockPanel.Dock" Value="Left" />
                <Setter Property="Margin" Value="2,1,0,1" />
            </Style>
            <Style Selector="^:pointerover /template/ Border#PART_SpinnerBorder">
                <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineBrush}" />
            </Style>
            <Style Selector="^:focus-within /template/ Border#PART_SpinnerBorder">
                <Setter Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}" />
            </Style>
        </ControlTheme>

        <!-- M3 Expressive NumericUpDown ControlTheme -->
        <ControlTheme x:Key="{x:Type NumericUpDown}" TargetType="NumericUpDown">
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowestBrush}" />
            <Setter Property="PlaceholderForeground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="7,0,2,0" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerMedium}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Template">
                <ControlTemplate>
                    <DataValidationErrors>
                        <ButtonSpinner Name="PART_Spinner"
                                       Background="{TemplateBinding Background}"
                                       BorderThickness="{TemplateBinding BorderThickness}"
                                       BorderBrush="{TemplateBinding BorderBrush}"
                                       CornerRadius="{TemplateBinding CornerRadius}"
                                       IsTabStop="False"
                                       Padding="0"
                                       MinWidth="0"
                                       HorizontalContentAlignment="Stretch"
                                       VerticalContentAlignment="Stretch"
                                       AllowSpin="{TemplateBinding AllowSpin}"
                                       ShowButtonSpinner="{TemplateBinding ShowButtonSpinner}"
                                       ButtonSpinnerLocation="{TemplateBinding ButtonSpinnerLocation}">
                            <TextBox Name="PART_TextBox"
                                     Background="Transparent"
                                     BorderBrush="Transparent"
                                     BorderThickness="0"
                                     Margin="0"
                                     Padding="{TemplateBinding Padding}"
                                     MinWidth="0"
                                     Foreground="{TemplateBinding Foreground}"
                                     PlaceholderText="{TemplateBinding PlaceholderText}"
                                     PlaceholderForeground="{TemplateBinding PlaceholderForeground}"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                     HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                     Text="{TemplateBinding Text}"
                                     TextAlignment="{TemplateBinding TextAlignment}"
                                     AcceptsReturn="False"
                                     TextWrapping="NoWrap"
                                     FontSize="{TemplateBinding FontSize}"
                                     FontWeight="{TemplateBinding FontWeight}"
                                     CornerRadius="0"
                                     InnerLeftContent="{Binding InnerLeftContent, RelativeSource={RelativeSource TemplatedParent}}"
                                     InnerRightContent="{Binding InnerRightContent, RelativeSource={RelativeSource TemplatedParent}}" />
                        </ButtonSpinner>
                    </DataValidationErrors>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineBrush}" />
            </Style>
            <Style Selector="^:focus-within">
                <Setter Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}" />
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <!-- Global Application Typography -->
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource M3FontFamily}" />
    </Style>

    <!-- M3 NumericUpDown Embedded TextBox & Border Seamless Integration -->
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="SelectionBrush" Value="{DynamicResource M3PrimaryBrush}" />
    </Style>
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- =================================================================== -->
    <!-- 1. BUTTONS SUITE (M3 Expressive Pill & Tactile Hierarchy)           -->
    <!-- =================================================================== -->

    <!-- M3 Filled Button (High Emphasis) -->
    <Style Selector="Button.m3-filled-btn">
        <Setter Property="Background" Value="{DynamicResource M3PrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerFull}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.m3-filled-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource WinAccentHoverBrush}" />
        <Setter Property="RenderTransform" Value="scale(1.02)" />
    </Style>
    <Style Selector="Button.m3-filled-btn:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>

    <!-- M3 Filled Tonal Button (Medium Emphasis) -->
    <Style Selector="Button.m3-tonal-btn">
        <Setter Property="Background" Value="{DynamicResource M3SecondaryContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSecondaryContainerBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerFull}" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.m3-tonal-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighestBrush}" />
        <Setter Property="RenderTransform" Value="scale(1.015)" />
    </Style>
    <Style Selector="Button.m3-tonal-btn:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>

    <!-- M3 Elevated Button -->
    <Style Selector="Button.m3-elevated-btn">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource M3PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerFull}" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.m3-elevated-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        <Setter Property="RenderTransform" Value="scale(1.02)" />
    </Style>
    <Style Selector="Button.m3-elevated-btn:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>

    <!-- M3 Outlined Button -->
    <Style Selector="Button.m3-outlined-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource M3PrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerFull}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.m3-outlined-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}" />
    </Style>
    <Style Selector="Button.m3-outlined-btn:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>

    <!-- M3 Text Button -->
    <Style Selector="Button.m3-text-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource M3PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerMedium}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.m3-text-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowBrush}" />
    </Style>

    <!-- M3 Header Interactive Item (Brand & Document Title) -->
    <Style Selector="Button.m3-header-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerMedium}" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.m3-header-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        <Setter Property="RenderTransform" Value="scale(1.015)" />
    </Style>
    <Style Selector="Button.m3-header-btn:pressed">
        <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>

    <!-- M3 Floating Action Button (Standard FAB) -->
    <Style Selector="Button.m3-fab">
        <Setter Property="Background" Value="{DynamicResource M3PrimaryContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnPrimaryContainerBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerLarge}" />
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.m3-fab:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.04)" />
    </Style>
    <Style Selector="Button.m3-fab:pressed">
        <Setter Property="RenderTransform" Value="scale(0.95)" />
    </Style>

    <!-- M3 Extended FAB -->
    <Style Selector="Button.m3-fab-extended">
        <Setter Property="Background" Value="{DynamicResource M3PrimaryContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnPrimaryContainerBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerFull}" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.m3-fab-extended:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.03)" />
    </Style>
    <Style Selector="Button.m3-fab-extended:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>

    <!-- M3 Circular Icon Button -->
    <Style Selector="Button.m3-icon-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerFull}" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.m3-icon-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        <Setter Property="RenderTransform" Value="scale(1.06)" />
    </Style>
    <Style Selector="Button.m3-icon-btn:pressed">
        <Setter Property="RenderTransform" Value="scale(0.93)" />
    </Style>
    <Style Selector="Button.m3-icon-btn.active">
        <Setter Property="Background" Value="{DynamicResource M3SecondaryContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSecondaryContainerBrush}" />
    </Style>

    <!-- =================================================================== -->
    <!-- 2. SEGMENTED BUTTONS & CAPSULES                                     -->
    <!-- =================================================================== -->

    <!-- M3 Segmented Capsule Container -->
    <Style Selector="Border.m3-segmented-container">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerFull}" />
        <Setter Property="Padding" Value="3" />
    </Style>

    <!-- M3 Segment Button Item -->
    <Style Selector="Button.m3-segment-btn, RadioButton.m3-segment-btn, ToggleButton.m3-segment-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerFull}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="Foreground" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.m3-segment-btn:pointerover, RadioButton.m3-segment-btn:pointerover, ToggleButton.m3-segment-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
    </Style>
    <Style Selector="Button.m3-segment-btn.active, RadioButton.m3-segment-btn:checked, ToggleButton.m3-segment-btn:checked">
        <Setter Property="Background" Value="{DynamicResource M3SecondaryContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSecondaryContainerBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- =================================================================== -->
    <!-- 3. CHIPS SUITE (M3 Filter, Assist, Suggestion)                      -->
    <!-- =================================================================== -->
    <Style Selector="Button.m3-chip, Button.m3-filter-chip, ToggleButton.m3-chip, ToggleButton.m3-filter-chip">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerSmall}" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Height" Value="30" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.m3-chip:pointerover, Button.m3-filter-chip:pointerover, ToggleButton.m3-chip:pointerover, ToggleButton.m3-filter-chip:pointerover">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
    </Style>
    <Style Selector="Button.m3-chip.active, Button.m3-filter-chip.active, ToggleButton.m3-chip:checked, ToggleButton.m3-filter-chip:checked">
        <Setter Property="Background" Value="{DynamicResource M3SecondaryContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSecondaryContainerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3SecondaryContainerBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.m3-chip.pill, Button.m3-filter-chip.pill, ToggleButton.m3-chip.pill, ToggleButton.m3-filter-chip.pill">
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerFull}" />
    </Style>

    <!-- M3 Compact Preset Pill Chip (Tactile Studio Presets) -->
    <Style Selector="Button.m3-preset-chip">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerFull}" />
        <Setter Property="Padding" Value="8,2,9,2" />
        <Setter Property="Height" Value="26" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <BrushTransition Property="Foreground" Duration="0:0:0.12" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.m3-preset-chip:pointerover">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}" />
        <Setter Property="RenderTransform" Value="scale(1.03)" />
    </Style>
    <Style Selector="Button.m3-preset-chip:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>
    <Style Selector="Button.m3-preset-chip.active">
        <Setter Property="Background" Value="{DynamicResource M3SecondaryContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSecondaryContainerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3SecondaryContainerBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- M3 Expressive Inspector Section Header Toggle Button (Full-width expandable category bar) -->
    <Style Selector="Button.m3-section-toggle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerSmall}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.m3-section-toggle:pointerover">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
    </Style>
    <Style Selector="Button.m3-section-toggle:pressed">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighestBrush}" />
    </Style>
    <Style Selector="Button.m3-section-toggle TextBlock.inspector-label">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
    </Style>
    <Style Selector="Button.m3-section-toggle:pointerover TextBlock.inspector-label">
        <Setter Property="Foreground" Value="{DynamicResource M3PrimaryBrush}" />
    </Style>
    <Style Selector="Button.m3-section-toggle:pointerover materialIcons|MaterialIcon">
        <Setter Property="Foreground" Value="{DynamicResource M3PrimaryBrush}" />
    </Style>

    <!-- =================================================================== -->
    <!-- 4. CARDS SUITE (Elevated, Filled, Outlined, Interactive Action Wrappers) -->
    <!-- =================================================================== -->

    <!-- Card Action Button Wrapper (Zero-leak transparent interactive container for elevated cards and page sheets) -->
    <Style Selector="Button.card-action-wrapper, Button.pdf-tool-btn, Button.template-card-btn, Button.workflow-banner-btn, Button.card-btn, Button.thumbnail-item-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,3,0,1" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.card-action-wrapper /template/ ContentPresenter#PART_ContentPresenter,
                     Button.pdf-tool-btn /template/ ContentPresenter#PART_ContentPresenter,
                     Button.template-card-btn /template/ ContentPresenter#PART_ContentPresenter,
                     Button.workflow-banner-btn /template/ ContentPresenter#PART_ContentPresenter,
                     Button.card-btn /template/ ContentPresenter#PART_ContentPresenter,
                     Button.thumbnail-item-btn /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="Button.card-action-wrapper:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.pdf-tool-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.template-card-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.workflow-banner-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.card-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.thumbnail-item-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.card-action-wrapper:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     Button.pdf-tool-btn:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     Button.template-card-btn:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     Button.workflow-banner-btn:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     Button.card-btn:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     Button.thumbnail-item-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Border.m3-card-elevated">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowestBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerLarge}" />
        <Setter Property="BoxShadow" Value="{StaticResource M3ElevationLevel1}" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" Easing="CubicEaseOut" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.m3-card-elevated:pointerover">
        <Setter Property="RenderTransform" Value="translateY(-2px)" />
        <Setter Property="BoxShadow" Value="{StaticResource M3ElevationLevel2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}" />
    </Style>
    <Style Selector="Border.m3-card-elevated:pressed">
        <Setter Property="RenderTransform" Value="scale(0.99)" />
        <Setter Property="BoxShadow" Value="{StaticResource M3ElevationLevel1}" />
    </Style>

    <Style Selector="Border.m3-card-filled">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerLarge}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Border.m3-card-outlined">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowestBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerLarge}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.m3-card-outlined:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}" />
        <Setter Property="RenderTransform" Value="translateY(-2px)" />
        <Setter Property="BoxShadow" Value="{StaticResource M3ElevationLevel1}" />
    </Style>
    <Style Selector="Border.m3-card-outlined:pressed">
        <Setter Property="RenderTransform" Value="scale(0.99)" />
    </Style>

    <!-- =================================================================== -->
    <!-- 5. INPUTS & FORM CONTROLS                                           -->
    <!-- =================================================================== -->
    <Style Selector="TextBox.m3-outlined">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowestBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerMedium}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="TextBox.m3-outlined:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- M3 Resizable Editor Container (Multi-line text editor with tactile drag resize grip) -->
    <Style Selector="Border.m3-resizable-editor">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowestBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerMedium}" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.m3-resizable-editor:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}" />
    </Style>
    <Style Selector="Border.m3-resizable-editor:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineBrush}" />
    </Style>

    <!-- M3 Tactile Bottom Resize Grip -->
    <Style Selector="Border.m3-resize-grip">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowBrush}" />
        <Setter Property="Cursor" Value="SizeNorthSouth" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.m3-resize-grip:pointerover">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
    </Style>
    <Style Selector="Border.m3-grip-pill">
        <Setter Property="Background" Value="{DynamicResource M3OutlineVariantBrush}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.m3-resize-grip:pointerover Border.m3-grip-pill">
        <Setter Property="Background" Value="{DynamicResource M3PrimaryBrush}" />
    </Style>

    <!-- M3 Search Bar (Full Pill) -->
    <Style Selector="TextBox.m3-search">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerFull}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="TextBox.m3-search:focus">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighestBrush}" />
    </Style>

    <!-- =================================================================== -->
    <!-- 6. DIALOGS, MODALS & FLOATING HUDS                                  -->
    <!-- =================================================================== -->
    <!-- M3 Modal Scrim (Full-bleed edge-to-edge overlay with smooth fade) -->
    <Style Selector="Grid.m3-dialog-scrim">
        <Setter Property="Background" Value="{DynamicResource M3ScrimBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.m3-dialog-scrim">
        <Setter Property="Background" Value="{DynamicResource M3ScrimBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.m3-dialog-card">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerExtraLarge}" />
        <Setter Property="BoxShadow" Value="{StaticResource M3ElevationModalDialog}" />
    </Style>

    <Style Selector="Border.m3-floating-hud">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerFull}" />
        <Setter Property="BoxShadow" Value="{StaticResource M3ElevationLevel3}" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <!-- M3 Expressive Badges -->
    <Style Selector="Border.m3-badge">
        <Setter Property="Background" Value="{DynamicResource M3PrimaryContainerBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerFull}" />
        <Setter Property="Padding" Value="8,2" />
    </Style>
    <Style Selector="Border.m3-badge-tertiary">
        <Setter Property="Background" Value="{DynamicResource M3TertiaryContainerBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerFull}" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

</Styles>
