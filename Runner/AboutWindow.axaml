<Window xmlns:lt="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Extensibility.Theming.Layout;assembly=CSharpEditorPlugin" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d"
        x:Class="PdfEditorApp.Plugins.CSharpEditor.Runner.AboutWindow"
        lt:Tokens.FontFamily="DsUiFontFamily"
        lt:Tokens.FontWeight="DsWeightBody"
        Title="About FrySharp"
        Icon="/Assets/app-logo.ico"
        Width="510" Height="580"
        MinWidth="510" MinHeight="580"
        MaxWidth="510" MaxHeight="580"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource DsBgBrush}">

    <Panel>
        <!-- Top Ambient Radial Glow -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                Width="510" Height="260"
                IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="50%,0%" GradientOrigin="50%,0%" RadiusX="60%" RadiusY="100%">
                    <GradientStop Offset="0" Color="#222F81F7" />
                    <GradientStop Offset="0.5" Color="#0E7C3AED" />
                    <GradientStop Offset="1" Color="#00000000" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Top Subtle Frosted Highlight Line -->
        <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource DsBorderBrush}" Opacity="0.4" />

        <Border Padding="28,24,28,20">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <!-- App Logo, Title, and Version Section -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" lt:Tokens.Spacing="DsSpace10" Margin="0,0,0,12">
                    <!-- Pure Circular Logo Emblem (Zero External Square Card) -->
                    <Border Width="72" Height="72" CornerRadius="36"
                            BorderBrush="{DynamicResource DsBorderBrush}"
                            lt:Tokens.BorderThickness="DsBorderThin"
                            ClipToBounds="True"
                            HorizontalAlignment="Center"
                            BoxShadow="0 10 30 0 #80000000, 0 0 20 0 #2E2F81F7">
                        <Image Source="/Assets/app-logo.png"
                               Width="72" Height="72"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                    </Border>

                    <!-- Title & Version Row -->
                    <StackPanel HorizontalAlignment="Center" Spacing="3">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="FrySharp"
                                       lt:Tokens.FontSize="DsFontSize800" lt:Tokens.FontWeight="DsWeightStrong"
                                       Foreground="{DynamicResource DsTextWhiteBrush}"
                                       VerticalAlignment="Center" />
                            <Border Background="#1A2F81F7"
                                    BorderBrush="#4D2F81F7"
                                    lt:Tokens.BorderThickness="DsBorderThin"
                                    lt:Tokens.CornerRadius="DsRadius2XL"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Border Width="6" Height="6" lt:Tokens.CornerRadius="DsRadiusXS" Background="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="v1.0.6 • Stable"
                                               lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightEmphasis"
                                               Foreground="{DynamicResource DsPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Polyglot Workspace &amp; .NET 10 Roslyn Studio"
                                   lt:Tokens.FontSize="DsFontSize300"
                                   Foreground="{DynamicResource DsMutedBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Description -->
                <TextBlock Grid.Row="1"
                           Text="High-performance in-app IDE for .NET 10 document automation, Roslyn scripting, algorithms, and polyglot interactive notebooks."
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           lt:Tokens.FontSize="DsFontSize250"
                           LineHeight="17"
                           Foreground="{DynamicResource DsTextBrush}"
                           Margin="14,0,14,14" />

                <!-- Architecture & Environment Specs Card -->
                <Border Grid.Row="2"
                        VerticalAlignment="Top"
                        Background="{DynamicResource DsSurfaceBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        lt:Tokens.BorderThickness="DsCardBorder"
                        lt:Tokens.CornerRadius="DsRadius2XL"
                        Padding="18,14"
                        lt:Tokens.BoxShadow="DsFloatingShadow"
                        Margin="0,0,0,16">
                    <StackPanel lt:Tokens.Spacing="DsSpace10">
                        <!-- Card Header -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Cpu64Bit" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="SYSTEM ARCHITECTURE"
                                       lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightStrong" lt:Tokens.LetterSpacing="DsTracking100"
                                       Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- System Details Grid -->
                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,2,0,0">
                            <!-- Runtime -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,3,8,3">
                                <materialIcons:MaterialIcon Kind="LightningBoltOutline" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Runtime" lt:Tokens.FontWeight="DsWeightEmphasis" lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" Background="{DynamicResource DsSurfaceHoverBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusSM" Padding="6,1.5" Margin="0,2,0,2">
                                <TextBlock x:Name="RuntimeText" Text=".NET 10.0" lt:Tokens.FontFamily="DsCodeFontFamily" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                            </Border>

                            <!-- Compiler -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,3,8,3">
                                <materialIcons:MaterialIcon Kind="CodeBraces" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Compiler" lt:Tokens.FontWeight="DsWeightEmphasis" lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Microsoft Roslyn C# 13" lt:Tokens.FontSize="DsFontSize250" lt:Tokens.FontWeight="DsWeightLabel" Foreground="{DynamicResource DsTextWhiteBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,3,0,3" />

                            <!-- UI Framework -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,3,8,3">
                                <materialIcons:MaterialIcon Kind="PaletteOutline" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="UI Engine" lt:Tokens.FontWeight="DsWeightEmphasis" lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Avalonia 12.1.2 (Metal GPU)" lt:Tokens.FontSize="DsFontSize250" lt:Tokens.FontWeight="DsWeightLabel" Foreground="{DynamicResource DsTextWhiteBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,3,0,3" />

                            <!-- OS Platform -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,3,8,3">
                                <materialIcons:MaterialIcon Kind="Laptop" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Platform" lt:Tokens.FontWeight="DsWeightEmphasis" lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="PlatformText" Text="macOS" lt:Tokens.FontSize="DsFontSize250" lt:Tokens.FontWeight="DsWeightLabel" Foreground="{DynamicResource DsTextWhiteBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,3,0,3" TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <Rectangle Height="1" Fill="{DynamicResource DsBorderBrush}" Margin="0,6,0,6" Opacity="0.7" />

                        <!-- Polyglot Toolchains -->
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="LayersOutline" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="POLYGLOT TOOLCHAINS"
                                           lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightStrong" lt:Tokens.LetterSpacing="DsTracking080"
                                           Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <WrapPanel Orientation="Horizontal">
                                <Border Background="#1E7C3AED" BorderBrush="#507C3AED" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusMD" Padding="8,2.5" Margin="0,2,6,2">
                                    <TextBlock Text="C# (.NET 10)" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="#C4B5FD" />
                                </Border>
                                <Border Background="#1E0284C7" BorderBrush="#500284C7" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusMD" Padding="8,2.5" Margin="0,2,6,2">
                                    <TextBlock Text="Python" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="#38BDF8" />
                                </Border>
                                <Border Background="#1E16A34A" BorderBrush="#5016A34A" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusMD" Padding="8,2.5" Margin="0,2,6,2">
                                    <TextBlock Text="JavaScript / Node" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="#4ADE80" />
                                </Border>
                                <Border Background="#1EEA580C" BorderBrush="#50EA580C" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusMD" Padding="8,2.5" Margin="0,2,6,2">
                                    <TextBlock Text="Java" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="#FB923C" />
                                </Border>
                                <Border Background="#1E0891B2" BorderBrush="#500891B2" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusMD" Padding="8,2.5" Margin="0,2,6,2">
                                    <TextBlock Text="C++" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="#22D3EE" />
                                </Border>
                                <Border Background="#1E64748B" BorderBrush="#5064748B" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusMD" Padding="8,2.5" Margin="0,2,6,2">
                                    <TextBlock Text="C" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="#CBD5E1" />
                                </Border>
                                <Border Background="#1ED97706" BorderBrush="#50D97706" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusMD" Padding="8,2.5" Margin="0,2,6,2">
                                    <TextBlock Text="Rust" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="#FBBF24" />
                                </Border>
                                <Border Background="#1E0D9488" BorderBrush="#500D9488" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusMD" Padding="8,2.5" Margin="0,2,6,2">
                                    <TextBlock Text="Go" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="#2DD4BF" />
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Bottom Actions and Copyright -->
                <StackPanel Grid.Row="3" lt:Tokens.Spacing="DsSpace10">
                    <TextBlock Text="Copyright © 2026 Code Fry Dev • Open Source Polyglot Studio"
                               lt:Tokens.FontSize="DsFontSize150"
                               Foreground="{DynamicResource DsMutedBrush}"
                               HorizontalAlignment="Center" />

                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                        <!-- Left Actions: Sponsor + Documentation + GitHub -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <!-- Sponsor Button (Hero Highlight) -->
                            <Button Classes="about-sponsor-btn"
                                    Click="OnSponsorClick"
                                    Cursor="Hand"
                                    ToolTip.Tip="Sponsor FrySharp on GitHub (❤)">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Heart" Width="14" Height="14" Foreground="#EA4AAA" VerticalAlignment="Center" />
                                    <TextBlock Text="Sponsor" lt:Tokens.FontWeight="DsWeightStrong" lt:Tokens.FontSize="DsFontSize300" Foreground="#EA4AAA" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Documentation Button -->
                            <Button Classes="about-action-btn"
                                    Click="OnDocumentationClick"
                                    Cursor="Hand"
                                    ToolTip.Tip="Open Documentation">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="BookOpenPageVariantOutline" Width="14" Height="14" Foreground="{DynamicResource DsTextBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Docs" lt:Tokens.FontSize="DsFontSize300" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- GitHub Button -->
                            <Button Classes="about-action-btn"
                                    Click="OnGitHubClick"
                                    Cursor="Hand"
                                    ToolTip.Tip="Open GitHub Repository">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Github" Width="14" Height="14" Foreground="{DynamicResource DsTextBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="GitHub" lt:Tokens.FontSize="DsFontSize300" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Right Action: Close Button -->
                        <Button Grid.Column="2"
                                Content="Close"
                                Classes="about-close-btn"
                                Click="OnCloseClick"
                                IsDefault="True"
                                Cursor="Hand" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Panel>
</Window>
