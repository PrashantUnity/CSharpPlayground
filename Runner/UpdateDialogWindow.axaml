<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d"
        x:Class="PdfEditorApp.Plugins.CSharpEditor.Runner.UpdateDialogWindow"
        Title="Check for Updates"
        Icon="/Assets/app-logo.ico"
        Width="420" Height="260"
        MinWidth="420" MinHeight="260"
        MaxWidth="420" MaxHeight="260"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource M3SurfaceBrush}">

    <Border Padding="24">
        <Grid RowDefinitions="Auto,*,Auto">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,4,0,16">
                <Border Width="52" Height="52"
                        CornerRadius="14"
                        Background="{DynamicResource M3PrimaryContainerBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="CheckCircleOutline"
                                                Width="32" Height="32"
                                                Foreground="{DynamicResource M3PrimaryBrush}" />
                </Border>

                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="You're up to date!"
                               FontFamily="{DynamicResource M3FontFamily}"
                               FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource M3OnSurfaceBrush}" />
                    <TextBlock Text="FrySharp v1.0.6"
                               FontSize="12.5"
                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="1"
                       Text="You are currently running the latest release of FrySharp. All Roslyn compiler services and polyglot runtime modules are ready."
                       TextWrapping="Wrap"
                       FontSize="12"
                       LineHeight="18"
                       Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                       Margin="4,0,4,12" />

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <Button Grid.Column="1"
                        Content="OK"
                        Classes="m3-filled-btn"
                        Click="OnCloseClick"
                        Width="90"
                        HorizontalContentAlignment="Center"
                        IsDefault="True"
                        Cursor="Hand" />
            </Grid>
        </Grid>
    </Border>
</Window>
