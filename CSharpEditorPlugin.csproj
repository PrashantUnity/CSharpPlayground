<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
    <!-- CSharpEditorPlugin.xml ships next to the DLL so hovering Display, Dump, Check... in a script shows their docs.
         Only the documented members need comments (CS1591, CS1573). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <AssemblyName>CSharpEditorPlugin</AssemblyName>
    <PackageId>FryPdf.Plugin.CSharpEditor</PackageId>
    <RootNamespace>PdfEditorApp.Plugins.CSharpEditor</RootNamespace>
    <Version>2.0.3</Version>
    <Company>Code Fry Dev</Company>
    <Description>Full-featured interactive FrySharp Script Automation and Polyglot Workspace for FryPDF</Description>
    <DefaultItemExcludes>$(DefaultItemExcludes);Runner/**;Tests/**;tools/**;samples/**</DefaultItemExcludes>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

  </PropertyGroup>

  <ItemGroup>
    <None Include="samples/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The words of the visual contract (ChartType, ElementState, ...): charts, 3D plots and visualizers all use them. -->
    <Using Include="PdfEditorApp.Plugins.CSharpEditor.Visuals.Spec" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FryPdf.PluginSdk" Version="0.1.0" PrivateAssets="all" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Common dependencies provided at runtime by the FryPDF host -->
    <PackageReference Include="Avalonia" Version="12.1.2" PrivateAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" PrivateAssets="all" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Code Editor & Roslyn compilation dependencies bundled with plugin -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.12.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaResource Include="Assets\**" />
    <!-- The notebook's Python kernel program, written out next to the plugin's data when a Python cell first runs. -->
    <EmbeddedResource Include="Services/Languages/Python/Kernel/*.py" LogicalName="PythonKernel.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Services/Languages/Python/Runtime/*.py" LogicalName="PythonKernel.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Services/Languages/Python/Runtime/*.py" LogicalName="PythonRuntime.%(Filename)%(Extension)" />
    <!-- The notebook's JavaScript kernel program, written out next to the plugin's data when a JavaScript cell first runs. -->
    <EmbeddedResource Include="Services/Languages/JavaScript/Kernel/*.js" LogicalName="JavaScriptKernel.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Services/Languages/JavaScript/Runtime/*.js" LogicalName="JavaScriptKernel.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Services/Languages/JavaScript/Runtime/*.js" LogicalName="JavaScriptRuntime.%(Filename)%(Extension)" />
    <!-- The notebook's Java kernel program, written out next to the plugin's data when a Java cell first runs. -->
    <EmbeddedResource Include="Services/Languages/Java/Kernel/*.java" LogicalName="JavaKernel.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Services/Languages/Java/Runtime/*.java" LogicalName="JavaKernel.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Services/Languages/Java/Runtime/*.java" LogicalName="JavaRuntime.%(Filename)%(Extension)" />
    <!-- The Go display and visual runtime package -->
    <EmbeddedResource Include="Services/Languages/Go/Runtime/*.go" LogicalName="GoRuntime.%(Filename)%(Extension)" />
    <!-- The Rust display and visual runtime package -->
    <EmbeddedResource Include="Services/Languages/Rust/Runtime/*.*" LogicalName="RustRuntime.%(Filename)%(Extension)" />
    <!-- The C++ display and visual runtime header -->
    <EmbeddedResource Include="Services/Languages/Cpp/Runtime/*.hpp" LogicalName="CppRuntime.%(Filename)%(Extension)" />
    <!-- The F# display and visual runtime script -->
    <EmbeddedResource Include="Services/Languages/FSharp/Runtime/*.fsx" LogicalName="FSharpRuntime.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Packaging into .fryplugin distribution archive -->
  <Target Name="PackageFryPlugin" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PluginStagingDir>$(TargetDir)staging\</PluginStagingDir>
      <OutputFryPlugin>$(TargetDir)CSharpEditor.fryplugin</OutputFryPlugin>
    </PropertyGroup>

    <RemoveDir Directories="$(PluginStagingDir)" />
    <MakeDir Directories="$(PluginStagingDir)" />

    <ItemGroup>
      <PluginFiles Include="$(TargetDir)CSharpEditorPlugin.dll" />
      <PluginFiles Include="$(TargetDir)CSharpEditorPlugin.xml" Condition="Exists('$(TargetDir)CSharpEditorPlugin.xml')" />
      <PluginFiles Include="$(TargetDir)CSharpEditorPlugin.deps.json" Condition="Exists('$(TargetDir)CSharpEditorPlugin.deps.json')" />
      <PluginFiles Include="$(TargetDir)AvaloniaEdit.dll" Condition="Exists('$(TargetDir)AvaloniaEdit.dll')" />
      <PluginFiles Include="$(TargetDir)Avalonia.Controls.WebView.dll" Condition="Exists('$(TargetDir)Avalonia.Controls.WebView.dll')" />
      <PluginFiles Include="$(TargetDir)Microsoft.CodeAnalysis.dll" Condition="Exists('$(TargetDir)Microsoft.CodeAnalysis.dll')" />
      <PluginFiles Include="$(TargetDir)Microsoft.CodeAnalysis.CSharp.dll" Condition="Exists('$(TargetDir)Microsoft.CodeAnalysis.CSharp.dll')" />
      <PluginFiles Include="$(TargetDir)Microsoft.CodeAnalysis.Scripting.dll" Condition="Exists('$(TargetDir)Microsoft.CodeAnalysis.Scripting.dll')" />
      <PluginFiles Include="$(TargetDir)Microsoft.CodeAnalysis.CSharp.Scripting.dll" Condition="Exists('$(TargetDir)Microsoft.CodeAnalysis.CSharp.Scripting.dll')" />
      <PluginFiles Include="$(TargetDir)Markdig.dll" Condition="Exists('$(TargetDir)Markdig.dll')" />
      <PluginFiles Include="$(ProjectDir)plugin.json" />
    </ItemGroup>

    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(PluginStagingDir)" />
    <Delete Files="$(OutputFryPlugin)" Condition="Exists('$(OutputFryPlugin)')" />
    <ZipDirectory SourceDirectory="$(PluginStagingDir)" DestinationFile="$(OutputFryPlugin)" />
    <RemoveDir Directories="$(PluginStagingDir)" />

    <Message Importance="High" Text="Successfully packaged FryPDF plugin: $(OutputFryPlugin)" />
  </Target>
</Project>