<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
    <AssemblyName>CSharpEditorPlugin</AssemblyName>
    <PackageId>FryPdf.Plugin.CSharpEditor</PackageId>
    <RootNamespace>PdfEditorApp.Plugins.CSharpEditor</RootNamespace>
    <Version>1.0.0</Version>
    <Company>Code Fry Dev</Company>
    <Description>Full-featured interactive C# Code Studio and Script Automation Workspace for FryPDF</Description>
    <DefaultItemExcludes>$(DefaultItemExcludes);Runner/**;Tests/**</DefaultItemExcludes>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="/Users/codefrydev/Desktop/SourceCode/PDFCreator/src/PdfEditorApp.Core/PdfEditorApp.Core.csproj" PrivateAssets="all" Condition="Exists('/Users/codefrydev/Desktop/SourceCode/PDFCreator/src/PdfEditorApp.Core/PdfEditorApp.Core.csproj')" />
    <PackageReference Include="FryPdf.PluginSdk" Version="0.0.8" PrivateAssets="all" Condition="!Exists('/Users/codefrydev/Desktop/SourceCode/PDFCreator/src/PdfEditorApp.Core/PdfEditorApp.Core.csproj')" />
  </ItemGroup>

  <ItemGroup>
    <!-- Common dependencies provided at runtime by the FryPDF host -->
    <PackageReference Include="Avalonia" Version="12.1.2" PrivateAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" PrivateAssets="all" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Code Editor & Roslyn compilation dependencies bundled with plugin -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.12.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Packaging into .fryplugin distribution archive -->
  <Target Name="PackageFryPlugin" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PluginStagingDir>$(TargetDir)staging\</PluginStagingDir>
      <OutputFryPlugin>$(TargetDir)CSharpEditor.fryplugin</OutputFryPlugin>
    </PropertyGroup>

    <RemoveDir Directories="$(PluginStagingDir)" />
    <MakeDir Directories="$(PluginStagingDir)" />

    <ItemGroup>
      <PluginFiles Include="$(TargetDir)CSharpEditorPlugin.dll" />
      <PluginFiles Include="$(TargetDir)CSharpEditorPlugin.deps.json" Condition="Exists('$(TargetDir)CSharpEditorPlugin.deps.json')" />
      <PluginFiles Include="$(TargetDir)AvaloniaEdit.dll" Condition="Exists('$(TargetDir)AvaloniaEdit.dll')" />
      <PluginFiles Include="$(TargetDir)Microsoft.CodeAnalysis.dll" Condition="Exists('$(TargetDir)Microsoft.CodeAnalysis.dll')" />
      <PluginFiles Include="$(TargetDir)Microsoft.CodeAnalysis.CSharp.dll" Condition="Exists('$(TargetDir)Microsoft.CodeAnalysis.CSharp.dll')" />
      <PluginFiles Include="$(TargetDir)Microsoft.CodeAnalysis.Scripting.dll" Condition="Exists('$(TargetDir)Microsoft.CodeAnalysis.Scripting.dll')" />
      <PluginFiles Include="$(TargetDir)Microsoft.CodeAnalysis.CSharp.Scripting.dll" Condition="Exists('$(TargetDir)Microsoft.CodeAnalysis.CSharp.Scripting.dll')" />
      <PluginFiles Include="$(ProjectDir)plugin.json" />
    </ItemGroup>

    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(PluginStagingDir)" />
    <Delete Files="$(OutputFryPlugin)" Condition="Exists('$(OutputFryPlugin)')" />
    <ZipDirectory SourceDirectory="$(PluginStagingDir)" DestinationFile="$(OutputFryPlugin)" />
    <RemoveDir Directories="$(PluginStagingDir)" />

    <Message Importance="High" Text="✨ Successfully packaged FryPDF plugin: $(OutputFryPlugin)" />
  </Target>

  <!-- Synchronize plugin to FryPDF host development plugins directory -->
  <Target Name="SyncPluginToHost" AfterTargets="Build">
    <PropertyGroup>
      <HostPluginsRoot>/Users/codefrydev/Desktop/SourceCode/PDFCreator/src/PdfEditorApp/bin/Debug/net10.0/plugins/</HostPluginsRoot>
      <HostPluginDir>$(HostPluginsRoot)com.frypdf.plugin.csharpeditor/</HostPluginDir>
    </PropertyGroup>

    <MakeDir Directories="$(HostPluginDir)" Condition="Exists('$(HostPluginsRoot)') And !Exists('$(HostPluginDir)')" />

    <ItemGroup Condition="Exists('$(HostPluginDir)')">
      <PluginSyncDll Include="$(TargetDir)CSharpEditorPlugin.dll" />
      <PluginSyncPdb Include="$(TargetDir)CSharpEditorPlugin.pdb" Condition="Exists('$(TargetDir)CSharpEditorPlugin.pdb')" />
      <PluginSyncDeps Include="$(TargetDir)CSharpEditorPlugin.deps.json" Condition="Exists('$(TargetDir)CSharpEditorPlugin.deps.json')" />
      <PluginSyncManifest Include="$(MSBuildProjectDirectory)/plugin.json" />
      <PluginSyncLibs Include="$(TargetDir)AvaloniaEdit.dll;$(TargetDir)Microsoft.CodeAnalysis*.dll" />
    </ItemGroup>

    <Copy SourceFiles="@(PluginSyncDll)" DestinationFolder="$(HostPluginDir)" SkipUnchangedFiles="false" Condition="Exists('$(HostPluginDir)')" />
    <Copy SourceFiles="@(PluginSyncPdb)" DestinationFolder="$(HostPluginDir)" SkipUnchangedFiles="false" Condition="Exists('$(HostPluginDir)')" />
    <Copy SourceFiles="@(PluginSyncDeps)" DestinationFolder="$(HostPluginDir)" SkipUnchangedFiles="false" Condition="Exists('$(HostPluginDir)')" />
    <Copy SourceFiles="@(PluginSyncManifest)" DestinationFolder="$(HostPluginDir)" SkipUnchangedFiles="false" Condition="Exists('$(HostPluginDir)')" />
    <Copy SourceFiles="@(PluginSyncLibs)" DestinationFolder="$(HostPluginDir)" SkipUnchangedFiles="false" Condition="Exists('$(HostPluginDir)')" />
    <Message Importance="High" Text="✨ Synchronized CSharpEditorPlugin to host plugins directory: $(HostPluginDir)" Condition="Exists('$(HostPluginDir)')" />
  </Target>
</Project>