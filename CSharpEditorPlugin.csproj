<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
    <!-- CSharpEditorPlugin.xml ships next to the DLL so hovering Display, Dump, Check... in a script shows their docs.
         Only the documented members need comments (CS1591, CS1573). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <AssemblyName>CSharpEditorPlugin</AssemblyName>
    <PackageId>FryPdf.Plugin.CSharpEditor</PackageId>
    <RootNamespace>PdfEditorApp.Plugins.CSharpEditor</RootNamespace>
    <Version>2.0.5</Version>
    <Company>Code Fry Dev</Company>
    <Description>Full-featured interactive FrySharp Script Automation and Polyglot Workspace for FryPDF</Description>
    <DefaultItemExcludes>$(DefaultItemExcludes);Runner/**;Tests/**;tools/**;samples/**;FrySharp.Core/**;FrySharp.Sidecar/**;FrySharp.Cli/**;Tests.Core/**;Tests.Sidecar/**;vscode-frysharp/**</DefaultItemExcludes>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

  </PropertyGroup>

  <ItemGroup>
    <None Include="samples/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="FrySharp.Core\FrySharp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The words of the visual contract (ChartType, ElementState, ...): charts, 3D plots and visualizers all use them. -->
    <Using Include="PdfEditorApp.Plugins.CSharpEditor.Visuals.Spec" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FryWorld.Sdk" Version="0.0.2" PrivateAssets="all" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Common dependencies provided at runtime by the FryPDF host -->
    <PackageReference Include="Avalonia" Version="12.1.2" PrivateAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" PrivateAssets="all" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Code Editor & Roslyn compilation dependencies bundled with plugin -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <!-- Syntax colours: VS Code's TextMate grammars and themes (AvaloniaEdit's TextMate support). -->
    <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.12.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaResource Include="Assets\**" />
    <!-- The Go display and visual runtime package -->
    <!-- The C++ display and visual runtime header -->
  </ItemGroup>

  <!-- Packaging into .fryplugin distribution archive -->
  <Target Name="PackageFryPlugin" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PluginStagingDir>$(TargetDir)staging\</PluginStagingDir>
      <OutputFryPlugin>$(TargetDir)CSharpEditor.fryplugin</OutputFryPlugin>
    </PropertyGroup>

    <RemoveDir Directories="$(PluginStagingDir)" />
    <MakeDir Directories="$(PluginStagingDir)" />

    <ItemGroup>
      <PluginFiles Include="$(TargetDir)*.dll"
                   Exclude="$(TargetDir)Avalonia.dll;$(TargetDir)Avalonia.Base.dll;$(TargetDir)Avalonia.Controls.dll;$(TargetDir)Avalonia.Markup.dll;$(TargetDir)Avalonia.Markup.Xaml.dll;$(TargetDir)Avalonia.Metal.dll;$(TargetDir)Avalonia.MicroCom.dll;$(TargetDir)Avalonia.OpenGL.dll;$(TargetDir)Avalonia.Remote.Protocol.dll;$(TargetDir)Avalonia.Skia.dll;$(TargetDir)Avalonia.Vulkan.dll;$(TargetDir)Avalonia.DesignerSupport.dll;$(TargetDir)Avalonia.Dialogs.dll;$(TargetDir)CommunityToolkit.Mvvm.dll;$(TargetDir)Material.Icons.dll;$(TargetDir)Material.Icons.Avalonia.dll;$(TargetDir)FryWorld.Sdk.dll;$(TargetDir)FryPdf.PluginSdk.dll;$(TargetDir)MicroCom.Runtime.dll" />
      <PluginFiles Include="$(TargetDir)CSharpEditorPlugin.xml" Condition="Exists('$(TargetDir)CSharpEditorPlugin.xml')" />
      <PluginFiles Include="$(TargetDir)CSharpEditorPlugin.deps.json" Condition="Exists('$(TargetDir)CSharpEditorPlugin.deps.json')" />
      <PluginFiles Include="$(TargetDir)FrySharp.Core.xml" Condition="Exists('$(TargetDir)FrySharp.Core.xml')" />
      <PluginFiles Include="$(ProjectDir)plugin.json" />
    </ItemGroup>

    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(PluginStagingDir)" />
    <!-- The TextMate grammars' regex engine (Oniguruma) is native: one library per platform, kept in its runtimes folder. -->
    <ItemGroup>
      <PluginNativeFiles Include="$(TargetDir)runtimes/*/native/*onigwrap*" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginNativeFiles)" DestinationFiles="@(PluginNativeFiles->'$(PluginStagingDir)runtimes/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Delete Files="$(OutputFryPlugin)" Condition="Exists('$(OutputFryPlugin)')" />
    <ZipDirectory SourceDirectory="$(PluginStagingDir)" DestinationFile="$(OutputFryPlugin)" />
    <RemoveDir Directories="$(PluginStagingDir)" />

    <Message Importance="High" Text="Successfully packaged FryPDF plugin: $(OutputFryPlugin)" />
  </Target>
</Project>