<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Charting.Controls.ChartFullScreenOverlay"
             Background="{DynamicResource M3SurfaceBrush}"
             Focusable="True">
    <!-- Holds the full-screen copy of the chart; the padding keeps clear of any title bar drawn into the window -->
    <Border Name="ViewHost" Padding="12" />
</UserControl>
