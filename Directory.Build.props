<Project>
  <PropertyGroup>
    <!-- Suppress transitive package vulnerability warnings on legacy ImageSharp / Avalonia sub-dependencies -->
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>

    <!-- Shared Metadata for CSharpPlayground -->
    <Authors>PrashantUnity; Code Fry Dev</Authors>
    <Company>Code Fry Dev</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/PrashantUnity/CSharpPlayground</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PrashantUnity/CSharpPlayground</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile Condition="Exists('README.md')">README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- The headless projects (FrySharp.Core, FrySharp.Web, FrySharp.Cli and their tests) share one set of compiler rules. -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('FrySharp.'))">
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="Exists('README.md')">
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
