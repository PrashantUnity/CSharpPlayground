    {
      "Id": "cell-table-code",
      "Type": 0,
      "Source": "// Strongly-typed enterprise cluster telemetry record\npublic record ClusterNode(\n    string Region,\n    string NodeId,\n    string Role,\n    double CpuPercent,\n    double MemoryGb,\n    double LatencyMs,\n    string Status);\n\n// Global production infrastructure nodes\nvar clusterNodes = new[]\n{\n    new ClusterNode(\"us-east-1\", \"node-core-01\", \"Primary Router\", 24.5, 64.0, 12.4, \"Optimal\"),\n    new ClusterNode(\"us-west-2\", \"node-worker-02\", \"Compute Shard\", 78.2, 128.0, 28.1, \"Under Load\"),\n    new ClusterNode(\"eu-west-1\", \"node-db-03\", \"Postgres Leader\", 45.0, 256.0, 18.7, \"Optimal\"),\n    new ClusterNode(\"ap-southeast-1\", \"node-edge-04\", \"Ingress Proxy\", 15.8, 32.0, 42.0, \"Optimal\"),\n    new ClusterNode(\"sa-east-1\", \"node-cache-05\", \"Redis In-Memory\", 88.9, 64.0, 68.5, \"Degraded\"),\n    new ClusterNode(\"ap-northeast-1\", \"node-ai-06\", \"Tensor Pipeline\", 92.1, 192.0, 31.2, \"Heavy Compute\")\n};\n\n// Render rich interactive dark-mode table\nDisplay.Table(clusterNodes, \"Global Cluster Infrastructure & Edge Telemetry\");\n\n// LINQ Aggregations\ndouble avgLatency = clusterNodes.Average(n => n.LatencyMs);\ndouble totalRam = clusterNodes.Sum(n => n.MemoryGb);\nint healthyCount = clusterNodes.Count(n => n.Status == \"Optimal\");\n\nConsole.WriteLine($\"✓ Telemetry Snapshot: {clusterNodes.Length} clusters monitored\");\nConsole.WriteLine($\"  - Average Edge Latency:  {avgLatency:F1} ms\");\nConsole.WriteLine($\"  - Total Provisioned RAM: {totalRam:N0} GB\");\nConsole.WriteLine($\"  - Healthy SLA Quorum:    {healthyCount}/{clusterNodes.Length} nodes\");",
      "OutputText": "Global Cluster Infrastructure & Edge Telemetry: ClusterNode[6]✓ Telemetry Snapshot: 6 clusters monitored\n  - Average Edge Latency:  33.5 ms\n  - Total Provisioned RAM: 736 GB\n  - Healthy SLA Quorum:    3/6 nodes\n",
      "ExecutionCount": 9,
      "IsExecuting": false,
      "ExecutionTimeText": "",
      "HasError": false,
      "IsMarkdownPreviewMode": false,
      "IsInputCollapsed": false,
      "IsOutputCollapsed": false,
      "IsOutputScrolled": false,
      "ImageBytes": null,
      "ImageFormat": null,
      "ImageWidth": null,
      "ImageHeight": null,
      "HtmlContent": "<div class=\"fry-tbl-container\" id=\"fry_tbl_5315e35d\" style=\"font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:var(--vscode-editor-background,#0d1117);border:1px solid var(--vscode-widget-border,#30363d);border-radius:8px;margin:10px 0;max-width:960px;box-shadow:0 4px 16px rgba(0,0,0,0.35);overflow:hidden;\">\n  <style>\n    #fry_tbl_5315e35d .fry-tbl-header {\n      display: flex; align-items: center; justify-content: space-between; gap: 8px;\n      padding: 8px 12px; background: var(--vscode-sideBar-background, #161b22);\n      border-bottom: 1px solid var(--vscode-widget-border, #30363d);\n    }\n    #fry_tbl_5315e35d .fry-tbl-toggle-btn {\n      display: flex; align-items: center; gap: 8px; background: transparent;\n      border: none; color: var(--vscode-foreground, #c9d1d9); cursor: pointer;\n      padding: 0; font-size: 13px; font-weight: 600; text-align: left;\n    }\n    #fry_tbl_5315e35d .fry-tbl-pill {\n      font-size: 11px; font-weight: 500; color: var(--vscode-descriptionForeground, #8b949e);\n      background: var(--vscode-badge-background, #21262d); border: 1px solid var(--vscode-widget-border, #30363d);\n      padding: 2px 8px; border-radius: 12px;\n    }\n    #fry_tbl_5315e35d .fry-tbl-actions {\n      display: flex; align-items: center; gap: 8px;\n    }\n    #fry_tbl_5315e35d .fry-tbl-search-wrap {\n      position: relative; display: flex; align-items: center;\n    }\n    #fry_tbl_5315e35d .fry-tbl-search-input {\n      background: var(--vscode-input-background, #0d1117);\n      border: 1px solid var(--vscode-input-border, #30363d);\n      color: var(--vscode-input-foreground, #c9d1d9);\n      padding: 3px 8px 3px 24px; border-radius: 4px; font-size: 11.5px;\n      width: 140px; transition: border-color 0.2s, width 0.2s;\n    }\n    #fry_tbl_5315e35d .fry-tbl-search-input:focus {\n      outline: none; border-color: var(--vscode-focusBorder, #58a6ff); width: 180px;\n    }\n    #fry_tbl_5315e35d .fry-tbl-search-icon {\n      position: absolute; left: 7px; font-size: 11px; opacity: 0.6; pointer-events: none;\n    }\n    #fry_tbl_5315e35d .fry-tbl-btn {\n      background: var(--vscode-button-secondaryBackground, #21262d);\n      color: var(--vscode-button-secondaryForeground, #c9d1d9);\n      border: 1px solid var(--vscode-widget-border, #30363d);\n      border-radius: 4px; padding: 3px 8px; font-size: 11px; font-weight: 500;\n      cursor: pointer; transition: background 0.15s;\n    }\n    #fry_tbl_5315e35d .fry-tbl-btn:hover {\n      background: var(--vscode-button-secondaryHoverBackground, #30363d);\n    }\n    #fry_tbl_5315e35d .fry-tbl-scroll {\n      max-height: 420px; overflow-y: auto; overflow-x: auto;\n    }\n    #fry_tbl_5315e35d table.fry-tbl-grid {\n      width: 100%; border-collapse: collapse; text-align: left; font-size: 12px;\n    }\n    #fry_tbl_5315e35d thead th {\n      position: sticky; top: 0; z-index: 5; background: var(--vscode-sideBar-background, #161b22);\n      padding: 8px 12px; border-bottom: 2px solid var(--vscode-widget-border, #30363d);\n      font-weight: 600; color: var(--vscode-foreground, #c9d1d9); user-select: none;\n    }\n    #fry_tbl_5315e35d thead th.sortable:hover {\n      background: var(--vscode-list-hoverBackground, #21262d);\n    }\n    #fry_tbl_5315e35d tbody tr.fry-data-row {\n      border-bottom: 1px solid rgba(255, 255, 255, 0.06);\n      transition: background 0.12s;\n    }\n    #fry_tbl_5315e35d tbody tr.fry-data-row:hover {\n      background: var(--vscode-list-hoverBackground, rgba(56, 139, 253, 0.08)) !important;\n    }\n    #fry_tbl_5315e35d td {\n      padding: 7px 12px; vertical-align: middle;\n    }\n    #fry_tbl_5315e35d .fry-num {\n      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n      text-align: right; color: #79c0ff;\n    }\n    #fry_tbl_5315e35d .fry-badge {\n      display: inline-block; padding: 2px 7px; border-radius: 12px;\n      font-size: 11px; font-weight: 500; letter-spacing: 0.2px;\n    }\n    #fry_tbl_5315e35d .fry-badge-green {\n      background: rgba(35, 134, 54, 0.2); color: #3fb950; border: 1px solid rgba(63, 185, 80, 0.4);\n    }\n    #fry_tbl_5315e35d .fry-badge-amber {\n      background: rgba(187, 128, 9, 0.2); color: #d29922; border: 1px solid rgba(210, 153, 34, 0.4);\n    }\n    #fry_tbl_5315e35d .fry-badge-red {\n      background: rgba(218, 54, 51, 0.2); color: #f85149; border: 1px solid rgba(248, 81, 73, 0.4);\n    }\n    #fry_tbl_5315e35d .fry-badge-blue {\n      background: rgba(31, 111, 235, 0.2); color: #58a6ff; border: 1px solid rgba(88, 166, 255, 0.4);\n    }\n    #fry_tbl_5315e35d .fry-expander-btn {\n      background: transparent; border: none; cursor: pointer;\n      color: var(--vscode-textLink-foreground, #58a6ff); font-size: 10px;\n      padding: 3px 5px; border-radius: 4px; transition: transform 0.15s;\n    }\n    #fry_tbl_5315e35d .fry-expander-btn:hover {\n      background: rgba(255,255,255,0.1);\n    }\n    #fry_tbl_5315e35d tr.fry-detail-row {\n      background: rgba(0, 0, 0, 0.28);\n    }\n    #fry_tbl_5315e35d .fry-prop-grid {\n      display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 8px; margin-top: 6px;\n    }\n    #fry_tbl_5315e35d .fry-prop-card {\n      background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);\n      border-radius: 4px; padding: 6px 10px;\n    }\n    #fry_tbl_5315e35d .fry-prop-key {\n      font-size: 10px; font-weight: 600; color: #8b949e; text-transform: uppercase; letter-spacing: 0.5px;\n    }\n    #fry_tbl_5315e35d .fry-prop-val {\n      font-size: 12px; color: #c9d1d9; margin-top: 2px; word-break: break-word;\n    }\n    #fry_tbl_5315e35d .fry-tbl-footer {\n      display: flex; align-items: center; justify-content: space-between;\n      padding: 6px 12px; font-size: 11px; color: var(--vscode-descriptionForeground, #8b949e);\n      background: var(--vscode-sideBar-background, #161b22);\n      border-top: 1px solid var(--vscode-widget-border, #30363d);\n    }\n  </style>\n\n  <div class=\"fry-tbl-header\">\n    <button type=\"button\" class=\"fry-tbl-toggle-btn\" onclick=\"fryTblToggle('fry_tbl_5315e35d')\" title=\"Click to collapse/expand table\">\n      <span class=\"fry-tbl-chevron\" style=\"color:#58a6ff;\">▼</span>\n      <span>📊 ClusterNode[6]</span>\n      <span class=\"fry-tbl-pill\">6 rows × 7 cols</span>\n    </button>\n    <div class=\"fry-tbl-actions\">\n      <div class=\"fry-tbl-search-wrap\">\n        <span class=\"fry-tbl-search-icon\">🔍</span>\n        <input type=\"text\" class=\"fry-tbl-search-input\" placeholder=\"Filter rows...\" oninput=\"fryTblFilter('fry_tbl_5315e35d', this.value)\" />\n      </div>\n      <button type=\"button\" class=\"fry-tbl-btn\" onclick=\"fryTblCopy('fry_tbl_5315e35d', 'csv')\" title=\"Copy as CSV\">CSV</button>\n      <button type=\"button\" class=\"fry-tbl-btn\" onclick=\"fryTblCopy('fry_tbl_5315e35d', 'json')\" title=\"Copy as JSON\">JSON</button>\n    </div>\n  </div>\n\n  <div class=\"fry-tbl-scroll\">\n    <table class=\"fry-tbl-grid\">\n      <thead>\n        <tr>\n          <th style=\"width:36px;text-align:center;padding:8px 4px;\"></th>\n          <th class=\"sortable\" onclick=\"fryTblSort('fry_tbl_5315e35d', 0, false)\" style=\"text-align:left;cursor:pointer;\" title=\"Sort by Region\">\n  Region <span class=\"fry-sort-ind\" style=\"opacity:0.35;font-size:10px;margin-left:3px;\">↕</span>\n</th><th class=\"sortable\" onclick=\"fryTblSort('fry_tbl_5315e35d', 1, false)\" style=\"text-align:left;cursor:pointer;\" title=\"Sort by NodeId\">\n  NodeId <span class=\"fry-sort-ind\" style=\"opacity:0.35;font-size:10px;margin-left:3px;\">↕</span>\n</th><th class=\"sortable\" onclick=\"fryTblSort('fry_tbl_5315e35d', 2, false)\" style=\"text-align:left;cursor:pointer;\" title=\"Sort by Role\">\n  Role <span class=\"fry-sort-ind\" style=\"opacity:0.35;font-size:10px;margin-left:3px;\">↕</span>\n</th><th class=\"sortable\" onclick=\"fryTblSort('fry_tbl_5315e35d', 3, true)\" style=\"text-align:right;cursor:pointer;\" title=\"Sort by CpuPercent\">\n  CpuPercent <span class=\"fry-sort-ind\" style=\"opacity:0.35;font-size:10px;margin-left:3px;\">↕</span>\n</th><th class=\"sortable\" onclick=\"fryTblSort('fry_tbl_5315e35d', 4, true)\" style=\"text-align:right;cursor:pointer;\" title=\"Sort by MemoryGb\">\n  MemoryGb <span class=\"fry-sort-ind\" style=\"opacity:0.35;font-size:10px;margin-left:3px;\">↕</span>\n</th><th class=\"sortable\" onclick=\"fryTblSort('fry_tbl_5315e35d', 5, true)\" style=\"text-align:right;cursor:pointer;\" title=\"Sort by LatencyMs\">\n  LatencyMs <span class=\"fry-sort-ind\" style=\"opacity:0.35;font-size:10px;margin-left:3px;\">↕</span>\n</th><th class=\"sortable\" onclick=\"fryTblSort('fry_tbl_5315e35d', 6, false)\" style=\"text-align:left;cursor:pointer;\" title=\"Sort by Status\">\n  Status <span class=\"fry-sort-ind\" style=\"opacity:0.35;font-size:10px;margin-left:3px;\">↕</span>\n</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr class=\"fry-data-row\" data-row=\"0\" style=\"background:rgba(255,255,255,0.015);\">\n  <td style=\"text-align:center;padding:6px 4px;\">\n    <button type=\"button\" class=\"fry-expander-btn\" onclick=\"fryTblToggleRow('fry_tbl_5315e35d', 0)\" title=\"Toggle row details\">▶</button>\n  </td>\n  <td style=\"text-align:left;\" class=\"\">us-east-1</td><td style=\"text-align:left;\" class=\"\">node-core-01</td><td style=\"text-align:left;\" class=\"\">Primary Router</td><td style=\"text-align:right;\" class=\"fry-num\">24.5</td><td style=\"text-align:right;\" class=\"fry-num\">64</td><td style=\"text-align:right;\" class=\"fry-num\">12.4</td><td style=\"text-align:left;\" class=\"\"><span class=\"fry-badge fry-badge-green\">Optimal</span></td>\n</tr>\n<tr class=\"fry-detail-row\" id=\"fry_tbl_5315e35d_detail_0\" style=\"display:none;\">\n  <td colspan=\"8\" style=\"padding:10px 14px;border-bottom:1px solid var(--vscode-widget-border,#30363d);\">\n    <div style=\"background:var(--vscode-editor-background,#0d1117);border:1px solid var(--vscode-widget-border,#30363d);border-radius:6px;padding:10px 14px;\">\n      <div style=\"display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;\">\n        <div style=\"font-size:11.5px;font-weight:600;color:#58a6ff;\">🔍 Row #1 Inspector</div>\n        <div style=\"font-size:10.5px;color:#8b949e;\">7 properties</div>\n      </div>\n      <div class=\"fry-prop-grid\">\n        <div class=\"fry-prop-card\">\n  <div class=\"fry-prop-key\">Region</div>\n  <div class=\"fry-prop-val\">us-east-1</div>\n</div><div class=\"fry-prop-card\">\n  <div class=\"fry-prop-key\">NodeId</div>\n  <div class=\"fry-prop-val\">node-core-01</div>\n</div><div class=\"fry-prop-card\">\n  <div class=\"fry-prop-key\">Role</div>\n  <div class=\"fry-prop-val\">Primary Router</div>\n</div><div class=\"fry-prop-card\">\n  <div class=\"fry-prop-key\">CpuPercent</div>\n  <div class=\"fry-prop-val\">24.5</div>\n</div><div class=\"fry-prop-card\">\n  <div class=\"fry-prop-key\">MemoryGb</div>\n  <div class=\"fry-prop-val\">64</div>\n</div><div class=\"fry-prop-card\">\n  <div class=\"fry-prop-key\">LatencyMs</div>\n  <div class=\"fry-prop-val\">12.4</div>\n</div><div class=\"fry-prop-card\">\n  <div class=\"fry-prop-key\">Status</div>\n  <div class=\"fry-prop-val\"><span class=\"fry-badge fry-badge-green\">Optimal</span></div>\n</div>\n      </div>\n      \n    </div>\n  </td>\n</tr><tr class=\"fry-data-row\" data-row=\"1\" style=\"background:transparent;\">\n  <td style=\"text-align:center;padding:6px 4px;\">\n    <button type=\"button\" class=\"fry-expander-btn\" onclick=\"fryTblToggleRow('fry_tbl_5315e35d', 1)\" title=\"Toggle row details\">▶</button>\n  </td>\n  <td style=\"text-align:left;\" class=\"\">us-west-2</td><td style=\"text-align:left;\" class=\"\">node-worker-02</td><td style=\"text-align:left;\" class=\"\">Compute Shard</td><td style=\"tex