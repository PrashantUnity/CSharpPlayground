    {
      "Id": "cell-chart2d-code",
      "Type": 0,
      "Source": "// Multi-series Fourier harmonic wave decomposition\nvar t = Enumerable.Range(0, 100).Select(i => i * 2.0 * Math.PI / 100.0).ToArray();\nvar fundamental = t.Select(Math.Sin).ToArray();\nvar harmonic3 = t.Select(x => (1.0 / 3.0) * Math.Sin(3 * x)).ToArray();\nvar composite = t.Select(x => Math.Sin(x) + (1.0 / 3.0) * Math.Sin(3 * x) + (1.0 / 5.0) * Math.Sin(5 * x)).ToArray();\n\nDisplay.LineChart(\n    (\"Fundamental (sin t)\", fundamental),\n    (\"3rd Harmonic (1/3 sin 3t)\", harmonic3),\n    (\"Composite Square Wave\", composite));\n\nConsole.WriteLine(\"✓ 2D Multi-series harmonic decomposition rendered.\");",
      "OutputText": "<Chart>✓ 2D Multi-series harmonic decomposition rendered.\n",
      "ExecutionCount": 10,
      "IsExecuting": false,
      "ExecutionTimeText": "",
      "HasError": false,
      "IsMarkdownPreviewMode": false,
      "IsInputCollapsed": false,
      "IsOutputCollapsed": false,
      "IsOutputScrolled": false,
      "ImageBytes": null,
      "ImageFormat": null,
      "ImageWidth": null,
