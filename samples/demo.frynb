      "ImageHeight": null,
      "HtmlContent": "<div class=\"fry-tbl-container\" id=\"fry_tbl_70046b4d\" style=\"font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:var(--vscode-editor-background,#0d1117);border:1px solid var(--vscode-widget-border,#30363d);border-radius:8px;margin:10px 0;max-width:960px;box-shadow:0 4px 16px rgba(0,0,0,0.35);overflow:hidden;\">\n  <style>\n    #fry_tbl_70046b4d .fry-tbl-header {\n      display: flex; align-items: center; justify-content: space-between; gap: 8px;\n      padding: 8px 12px; background: var(--vscode-sideBar-background, #161b22);\n      border-bottom: 1px solid var(--vscode-widget-border, #30363d);\n    }\n    #fry_tbl_70046b4d .fry-tbl-toggle-btn {\n      display: flex; align-items: center; gap: 8px; background: transparent;\n      border: none; color: var(--vscode-foreground, #c9d1d9); cursor: pointer;\n      padding: 0; font-size: 13px; font-weight: 600; text-align: left;\n    }\n    #fry_tbl_70046b4d .fry-tbl-pill {\n      font-size: 11px; font-weight: 500; color: var(--vscode-descriptionForeground, #8b949e);\n      background: var(--vscode-badge-background, #21262d); border: 1px solid var(--vscode-widget-border, #30363d);\n      padding: 2px 8px; border-radius: 12px;\n    }\n    #fry_tbl_70046b4d .fry-tbl-actions {\n      display: flex; align-items: center; gap: 8px;\n    }\n    #fry_tbl_70046b4d .fry-tbl-search-wrap {\n      position: relative; display: flex; align-items: center;\n    }\n    #fry_tbl_70046b4d .fry-tbl-search-input {\n      background: var(--vscode-input-background, #0d1117);\n      border: 1px solid var(--vscode-input-border, #30363d);\n      color: var(--vscode-input-foreground, #c9d1d9);\n      padding: 3px 8px 3px 24px; border-radius: 4px; font-size: 11.5px;\n      width: 140px; transition: border-color 0.2s, width 0.2s;\n    }\n    #fry_tbl_70046b4d .fry-tbl-search-input:focus {\n      outline: none; border-color: var(--vscode-focusBorder, #58a6ff); width: 180px;\n    }\n    #fry_tbl_70046b4d .fry-tbl-search-icon {\n      position: absolute; left: 7px; font-size: 11px; opacity: 0.6; pointer-events: none;\n    }\n    #fry_tbl_70046b4d .fry-tbl-btn {\n      background: var(--vscode-button-secondaryBackground, #21262d);\n      color: var(--vscode-button-secondaryForeground, #c9d1d9);\n      border: 1px solid var(--vscode-widget-border, #30363d);\n      border-radius: 4px; padding: 3px 8px; font-size: 11px; font-weight: 500;\n      cursor: pointer; transition: background 0.15s;\n    }\n    #fry_tbl_70046b4d .fry-tbl-btn:hover {\n      background: var(--vscode-button-secondaryHoverBackground, #30363d);\n    }\n    #fry_tbl_70046b4d .fry-tbl-scroll {\n      max-height: 420px; overflow-y: auto; overflow-x: auto;\n    }\n    #fry_tbl_70046b4d table.fry-tbl-grid {\n      width: 100%; border-collapse: collapse; text-align: left; font-size: 12px;\n    }\n    #fry_tbl_70046b4d thead th {\n      position: sticky; top: 0; z-index: 5; background: var(--vscode-sideBar-background, #161b22);\n      padding: 8px 12px; border-bottom: 2px solid var(--vscode-widget-border, #30363d);\n      font-weight: 600; color: var(--vscode-foreground, #c9d1d9); user-select: none;\n    }\n    #fry_tbl_70046b4d thead th.sortable:hover {\n      background: var(--vscode-list-hoverBackground, #21262d);\n    }\n    #fry_tbl_70046b4d tbody tr.fry-data-row {\n      border-bottom: 1px solid rgba(255, 255, 255, 0.06);\n      transition: background 0.12s;\n    }\n    #fry_tbl_70046b4d tbody tr.fry-data-row:hover {\n      background: var(--vscode-list-hoverBackground, rgba(56, 139, 253, 0.08)) !important;\n    }\n    #fry_tbl_70046b4d td {\n      padding: 7px 12px; vertical-align: middle;\n    }\n    #fry_tbl_70046b4d .fry-num {\n      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n      text-align: right; color: #79c0ff;\n    }\n    #fry_tbl_70046b4d .fry-badge {\n      display: inline-block; padding: 2px 7px; border-radius: 12px;\n      font-size: 11px; font-weight: 500; letter-spacing: 0.2px;\n    }\n    #fry_tbl_70046b4d .fry-badge-green {\n      background: rgba(35, 134, 54, 0.2); color: #3fb950; border: 1px solid rgba(63, 185, 80, 0.4);\n    }\n    #fry_tbl_70046b4d .fry-badge-amber {\n      background: rgba(187, 128, 9, 0.2); color: #d29922; border: 1px solid rgba(210, 153, 34, 0.4);\n    }\n    #fry_tbl_70046b4d .fry-badge-red {\n      background: rgba(218, 54, 51, 0.2); color: #f85149; border: 1px solid rgba(248, 81, 73, 0.4);\n    }\n    #fry_tbl_70046b4d .fry-badge-blue {\n      background: rgba(31, 111, 235, 0.2); color: #58a6ff; border: 1px solid rgba(88, 166, 255, 0.4);\n    }\n    #fry_tbl_70046b4d .fry-expander-btn {\n      background: transparent; border: none; cursor: pointer;\n      color: var(--vscode-textLink-foreground, #58a6ff); font-size: 10px;\n      padding: 3px 5px; border-radius: 4px; transition: transform 0.15s;\n    }\n    #fry_tbl_70046b4d .fry-expander-btn:hover {\n      background: rgba(255,255,255,0.1);\n    }\n    #fry_tbl_70046b4d tr.fry-detail-row {\n      background: rgba(0, 0, 0, 0.28);\n    }\n    #fry_tbl_70046b4d .fry-prop-grid {\n      display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 8px; margin-top: 6px;\n    }\n    #fry_tbl_70046b4d .fry-prop-card {\n      background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);\n      border-radius: 4px; padding: 6px 10px;\n    }\n    #fry_tbl_70046b4d .fry-prop-key {\n      font-size: 10px; font-weight: 600; color: #8b949e; text-transform: uppercase; letter-spacing: 0.5px;\n    }\n    #fry_tbl_70046b4d .fry-prop-val {\n      font-size: 12px; color: #c9d1d9; margin-top: 2px; word-break: break-word;\n    }\n    #fry_tbl_70046b4d .fry-tbl-footer {\n      display: flex; align-items: center; justify-content: space-between;\n      padding: 6px 12px; font-size: 11px; color: var(--vscode-descriptionForeground, #8b949e);\n      background: var(--vscode-sideBar-background, #161b22);\n      border-top: 1px solid var(--vscode-widget-border, #30363d);\n    }\n  </style>\n\n  <div class=\"fry-tbl-header\">\n    <button type=\"button\" class=\"fry-tbl-toggle-btn\" onclick=\"fryTblToggle('fry_tbl_70046b4d')\" title=\"Click to collapse/expand table\">\n      <span class=\"fry-tbl-chevron\" style=\"color:#58a6ff;\">▼</span>\n      <span>📊 Array[3]</span>\n      <span class=\"fry-tbl-pill\">3 rows × 7 cols</span>\n    </button>\n    <div class=\"fry-tbl-actions\">\n      <div class=\"fry-tbl-search-wrap\">\n        <span class=\"fry-tbl-search-icon\">🔍</span>\n        <input type=\"text\" class=\"fry-tbl-search-input\" placeholder=\"Filter rows...\" oninput=\"fryTblFilter('fry_tbl_70046b4d', this.value)\" />\n      </div>\n      <button type=\"button\" class=\"fry-tbl-btn\" onclick=\"fryTblCopy('fry_tbl_70046b4d', 'csv')\" title=\"Copy as CSV\">CSV</button>\n      <button type=\"button\" class=\"fry-tbl-btn\" onclick=\"fryTblCopy('fry_tbl_70046b4d', 'json')\" title=\"Copy as JSON\">JSON</button>\n    </div>\n  </div>\n\n  <div class=\"fry-tbl-scroll\">\n    <table class=\"fry-tbl-grid\">\n      <thead>\n        <tr>\n          <th style=\"width:36px;text-align:center;padding:8px 4px;\"></th>\n          <th class=\"sortable\" onclick=\"fryTblSort('fry_tbl_70046b4d', 0, false)\" style=\"text-align:left;cursor:pointer;\" title=\"Sort by Region\">\n  Region <span class=\"fry-sort-ind\" style=\"opacity:0.35;font-size:10px;margin-left:3px;\">↕</span>\n</th><th class=\"sortable\" onclick=\"fryTblSort('fry_tbl_70046b4d', 1, false)\" style=\"text-align:left;cursor:pointer;\" title=\"Sort by NodeId\">\n  NodeId <span class=\"fry-sort-ind\" style=\"opacity:0.35;font-size:10px;margin-left:3px;\">↕</span>\n</th><th class=\"sortable\" onclick=\"fryTblSort('fry_tbl_70046b4d', 2, false)\" style=\"text-align:left;cursor:pointer;\" title=\"Sort by Role\">\n  Role <span class=\"fry-sort-ind\" style=\"opacity:0.35;font-size:10px;margin-left:3px;\">↕</span>\n</th><th class=\"sortable\" onclick=\"fryTblSort('fry_tbl_70046b4d', 3, true)\" style=\"text-align:right;cursor:pointer;\" title=\"Sort by CpuPercent\">\n  CpuPercent <span class=\"fry-sort-ind\" style=\"opacity:0.35;font-size:10px;margin-left:3px;\">↕</span>\n</th><th class=\"sortable\" onclick=\"fryTblSort('fry_tbl_70046b4d', 4, true)\" style=\"text-align:right;cursor:pointer;\" title=\"Sort by MemoryGb\">\n  MemoryGb <span class=\"fry-sort-ind\" style=\"opacity:0.35;font-size:10px;margin-left:3px;\">↕</span>\n</th><th class=\"sortable\" onclick=\"fryTblSort('fry_tbl_70046b4d', 5, true)\" style=\"text-align:right;cursor:pointer;\" title=\"Sort by LatencyMs\">\n  LatencyMs <span class=\"fry-sort-ind\" style=\"opacity:0.35;font-size:10px;margin-left:3px;\">↕</span>\n</th><th class=\"sortable\" onclick=\"fryTblSort('fry_tbl_70046b4d', 6, false)\" style=\"text-align:left;cursor:pointer;\" title=\"Sort by Status\">\n  Status <span class=\"fry-sort-ind\" style=\"opacity:0.35;font-size:10px;margin-left:3px;\">↕</span>\n</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr class=\"fry-data-row\" data-row=\"0\" style=\"background:rgba(255,255,255,0.015);\">\n  <td style=\"text-align:center;padding:6px 4px;\">\n    <button type=\"button\" class=\"fry-expander-btn\" onclick=\"fryTblToggleRow('fry_tbl_70046b4d', 0)\" title=\"Toggle row details\">▶</button>\n  </td>\n  <td style=\"text-align:left;\" class=\"\">us-west-2</td><td style=\"text-align:left;\" class=\"\">node-worker-02</td><td style=\"text-align:left;\" class=\"\">Compute Shard</td><td style=\"text-align:right;\" class=\"fry-num\">78.2</td><td style=\"text-align:right;\" class=\"fry-num\">128</td><td style=\"text-align:right;\" class=\"fry-num\">28.1</td><td style=\"text-align:left;\" class=\"\"><span class=\"fry-badge fry-badge-amber\">Under Load</span></td>\n</tr>\n<tr class=\"fry-detail-row\" id=\"fry_tbl_70046b4d_detail_0\" style=\"display:none;\">\n  <td colspan=\"8\" style=\"padding:10px 14px;border-bottom:1px solid var(--vscod