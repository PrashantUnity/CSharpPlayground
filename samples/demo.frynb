      "Id": "cell-chart2d-md",
      "Type": 1,
      "Source": "### 2. Multi-Series 2D Line Chart (Fourier Harmonics)",
      "OutputText": "",
      "ExecutionCount": null,
      "IsExecuting": false,
      "ExecutionTimeText": "",
      "HasError": false,
      "IsMarkdownPreviewMode": false,
      "IsInputCollapsed": false,
      "IsOutputCollapsed": false,
      "IsOutputScrolled": false,
      "ImageBytes": null,
