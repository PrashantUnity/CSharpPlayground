    {
      "Id": "cell-barchart-code",
      "Type": 0,
      "Source": "// 1. Regional CPU load bar chart\nvar loads = clusterNodes.ToDictionary(n => n.Region, n => n.CpuPercent);\nDisplay.BarChart(loads, \"Regional Compute Load (%)\");\n\n// 2. Resource memory allocation donut chart\nvar ramAllocation = clusterNodes.ToDictionary(n => $\"{n.Role} ({n.Region})\", n => n.MemoryGb);\nDisplay.Chart(ramAllocation, \"Cluster Memory Distribution (GB)\", chartType: \"donut\");\n\nConsole.WriteLine(\"✓ Categorical bar & donut charts rendered.\");",
      "OutputText": "<Chart><Chart>✓ Categorical bar & donut charts rendered.\n",
      "ExecutionCount": 11,
      "IsExecuting": false,
      "ExecutionTimeText": "",
      "HasError": false,
      "IsMarkdownPreviewMode": false,
      "IsInputCollapsed": false,
      "IsOutputCollapsed": false,
      "IsOutputScrolled": false,
      "ImageBytes": null,
      "ImageFormat": null,
      "ImageWidth": null,
