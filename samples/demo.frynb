    {
      "Id": "cell-img-code",
      "Type": 0,
      "Language": "csharp",
      "Source": "using System.IO;\nusing System.IO.Compression;\n\nbyte[] GenerateMandelbrot(int w, int h)\n{\n    var raw = new byte[h * (1 \u002B w * 4)];\n    for (int y = 0; y \u003C h; y\u002B\u002B)\n    {\n        int rowOff = y * (1 \u002B w * 4);\n        raw[rowOff] = 0;\n        double cy = (y - h / 2.0) * 2.8 / h;\n        for (int x = 0; x \u003C w; x\u002B\u002B)\n        {\n            double cx = (x - w * 0.72) * 2.8 / w;\n            double zx = 0, zy = 0;\n            int iter = 0;\n            while (zx * zx \u002B zy * zy \u003C 4.0 \u0026\u0026 iter \u003C 64)\n            {\n                double tmp = zx * zx - zy * zy \u002B cx;\n                zy = 2.0 * zx * zy \u002B cy;\n                zx = tmp;\n                iter\u002B\u002B;\n            }\n\n            int pxOff = rowOff \u002B 1 \u002B x * 4;\n            if (iter == 64)\n            {\n                raw[pxOff] = 13; raw[pxOff \u002B 1] = 17; raw[pxOff \u002B 2] = 23; raw[pxOff \u002B 3] = 255;\n            }\n            else\n            {\n                double t = (double)iter / 64.0;\n                raw[pxOff] = (byte)(Math.Sin(t * 6.28) * 110 \u002B 130);\n                raw[pxOff \u002B 1] = (byte)(Math.Sin(t * 6.28 \u002B 2.0) * 110 \u002B 130);\n                raw[pxOff \u002B 2] = (byte)(Math.Sin(t * 6.28 \u002B 4.0) * 110 \u002B 130);\n                raw[pxOff \u002B 3] = 255;\n            }\n        }\n    }\n\n    using var ms = new MemoryStream();\n    using var bw = new BinaryWriter(ms);\n    bw.Write(new byte[] { 0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A });\n\n    void Chunk(string name, byte[] data)\n    {\n        bw.Write(System.Buffers.Binary.BinaryPrimitives.ReverseEndianness(data.Length));\n        var tag = System.Text.Encoding.ASCII.GetBytes(name);\n        bw.Write(tag);\n        bw.Write(data);\n        uint crc = 0xFFFFFFFF;\n        foreach (var b in tag) crc = Crc32(crc, b);\n        foreach (var b in data) crc = Crc32(crc, b);\n        bw.Write(System.Buffers.Binary.BinaryPrimitives.ReverseEndianness(~crc));\n    }\n\n    uint Crc32(uint c, byte b)\n    {\n        c ^= b;\n        for (int k = 0; k \u003C 8; k\u002B\u002B) c = (c \u0026 1) != 0 ? (0xEDB88320 ^ (c \u003E\u003E 1)) : (c \u003E\u003E 1);\n        return c;\n    }\n\n    using (var ihdr = new MemoryStream())\n    using (var iw = new BinaryWriter(ihdr))\n    {\n        iw.Write(System.Buffers.Binary.BinaryPrimitives.ReverseEndianness(w));\n        iw.Write(System.Buffers.Binary.BinaryPrimitives.ReverseEndianness(h));\n        iw.Write((byte)8); iw.Write((byte)6); iw.Write((byte)0); iw.Write((byte)0); iw.Write((byte)0);\n        Chunk(\u0022IHDR\u0022, ihdr.ToArray());\n    }\n\n    using (var idat = new MemoryStream())\n    {\n        using (var deflate = new ZLibStream(idat, CompressionLevel.Optimal, true))\n        {\n            deflate.Write(raw);\n        }\n        Chunk(\u0022IDAT\u0022, idat.ToArray());\n    }\n\n    Chunk(\u0022IEND\u0022, Array.Empty\u003Cbyte\u003E());\n    return ms.ToArray();\n}\n\nbyte[] pngBytes = GenerateMandelbrot(540, 270);\nDisplay.Image(pngBytes, \u0022PNG\u0022);\nConsole.WriteLine($\u0022\u2713 Mandelbrot fractal synthesized ({pngBytes.Length:N0} bytes PNG).\u0022);",
      "OutputText": "\u2713 Mandelbrot fractal synthesized (20,374 bytes PNG).\n",
