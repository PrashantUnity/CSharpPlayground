    {
      "Id": "cell-polyglot-python-code",
      "Type": 0,
      "Language": "python",
      "Source": "#!share --from csharp clusterNodes --as nodes\n\nprint(f\"🐍 Python Kernel received {len(nodes)} cluster nodes from C#:\")\nfor n in nodes:\n    print(f\"  • {n['Region']:<16} CPU: {n['CpuPercent']:>5.1f}% | RAM: {n['MemoryGb']:>3.0f}GB | Status: {n['Status']}\")\n\ncpus = [n['CpuPercent'] for n in nodes]\nmean_cpu = sum(cpus) / len(cpus)\nvariance = sum((x - mean_cpu) ** 2 for x in cpus) / len(cpus)\nstd_dev = variance ** 0.5\n\nprint(f\"\\n📊 Python Statistical Moments:\")\nprint(f\"  - Mean CPU Utilization: {mean_cpu:.2f}%\")\nprint(f\"  - Population Std Dev:   {std_dev:.2f}%\")\n\n# Display summary metrics table directly from Python\ndisplay([\n    {\"Metric\": \"Monitored Nodes\", \"Value\": str(len(nodes)), \"Status\": \"Optimal\"},\n    {\"Metric\": \"Mean CPU\", \"Value\": f\"{mean_cpu:.1f}%\", \"Status\": \"Optimal\" if mean_cpu < 70 else \"Warning\"},\n    {\"Metric\": \"CPU Std Dev\", \"Value\": f\"{std_dev:.1f}%\", \"Status\": \"Nominal\"},\n    {\"Metric\": \"Peak Load Node\", \"Value\": max(nodes, key=lambda x: x[\"CpuPercent\"])[\"NodeId\"], \"Status\": \"Investigate\"}\n])",
      "OutputText": "🐍 Python Kernel received 6 cluster nodes from C#:\n  • us-east-1        CPU:  24.5% | RAM:  64GB | Status: Optimal\n  • us-west-2        CPU:  78.2% | RAM: 128GB | Status: Under Load\n  • eu-west-1        CPU:  45.0% | RAM: 256GB | Status: Optimal\n  • ap-southeast-1   CPU:  15.8% | RAM:  32GB | Status: Optimal\n  • sa-east-1        CPU:  88.9% | RAM:  64GB | Status: Degraded\n  • ap-northeast-1   CPU:  92.1% | RAM: 192GB | Status: Heavy Compute\n\n📊 Python Statistical Moments:\n  - Mean CPU Utilization: 57.42%\n  - Population Std Dev:   30.54%\nRecords[4]",
      "ExecutionCount": 14,
      "IsExecuting": false,
      "ExecutionTimeText": "",
      "HasError": false,
      "IsMarkdownPreviewMode": false,
      "IsInputCollapsed": false,
      "IsOutputCollapsed": false,
