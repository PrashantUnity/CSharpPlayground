      "ImageWidth": null,
      "ImageHeight": null,
      "HtmlContent": "\u003Cdiv class=\u0022fry-visual-card\u0022 style=\u0022font-family:system-ui,-apple-system,BlinkMacSystemFont,\u0027Segoe UI\u0027,Roboto,sans-serif;background:#0d1117;border:1px solid #30363d;border-radius:10px;padding:14px;margin:8px 0;max-width:840px;box-shadow:0 4px 16px rgba(0,0,0,0.35);overflow-x:auto;\u0022\u003E\u003Cdiv style=\u0022display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;gap:12px;\u0022\u003E\u003Cdiv\u003E\u003Cdiv style=\u0022font-weight:600;font-size:13.5px;color:#58a6ff;letter-spacing:0.2px;\u0022\u003E\uD83D\uDCCA Cluster Memory Distribution (GB)\u003C/div\u003E\u003C/div\u003E\u003Cdiv style=\u0022font-size:10.5px;font-weight:600;color:#8b949e;background:#161b22;padding:3px 9px;border-radius:12px;border:1px solid #30363d;letter-spacing:0.5px;\u0022\u003EDONUT\u003C/div\u003E\u003C/div\u003E\u003Cdiv id=\u0022fry_pie_ed845486\u0022 style=\u0022position:relative;\u0022\u003E\n  \u003Cstyle\u003E\n    #fry_pie_ed845486 path.fry-pie-slice {\n      transform-origin: 280px 180px;\n      transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s;\n      cursor: pointer;\n    }\n    #fry_pie_ed845486 path.fry-pie-slice:hover {\n      transform: scale(1.05);\n      filter: drop-shadow(0 2px 8px rgba(0,0,0,0.5));\n    }\n    #fry_pie_ed845486 .fry-pie-legend-item {\n      cursor: pointer; transition: opacity 0.15s;\n    }\n    #fry_pie_ed845486 .fry-pie-legend-item:hover {\n      opacity: 0.75;\n    }\n  \u003C/style\u003E\n  \u003Csvg viewBox=\u00220 0 760 360\u0022 width=\u0022100%\u0022 height=\u0022auto\u0022 style=\u0022display:block;border-radius:6px;background:#161b22;\u0022 xmlns=\u0022http://www.w3.org/2000/svg\u0022\u003E\u003Cpath class=\u0022fry-pie-slice\u0022 data-slice=\u00220\u0022 d=\u0022M 280.0 50.0 A 130 130 0 0 1 347.5 68.9 L 313.8 124.5 A 65 65 0 0 0 280.0 115.0 Z\u0022 fill=\u0022#58a6ff\u0022 stroke=\u0022#161b22\u0022 stroke-width=\u00222\u0022\u003E\n  \u003Ctitle\u003EPrimary Router (us-east-1): 64.0 (8.7%)\u003C/title\u003E\n\u003C/path\u003E\u003Cpath class=\u0022fry-pie-slice\u0022 data-slice=\u00221\u0022 d=\u0022M 347.5 68.9 A 130 130 0 0 1 409.7 188.9 L 344.8 184.4 A 65 65 0 0 0 313.8 124.5 Z\u0022 fill=\u0022#3fb950\u0022 stroke=\u0022#161b22\u0022 stroke-width=\u00222\u0022\u003E\n  \u003Ctitle\u003ECompute Shard (us-west-2): 128.0 (17.4%)\u003C/title\u003E\n\u003C/path\u003E\u003Cpath class=\u0022fry-pie-slice\u0022 data-slice=\u00222\u0022 d=\u0022M 409.7 188.9 A 130 130 0 0 1 198.0 280.8 L 239.0 230.4 A 65 65 0 0 0 344.8 184.4 Z\u0022 fill=\u0022#d29922\u0022 stroke=\u0022#161b22\u0022 stroke-width=\u00222\u0022\u003E\n  \u003Ctitle\u003EPostgres Leader (eu-west-1): 256.0 (34.8%)\u003C/title\u003E\n\u003C/path\u003E\u003Cpath class=\u0022fry-pie-slice\u0022 data-slice=\u00223\u0022 d=\u0022M 198.0 280.8 A 130 130 0 0 1 173.8 255.0 L 226.9 217.5 A 65 65 0 0 0 239.0 230.4 Z\u0022 fill=\u0022#f85149\u0022 stroke=\u0022#161b22\u0022 stroke-width=\u00222\u0022\u003E\n  \u003Ctitle\u003EIngress Proxy (ap-southeast-1): 32.0 (4.3%)\u003C/title\u003E\n\u003C/path\u003E\u003Cpath class=\u0022fry-pie-slice\u0022 data-slice=\u00224\u0022 d=\u0022M 173.8 255.0 A 130 130 0 0 1 150.3 188.9 L 215.2 184.4 A 65 65 0 0 0 226.9 217.5 Z\u0022 fill=\u0022#bc8cff\u0022 stroke=\u0022#161b22\u0022 stroke-width=\u00222\u0022\u003E\n  \u003Ctitle\u003ERedis In-Memory (sa-east-1): 64.0 (8.7%)\u003C/title\u003E\n\u003C/path\u003E\u003Cpath class=\u0022fry-pie-slice\u0022 data-slice=\u00225\u0022 d=\u0022M 150.3 188.9 A 130 130 0 0 1 280.0 50.0 L 280.0 115.0 A 65 65 0 0 0 215.2 184.4 Z\u0022 fill=\u0022#2dd4bf\u0022 stroke=\u0022#161b22\u0022 stroke-width=\u00222\u0022\u003E\n  \u003Ctitle\u003ETensor Pipeline (ap-northeast-1): 192.0 (26.1%)\u003C/title\u003E\n\u003C/path\u003E\u003Cg class=\u0022fry-pie-legend-item\u0022 data-slice=\u00220\u0022\u003E\n  \u003Crect x=\u0022470\u0022 y=\u002260\u0022 width=\u002212\u0022 height=\u002212\u00