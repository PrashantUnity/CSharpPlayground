    {
      "Id": "cell-plot3d-code",
      "Type": 0,
      "Source": "// 3D Sombrero surface wave: z = sin(r) / r\nDisplay.Plot3D((x, y) => {\n    double r = Math.Sqrt(x * x + y * y);\n    return r == 0 ? 1.0 : Math.Sin(r) / r;\n}, (-6.0, 6.0), (-6.0, 6.0), resolution: 28, title: \"Sombrero Wave Surface (z = sin(r) / r)\");\n\nConsole.WriteLine(\"✓ 3D Parametric surface mesh rendered.\");",
      "OutputText": "<Plot3D>✓ 3D Parametric surface mesh rendered.\n",
      "ExecutionCount": 12,
      "IsExecuting": false,
      "ExecutionTimeText": "",
      "HasError": false,
      "IsMarkdownPreviewMode": false,
      "IsInputCollapsed": false,
      "IsOutputCollapsed": false,
      "IsOutputScrolled": false,
      "ImageBytes": null,
      "ImageFormat": null,
      "ImageWidth": null,
      "ImageHeight": null,
      "HtmlContent": "<div class=\"fry-visual-card\" style=\"font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#0d1117;border:1px solid #30363d;border-radius:10px;padding:14px;margin:8px 0;max-width:840px;box-shadow:0 4px 16px rgba(0,0,0,0.35);overflow-x:auto;\"><div style=\"display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;gap:12px;\"><div><div style=\"font-weight:600;font-size:13.5px;color:#58a6ff;letter-spacing:0.2px;\">📊 Sombrero Wave Surface (z = sin(r) / r)</div></div><div style=\"font-size:10.5px;font-weight:600;color:#8b949e;background:#161b22;padding:3px 9px;border-radius:12px;border:1px solid #30363d;letter-spacing:0.5px;\">SURFACE</div></div><div id=\"fry_3d_a2429b6a\" style=\"position:relative;user-select:none;\">\n  <div style=\"display:flex;align-items:center;justify-content:flex-end;gap:12px;margin-bottom:8px;font-size:11px;color:#8b949e;\">\n    <div style=\"display:flex;align-items:center;gap:6px;\">\n      <span>🔄 Rotate</span>\n      <input type=\"range\" class=\"fry-3d-az-slider\" min=\"0\" max=\"360\" value=\"30\" style=\"width:90px;height:4px;accent-color:#58a6ff;cursor:pointer;\" oninput=\"window.fryRotate3D && window.fryRotate3D('fry_3d_a2429b6a', this.value, null)\" />\n    </div>\n    <div style=\"display:flex;align-items:center;gap:6px;\">\n      <span>📐 Tilt</span>\n      <input type=\"range\" class=\"fry-3d-el-slider\" min=\"15\" max=\"80\" value=\"35\" style=\"width:70px;height:4px;accent-color:#58a6ff;cursor:pointer;\" oninput=\"window.fryRotate3D && window.fryRotate3D('fry_3d_a2429b6a', null, this.value)\" />\n    </div>\n    <span style=\"opacity:0.6;font-size:10px;\">(Drag on canvas to rotate)</span>\n  </div>\n\n  <svg class=\"fry-3d-canvas\" viewBox=\"0 0 760 380\" width=\"100%\" height=\"auto\" style=\"display:block;border-radius:6px;background:#161b22;cursor:grab;\" xmlns=\"http://www.w3.org/2000/svg\">\n    <g class=\"fry-3d-mesh\"></g>\n  </svg><script