    {
      "Id": "cell-img-code",
      "Type": 0,
      "Source": "using System.IO;\nusing System.IO.Compression;\n\nbyte[] GenerateMandelbrot(int w, int h)\n{\n    var raw = new byte[h * (1 + w * 4)];\n    for (int y = 0; y < h; y++)\n    {\n        int rowOff = y * (1 + w * 4);\n        raw[rowOff] = 0;\n        double cy = (y - h / 2.0) * 2.8 / h;\n        for (int x = 0; x < w; x++)\n        {\n            double cx = (x - w * 0.72) * 2.8 / w;\n            double zx = 0, zy = 0;\n            int iter = 0;\n            while (zx * zx + zy * zy < 4.0 && iter < 64)\n            {\n                double tmp = zx * zx - zy * zy + cx;\n                zy = 2.0 * zx * zy + cy;\n                zx = tmp;\n                iter++;\n            }\n\n            int pxOff = rowOff + 1 + x * 4;\n            if (iter == 64)\n            {\n                raw[pxOff] = 13; raw[pxOff + 1] = 17; raw[pxOff + 2] = 23; raw[pxOff + 3] = 255;\n            }\n            else\n            {\n                double t = (double)iter / 64.0;\n                raw[pxOff] = (byte)(Math.Sin(t * 6.28) * 110 + 130);\n                raw[pxOff + 1] = (byte)(Math.Sin(t * 6.28 + 2.0) * 110 + 130);\n                raw[pxOff + 2] = (byte)(Math.Sin(t * 6.28 + 4.0) * 110 + 130);\n                raw[pxOff + 3] = 255;\n            }\n        }\n    }\n\n    using var ms = new MemoryStream();\n    using var bw = new BinaryWriter(ms);\n    bw.Write(new byte[] { 0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A });\n\n    void Chunk(string name, byte[] data)\n    {\n        bw.Write(System.Buffers.Binary.BinaryPrimitives.ReverseEndianness(data.Length));\n        var tag = System.Text.Encoding.ASCII.GetBytes(name);\n        bw.Write(tag);\n        bw.Write(data);\n        uint crc = 0xFFFFFFFF;\n        foreach (var b in tag) crc = Crc32(crc, b);\n        foreach (var b in data) crc = Crc32(crc, b);\n        bw.Write(System.Buffers.Binary.BinaryPrimitives.ReverseEndianness(~crc));\n    }\n\n    uint Crc32(uint c, byte b)\n    {\n        c ^= b;\n        for (int k = 0; k < 8; k++) c = (c & 1) != 0 ? (0xEDB88320 ^ (c >> 1)) : (c >> 1);\n        return c;\n    }\n\n    using (var ihdr = new MemoryStream())\n    using (var iw = new BinaryWriter(ihdr))\n    {\n        iw.Write(System.Buffers.Binary.BinaryPrimitives.ReverseEndianness(w));\n        iw.Write(System.Buffers.Binary.BinaryPrimitives.ReverseEndianness(h));\n        iw.Write((byte)8); iw.Write((byte)6); iw.Write((byte)0); iw.Write((byte)0); iw.Write((byte)0);\n        Chunk(\"IHDR\", ihdr.ToArray());\n    }\n\n    using (var idat = new MemoryStream())\n    {\n        using (var deflate = new ZLibStream(idat, CompressionLevel.Optimal, true))\n        {\n            deflate.Write(raw);\n        }\n        Chunk(\"IDAT\", idat.ToArray());\n    }\n\n    Chunk(\"IEND\", Array.Empty<byte>());\n    return ms.ToArray();\n}\n\nbyte[] pngBytes = GenerateMandelbrot(540, 270);\nDisplay.Image(pngBytes, \"PNG\");\nConsole.WriteLine($\"✓ Mandelbrot fractal synthesized ({pngBytes.Length:N0} bytes PNG).\");",
      "OutputText": "<image>✓ Mandelbrot fractal synthesized (20,374 bytes PNG).\n",
      "ExecutionCount": 13,
