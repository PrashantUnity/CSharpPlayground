    {
      "Id": "cell-table-code",
      "Type": 0,
      "Language": "csharp",
      "Source": "// Strongly-typed enterprise cluster telemetry record\npublic record ClusterNode(\n    string Region,\n    string NodeId,\n    string Role,\n    double CpuPercent,\n    double MemoryGb,\n    double LatencyMs,\n    string Status);\n\n// Global production infrastructure nodes\nvar clusterNodes = new[]\n{\n    new ClusterNode(\u0022us-east-1\u0022, \u0022node-core-01\u0022, \u0022Primary Router\u0022, 24.5, 64.0, 12.4, \u0022Optimal\u0022),\n    new ClusterNode(\u0022us-west-2\u0022, \u0022node-worker-02\u0022, \u0022Compute Shard\u0022, 78.2, 128.0, 28.1, \u0022Under Load\u0022),\n    new ClusterNode(\u0022eu-west-1\u0022, \u0022node-db-03\u0022, \u0022Postgres Leader\u0022, 45.0, 256.0, 18.7, \u0022Optimal\u0022),\n    new ClusterNode(\u0022ap-southeast-1\u0022, \u0022node-edge-04\u0022, \u0022Ingress Proxy\u0022, 15.8, 32.0, 42.0, \u0022Optimal\u0022),\n    new ClusterNode(\u0022sa-east-1\u0022, \u0022node-cache-05\u0022, \u0022Redis In-Memory\u0022, 88.9, 64.0, 68.5, \u0022Degraded\u0022),\n    new ClusterNode(\u0022ap-northeast-1\u0022, \u0022node-ai-06\u0022, \u0022Tensor Pipeline\u0022, 92.1, 192.0, 31.2, \u0022Heavy Compute\u0022)\n};\n\n// Render rich interactive dark-mode table\nDisplay.Table(clusterNodes, \u0022Global Cluster Infrastructure \u0026 Edge Telemetry\u0022);\n\n// LINQ Aggregations\ndouble avgLatency = clusterNodes.Average(n =\u003E n.LatencyMs);\ndouble totalRam = clusterNodes.Sum(n =\u003E n.MemoryGb);\nint healthyCount = clusterNodes.Count(n =\u003E n.Status == \u0022Optimal\u0022);\n\nConsole.WriteLine($\u0022\u2713 Telemetry Snapshot: {clusterNodes.Length} clusters monitored\u0022);\nConsole.WriteLine($\u0022  - Average Edge Latency:  {avgLatency:F1} ms\u0022);\nConsole.WriteLine($\u0022  - Total Provisioned RAM: {totalRam:N0} GB\u0022);\nConsole.WriteLine($\u0022  - Healthy SLA Quorum:    {healthyCount}/{clusterNodes.Length} nodes\u0022);",
      "OutputText": "\u2713 Telemetry Snapshot: 6 clusters monitored\n  - Average Edge Latency:  33.5 ms\n  - Total Provisioned RAM: 736 GB\n  - Healthy SLA Quorum:    3/6 nodes\n",
      "ExecutionCount": 1,
      "IsExecuting": false,
      "ExecutionTimeText": "995 ms",
      "HasError": false,
      "IsMarkdownPreviewMode": false,
      "IsInputCollapsed": false,
      "IsOutputCollapsed": false,
      "IsOutputScrolled": false,
      "ImageBytes": null,
      "ImageFormat": null,
      "ImageWidth": null,
      "ImageHeight": null,
      "HtmlContent": "\u003Cdiv class=\u0022fry-tbl-container\u0022 id=\u0022fry_tbl_be473415\u0022 style=\u0022font-family:system-ui,-apple-system,BlinkMacSystemFont,\u0027Segoe UI\u0027,Roboto,sans-serif;background:var(--vscode-editor-background,#0d1117);border:1px solid var(--vscode-widget-border,#30363d);border-radius:8px;margin:10px 0;max-width:960px;box-shadow:0 4px 16px rgba(0,0,0,0.35);overflow:hidden;\u0022\u003E\n  \u003Cstyle\u003E\n    #fry_tbl_be473415 .fry-tbl-header {\n      display: flex; align-items: center; justify-content: space-between; gap: 8px;\n      padding: 8px 12px; background: var(--vscode-sideBar-background, #161b22);\n      border-bottom: 1px solid var(--vscode-widget-border, #30363d);\n    }\n    #fry_tbl_be473415 .fry-tbl-toggle-btn {\n      display: flex; align-items: center; gap: 8px; background: transparent;\n      border: none; color: var(--vscode-foreground, #c9d1d9); cursor: pointer;\n      padding: 0; font-size: 13px; font-weight: 600; text-align: left;\n    }\n    #fry_tbl_be473415 .fry-tbl-pill {\n      font-size: 11px; font-weight: 500; color: var(--vscode-descriptionForeground, #8b949e);\n      background: var(--vscode-badge-background, #21262d); border: 1px solid var(--vscode-widget-border, #30363d);\n      padding: 2px 8px; border-radius: 12px;\n    }\n    #fry_tbl_be473415 .fry-tbl-actions {\n      display: flex; align-items: center; gap: 8px;\n    }\n    #fry_tbl_be473415 .fry-tbl-search-wrap {\n      position: relative; display: flex; align-items: center;\n    }\n    #fry_tbl_be473415 .fry-tbl-search-input {\n      background: var(--vscode-input-background, #0d1117);\n      border: 1px solid var(--vscode-input-border, #30363d);\n      color: var(--vscode-input-foreground, #c9d1d9);\n      padding: 3px 8px 3px 24px; border-radius: 4px; font-size: 11.5px;\n      width: 140px; transition: border-color 0.2s, width 0.2s;\n    }\n    #fry_tbl_be473415 .fry-tbl-search-input:focus {\n      outline: none; border-color: var(--vscode-focusBorder, #58a6ff); width: 180px;\n    }\n    #fry_tbl_be473415 .fry-tbl-search-icon {\n      position: absolute; left: 7px; font-size: 11px; opacity: 0.6; pointer-events: none;\n    }\n    #fry_tbl_be473415 .fry-tbl-btn {\n      background: var(--vscode-button-secondaryBackground, #21262d);\n      color: var(--vscode-button-secondaryForeground, #c9d1d9);\n      border: 1px solid var(--vscode-widget-border, #30363d);\n      border-radius: 4px; padding: 3px 8px; font-size: 11px; font-weight: 500;\n      cursor: pointer; transition: background 0.15s;\n    }\n    #fry_tbl_be473415 .fry-tbl-btn:hover {\n      background: var(--vscode-button-secondaryHoverBackground, #30363d);\n    }\n    #fry_tbl_be473415 .fry-tbl-scroll {\n      max-height: 420px; overflow-y: auto; overflow-x: auto;\n    }\n    #fry_tbl_be473415 table.fry-tbl-grid {\n      width: 100%; border-collapse: collapse; text-align: left; font-size: 12px;\n    }\n    #fry_tbl_be473415 thead th {\n      position: sticky; top: 0; z-index: 5; background: var(--vscode-sideBar-background, #161b22);\n      padding: 8px 12px; border-bottom: 2px solid var(--vscode-widget-border, #30363d);\n      font-weight: 600; color: var(--vscode-foreground, #c9d1d9); user-select: none;\n    }\n    #fry_tbl_be473415 thead th.sortable:hover {\n      background: var(--vscode-list-hoverBackground, #21262d);\n    }\n    #fry_tbl_be473415 tbody tr.fry-data-row {\n      border-bottom: 1px solid rgba(255, 255, 255, 0.06);\n      transition: background 0.12s;\n    }\n    #fry_tbl_be473415 tbody tr.fry-data-row:hover {\n      background: var(--vscode-list-hoverBackground, rgba(56, 139, 253, 0.08)) !important;\n    }\n    #fry_tbl_be473415 td {\n      padding: 7px 12px; vertical-align: middle;\n    }\n    #fry_tbl_be473415 .fry-num {\n      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n      text-align: right; color: #79c0ff;\n    }\n    #fry_tbl_be473415 .fry-badge {\n      display: inline-block; padding: 2px 7px; border-radius: 12px;\n      font-size: 11px; font-weight: 500; letter-spacing: 0.2px;\n    }\n    #fry_tbl_be473415 .fry-badge-green {\n      background: rgba(35, 134, 54, 0.2); color: #3fb950; border: 1px solid rgba(63, 185, 80, 0.4);\n    }\n    #fry_tbl_be473415 .fry-badge-amber {\n      background: rgba(187, 128, 9, 0.2); color: #d29922; border: 1px solid rgba(210, 153, 34, 0.4);\n    }\n    #fry_tbl_be473415 .fry-badge-red {\n      background: rgba(218, 54, 51, 0.2); color: #f85149; border: 1px solid rgba(248, 81, 73, 0.4);\n    }\n    #fry_tbl_be473415 .fry-badge-blue {\n      background: rgba(31, 111, 235, 0.2); color: #58a6ff; border: 1px solid rgba(88, 166, 255, 0.4);\n    }\n    #fry_tbl_be473415 .fry-expander-btn {\n      background: transparent; border: none; cursor: pointer;\n      color: var(--vscode-textLink-foreground, #58a6ff); font-size: 10px;\n      padding: 3px 5px; border-radius: 4px; transition: transform 0.15s;\n    }\n    #fry_tbl_be473415 .fry-expander-btn:hover {\n      background: rgba(255,255,255,0.1);\n    }\n    #fry_tbl_be473415 tr.fry-detail-row {\n      background: rgba(0, 0, 0, 0.28);\n    }\n    #fry_tbl_be473415 .fry-prop-grid {\n      display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 8px; margin-top: 6px;\n    }\n    #fry_tbl_be473415 .fry-prop-card {\n      background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);\n      border-radius: 4px; padding: 6px 10px;\n    }\n    #fry_tbl_be473415 .fry-prop-key {\n      font-size: 10px; font-weight: 600; color: #8b949e; text-transform: uppercase; letter-spacing: 0.5px;\n    }\n    #fry_tbl_be473415 .fry-prop-val {\n      font-size: 12px; color: #c9d1d9; margin-top: 2px; word-break: break-word;\n    }\n    #fry_tbl_be473415 .fry-tbl-footer {\n      display: flex; align-items: center; justify-content: space-between;\n      padding: 6px 12px; font-size: 11px; color: var(--vscode-descriptionForeground, #8b949e);\n      background: var(--vscode-sideBar-background, #161b22);\n      border-top: 1px solid var(--vscode-widget-border, #30363d);\n    }\n  \u003C/style\u003E\n\n  \u003Cdiv class=\u0022fry-tbl-header\u0022\u003E\n    \u003Cbutton type=\u0022button\u0022 class=\u0022fry-tbl-toggle-btn\u0022 onclick=\u0022fryTblToggle(\u0027fry_tbl_be473415\u0027)\u0022 title=\u0022Click to collapse/expand table\u0022\u003E\n      \u003Cspan class=\u0022fry-tbl-chevron\u0022 style=\u0022color:#58a6ff;\u0022\u003E\u25BC\u003C/span\u003E\n      \u003Cspan\u003E\uD83D\uDCCA ClusterNode[6]\u003C/span\u003E\n      \u003Cspan class=\u0022fry-tbl-pill\u0022\u003E6 rows \u00D7 7 cols\u003C/span\u003E\n    \u003C/button\u003E\n    \u003Cdiv class=\u0022fry-tbl-actions\u0022\u003E\n      \u003Cdiv class=\u0022fry-tbl-search-wrap\u0022\u003E\n        \u003Cspan class=\u0022fry-tbl-search-icon\u0022\u003E\uD83D\uDD0D\u003C/span\u003E\n        \u003Cinput type=\u0022text\u0022 class=\u0022fry-tbl-search-input\u0022 placeholder=\u0022Filter rows...\u0022 oninput=\u0022fryTblFilter(\u0027fry_tbl_be473415\u0027, this.value)\u0022 /\u003E\n      \u003C/div\u003E\n      \u003Cbutton type=\u0022button\u0022 class=\u0022fry-tbl-btn\u0022 onclick=\u0022fryTblCopy(\u0027fry_tbl_be473415\u0027, \u0027csv\u0027)\u0022 title=\u0022Copy as CSV\u0022\u003ECSV\u003C/button\u003E\n      \u003Cbutton type=\u0022button\u0022 class=\u0022fry-tbl-btn\u0022 onclick=\u0022fryTblCopy(\u0027fry_tbl_be473415\u0027, \u0027json\u0027)\u0022 title=\u0022Copy as JSON\u0022\u003EJSON\u003C/button\u003E\n    \u003C/div\u003E\n  \u003C/div\u003E\n\n  \u003Cdiv class=\u0022fry-tbl-scroll\u0022\u003E\n    \u003Ctable class=\u0022fry-tbl-grid\u0022\u003E\n      \u003Cthead\u003E\n        \u003Ctr\u003E\n          \u003Cth style=\u0022width:36px;text-align:center;padding:8px 4px;\u0022\u003E\u003C/th\u003E\n          \u003Cth class=\u0022sortable\u0022 onclick=\u0022fryTblSort(\u0027fry_tbl_be473415\u0027, 0, false)\u0022 style=\u0022text-align:left;cursor:pointer;\u0022 title=\u0022Sort by Region\u0022\u003E\n  Region \u003Cspan class=\u0022fry-sort-ind\u0022 style=\u0022opacity:0.35;font-size:10px;margin-left:3px;\u0022\u003E\u2195\u003C/span\u003E\n\u003C/th\u003E\u003Cth class=\u0022sortable\u0022 onclick=\u0022fryTblSort(\u0027fry_tbl_be473415\u0027, 1, false)\u0022 style=\u0022text-align:left;cursor:pointer;\u0022 title=\u0022Sort by NodeId\u0022\u003E\n  NodeId \u003Cspan class=\u0022fry-sort-ind\u0022 style=\u0022opacity:0.35;font-size:10px;margin-left:3px;\u0022\u003E\u2195\u003C/span\u003E\n\u003C/th\u003E\u003Cth class=\u0022sortable\u0022 onclick=\u0022fryTblSort(\u0027fry_tbl_be473415\u0027, 2, false)\u0022 style=\u0022text-align:left;cursor:pointer;\u0022 title=\u0022Sort by Role\u0022\u003E\n  Role \u003Cspan class=\u0022fry-sort-ind\u0022 style=\u0022opacity:0.35;font-size:10px;margin-left:3px;\u0022\u003E\u2195\u003C/span\u003E\n\u003C/th\u003E\u003Cth class=\u0022sortable\u0022 onclick=\u0022fryTblSort(\u0027fry_tbl_be473415\u0027, 3, true)\u0022 style=\u0022text-align:right;cursor:pointer;\u0022 title=\u0022Sort by CpuPercent\u0022\u003E\n  CpuPercent \u003Cspan class=\u0022fry-sort-ind\u0022 style=\u0022opacity:0.35;font-size:10px;margin-left:3px;\u0022\u003E\u2195\u003C/span\u003E\n\u003C/th\u003E\u003Cth class=\u0022sortable\u0022 onclick=\u0022fryTblSort(\u0027fry_tbl_be473415\u0027, 4, true)\u0022 style=\u0022text-align:right;cursor:pointer;\u0022 title=\u0022Sort by MemoryGb\u0022\u003E\n  MemoryGb \u003Cspan class=\u0022fry-sort-ind\u0022 style=\u0022opacity:0.35;font-size:10px;margin-left:3px;\u0022\u003E\u2195\u003C/span\u003E\n\u003C/th\u003E\u003Cth class=\u0022sortable\u0022 onclick=\u0022fryTblSort(\u0027fry_tbl_be473415\u0027, 5, true)\u0022 style=\u0022text-align:right;cursor:pointer;\u0022 title=\u0022Sort by LatencyMs\u0022\u003E\n  LatencyMs \u003Cspan class=\u0022fry-sort-ind\u0022 style=\u0022opacity:0.35;font-size:10px;margin-left:3px;\u0022\u003E\u2195\u003C/span\u003E\n\u00