    {
      "Id": "cell-polyglot-js-code",
      "Type": 0,
      "Language": "javascript",
      "Source": "#!share --from csharp clusterNodes --as nodes\n\nconsole.log(\u0060\u26A1 Node.js Kernel received ${nodes.length} cluster nodes from C#!\u0060);\n\nconst highLoadNodes = nodes.filter(n =\u003E n.CpuPercent \u003E 70);\nconsole.log(\u0060\uD83D\uDEA8 High Load Nodes (\u003E70% CPU):\u0060);\nhighLoadNodes.forEach(n =\u003E console.log(\u0060  - [${n.Region}] ${n.NodeId} (${n.Role}): ${n.CpuPercent}% CPU\u0060));\n\nconst totalLatency = nodes.reduce((sum, n) =\u003E sum \u002B n.LatencyMs, 0);\nconst avgLatency = (totalLatency / nodes.length).toFixed(1);\nconsole.log(\u0060\\n\u23F1\uFE0F Aggregated JavaScript SLA Latency: ${avgLatency} ms\u0060);\n\n// Display filtered high-load cluster nodes as interactive table from Node.js\ndisplay(highLoadNodes);",
      "OutputText": "\u26A1 Node.js Kernel received 6 cluster nodes from C#!\n\uD83D\uDEA8 High Load Nodes (\u003E70% CPU):\n  - [us-west-2] node-worker-02 (Compute Shard): 78.2% CPU\n  - [sa-east-1] node-cache-05 (Redis In-Memory): 88.9% CPU\n  - [ap-northeast-1] node-ai-06 (Tensor Pipeline): 92.1% CPU\n\n\u23F1\uFE0F Aggregated JavaScript SLA Latency: 33.5 ms\n",
      "ExecutionCount": 7,
      "IsExecuting": false,
      "ExecutionTimeText": "224 ms",
      "HasError": false,
