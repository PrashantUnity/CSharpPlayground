    {
      "Id": "cell-barchart-code",
      "Type": 0,
      "Language": "csharp",
      "Source": "// 1. Regional CPU load bar chart\nvar loads = clusterNodes.ToDictionary(n =\u003E n.Region, n =\u003E n.CpuPercent);\nDisplay.BarChart(loads, \u0022Regional Compute Load (%)\u0022);\n\n// 2. Resource memory allocation donut chart\nvar ramAllocation = clusterNodes.ToDictionary(n =\u003E $\u0022{n.Role} ({n.Region})\u0022, n =\u003E n.MemoryGb);\nDisplay.Chart(ramAllocation, \u0022Cluster Memory Distribution (GB)\u0022, chartType: \u0022donut\u0022);\n\nConsole.WriteLine(\u0022\u2713 Categorical bar \u0026 donut charts rendered.\u0022);",
      "OutputText": "\u2713 Categorical bar \u0026 donut charts rendered.\n",
      "ExecutionCount": 3,
      "IsExecuting": false,
      "ExecutionTimeText": "41 ms",
      "HasError": false,
      "IsMarkdownPreviewMode": false,
      "IsInputCollapsed": false,
