    {
      "Id": "cell-polyglot-python-code",
      "Type": 0,
      "Language": "python",
      "Source": "#!share --from csharp clusterNodes --as nodes\n\nprint(f\u0022\uD83D\uDC0D Python Kernel received {len(nodes)} cluster nodes from C#:\u0022)\nfor n in nodes:\n    print(f\u0022  \u2022 {n[\u0027Region\u0027]:\u003C16} CPU: {n[\u0027CpuPercent\u0027]:\u003E5.1f}% | RAM: {n[\u0027MemoryGb\u0027]:\u003E3.0f}GB | Status: {n[\u0027Status\u0027]}\u0022)\n\ncpus = [n[\u0027CpuPercent\u0027] for n in nodes]\nmean_cpu = sum(cpus) / len(cpus)\nvariance = sum((x - mean_cpu) ** 2 for x in cpus) / len(cpus)\nstd_dev = variance ** 0.5\n\nprint(f\u0022\\n\uD83D\uDCCA Python Statistical Moments:\u0022)\nprint(f\u0022  - Mean CPU Utilization: {mean_cpu:.2f}%\u0022)\nprint(f\u0022  - Population Std Dev:   {std_dev:.2f}%\u0022)\n\n# Display summary metrics table directly from Python\ndisplay([\n    {\u0022Metric\u0022: \u0022Monitored Nodes\u0022, \u0022Value\u0022: str(len(nodes)), \u0022Status\u0022: \u0022Optimal\u0022},\n    {\u0022Metric\u0022: \u0022Mean CPU\u0022, \u0022Value\u0022: f\u0022{mean_cpu:.1f}%\u0022, \u0022Status\u0022: \u0022Optimal\u0022 if mean_cpu \u003C 70 else \u0022Warning\u0022},\n    {\u0022Metric\u0022: \u0022CPU Std Dev\u0022, \u0022Value\u0022: f\u0022{std_dev:.1f}%\u0022, \u0022Status\u0022: \u0022Nominal\u0022},\n    {\u0022Metric\u0022: \u0022Peak Load Node\u0022, \u0022Value\u0022: max(nodes, key=lambda x: x[\u0022CpuPercent\u0022])[\u0022NodeId\u0022], \u0022Status\u0022: \u0022Investigate\u0022}\n])",
      "OutputText": "\uD83D\uDC0D Python Kernel received 6 cluster nodes from C#:\n  \u2022 us-east-1        CPU:  24.5% | RAM:  64GB | Status: Optimal\n  \u2022 us-west-2        CPU:  78.2% | RAM: 128GB | Status: Under Load\n  \u2022 eu-west-1        CPU:  45.0% | RAM: 256GB | Status: Optimal\n  \u2022 ap-southeast-1   CPU:  15.8% | RAM:  32GB | Status: Optimal\n  \u2022 sa-east-1        CPU:  88.9% | RAM:  64GB | Status: Degraded\n  \u2022 ap-northeast-1   CPU:  92.1% | RAM: 192GB | Status: Heavy Compute\n\n\uD83D\uDCCA Python Statistical Moments:\n  - Mean CPU Utilization: 57.42%\n  - Population Std Dev:   30.54%\n",
      "ExecutionCount": 6,
      "IsExecuting": false,
      "ExecutionTimeText": "386 ms",
