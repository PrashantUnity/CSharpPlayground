<UserControl xmlns:lt="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Extensibility.Theming.Layout;assembly=CSharpEditorPlugin" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             xmlns:views="using:PdfEditorApp.Plugins.CSharpEditor.Views"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             xmlns:common="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Common"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="200"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Views.ObjectInspectorView"
             x:DataType="models:ObjectInspectorNode">


    <StackPanel Spacing="3" Margin="0,1">
        <!-- 1. Header Row (e.g. ▼ Submission#16+People) -->
        <Button Command="{Binding ToggleExpandCommand}"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                Cursor="Hand"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <!-- Disclosure Icon -->
                <TextBlock Text="{Binding ToggleIcon}"
                           lt:Tokens.FontSize="DsFontSize100"
                           lt:Tokens.FontWeight="DsWeightStrong"
                           Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                           VerticalAlignment="Center"
                           Width="12" />

                <!-- Type Name Chip with VS Code Type Styling -->
                <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                        lt:Tokens.BorderThickness="DsBorderThin"
                        lt:Tokens.CornerRadius="DsRadiusSM"
                        Padding="7,2"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Border Width="6" Height="6" lt:Tokens.CornerRadius="DsRadiusXS" Background="{DynamicResource CodeTypeBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding HeaderTitle}"
                                   lt:Tokens.FontFamily="DsCodeFontFamily"
                                   lt:Tokens.FontSize="DsFontSize250"
                                   lt:Tokens.FontWeight="DsWeightEmphasis"
                                   Foreground="{DynamicResource CodeTypeBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Button>

        <!-- 2. Properties Key-Value Table (with VS Code tree guideline) -->
        <Border BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                lt:Tokens.BorderThickness="DsBorderLeft"
                Margin="5,2,0,2"
                Padding="10,0,0,0"
                IsVisible="{Binding IsExpanded}">
            <ItemsControl ItemsSource="{Binding Properties}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ObjectInspectorPropertyRow">
                        <Border Classes="inspector-row" Margin="0,1">
                            <Panel>
                                <!-- Case A: Simple Scalar or Inline Array Property Row -->
                                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding !IsComplexChild}">
                                    <!-- Column 0: Property Name in VS Code Identifier Blue (CodeMemberBrush) -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" MinWidth="130" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   lt:Tokens.FontFamily="DsCodeFontFamily"
                                                   lt:Tokens.FontSize="DsFontSize250"
                                                   lt:Tokens.FontWeight="DsWeightLabel"
                                                   Foreground="{DynamicResource CodeMemberBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text=":"
                                                   lt:Tokens.FontFamily="DsCodeFontFamily"
                                                   lt:Tokens.FontSize="DsFontSize250"
                                                   Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                   Margin="2,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Column 1: Value Display (Colored by Syntax Type) -->
                                    <Panel Grid.Column="1" VerticalAlignment="Center">
                                        <!-- Null Value (<null>) -->
                                        <TextBlock Text="&lt;null&gt;"
                                                   lt:Tokens.FontFamily="DsCodeFontFamily"
                                                   lt:Tokens.FontSize="DsFontSize250"
                                                   FontStyle="Italic"
                                                   Foreground="{DynamicResource DsMutedBrush}"
                                                   IsVisible="{Binding IsNull}"
                                                   VerticalAlignment="Center" />

                                        <!-- Non-Null Value / Formatted Array -->
                                        <TextBlock Text="{Binding SimpleValueText}"
                                                   lt:Tokens.FontFamily="DsCodeFontFamily"
                                                   lt:Tokens.FontSize="DsFontSize250"
                                                   common:ThemeBrush.Foreground="{Binding ValueForegroundKey}"
                                                   IsVisible="{Binding !IsNull}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </Panel>
                                </Grid>

                                <!-- Case B: Complex Child Object (Recursive Nested Inspector) -->
                                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsComplexChild}">
                                    <!-- Column 0: Property Name -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" MinWidth="130" Margin="0,3,12,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Name}"
                                                   lt:Tokens.FontFamily="DsCodeFontFamily"
                                                   lt:Tokens.FontSize="DsFontSize250"
                                                   lt:Tokens.FontWeight="DsWeightLabel"
                                                   Foreground="{DynamicResource CodeMemberBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text=":"
                                                   lt:Tokens.FontFamily="DsCodeFontFamily"
                                                   lt:Tokens.FontSize="DsFontSize250"
                                                   Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                   Margin="2,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Column 1: Nested Child Object Inspector -->
                                    <views:ObjectInspectorView Grid.Column="1"
                                                               DataContext="{Binding ChildNode}"
                                                               VerticalAlignment="Center" />
                                </Grid>
                            </Panel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </StackPanel>
</UserControl>
