<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             xmlns:docs="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.Docs"
             xmlns:docs1="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Docs"
             xmlns:editor="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Editor"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="880"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Views.CSharpDocsView"
             x:DataType="docs:CSharpDocsViewModel"
             Background="{DynamicResource DsBgBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CSharpEditorPlugin/Styles/Tokens/StudioPaletteTokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://CSharpEditorPlugin/Styles/StudioStyles.axaml" />
    </UserControl.Styles>

    <Grid RowDefinitions="56,*">
        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- HEADER BAR                                                     -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource DsSurfaceBrush}" BorderBrush="{DynamicResource DsBorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <!-- Back to Hub Button -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{Binding BackToHubCommand}" Classes="nexus-btn-surface" Height="34" Padding="12,0" ToolTip.Tip="Return to Hub (Esc)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ArrowLeft" Width="15" Height="15" Foreground="{DynamicResource DsMutedBrush}" />
                            <TextBlock Text="Hub" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="20" Fill="{DynamicResource DsBorderBrush}" Margin="4,0,8,0" />
                </StackPanel>

                <!-- Title & Badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Width="30" Height="30" CornerRadius="8"
                            Background="{DynamicResource NavDocsBgBrush}"
                            BorderBrush="{DynamicResource DsBorderBrush}"
                            BorderThickness="1">
                        <materialIcons:MaterialIcon Kind="BookOpenPageVariantOutline" Width="17" Height="17"
                                                    Foreground="{DynamicResource NavDocsFgBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Documentation &amp; Learning Center"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource DsTextWhiteBrush}" />
                        <TextBlock Text="Interactive .NET 10 Guides &amp; API Reference"
                                   FontSize="10" Foreground="{DynamicResource DsMutedBrush}" />
                    </StackPanel>
                    <Border Classes="nexus-badge-pill"
                            Background="{DynamicResource DsPrimarySubtleBrush}"
                            BorderBrush="{DynamicResource DsPrimaryBorderSubtleBrush}"
                            BorderThickness="1" Margin="6,0,0,0">
                        <TextBlock Text=".NET 10 Roslyn" Foreground="{DynamicResource DsPrimaryBrush}" />
                    </Border>
                </StackPanel>

                <!-- Global Search Box (Matches Hub Search Bar) -->
                <Border Grid.Column="2" Background="{DynamicResource DsSurfaceHighBrush}" BorderBrush="{DynamicResource DsBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Height="36" MaxWidth="460"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="12,0" Padding="10,0">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Grid.Column="0" Kind="Magnify" Width="16" Height="16"
                                                    Foreground="{DynamicResource DsMutedBrush}"
                                                    Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchQuery, Mode=TwoWay}"
                                 PlaceholderText="Search docs, APIs, VisualizerRecorder, shortcuts..."
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MinHeight="0" Height="26" Padding="0"
                                 FontSize="12.5"
                                 Foreground="{DynamicResource DsTextWhiteBrush}"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center" />
                        <Button Grid.Column="2"
                                Command="{Binding ClearSearchCommand}"
                                IsVisible="{Binding HasSearchQuery}"
                                Background="Transparent" BorderThickness="0"
                                Padding="4,0" Cursor="Hand"
                                ToolTip.Tip="Clear search">
                            <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="15" Height="15" Foreground="{DynamicResource DsMutedBrush}" />
                        </Button>
                        <Border Grid.Column="3" Background="{DynamicResource DsBorderBrush}" CornerRadius="4" Padding="5,2" Margin="6,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="Ctrl" FontSize="9.5" FontFamily="JetBrains Mono,Consolas" Foreground="{DynamicResource DsMutedBrush}" />
                                <TextBlock Text="F" FontSize="9.5" FontFamily="JetBrains Mono,Consolas" Foreground="{DynamicResource DsMutedBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Action Links -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{Binding OpenCodeStudioCommand}"
                            Classes="nexus-btn-surface"
                            Height="34" Padding="12,0"
                            ToolTip.Tip="Open FrySharp Script Studio">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="CodeBraces" Width="15" Height="15" Foreground="{DynamicResource NavScriptsFgBrush}" />
                            <TextBlock Text="Script Studio" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenNotebookStudioCommand}"
                            Classes="nexus-btn-surface"
                            Height="34" Padding="12,0"
                            ToolTip.Tip="Open C# Notebook Studio">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="NotebookOutline" Width="15" Height="15" Foreground="{DynamicResource NavNotebooksFgBrush}" />
                            <TextBlock Text="Notebook Studio" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- MAIN BODY (2 PANES: SIDEBAR + CONTENT CANVAS)                   -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" ColumnDefinitions="310,*">
            <!-- LEFT NAVIGATION RAIL (Reusable DocsNavRailControl) -->
            <docs1:DocsNavRailControl Grid.Column="0" />

            <!-- RIGHT ARTICLE CONTENT VIEWER -->
            <Panel Grid.Column="1">
                <!-- Top-Right Ambient Glow Effect (Matches Manager Dashboard) -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="450" Height="340"
                        IsHitTestVisible="False"
                        Background="{DynamicResource DsAmbientGlowBrush}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" Margin="36,24,36,40">
                        <StackPanel Grid.Column="0" Spacing="22">
                            <!-- Breadcrumbs Strip -->
                            <Border Background="{DynamicResource DsSurfaceBrush}" BorderBrush="{DynamicResource DsBorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,5" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="13" Height="13" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ActiveBreadcrumb}" FontSize="11.5" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Article Title & Header -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding SelectedArticle.Title}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                <TextBlock Text="{Binding SelectedArticle.Subtitle}" FontSize="14" Foreground="{DynamicResource DsMutedBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                    <Border Classes="nexus-badge-pill" Background="{Binding SelectedCategory.AccentBgColor}" BorderBrush="{Binding SelectedCategory.AccentColor}" BorderThickness="1">
                                        <TextBlock Text="{Binding SelectedCategory.Badge}" Foreground="{Binding SelectedCategory.AccentColor}" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="ClockOutline" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedArticle.ReadingTime}" FontSize="11" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Summary Callout Box -->
                            <Border Background="{DynamicResource DsSurfaceBrush}"
                                    BorderBrush="{DynamicResource DsBorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="18,14">
                                <TextBlock Text="{Binding SelectedArticle.Summary}" FontSize="13.5" Foreground="{DynamicResource DsTextBrush}" TextWrapping="Wrap" LineHeight="22" />
                            </Border>

                            <!-- Article Sections -->
                            <ItemsControl ItemsSource="{Binding SelectedArticle.Sections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DocSection">
                                        <StackPanel Spacing="10" Margin="0,0,0,18">
                                            <TextBlock Text="{Binding Heading}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                            <TextBlock Text="{Binding Content}" FontSize="13" Foreground="{DynamicResource DsTextBrush}" TextWrapping="Wrap" LineHeight="20" />

                                            <!-- Callout box -->
                                            <Border IsVisible="{Binding HasCallout}"
                                                    Background="{DynamicResource DsSurfaceBrush}"
                                                    BorderBrush="{DynamicResource DsBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10" Padding="16,12" Margin="0,4">
                                                <TextBlock Text="{Binding CalloutText}" FontSize="12.5" Foreground="{DynamicResource DsTextBrush}" TextWrapping="Wrap" LineHeight="20" />
                                            </Border>

                                            <!-- Bullet points -->
                                            <ItemsControl ItemsSource="{Binding BulletPoints}" IsVisible="{Binding HasBullets}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="Auto,*" Margin="4,2,0,2">
                                                            <TextBlock Grid.Column="0" Text="• " FontSize="13" Foreground="{DynamicResource DsPrimaryBrush}" FontWeight="Bold" />
                                                            <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12.5" Foreground="{DynamicResource DsTextBrush}" TextWrapping="Wrap" LineHeight="18" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- API Signatures -->
                            <StackPanel IsVisible="{Binding SelectedArticle.HasApiSignatures}" Spacing="10">
                                <TextBlock Text="API Reference" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                <ItemsControl ItemsSource="{Binding SelectedArticle.ApiSignatures}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:DocApiSignature">
                                            <Border Background="{DynamicResource DsSurfaceBrush}" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="{Binding FullSignature}" FontFamily="Consolas, Menlo, monospace" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource DsGreenBrush}" />
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Code Snippets with Try in Studio & Copy -->
                            <StackPanel IsVisible="{Binding SelectedArticle.HasCodeSnippets}" Spacing="12">
                                <TextBlock Text="Live Code Examples" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                <ItemsControl ItemsSource="{Binding SelectedArticle.CodeSnippets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:DocCodeSnippet">
                                            <Border Background="{DynamicResource DsSurfaceBrush}"
                                                    BorderBrush="{DynamicResource DsBorderBrush}"
                                                    BorderThickness="1" CornerRadius="10" Margin="0,0,0,12"
                                                    ClipToBounds="True">
                                                <StackPanel Spacing="0">
                                                    <!-- Snippet Top Bar -->
                                                    <Border Background="{DynamicResource DsSurfaceHighBrush}"
                                                            BorderBrush="{DynamicResource DsBorderBrush}"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="14,10">
                                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                                                <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource DsMutedBrush}" />
                                                            </StackPanel>
                                                            <!-- Copy Button -->
                                                            <Button Grid.Column="1"
                                                                    Command="{Binding $parent[UserControl].((docs:CSharpDocsViewModel)DataContext).CopySnippetCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Classes="nexus-btn-surface"
                                                                    Height="30" Padding="10,0"
                                                                    Margin="0,0,8,0"
                                                                    ToolTip.Tip="Copy code to clipboard">
                                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                    <materialIcons:MaterialIcon Kind="ContentCopy" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                                                    <TextBlock Text="Copy Code" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                            <!-- Try in Studio Button -->
                                                            <Button Grid.Column="2"
                                                                    Command="{Binding $parent[UserControl].((docs:CSharpDocsViewModel)DataContext).TryInStudioCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Classes="nexus-btn-primary"
                                                                    Height="30" Padding="12,0"
                                                                    ToolTip.Tip="Launch this code sample directly in FrySharp">
                                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                    <materialIcons:MaterialIcon Kind="Play" Width="13" Height="13" Foreground="{DynamicResource DsOnAccentBrush}" />
                                                                    <TextBlock Text="Try in Studio" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Multi-Language Tab Bar (C++ | Java | Python | C#) -->
                                                    <Border IsVisible="{Binding HasVariants}"
                                                            Background="{DynamicResource DsSurfaceBrush}"
                                                            BorderBrush="{DynamicResource DsBorderBrush}"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="12,5">
                                                        <ItemsControl ItemsSource="{Binding Variants}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:DocCodeLanguageVariant">
                                                                    <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                                                                        <Button Command="{Binding $parent[ItemsControl].((models:DocCodeSnippet)DataContext).SelectVariantCommand}"
                                                                                CommandParameter="{Binding}"
                                                                                Classes="doc-lang-tab"
                                                                                Classes.selected="{Binding IsSelected}">
                                                                            <TextBlock Text="{Binding DisplayLabel}" />
                                                                        </Button>
                                                                        <TextBlock Text="|" FontSize="11" Foreground="{DynamicResource DsMutedBrush}" Opacity="0.6"
                                                                                   VerticalAlignment="Center" Margin="4,0" IsVisible="{Binding HasSeparator}"
                                                                                   IsHitTestVisible="False" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>

                                                    <!-- Code Block Canvas -->
                                                    <Border Padding="6" Background="{DynamicResource DsBgBrush}">
                                                        <editor:CodeViewer Code="{Binding Code}" Language="{Binding Language}" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Keyboard Shortcuts Table -->
                            <StackPanel IsVisible="{Binding SelectedArticle.HasShortcuts}" Spacing="10">
                                <TextBlock Text="Shortcut Reference" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                <Border Background="{DynamicResource DsSurfaceBrush}" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                    <ItemsControl ItemsSource="{Binding SelectedArticle.Shortcuts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DocShortcutItem">
                                                <Border BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="0,0,0,1" Padding="6,8">
                                                    <Grid ColumnDefinitions="180,90,110,*">
                                                        <TextBlock Grid.Column="0" Text="{Binding Action}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" Background="{DynamicResource DsSurfaceHoverBrush}" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1"
                                                                Height="22" MinHeight="22" CornerRadius="4" Padding="6,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding MacKey}" FontSize="11" FontWeight="Bold" FontFamily="JetBrains Mono,Consolas" Foreground="{DynamicResource DsPrimaryBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0,1,0,0" />
                                                        </Border>
                                                        <Border Grid.Column="2" Background="{DynamicResource DsSurfaceHoverBrush}" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1"
                                                                Height="22" MinHeight="22" CornerRadius="4" Padding="6,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding WinKey}" FontSize="11" FontWeight="Bold" FontFamily="JetBrains Mono,Consolas" Foreground="{DynamicResource NavNotebooksFgBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0,1,0,0" />
                                                        </Border>
                                                        <TextBlock Grid.Column="3" Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>

                            <!-- Footer Navigation (Prev / Next Topic) -->
                            <Grid ColumnDefinitions="*,16,*" Margin="0,16,0,0">
                                <Button Grid.Column="0"
                                        Command="{Binding PreviousArticleCommand}"
                                        IsVisible="{Binding HasPreviousArticle}"
                                        Classes="nexus-nav-item"
                                        Padding="14,10"
                                        HorizontalAlignment="Stretch">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <materialIcons:MaterialIcon Grid.Column="0" Kind="ArrowLeft" Width="18" Height="18" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="PREVIOUS TOPIC" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DsMutedBrush}" LetterSpacing="1" />
                                            <TextBlock Text="Go to Previous Guide" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Grid.Column="2"
                                        Command="{Binding NextArticleCommand}"
                                        IsVisible="{Binding HasNextArticle}"
                                        Classes="nexus-nav-item"
                                        Padding="14,10"
                                        HorizontalAlignment="Stretch">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="1">
                                            <TextBlock Text="NEXT TOPIC" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DsMutedBrush}" LetterSpacing="1" HorizontalAlignment="Right" />
                                            <TextBlock Text="Continue to Next Guide" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource DsTextWhiteBrush}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                        <materialIcons:MaterialIcon Grid.Column="1" Kind="ArrowRight" Width="18" Height="18" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </StackPanel>
                        <docs1:DocsOutlinePanelControl Grid.Column="1" IsVisible="{Binding IsOutlineVisible}" />
                    </Grid>
                </ScrollViewer>
            </Panel>
        </Grid>
    </Grid>
</UserControl>
