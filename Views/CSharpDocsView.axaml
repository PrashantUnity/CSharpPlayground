<UserControl xmlns:lt="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Extensibility.Theming.Layout;assembly=CSharpEditorPlugin" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             xmlns:docs="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.Docs"
             xmlns:docs1="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Docs"
             xmlns:editor="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Editor"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="880"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Views.CSharpDocsView"
             x:DataType="docs:CSharpDocsViewModel"
             Background="{DynamicResource DsBgBrush}">



    <Grid RowDefinitions="56,*">
        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- HEADER BAR                                                     -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource DsSurfaceBrush}" BorderBrush="{DynamicResource DsBorderBrush}"
                lt:Tokens.BorderThickness="DsBorderBottom" Padding="16,0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <!-- Back to Hub Button -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{Binding BackToHubCommand}" Classes="nexus-btn-surface" lt:Tokens.Height="DsControlHeight400" Padding="12,0" ToolTip.Tip="Return to Hub (Esc)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ArrowLeft" Width="15" Height="15" Foreground="{DynamicResource DsMutedBrush}" />
                            <TextBlock Text="Hub" VerticalAlignment="Center" lt:Tokens.FontWeight="DsWeightEmphasis" lt:Tokens.FontSize="DsFontSize350" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="20" Fill="{DynamicResource DsBorderBrush}" Margin="4,0,8,0" />
                </StackPanel>

                <!-- Title & Badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" lt:Tokens.Spacing="DsSpace10" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Width="30" Height="30" lt:Tokens.CornerRadius="DsRadiusLG"
                            Background="{DynamicResource NavDocsBgBrush}"
                            BorderBrush="{DynamicResource DsBorderBrush}"
                            lt:Tokens.BorderThickness="DsBorderThin">
                        <materialIcons:MaterialIcon Kind="BookOpenPageVariantOutline" Width="17" Height="17"
                                                    Foreground="{DynamicResource NavDocsFgBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Documentation &amp; Learning Center"
                                   lt:Tokens.FontSize="DsFontSize500" lt:Tokens.FontWeight="DsWeightStrong"
                                   Foreground="{DynamicResource DsTextWhiteBrush}" />
                        <TextBlock Text="Interactive .NET 10 Guides &amp; API Reference"
                                   lt:Tokens.FontSize="DsFontSize100" Foreground="{DynamicResource DsMutedBrush}" />
                    </StackPanel>
                    <Border Classes="nexus-badge-pill"
                            Background="{DynamicResource DsPrimarySubtleBrush}"
                            BorderBrush="{DynamicResource DsPrimaryBorderSubtleBrush}"
                            lt:Tokens.BorderThickness="DsBorderThin" Margin="6,0,0,0">
                        <TextBlock Text=".NET 10 Roslyn" Foreground="{DynamicResource DsPrimaryBrush}" />
                    </Border>
                </StackPanel>

                <!-- Global Search Box (Matches Hub Search Bar) -->
                <Border Grid.Column="2" Background="{DynamicResource DsSurfaceHighBrush}" BorderBrush="{DynamicResource DsBorderBrush}"
                        lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusLG" Height="36" MaxWidth="460"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="12,0" Padding="10,0">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Grid.Column="0" Kind="Magnify" Width="16" Height="16"
                                                    Foreground="{DynamicResource DsMutedBrush}"
                                                    Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchQuery, Mode=TwoWay}"
                                 PlaceholderText="Search docs, APIs, VisualizerRecorder, shortcuts..."
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MinHeight="0" lt:Tokens.Height="DsControlHeight100" Padding="0"
                                 lt:Tokens.FontSize="DsFontSize350"
                                 Foreground="{DynamicResource DsTextWhiteBrush}"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center" />
                        <Button Grid.Column="2"
                                Command="{Binding ClearSearchCommand}"
                                IsVisible="{Binding HasSearchQuery}"
                                Background="Transparent" BorderThickness="0"
                                Padding="4,0" Cursor="Hand"
                                ToolTip.Tip="Clear search">
                            <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="15" Height="15" Foreground="{DynamicResource DsMutedBrush}" />
                        </Button>
                        <Border Grid.Column="3" Background="{DynamicResource DsBorderBrush}" lt:Tokens.CornerRadius="DsRadiusSM" Padding="5,2" Margin="6,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="Ctrl" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontFamily="DsCodeFontFamily" Foreground="{DynamicResource DsMutedBrush}" />
                                <TextBlock Text="F" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontFamily="DsCodeFontFamily" Foreground="{DynamicResource DsMutedBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Action Links -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{Binding OpenCodeStudioCommand}"
                            Classes="nexus-btn-surface"
                            lt:Tokens.Height="DsControlHeight400" Padding="12,0"
                            ToolTip.Tip="Open FrySharp Script Studio">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="CodeBraces" Width="15" Height="15" Foreground="{DynamicResource NavScriptsFgBrush}" />
                            <TextBlock Text="Script Studio" lt:Tokens.FontSize="DsFontSize300" lt:Tokens.FontWeight="DsWeightEmphasis" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenNotebookStudioCommand}"
                            Classes="nexus-btn-surface"
                            lt:Tokens.Height="DsControlHeight400" Padding="12,0"
                            ToolTip.Tip="Open C# Notebook Studio">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="NotebookOutline" Width="15" Height="15" Foreground="{DynamicResource NavNotebooksFgBrush}" />
                            <TextBlock Text="Notebook Studio" lt:Tokens.FontSize="DsFontSize300" lt:Tokens.FontWeight="DsWeightEmphasis" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- MAIN BODY (2 PANES: SIDEBAR + CONTENT CANVAS)                   -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" ColumnDefinitions="310,*">
            <!-- LEFT NAVIGATION RAIL (Reusable DocsNavRailControl) -->
            <docs1:DocsNavRailControl Grid.Column="0" />

            <!-- RIGHT ARTICLE CONTENT VIEWER -->
            <Panel Grid.Column="1">
                <!-- Top-Right Ambient Glow Effect (Matches Manager Dashboard) -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="450" Height="340"
                        IsHitTestVisible="False"
                        Background="{DynamicResource DsAmbientGlowBrush}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" Margin="36,24,36,40">
                        <StackPanel Grid.Column="0" Spacing="22">
                            <!-- Breadcrumbs Strip -->
                            <Border Background="{DynamicResource DsSurfaceBrush}" BorderBrush="{DynamicResource DsBorderBrush}"
                                    lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusMD" Padding="10,5" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="13" Height="13" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ActiveBreadcrumb}" lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Article Title & Header -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding SelectedArticle.Title}" lt:Tokens.FontSize="DsFontSize800" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                <TextBlock Text="{Binding SelectedArticle.Subtitle}" lt:Tokens.FontSize="DsFontSize500" Foreground="{DynamicResource DsMutedBrush}" />
                                <StackPanel Orientation="Horizontal" lt:Tokens.Spacing="DsSpace12" Margin="0,4,0,0">
                                    <Border Classes="nexus-badge-pill" Background="{Binding SelectedCategory.AccentBgColor}" BorderBrush="{Binding SelectedCategory.AccentColor}" lt:Tokens.BorderThickness="DsBorderThin">
                                        <TextBlock Text="{Binding SelectedCategory.Badge}" Foreground="{Binding SelectedCategory.AccentColor}" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="ClockOutline" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedArticle.ReadingTime}" lt:Tokens.FontSize="DsFontSize200" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Summary Callout Box -->
                            <Border Background="{DynamicResource DsSurfaceBrush}"
                                    BorderBrush="{DynamicResource DsBorderBrush}"
                                    lt:Tokens.BorderThickness="DsCardBorder" lt:Tokens.CornerRadius="DsRadiusCard" Padding="18,14" lt:Tokens.BoxShadow="DsCardShadow">
                                <TextBlock Text="{Binding SelectedArticle.Summary}" lt:Tokens.FontSize="DsFontSize400" Foreground="{DynamicResource DsTextBrush}" TextWrapping="Wrap" LineHeight="22" />
                            </Border>

                            <!-- Article Sections -->
                            <ItemsControl ItemsSource="{Binding SelectedArticle.Sections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DocSection">
                                        <StackPanel lt:Tokens.Spacing="DsSpace10" Margin="0,0,0,18">
                                            <TextBlock Text="{Binding Heading}" lt:Tokens.FontSize="DsFontSize600" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                            <TextBlock Text="{Binding Content}" lt:Tokens.FontSize="DsFontSize400" Foreground="{DynamicResource DsTextBrush}" TextWrapping="Wrap" LineHeight="20" />

                                            <!-- Callout box -->
                                            <Border IsVisible="{Binding HasCallout}"
                                                    Background="{DynamicResource DsSurfaceBrush}"
                                                    BorderBrush="{DynamicResource DsBorderBrush}"
                                                    lt:Tokens.BorderThickness="DsCardBorder"
                                                    lt:Tokens.CornerRadius="DsRadiusCard" Padding="16,12" Margin="0,4" lt:Tokens.BoxShadow="DsCardShadow">
                                                <TextBlock Text="{Binding CalloutText}" lt:Tokens.FontSize="DsFontSize350" Foreground="{DynamicResource DsTextBrush}" TextWrapping="Wrap" LineHeight="20" />
                                            </Border>

                                            <!-- Bullet points -->
                                            <ItemsControl ItemsSource="{Binding BulletPoints}" IsVisible="{Binding HasBullets}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="Auto,*" Margin="4,2,0,2">
                                                            <TextBlock Grid.Column="0" Text="• " lt:Tokens.FontSize="DsFontSize400" Foreground="{DynamicResource DsPrimaryBrush}" lt:Tokens.FontWeight="DsWeightStrong" />
                                                            <TextBlock Grid.Column="1" Text="{Binding}" lt:Tokens.FontSize="DsFontSize350" Foreground="{DynamicResource DsTextBrush}" TextWrapping="Wrap" LineHeight="18" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- API Signatures -->
                            <StackPanel IsVisible="{Binding SelectedArticle.HasApiSignatures}" lt:Tokens.Spacing="DsSpace10">
                                <TextBlock Text="API Reference" lt:Tokens.FontSize="DsFontSize600" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                <ItemsControl ItemsSource="{Binding SelectedArticle.ApiSignatures}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:DocApiSignature">
                                            <Border Background="{DynamicResource DsSurfaceBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsCardBorder" lt:Tokens.CornerRadius="DsRadiusLG" Padding="14" Margin="0,0,0,8" lt:Tokens.BoxShadow="DsCardShadow">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="{Binding FullSignature}" lt:Tokens.FontFamily="DsCodeFontFamily" lt:Tokens.FontSize="DsFontSize350" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsGreenBrush}" />
                                                    <TextBlock Text="{Binding Description}" lt:Tokens.FontSize="DsFontSize300" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Code Snippets with Try in Studio & Copy -->
                            <StackPanel IsVisible="{Binding SelectedArticle.HasCodeSnippets}" lt:Tokens.Spacing="DsSpace12">
                                <TextBlock Text="Live Code Examples" lt:Tokens.FontSize="DsFontSize600" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                <ItemsControl ItemsSource="{Binding SelectedArticle.CodeSnippets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:DocCodeSnippet">
                                            <Border Background="{DynamicResource DsSurfaceBrush}"
                                                    BorderBrush="{DynamicResource DsBorderBrush}"
                                                    lt:Tokens.BorderThickness="DsCardBorder" lt:Tokens.CornerRadius="DsRadiusCard" Margin="0,0,0,12"
                                                    ClipToBounds="True" lt:Tokens.BoxShadow="DsCardShadow">
                                                <StackPanel Spacing="0">
                                                    <!-- Snippet Top Bar -->
                                                    <Border Background="{DynamicResource DsSurfaceHighBrush}"
                                                            BorderBrush="{DynamicResource DsBorderBrush}"
                                                            lt:Tokens.BorderThickness="DsBorderBottom"
                                                            Padding="14,10">
                                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" lt:Tokens.FontSize="DsFontSize400" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                                                <TextBlock Text="{Binding Description}" lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}" />
                                                            </StackPanel>
                                                            <!-- Copy Button -->
                                                            <Button Grid.Column="1"
                                                                    Command="{Binding $parent[UserControl].((docs:CSharpDocsViewModel)DataContext).CopySnippetCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Classes="nexus-btn-surface"
                                                                    lt:Tokens.Height="DsControlHeight200" Padding="10,0"
                                                                    Margin="0,0,8,0"
                                                                    ToolTip.Tip="Copy code to clipboard">
                                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                    <materialIcons:MaterialIcon Kind="ContentCopy" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                                                    <TextBlock Text="Copy Code" lt:Tokens.FontSize="DsFontSize250" lt:Tokens.FontWeight="DsWeightEmphasis" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                            <!-- Open in Studio: the way to edit and keep a sample (the main button when it can't run here) -->
                                                            <Button Grid.Column="2"
                                                                    Command="{Binding $parent[UserControl].((docs:CSharpDocsViewModel)DataContext).TryInStudioCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    IsVisible="{Binding HasRunner}"
                                                                    Classes="nexus-btn-surface"
                                                                    lt:Tokens.Height="DsControlHeight200" Padding="10,0"
                                                                    Margin="0,0,8,0"
                                                                    ToolTip.Tip="Open this sample in FrySharp to edit it">
                                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                    <materialIcons:MaterialIcon Kind="OpenInNew" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                                                    <TextBlock Text="Open in Studio" lt:Tokens.FontSize="DsFontSize250" lt:Tokens.FontWeight="DsWeightEmphasis" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Grid.Column="2"
                                                                    Command="{Binding $parent[UserControl].((docs:CSharpDocsViewModel)DataContext).TryInStudioCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    IsVisible="{Binding !HasRunner}"
                                                                    Classes="nexus-btn-primary"
                                                                    lt:Tokens.Height="DsControlHeight200" Padding="12,0"
                                                                    ToolTip.Tip="Launch this code sample directly in FrySharp">
                                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                    <materialIcons:MaterialIcon Kind="Play" Width="13" Height="13" Foreground="{DynamicResource DsOnAccentBrush}" />
                                                                    <TextBlock Text="Try in Studio" lt:Tokens.FontSize="DsFontSize250" lt:Tokens.FontWeight="DsWeightEmphasis" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                            <!-- Run: the sample runs here, its output opens under it -->
                                                            <Button Grid.Column="3"
                                                                    Command="{Binding Run.RunCommand}"
                                                                    IsVisible="{Binding HasRunner}"
                                                                    IsEnabled="{Binding Run.CanRunNow, FallbackValue=False}"
                                                                    Classes="nexus-btn-primary"
                                                                    lt:Tokens.Height="DsControlHeight200" Padding="12,0"
                                                                    ToolTip.Tip="Run this sample here and see its output below">
                                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                    <materialIcons:MaterialIcon Kind="Play" Width="13" Height="13" Foreground="{DynamicResource DsOnAccentBrush}" />
                                                                    <TextBlock Text="Run" lt:Tokens.FontSize="DsFontSize250" lt:Tokens.FontWeight="DsWeightEmphasis" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Multi-Language Tab Bar (C++ | Java | Python | C#) -->
                                                    <Border IsVisible="{Binding HasVariants}"
                                                            Background="{DynamicResource DsSurfaceBrush}"
                                                            BorderBrush="{DynamicResource DsBorderBrush}"
                                                            lt:Tokens.BorderThickness="DsBorderBottom"
                                                            Padding="12,5">
                                                        <ItemsControl ItemsSource="{Binding Variants}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:DocCodeLanguageVariant">
                                                                    <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                                                                        <Button Command="{Binding $parent[ItemsControl].((models:DocCodeSnippet)DataContext).SelectVariantCommand}"
                                                                                CommandParameter="{Binding}"
                                                                                Classes="doc-lang-tab"
                                                                                Classes.selected="{Binding IsSelected}">
                                                                            <TextBlock Text="{Binding DisplayLabel}" />
                                                                        </Button>
                                                                        <TextBlock Text="|" lt:Tokens.FontSize="DsFontSize200" Foreground="{DynamicResource DsMutedBrush}" Opacity="0.6"
                                                                                   VerticalAlignment="Center" Margin="4,0" IsVisible="{Binding HasSeparator}"
                                                                                   IsHitTestVisible="False" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>

                                                    <!-- Code Block Canvas -->
                                                    <Border Padding="6" Background="{DynamicResource DsBgBrush}">
                                                        <editor:CodeViewer Code="{Binding Code}" Language="{Binding Language}" />
                                                    </Border>

                                                    <!-- What the sample printed and drew when it was run here -->
                                                    <Border IsVisible="{Binding HasRunner}">
                                                        <docs1:SnippetOutputControl DataContext="{Binding Run}" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Keyboard Shortcuts Table -->
                            <StackPanel IsVisible="{Binding SelectedArticle.HasShortcuts}" lt:Tokens.Spacing="DsSpace10">
                                <TextBlock Text="Shortcut Reference" lt:Tokens.FontSize="DsFontSize600" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                <Border Background="{DynamicResource DsSurfaceBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsCardBorder" lt:Tokens.CornerRadius="DsRadiusCard" Padding="14" lt:Tokens.BoxShadow="DsCardShadow">
                                    <ItemsControl ItemsSource="{Binding SelectedArticle.Shortcuts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DocShortcutItem">
                                                <Border BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderBottom" Padding="6,8">
                                                    <Grid ColumnDefinitions="180,90,110,*">
                                                        <TextBlock Grid.Column="0" Text="{Binding Action}" lt:Tokens.FontSize="DsFontSize300" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" Background="{DynamicResource DsSurfaceHoverBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin"
                                                                Height="22" MinHeight="22" lt:Tokens.CornerRadius="DsRadiusSM" Padding="6,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding MacKey}" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontWeight="DsWeightStrong" lt:Tokens.FontFamily="DsCodeFontFamily" Foreground="{DynamicResource DsPrimaryBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0,1,0,0" />
                                                        </Border>
                                                        <Border Grid.Column="2" Background="{DynamicResource DsSurfaceHoverBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin"
                                                                Height="22" MinHeight="22" lt:Tokens.CornerRadius="DsRadiusSM" Padding="6,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding WinKey}" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontWeight="DsWeightStrong" lt:Tokens.FontFamily="DsCodeFontFamily" Foreground="{DynamicResource NavNotebooksFgBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0,1,0,0" />
                                                        </Border>
                                                        <TextBlock Grid.Column="3" Text="{Binding Description}" lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>

                            <!-- Footer Navigation (Prev / Next Topic) -->
                            <Grid ColumnDefinitions="*,16,*" Margin="0,16,0,0">
                                <Button Grid.Column="0"
                                        Command="{Binding PreviousArticleCommand}"
                                        IsVisible="{Binding HasPreviousArticle}"
                                        Classes="nexus-nav-item"
                                        Padding="14,10"
                                        HorizontalAlignment="Stretch">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <materialIcons:MaterialIcon Grid.Column="0" Kind="ArrowLeft" Width="18" Height="18" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="PREVIOUS TOPIC" lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsMutedBrush}" lt:Tokens.LetterSpacing="DsTracking100" />
                                            <TextBlock Text="Go to Previous Guide" lt:Tokens.FontSize="DsFontSize350" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Grid.Column="2"
                                        Command="{Binding NextArticleCommand}"
                                        IsVisible="{Binding HasNextArticle}"
                                        Classes="nexus-nav-item"
                                        Padding="14,10"
                                        HorizontalAlignment="Stretch">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="1">
                                            <TextBlock Text="NEXT TOPIC" lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsMutedBrush}" lt:Tokens.LetterSpacing="DsTracking100" HorizontalAlignment="Right" />
                                            <TextBlock Text="Continue to Next Guide" lt:Tokens.FontSize="DsFontSize350" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                        <materialIcons:MaterialIcon Grid.Column="1" Kind="ArrowRight" Width="18" Height="18" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </StackPanel>
                        <docs1:DocsOutlinePanelControl Grid.Column="1" IsVisible="{Binding IsOutlineVisible}" />
                    </Grid>
                </ScrollViewer>
            </Panel>
        </Grid>
    </Grid>
</UserControl>
