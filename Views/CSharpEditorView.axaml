<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Views.CSharpEditorView"
             x:DataType="vm:CSharpEditorViewModel">

    <UserControl.Styles>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 1. Top Navigation & Unified Command Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource M3SurfaceContainerLowBrush}"
                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,8">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <!-- Left: Back Button & Script Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Command="{Binding BackToManagerCommand}"
                            Classes="m3-tonal-btn"
                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                            Padding="12,6"
                            Cursor="Hand"
                            ToolTip.Tip="Return to Scripts &amp; Projects Dashboard">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="ArrowLeft" Width="16" Height="16" />
                            <TextBlock Text="Scripts Hub" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="20" Fill="{DynamicResource M3OutlineVariantBrush}" VerticalAlignment="Center" />

                    <!-- Editable Script Title -->
                    <TextBox Text="{Binding CurrentScript.Title, Mode=TwoWay}"
                             FontWeight="SemiBold" FontSize="13.5"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="4,2"
                             MinWidth="150"
                             PlaceholderText="Script Name..." />
                </StackPanel>

                <!-- Center Controls: Mode Switcher & LINQPad Execution Mode -->
                <StackPanel Grid.Column="1" Margin="14,0,0,0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- Segmented View Mode Toggle: [ 📓 Notebook | 💻 Studio ] -->
                    <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                            Padding="3">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <!-- Notebook Mode Tab -->
                            <ToggleButton IsChecked="{Binding IsNotebookMode, Mode=TwoWay}"
                                          Classes="m3-filter-chip"
                                          Padding="10,4"
                                          Cursor="Hand"
                                          ToolTip.Tip="Jupyter / Polyglot Notebook Mode (Interactive Cells)">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <materialIcons:MaterialIcon Kind="NotebookOutline" Width="14" Height="14" />
                                    <TextBlock Text="Notebook" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>

                            <!-- Script Mode Tab -->
                            <ToggleButton IsChecked="{Binding !IsNotebookMode, Mode=TwoWay}"
                                          Classes="m3-filter-chip"
                                          Padding="10,4"
                                          Cursor="Hand"
                                          ToolTip.Tip="LINQPad / Classic Full Studio Script Mode">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <materialIcons:MaterialIcon Kind="CodeBraces" Width="14" Height="14" />
                                    <TextBlock Text="Studio Script" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                    </Border>

                    <!-- LINQPad Execution Mode Dropdown (Only in Script Mode) -->
                    <ComboBox ItemsSource="{Binding LanguageModes}"
                              SelectedIndex="{Binding SelectedLanguageModeIndex, Mode=TwoWay}"
                              FontSize="11.5"
                              Padding="10,4"
                              CornerRadius="{StaticResource M3ShapeCornerFull}"
                              IsVisible="{Binding !IsNotebookMode}"
                              ToolTip.Tip="Execution Mode (LINQPad Statements, Program, or Expression)" />

                    <!-- Compiler Status Badge -->
                    <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                            Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="AutoFix" Width="14" Height="14"
                                                        Foreground="{DynamicResource M3PrimaryBrush}" />
                            <TextBlock Text="{Binding CompilerStatusText}"
                                       FontSize="11.5" FontWeight="Medium"
                                       Foreground="{DynamicResource M3OnSurfaceBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Action Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Save Button -->
                    <Button Command="{Binding SaveScriptCommand}"
                            Classes="m3-tonal-btn"
                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                            Padding="12,6"
                            ToolTip.Tip="Save Script &amp; Cells (Ctrl+S)"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="15" Height="15" />
                            <TextBlock Text="Save" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Stop Button -->
                    <Button Command="{Binding StopScriptCommand}"
                            Classes="m3-outlined-btn"
                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                            Padding="12,6"
                            BorderBrush="#EF4444"
                            Foreground="#EF4444"
                            IsVisible="{Binding IsExecuting}"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="Stop" Width="16" Height="16" Foreground="#EF4444" />
                            <TextBlock Text="Stop" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Run Button -->
                    <Button Command="{Binding RunScriptCommand}"
                            Classes="m3-filled-btn"
                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                            Padding="16,6"
                            IsEnabled="{Binding !IsExecuting}"
                            Cursor="Hand"
                            ToolTip.Tip="Execute C# Code (F5)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="Play" Width="16" Height="16" />
                            <TextBlock Text="Run (F5)" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Content Area (Notebook View VS Classic Studio View) -->
        <Grid Grid.Row="1">
            <!-- ============================================== -->
            <!-- MODE A: JUPYTER / POLYGLOT NOTEBOOK CELLS MODE -->
            <!-- ============================================== -->
            <Grid IsVisible="{Binding IsNotebookMode}" RowDefinitions="*,Auto">
                <!-- Cells Scroll Viewer -->
                <ScrollViewer Grid.Row="0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Margin="24,20,24,30">
                        <ItemsControl ItemsSource="{Binding NotebookCells}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NotebookCellViewModel">
                                    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                            Padding="0"
                                            Margin="0,0,0,14">
                                        <Grid RowDefinitions="Auto,Auto,Auto">
                                            <!-- Cell Header Bar -->
                                            <Border Grid.Row="0"
                                                    Background="{DynamicResource M3SurfaceContainerLowBrush}"
                                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="12,6">
                                                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                    <!-- Left: Run Button & Execution Badge -->
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Button Command="{Binding RunCellCommand}"
                                                                Classes="m3-filled-btn"
                                                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                                                Padding="8,4"
                                                                IsVisible="{Binding IsCodeCell}"
                                                                Cursor="Hand"
                                                                ToolTip.Tip="Execute this cell (Ctrl+Enter)">
                                                            <materialIcons:MaterialIcon Kind="Play" Width="13" Height="13" />
                                                        </Button>

                                                        <TextBlock Text="{Binding ExecutionBadgeText}"
                                                                   FontFamily="Consolas, monospace"
                                                                   FontSize="11.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource M3PrimaryBrush}"
                                                                   VerticalAlignment="Center" />

                                                        <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                                                CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                                                Padding="6,2">
                                                            <TextBlock Text="{Binding Type}"
                                                                       FontSize="10" FontWeight="Bold"
                                                                       Foreground="{DynamicResource WinMutedBrush}" />
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Center Elapsed Time -->
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                                                IsVisible="{Binding ExecutionTimeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                        <materialIcons:MaterialIcon Kind="TimerOutline" Width="13" Height="13" Foreground="{DynamicResource WinMutedBrush}" />
                                                        <TextBlock Text="{Binding ExecutionTimeText}" FontSize="11" Foreground="{DynamicResource WinMutedBrush}" />
                                                    </StackPanel>

                                                    <!-- Right: Cell Management Actions -->
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <Button Command="{Binding ToggleTypeCommand}"
                                                                Classes="m3-icon-btn"
                                                                ToolTip.Tip="Toggle Code / Markdown"
                                                                Cursor="Hand">
                                                            <materialIcons:MaterialIcon Kind="SwapHorizontal" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" />
                                                        </Button>

                                                        <Button Command="{Binding MoveUpCommand}"
                                                                Classes="m3-icon-btn"
                                                                ToolTip.Tip="Move Cell Up"
                                                                Cursor="Hand">
                                                            <materialIcons:MaterialIcon Kind="ArrowUp" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" />
                                                        </Button>

                                                        <Button Command="{Binding MoveDownCommand}"
                                                                Classes="m3-icon-btn"
                                                                ToolTip.Tip="Move Cell Down"
                                                                Cursor="Hand">
                                                            <materialIcons:MaterialIcon Kind="ArrowDown" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" />
                                                        </Button>

                                                        <Button Command="{Binding AddCodeBelowCommand}"
                                                                Classes="m3-icon-btn"
                                                                ToolTip.Tip="Add Code Cell Below"
                                                                Cursor="Hand">
                                                            <materialIcons:MaterialIcon Kind="PlusBoxOutline" Width="16" Height="16" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                        </Button>

                                                        <Button Command="{Binding AddMarkdownBelowCommand}"
                                                                Classes="m3-icon-btn"
                                                                ToolTip.Tip="Add Markdown Below"
                                                                Cursor="Hand">
                                                            <materialIcons:MaterialIcon Kind="FormatHeaderPound" Width="16" Height="16" Foreground="{DynamicResource M3SecondaryBrush}" />
                                                        </Button>

                                                        <Button Command="{Binding DeleteCommand}"
                                                                Classes="m3-icon-btn"
                                                                ToolTip.Tip="Delete Cell"
                                                                Cursor="Hand">
                                                            <materialIcons:MaterialIcon Kind="DeleteOutline" Width="16" Height="16" Foreground="#EF4444" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Cell Body (Editor) -->
                                            <Border Grid.Row="1" Background="#14171F" Padding="12,8">
                                                <TextBox Text="{Binding Source, Mode=TwoWay}"
                                                         AcceptsReturn="True"
                                                         AcceptsTab="True"
                                                         FontFamily="Consolas, Menlo, Monaco, Roboto Mono, monospace"
                                                         FontSize="13"
                                                         Foreground="#E2E8F0"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         MinHeight="80"
                                                         TextWrapping="Wrap" />
                                            </Border>

                                            <!-- Inline Cell Output Box (Directly Underneath) -->
                                            <Border Grid.Row="2"
                                                    Background="#0D1117"
                                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                    BorderThickness="0,1,0,0"
                                                    Padding="14,10"
                                                    IsVisible="{Binding HasOutput}">
                                                <Grid RowDefinitions="Auto,*">
                                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                                        <TextBlock Text="Output" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WinMutedBrush}" />
                                                        <Button Grid.Column="1" Command="{Binding ClearOutputCommand}"
                                                                Classes="m3-icon-btn" ToolTip.Tip="Clear Cell Output" Cursor="Hand">
                                                            <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" />
                                                        </Button>
                                                    </Grid>
                                                    <TextBox Grid.Row="1"
                                                             Text="{Binding OutputText, Mode=OneWay}"
                                                             FontFamily="Consolas, Menlo, Monaco, monospace"
                                                             FontSize="12"
                                                             Foreground="#58A6FF"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             IsReadOnly="True"
                                                             TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Notebook Bottom Quick-Add Bar -->
                <Border Grid.Row="1"
                        Background="{DynamicResource M3SurfaceContainerLowBrush}"
                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                        <Button Command="{Binding AddCodeCellCommand}"
                                Classes="m3-tonal-btn"
                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                Padding="14,6"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Plus" Width="16" Height="16" />
                                <TextBlock Text="+ Code Cell" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AddMarkdownCellCommand}"
                                Classes="m3-tonal-btn"
                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                Padding="14,6"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="FormatHeaderPound" Width="16" Height="16" />
                                <TextBlock Text="+ Markdown Note" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding RunAllCellsCommand}"
                                Classes="m3-filled-btn"
                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                Padding="16,6"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="PlayBoxMultipleOutline" Width="16" Height="16" />
                                <TextBlock Text="Run All Cells" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ClearAllCellOutputsCommand}"
                                Classes="m3-outlined-btn"
                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                Padding="14,6"
                                Cursor="Hand">
                            <TextBlock Text="Clear All Outputs" FontSize="12" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================================== -->
            <!-- MODE B: CLASSIC STUDIO SCRIPT MODE (LINQPAD)   -->
            <!-- ============================================== -->
            <Grid IsVisible="{Binding !IsNotebookMode}" RowDefinitions="*,Auto">
                <!-- Central Code Editor -->
                <Border Grid.Row="0" Background="#14171F">
                    <avaloniaEdit:TextEditor Name="Editor"
                                             FontFamily="Consolas, Menlo, Monaco, Roboto Mono, monospace"
                                             FontSize="13.5"
                                             ShowLineNumbers="True"
                                             WordWrap="False"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto"
                                             Background="#14171F"
                                             Foreground="#E2E8F0" />
                </Border>

                <!-- Bottom Tool Deck (Problems / Output / References) -->
                <Border Grid.Row="1"
                        Height="220"
                        Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                        BorderThickness="0,1,0,0"
                        IsVisible="{Binding IsToolDeckExpanded}">
                    <Grid RowDefinitions="Auto,*">
                        <!-- Tool Deck Header Tabs -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource M3SurfaceContainerLowBrush}"
                                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,4">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                    <!-- Problems Tab Button -->
                                    <Button Classes="m3-segment-btn"
                                            Command="{Binding $parent[UserControl].((vm:CSharpEditorViewModel)DataContext).SetToolTabCommand}"
                                            CommandParameter="0"
                                            Padding="10,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="14" Height="14"
                                                                        Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="Problems" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                                            <Border Background="#EF4444" CornerRadius="10" Padding="5,1"
                                                    IsVisible="{Binding ErrorCount}">
                                                <TextBlock Text="{Binding ErrorCount}" FontSize="9.5" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                    </Button>

                                    <!-- Console Output Tab Button -->
                                    <Button Classes="m3-segment-btn"
                                            Command="{Binding $parent[UserControl].((vm:CSharpEditorViewModel)DataContext).SetToolTabCommand}"
                                            CommandParameter="1"
                                            Padding="10,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <materialIcons:MaterialIcon Kind="Console" Width="14" Height="14"
                                                                        Foreground="{DynamicResource M3SecondaryBrush}" />
                                            <TextBlock Text="Console Output (.Dump)" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- References Tab Button -->
                                    <Button Classes="m3-segment-btn"
                                            Command="{Binding $parent[UserControl].((vm:CSharpEditorViewModel)DataContext).SetToolTabCommand}"
                                            CommandParameter="2"
                                            Padding="10,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <materialIcons:MaterialIcon Kind="PackageVariantClosed" Width="14" Height="14"
                                                                        Foreground="{DynamicResource WinMutedBrush}" />
                                            <TextBlock Text="Assembly References" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Right Actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                    <Button Command="{Binding ClearConsoleCommand}"
                                            Classes="m3-icon-btn"
                                            ToolTip.Tip="Clear Console"
                                            Cursor="Hand">
                                        <materialIcons:MaterialIcon Kind="Eraser" Width="15" Height="15"
                                                                    Foreground="{DynamicResource WinMutedBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Tool Deck Content -->
                        <Carousel Grid.Row="1" SelectedIndex="{Binding SelectedToolTabIndex}">
                            <!-- Tab 0: Problems / Diagnostics -->
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="12,8">
                                    <TextBlock Text="No diagnostics issues detected. Ready to build."
                                               FontSize="12" Foreground="{DynamicResource WinMutedBrush}"
                                               Margin="10"
                                               IsVisible="{Binding !Diagnostics.Count}" />

                                    <ItemsControl ItemsSource="{Binding Diagnostics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DiagnosticItemViewModel">
                                                <Border Background="Transparent"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="8,6">
                                                    <Button Command="{Binding NavigateCommand}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            Padding="0"
                                                            Cursor="Hand">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <materialIcons:MaterialIcon Grid.Column="0"
                                                                                        Kind="{Binding SeverityIconKind}"
                                                                                        Foreground="{Binding SeverityColorHex}"
                                                                                        Width="16" Height="16"
                                                                                        Margin="0,0,8,0"
                                                                                        VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Id}" FontWeight="Bold" FontSize="11.5"
                                                                           Foreground="{Binding SeverityColorHex}" />
                                                                <TextBlock Text="{Binding Message}" FontSize="12"
                                                                           Foreground="{DynamicResource M3OnSurfaceBrush}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding LocationString}"
                                                                       FontSize="11" Foreground="{DynamicResource WinMutedBrush}"
                                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                                        </Grid>
                                                    </Button>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Tab 1: Console Output -->
                            <Border Background="#0D1117" Padding="12,8">
                                <ScrollViewer Name="ConsoleScrollViewer"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto">
                                    <TextBox Text="{Binding ConsoleOutput, Mode=OneWay}"
                                             FontFamily="Consolas, Menlo, Monaco, monospace"
                                             FontSize="12"
                                             Background="Transparent"
                                             Foreground="#58A6FF"
                                             BorderThickness="0"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Border>

                            <!-- Tab 2: Assembly References -->
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding References}" Margin="12,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AssemblyReferenceViewModel">
                                            <Border Padding="8,4"
                                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="PackageVariant" Width="16" Height="16"
                                                                                Foreground="{DynamicResource M3PrimaryBrush}"
                                                                                Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                                        <TextBlock Text="{Binding AssemblyPath}" FontSize="10.5"
                                                                   Foreground="{DynamicResource WinMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsEnabled}"
                                                              IsEnabled="{Binding !IsSystem}"
                                                              VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Carousel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 3. Bottom Status Bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource M3SurfaceContainerLowBrush}"
                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,4">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding CaretLine, StringFormat='{}Ln {0}'}"
                               FontSize="11" Foreground="{DynamicResource WinMutedBrush}"
                               IsVisible="{Binding !IsNotebookMode}" />
                    <TextBlock Text="{Binding CaretColumn, StringFormat='{}Col {0}'}"
                               FontSize="11" Foreground="{DynamicResource WinMutedBrush}"
                               IsVisible="{Binding !IsNotebookMode}" />
                    <TextBlock Text="{Binding NotebookCells.Count, StringFormat='{}{0} Cells'}"
                               FontSize="11" Foreground="{DynamicResource WinMutedBrush}"
                               IsVisible="{Binding IsNotebookMode}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16">
                    <TextBlock Text=".NET 10 (C# 13) + Roslyn"
                               FontSize="11" Foreground="{DynamicResource WinMutedBrush}" />
                    <TextBlock Text="LINQPad .Dump Ready"
                               FontSize="11" Foreground="{DynamicResource M3PrimaryBrush}" />
                    <TextBlock Text="UTF-8"
                               FontSize="11" Foreground="{DynamicResource WinMutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
