<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="300"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Views.DumpTableView"
             x:DataType="models:DumpTableResult">

    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Margin="0,0,0,12"
            HorizontalAlignment="Stretch">
        <StackPanel>
            <!-- 1. Header Banner (e.g. ▲ Int32[9] •••) -->
            <Border Background="{DynamicResource M3PrimaryBrush}"
                    CornerRadius="5,5,0,0"
                    Padding="10,6">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Collapse Toggle Button & Type Title -->
                    <Button Grid.Column="0"
                            Command="{Binding ToggleCollapseCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CollapseIcon}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource M3OnPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FullHeaderTitle}"
                                       FontSize="12.5" FontWeight="Bold"
                                       Foreground="{DynamicResource M3OnPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SummaryText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource M3OnPrimaryBrush}"
                                       Opacity="0.85"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0" />
                        </StackPanel>
                    </Button>

                    <!-- Actions Menu (•••) -->
                    <Button Grid.Column="2"
                            Width="28" Height="22"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand"
                            ToolTip.Tip="Copy &amp; Export Table">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Copy as TSV (Excel / Google Sheets)"
                                          Command="{Binding CopyTsvCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="FileExcelOutline" Width="16" Height="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Copy as CSV"
                                          Command="{Binding CopyCsvCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="FileDelimitedOutline" Width="16" Height="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Copy as JSON"
                                          Command="{Binding CopyJsonCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="CodeJson" Width="16" Height="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        <TextBlock Text="•••"
                                   FontSize="13" FontWeight="Heavy"
                                   Foreground="{DynamicResource M3OnPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Grid Table Body (Hidden when collapsed) -->
            <Border x:Name="TableBodyBorder"
                    IsVisible="{Binding !IsCollapsed}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    BorderThickness="0,1,0,0"
                    HorizontalAlignment="Stretch">
                <ScrollViewer x:Name="TableScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid x:Name="TableGrid"
                          HorizontalAlignment="Stretch"
                          MinWidth="{Binding #TableScrollViewer.Bounds.Width}" />
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
