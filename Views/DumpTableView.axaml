<UserControl xmlns:lt="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Extensibility.Theming.Layout;assembly=CSharpEditorPlugin" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             xmlns:views="using:PdfEditorApp.Plugins.CSharpEditor.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="300"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Views.DumpTableView"
             x:DataType="models:DumpTableResult">

    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
            lt:Tokens.BorderThickness="DsBorderThin"
            lt:Tokens.CornerRadius="DsRadiusMD"
            Margin="0,0,0,12"
            HorizontalAlignment="Stretch">
        <DockPanel>
            <!-- 1. Header Banner (VS Code Data Viewer Header) -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource M3SurfaceContainerHighBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    lt:Tokens.BorderThickness="DsBorderBottom"
                    lt:Tokens.CornerRadius="DsRadiusSMTop"
                    Padding="10,6">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <!-- Collapse Toggle Button & Type Title -->
                    <Button Grid.Column="0"
                            Command="{Binding ToggleCollapseCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand"
                            ToolTip.Tip="Toggle collapse table">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CollapseIcon}"
                                       lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontWeight="DsWeightStrong"
                                       Foreground="{DynamicResource M3PrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FullHeaderTitle}"
                                       lt:Tokens.FontSize="DsFontSize300" lt:Tokens.FontWeight="DsWeightEmphasis"
                                       Foreground="{DynamicResource M3OnSurfaceBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SummaryText}"
                                       lt:Tokens.FontSize="DsFontSize200"
                                       Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0" />
                        </StackPanel>
                    </Button>

                    <!-- Spacer -->
                    <Panel Grid.Column="1" />

                    <!-- Live Filter / Search Input -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            lt:Tokens.BorderThickness="DsBorderThin"
                            lt:Tokens.CornerRadius="DsRadiusSM"
                            Height="24"
                            Margin="8,0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Filter table rows in real-time">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <materialIcons:MaterialIcon Grid.Column="0"
                                                        Kind="Magnify"
                                                        Width="13" Height="13"
                                                        Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                        Margin="6,0,2,0"
                                                        VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding FilterText, Mode=TwoWay}"
                                     PlaceholderText="Filter rows..."
                                     lt:Tokens.FontSize="DsFontSize200"
                                     Width="130"
                                     Height="22"
                                     Padding="2,1"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center" />
                            <Button Grid.Column="2"
                                    Command="{Binding ClearFilterCommand}"
                                    IsVisible="{Binding FilterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="2"
                                    Margin="0,0,4,0"
                                    Cursor="Hand"
                                    ToolTip.Tip="Clear filter">
                                <materialIcons:MaterialIcon Kind="Close" Width="11" Height="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Actions Menu (•••) -->
                    <Button Grid.Column="3"
                            Width="28" Height="22"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand"
                            ToolTip.Tip="Copy &amp; Export Table">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Copy as TSV (Excel / Google Sheets)"
                                          Command="{Binding CopyTsvCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="FileExcelOutline" Width="16" Height="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Copy as CSV"
                                          Command="{Binding CopyCsvCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="FileDelimitedOutline" Width="16" Height="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Copy as JSON"
                                          Command="{Binding CopyJsonCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="CodeJson" Width="16" Height="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Copy as Markdown Table"
                                          Command="{Binding CopyMarkdownCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="LanguageMarkdown" Width="16" Height="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Reset Filters &amp; Sorting"
                                          Command="{Binding ResetAllCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="Refresh" Width="16" Height="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        <TextBlock Text="•••"
                                   lt:Tokens.FontSize="DsFontSize400" lt:Tokens.FontWeight="DsWeightStrong"
                                   Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Table Body (Hidden when collapsed): the column headers, then the rows. Only the rows on screen are
                 built (a virtualized list), so a table of 100,000 rows costs what a table of 30 does. -->
            <Border x:Name="TableBodyBorder"
                    IsVisible="{Binding !IsCollapsed}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    lt:Tokens.BorderThickness="DsBorderTop"
                    HorizontalAlignment="Stretch">
                <ScrollViewer x:Name="TableScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid x:Name="TableHost" RowDefinitions="Auto,Auto,*" HorizontalAlignment="Left">
                        <Grid x:Name="TableGrid" Grid.Row="0" />
                        <Border x:Name="EmptyRow" Grid.Row="1" Padding="16,14" IsVisible="False">
                            <TextBlock x:Name="EmptyText" lt:Tokens.FontSize="DsFontSize300" FontStyle="Italic" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                        </Border>
                        <views:DumpTableRowsList x:Name="RowsPart" Grid.Row="2" />
                    </Grid>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
