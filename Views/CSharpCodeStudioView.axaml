<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             xmlns:views="using:PdfEditorApp.Plugins.CSharpEditor.Views"
             xmlns:services="using:PdfEditorApp.Plugins.CSharpEditor.Services"
             xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             xmlns:codeStudio="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.CodeStudio"
             xmlns:studio="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Studio"
             xmlns:activities="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Activities"
             xmlns:common="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.Common"
             xmlns:docs="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Docs"
             xmlns:editor="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Editor"
             xmlns:visuals="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Visuals"
             xmlns:overlays="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Overlays"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="820"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Views.CSharpCodeStudioView"
             x:DataType="codeStudio:CSharpCodeStudioViewModel">


    <UserControl.Styles>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto" Background="{DynamicResource DsBgBrush}">
        <!-- ============================================================ -->
        <!-- 1. MAIN WORKSPACE (Activity Bar + SideBar + Splitter + Editor) -->
        <!-- ============================================================ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="{Binding SideBarGridLength, Mode=TwoWay}" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- ======================================================== -->
            <!-- 1A. ACTIVITY BAR (Column 0, 48px fixed)                  -->
            <!-- ======================================================== -->
            <studio:StudioActivityBarControl Grid.Column="0" />

            <!-- ======================================================== -->
            <!-- 1B. PRIMARY SIDEBAR (Column 1, Resizable, Collapsible)   -->
            <!-- ======================================================== -->
            <Border Grid.Column="1"
                    IsVisible="{Binding IsSideBarVisible}"
                    MinWidth="160"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource DsSurfaceBrush}"
                    BorderBrush="{DynamicResource DsBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*">
                    <!-- SideBar Header -->
                    <Border Grid.Row="0" Height="36"
                            BorderBrush="{DynamicResource DsBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,0,8,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding SideBarTitle}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource DsTextWhiteBrush}"
                                       VerticalAlignment="Center" />

                            <!-- Explorer Tools (View 0) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center"
                                        IsVisible="{Binding IsExplorerActive}">
                                <Button Classes="explorer-tool-btn" ToolTip.Tip="New File...">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="OnNewFileFlyoutOpening">
                                            <MenuItem Header="New C# Script (.csx)" Command="{Binding NewScriptCommand}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="LanguageCsharp" Width="14" Height="14" Foreground="{DynamicResource NavScriptsFgBrush}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <materialIcons:MaterialIcon Kind="FilePlusOutline" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                                <Button Command="{Binding NewFolderCommand}" Classes="explorer-tool-btn" ToolTip.Tip="New Folder">
                                    <materialIcons:MaterialIcon Kind="FolderPlusOutline" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                                <Button Click="OnOpenProjectClick" Classes="explorer-tool-btn" ToolTip.Tip="Open Project or File... (Ctrl+O)">
                                    <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                                <Button Command="{Binding RefreshExplorerCommand}" Classes="explorer-tool-btn" ToolTip.Tip="Refresh Explorer">
                                    <materialIcons:MaterialIcon Kind="Refresh" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                                <Button Command="{Binding CollapseAllExplorerCommand}" Classes="explorer-tool-btn" ToolTip.Tip="Collapse Folders">
                                    <materialIcons:MaterialIcon Kind="ArrowCollapseVertical" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                                <Button Command="{Binding ToggleSideBarCommand}" Classes="explorer-tool-btn" ToolTip.Tip="Hide Primary Side Bar (Ctrl+B)">
                                    <materialIcons:MaterialIcon Kind="ChevronLeft" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                            </StackPanel>

                            <!-- Search Tools (View 1) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                                        IsVisible="{Binding IsSearchActive}">
                                <Button Command="{Binding ExecuteSearchCommand}" Classes="explorer-tool-btn" ToolTip.Tip="Refresh Search">
                                    <materialIcons:MaterialIcon Kind="Refresh" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                                <Button Command="{Binding ToggleSideBarCommand}" Classes="explorer-tool-btn" ToolTip.Tip="Hide Primary Side Bar (Ctrl+B)">
                                    <materialIcons:MaterialIcon Kind="ChevronLeft" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                            </StackPanel>

                            <!-- Debug Tools (View 2) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                                        IsVisible="{Binding IsDebugActive}">
                                <Button Command="{Binding ClearAllBreakpointsCommand}" Classes="explorer-tool-btn" ToolTip.Tip="Clear All Breakpoints" IsVisible="{Binding Breakpoints.Count}">
                                    <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                                <Button Command="{Binding ToggleSideBarCommand}" Classes="explorer-tool-btn" ToolTip.Tip="Hide Primary Side Bar (Ctrl+B)">
                                    <materialIcons:MaterialIcon Kind="ChevronLeft" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                            </StackPanel>

                            <!-- Default Close Button for Views 3-5 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                                        IsVisible="{Binding !IsExplorerActive}">
                                <Button Command="{Binding ToggleSideBarCommand}" Classes="explorer-tool-btn" ToolTip.Tip="Hide Primary Side Bar (Ctrl+B)"
                                        IsVisible="{Binding !IsSearchActive}">
                                    <materialIcons:MaterialIcon Kind="ChevronLeft" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Explorer work (listing a big folder, opening a workspace): a line along the header's bottom edge -->
                    <activities:ActivityProgressLine Grid.Row="0" Location="Explorer" VerticalAlignment="Bottom" ZIndex="1" />

                    <!-- SideBar Carousel Pages -->
                    <Carousel Grid.Row="1" SelectedIndex="{Binding SelectedActivityBarIndex}">

                        <!-- Page 0: Explorer Tree -->
                        <studio:StudioExplorerPanelControl OpenProjectRequested="OnOpenProjectClick" />

                        <!-- Page 1: Search in Active Script -->
                        <studio:StudioSearchPanelControl />

                        <!-- Page 2: Run & Debug Sidebar Panel -->
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,8" Spacing="10">
                                <!-- Launch Action Buttons -->
                                <StackPanel Spacing="6">
                                    <Button Command="{Binding DebugCodeCommand}" Classes="cs-toolbar-filled"
                                            Background="{DynamicResource DsPrimaryBrush}" Foreground="{DynamicResource DsTextWhiteBrush}"
                                            IsEnabled="{Binding !IsExecuting}" IsVisible="{Binding !IsDebugging}"
                                            HorizontalAlignment="Stretch" Height="32" CornerRadius="6"
                                            ToolTip.Tip="Start Interactive Debugging (F5)">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="BugPlay" Width="15" Height="15" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="Start Debugging (F5)" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding RunCodeCommand}" Classes="cs-toolbar-tonal"
                                            Background="{DynamicResource DsSurfaceHighBrush}"
                                            BorderBrush="{DynamicResource DsBorderBrush}"
                                            BorderThickness="1"
                                            Foreground="{DynamicResource DsTextWhiteBrush}"
                                            IsEnabled="{Binding !IsExecuting}" IsVisible="{Binding !IsDebugging}"
                                            HorizontalAlignment="Stretch" Height="32" CornerRadius="6"
                                            ToolTip.Tip="Run without Debugging (Ctrl+F5)">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Play" Width="15" Height="15" Foreground="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="Run Without Debugging" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Stepping Controls (Visible when active debugging) -->
                                <Border Background="{DynamicResource DsSurfaceHighBrush}" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6" IsVisible="{Binding IsDebugging}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="DEBUGGING ACTIVE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DsPrimaryBrush}" HorizontalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <Button Command="{Binding ContinueDebugCommand}" Classes="cs-toolbar-filled" Background="{DynamicResource DsPrimaryBrush}" Foreground="{DynamicResource DsTextWhiteBrush}" IsVisible="{Binding IsPaused}" ToolTip.Tip="Continue (F5)">
                                                <materialIcons:MaterialIcon Kind="Play" Width="14" Height="14" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                            </Button>
                                            <Button Command="{Binding StepOverCommand}" Classes="cs-toolbar-tonal" IsVisible="{Binding IsPaused}" ToolTip.Tip="Step Over (F10)">
                                                <materialIcons:MaterialIcon Kind="DebugStepOver" Width="14" Height="14" />
                                            </Button>
                                            <Button Command="{Binding StepIntoCommand}" Classes="cs-toolbar-tonal" IsVisible="{Binding IsPaused}" ToolTip.Tip="Step Into (F11)">
                                                <materialIcons:MaterialIcon Kind="DebugStepInto" Width="14" Height="14" />
                                            </Button>
                                            <Button Command="{Binding RestartDebugCommand}" Classes="cs-toolbar-icon" ToolTip.Tip="Restart">
                                                <materialIcons:MaterialIcon Kind="Restart" Width="14" Height="14" />
                                            </Button>
                                            <Button Command="{Binding StopDebugCommand}" Classes="cs-toolbar-outlined" BorderBrush="{DynamicResource DsErrorBrush}" Foreground="{DynamicResource DsErrorBrush}" ToolTip.Tip="Stop (Shift+F5)">
                                                <materialIcons:MaterialIcon Kind="Stop" Width="14" Height="14" Foreground="{DynamicResource DsErrorBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Call Stack Section (innermost frame first) -->
                                <Border Background="{DynamicResource DsSurfaceHighBrush}" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" IsVisible="{Binding IsPaused}">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="CALL STACK" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Background="{DynamicResource DsSurfaceBrush}" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1"
                                                    Height="18" MinHeight="18" MinWidth="18" CornerRadius="9" Padding="4,0"
                                                    VerticalAlignment="Center" ToolTip.Tip="Frames on the stack">
                                                <TextBlock Text="{Binding CallStack.Count}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource DsPrimaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0,1,0,0" />
                                            </Border>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding CallStack}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:CallStackFrameItem">
                                                    <Grid ColumnDefinitions="14,*,Auto" Margin="0,1">
                                                        <materialIcons:MaterialIcon Grid.Column="0" Kind="ArrowRightBold" Width="11" Height="11" Foreground="{DynamicResource DsPrimaryBrush}" IsVisible="{Binding IsCurrentFrame}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding MethodName}" ToolTip.Tip="{Binding MethodName}" FontFamily="Consolas, monospace" FontSize="10.5" Foreground="{DynamicResource DsTextWhiteBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding LineNumber, StringFormat='Ln {0}'}" FontSize="10" Foreground="{DynamicResource DsMutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Breakpoints Section -->
                                <Border Background="{DynamicResource DsSurfaceHighBrush}" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="BREAKPOINTS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Background="{DynamicResource DsSurfaceBrush}" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1"
                                                    Height="18" MinHeight="18" MinWidth="18" CornerRadius="9" Padding="4,0"
                                                    VerticalAlignment="Center" IsVisible="{Binding Breakpoints.Count}">
                                                <TextBlock Text="{Binding Breakpoints.Count}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource DsErrorBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0,1,0,0" />
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="No breakpoints. Click the gutter or press F9." FontSize="10.5" Foreground="{DynamicResource DsMutedBrush}" IsVisible="{Binding !Breakpoints.Count}" />

                                        <ItemsControl ItemsSource="{Binding Breakpoints}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:BreakpointItem">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                  Command="{Binding $parent[UserControl].((codeStudio:CSharpCodeStudioViewModel)DataContext).ToggleBreakpointEnabledCommand}"
                                                                  CommandParameter="{Binding}" Margin="0,0,4,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayText}" FontSize="11" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                                                        <Button Grid.Column="2" Command="{Binding $parent[UserControl].((codeStudio:CSharpCodeStudioViewModel)DataContext).RemoveBreakpointCommand}" CommandParameter="{Binding}" Classes="explorer-tool-btn" Width="18" Height="18">
                                                            <materialIcons:MaterialIcon Kind="Close" Width="10" Height="10" Foreground="{DynamicResource DsMutedBrush}" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Watch Expressions Section -->
                                <Border Background="{DynamicResource DsSurfaceHighBrush}" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="WATCH EXPRESSIONS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource DsMutedBrush}" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding WatchInputText, Mode=TwoWay}"
                                                     Classes="sidebar-search-box" PlaceholderText="Expression to watch...">
                                                <TextBox.KeyBindings>
                                                    <KeyBinding Gesture="Enter" Command="{Binding AddWatchCommand}" />
                                                </TextBox.KeyBindings>
                                            </TextBox>
                                            <Button Grid.Column="1" Command="{Binding AddWatchCommand}" Classes="cs-toolbar-tonal" Height="28" MinHeight="0" Margin="4,0,0,0">
                                                <materialIcons:MaterialIcon Kind="Plus" Width="13" Height="13" />
                                            </Button>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding WatchExpressions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:WatchExpressionItem">
                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                        <TextBlock Grid.Column="0" Text="{Binding Expression, StringFormat='{}{0}: '}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource DsPrimaryBrush}" />
                                                        <Button Grid.Column="1" Command="{Binding $parent[UserControl].((codeStudio:CSharpCodeStudioViewModel)DataContext).RemoveWatchCommand}" CommandParameter="{Binding}" Classes="explorer-tool-btn" Width="18" Height="18">
                                                            <materialIcons:MaterialIcon Kind="Close" Width="10" Height="10" Foreground="{DynamicResource DsMutedBrush}" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Page 3: Dependencies & NuGet -->
                        <studio:StudioDependenciesPanelControl />

                        <!-- Page 4: Scratchpad & Documentation Notes: rendered markdown, or the markdown source while editing -->
                        <Grid RowDefinitions="Auto,*">
                            <Border Grid.Row="0" Background="{DynamicResource DsSurfaceBrush}" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="0,0,0,1" Padding="12,3,8,3">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="DOCUMENTATION &amp; NOTES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Notes.Length, StringFormat='{}{0} chars'}" FontSize="10" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" Margin="8,0" />
                                    <Button Grid.Column="2" Command="{Binding ToggleNotesPreviewCommand}"
                                            Classes="snippet-action-btn" Height="22" MinHeight="0" Padding="7,0">
                                        <Panel>
                                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsNotesPreviewMode}"
                                                         ToolTip.Tip="Edit the markdown">
                                                <materialIcons:MaterialIcon Kind="PencilOutline" Width="12" Height="12" VerticalAlignment="Center" />
                                                <TextBlock Text="Edit" FontSize="10.5" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsEditingNotes}"
                                                         ToolTip.Tip="Show the notes rendered">
                                                <materialIcons:MaterialIcon Kind="Check" Width="12" Height="12" VerticalAlignment="Center" />
                                                <TextBlock Text="Done" FontSize="10.5" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Panel>
                                    </Button>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" IsVisible="{Binding IsNotesPreviewMode}"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                          Background="{DynamicResource DsBgBrush}">
                                <Panel Margin="14,12">
                                    <docs:MarkdownView Markdown="{Binding Notes}"
                                                           FontSize="12.5" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                    <TextBlock Text="No notes yet. Click Edit to write requirements, plans or scratch work in markdown."
                                               IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                               FontSize="11.5" TextWrapping="Wrap"
                                               Foreground="{DynamicResource DsMutedBrush}" />
                                </Panel>
                            </ScrollViewer>

                            <TextBox x:Name="NotesEditor" Grid.Row="1" IsVisible="{Binding IsEditingNotes}"
                                     Text="{Binding Notes, Mode=TwoWay}"
                                     AcceptsReturn="True" AcceptsTab="True"
                                     FontFamily="Consolas, Menlo, Monaco, monospace" FontSize="12"
                                     Foreground="{DynamicResource DsTextWhiteBrush}" Background="{DynamicResource DsBgBrush}"
                                     BorderThickness="0" Padding="10" TextWrapping="Wrap"
                                     PlaceholderText="// Write requirements, scratchpad notes, or plans here (markdown)..." />
                        </Grid>

                        <!-- Page 5: Problems & Roslyn Diagnostics -->
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,8" Spacing="6">
                                <TextBlock Text="No problems detected in script."
                                           FontSize="11.5" Foreground="{DynamicResource DsMutedBrush}"
                                           Margin="8" IsVisible="{Binding !Diagnostics.Count}" />

                                <ItemsControl ItemsSource="{Binding Diagnostics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="common:DiagnosticItemViewModel">
                                            <Button Command="{Binding NavigateCommand}"
                                                    Background="Transparent" BorderThickness="0"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                    Padding="4" Cursor="Hand">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding SeverityIconKind}" Foreground="{Binding SeverityColorHex}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Top" />
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{DynamicResource DsTextWhiteBrush}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding LocationString}" FontSize="9.5" Foreground="{DynamicResource DsMutedBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Page 6: Source Control (Git) -->
                        <studio:StudioSourceControlPanelControl />

                    </Carousel>
                </Grid>
            </Border>

            <!-- ======================================================== -->
            <!-- 1C. VERTICAL SPLITTER (Column 2)                         -->
            <!-- ======================================================== -->
            <GridSplitter Grid.Column="2"
                          Classes="studio-sash"
                          Width="4"
                          ResizeDirection="Columns"
                          Cursor="SizeWestEast"
                          IsVisible="{Binding IsSideBarVisible}" />

            <!-- ======================================================== -->
            <!-- 1D. EDITOR & BOTTOM TOOL DECK (Column 3)                 -->
            <!-- ======================================================== -->
            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" MinHeight="100" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="{Binding BottomDeckGridLength, Mode=TwoWay}" MinHeight="0" />
                </Grid.RowDefinitions>

                <!-- Opening a file that takes a while: a line along the tab bar's bottom edge (VS Code's editor progress) -->
                <activities:ActivityProgressLine Grid.Row="0" Location="Editor" VerticalAlignment="Bottom" ZIndex="1" />

                <!-- Row 0: VS Code Editor Tab Bar & Actions Strip -->
                <Border Grid.Row="0"
                        Background="{DynamicResource DsSurfaceBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Height="35"
                        Padding="0,0,8,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- Scrollable Multi-Tab Document Strip -->
                        <studio:StudioTabBarControl Grid.Column="0" />

                        <!-- Right-Side Editor Action Toolbar -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <!-- Stepping Controls (Visible when active debugging) -->
                            <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding IsDebugging}" VerticalAlignment="Center">
                                <Button Command="{Binding ContinueDebugCommand}" Classes="cs-toolbar-filled" Background="{DynamicResource DsPrimaryBrush}" Foreground="{DynamicResource DsTextWhiteBrush}" IsVisible="{Binding IsPaused}" ToolTip.Tip="Continue (F5)" Width="28" Height="26" Padding="0">
                                    <materialIcons:MaterialIcon Kind="Play" Width="13" Height="13" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                                </Button>
                                <Button Command="{Binding StepOverCommand}" Classes="cs-toolbar-tonal" IsVisible="{Binding IsPaused}" ToolTip.Tip="Step Over (F10)" Width="28" Height="26" Padding="0">
                                    <materialIcons:MaterialIcon Kind="DebugStepOver" Width="13" Height="13" VerticalAlignment="Center" />
                                </Button>
                                <Button Command="{Binding StepIntoCommand}" Classes="cs-toolbar-tonal" IsVisible="{Binding IsPaused}" ToolTip.Tip="Step Into (F11)" Width="28" Height="26" Padding="0">
                                    <materialIcons:MaterialIcon Kind="DebugStepInto" Width="13" Height="13" VerticalAlignment="Center" />
                                </Button>
                                <Button Command="{Binding RestartDebugCommand}" Classes="cs-toolbar-icon" ToolTip.Tip="Restart Debugging">
                                    <materialIcons:MaterialIcon Kind="Restart" Width="13" Height="13" VerticalAlignment="Center" />
                                </Button>
                                <Button Command="{Binding StopDebugCommand}" Classes="cs-toolbar-outlined" BorderBrush="{DynamicResource DsErrorBrush}" Foreground="{DynamicResource DsErrorBrush}" ToolTip.Tip="Stop (Shift+F5)" Width="28" Height="26" Padding="0">
                                    <materialIcons:MaterialIcon Kind="Stop" Width="13" Height="13" Foreground="{DynamicResource DsErrorBrush}" VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>

                            <!-- Normal Stop (Visible during background execution) -->
                            <Button Command="{Binding StopCommand}" Classes="cs-toolbar-outlined" BorderBrush="{DynamicResource DsErrorBrush}" Foreground="{DynamicResource DsErrorBrush}" IsVisible="{Binding IsNormalExecuting}" ToolTip.Tip="Stop Execution (Shift+F5)" Height="26" Padding="8,0" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Stop" Width="13" Height="13" Foreground="{DynamicResource DsErrorBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Stop" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Run Script Button (Normal execution) -->
                            <Button Command="{Binding RunCodeCommand}"
                                    Classes="cs-toolbar-filled"
                                    Background="{DynamicResource DsGreenBrush}"
                                    Foreground="{DynamicResource DsTextWhiteBrush}"
                                    Height="26"
                                    Padding="10,0"
                                    CornerRadius="4"
                                    IsVisible="{Binding !IsExecuting}"
                                    ToolTip.Tip="Run Script (Ctrl+F5)">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Play" Width="13" Height="13" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Run" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Start Debugging Button -->
                            <Button Command="{Binding DebugCodeCommand}"
                                    Classes="cs-toolbar-tonal"
                                    Background="{DynamicResource DsSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource DsBorderBrush}"
                                    BorderThickness="1"
                                    Height="26"
                                    Padding="8,0"
                                    CornerRadius="4"
                                    IsVisible="{Binding ShowDebugButton}"
                                    ToolTip.Tip="Start Debugging (F5)">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="BugPlayOutline" Width="13" Height="13" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Debug" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Preview / Edit Mode Toggle (Markdown & CSV) -->
                            <Button Command="{Binding ToggleDocumentPreviewModeCommand}"
                                    Classes="cs-toolbar-tonal"
                                    Background="{DynamicResource DsSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource DsBorderBrush}"
                                    BorderThickness="1"
                                    Height="26"
                                    Padding="8,0"
                                    CornerRadius="4"
                                    IsVisible="{Binding HasPreviewMode}"
                                    ToolTip.Tip="{Binding DocumentPreviewModeTooltip}">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="{Binding DocumentPreviewToggleIconKind}" Width="13" Height="13" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DocumentPreviewToggleText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Rectangle Width="1" Height="16" Fill="{DynamicResource DsBorderBrush}" Margin="2,0" VerticalAlignment="Center" />

                            <!-- Apply as Studio Customization -->
                            <Button Command="{Binding ApplyActiveTabAsCustomizationCommand}" Classes="cs-toolbar-icon" ToolTip.Tip="Apply Script as Studio Customization (Ctrl+Alt+R)">
                                <materialIcons:MaterialIcon Kind="Tune" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}" />
                            </Button>

                            <!-- Format Document -->
                            <Button Command="{Binding FormatCodeCommand}" Classes="cs-toolbar-icon" IsVisible="{Binding SupportsFormatting}" ToolTip.Tip="Format Document (Shift+Alt+F)">
                                <materialIcons:MaterialIcon Kind="FormatAlignLeft" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                            </Button>

                            <!-- Word Wrap Toggle -->
                            <ToggleButton IsChecked="{Binding IsWordWrap, Mode=TwoWay}" Classes="cs-toolbar-icon" ToolTip.Tip="Toggle Word Wrap">
                                <materialIcons:MaterialIcon Kind="Wrap" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                            </ToggleButton>

                            <!-- Find & Replace -->
                            <Button Command="{Binding ToggleSearchCommand}" Classes="cs-toolbar-icon" ToolTip.Tip="Find in Editor (Ctrl+F)">
                                <materialIcons:MaterialIcon Kind="Magnify" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                            </Button>

                            <!-- Toggle Bottom Tool Deck -->
                            <Button Command="{Binding ToggleBottomDeckCommand}" Classes="cs-toolbar-icon" ToolTip.Tip="Toggle Bottom Panel (Ctrl+J)">
                                <materialIcons:MaterialIcon Kind="DockBottom" Width="15" Height="15" Foreground="{DynamicResource DsMutedBrush}" />
                            </Button>

                            <!-- Side-by-Side Right Dock / Bottom Dock Toggle -->
                            <Button Command="{Binding ToggleDeckPositionCommand}" Classes="cs-toolbar-icon" ToolTip.Tip="{Binding DeckPositionTooltip}">
                                <Panel>
                                    <materialIcons:MaterialIcon Kind="DockRight" Width="15" Height="15" Foreground="{DynamicResource DsMutedBrush}" IsVisible="{Binding !IsDeckDockedToRight}" />
                                    <materialIcons:MaterialIcon Kind="DockBottom" Width="15" Height="15" Foreground="{DynamicResource DsMutedBrush}" IsVisible="{Binding IsDeckDockedToRight}" />
                                </Panel>
                            </Button>

                            <!-- Dynamic Injected Editor Toolbar Actions Slot -->
                            <StackPanel Name="DynamicEditorToolbarHost" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />

                            <!-- Save Script -->
                            <Button Command="{Binding SaveCommand}" Classes="cs-toolbar-icon" ToolTip.Tip="Save Script (Ctrl+S)">
                                <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                            </Button>

                            <!-- AI Composer / Agent (Cmd+I) -->
                            <Button Command="{Binding ToggleAiComposerCommand}" Classes="cs-toolbar-icon" ToolTip.Tip="Toggle AI Composer &amp; Agent (Cmd+I / Ctrl+I)">
                                <materialIcons:MaterialIcon Kind="AutoFix" Width="15" Height="15" Foreground="{DynamicResource DsPrimaryBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 1: VS Code Breadcrumbs Bar -->
                <studio:StudioBreadcrumbsControl Grid.Row="1" />

                <!-- Row 2: AvaloniaEdit Code Canvas + Right Dock Host -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="300" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{Binding RightDeckGridLength, Mode=TwoWay}" MinWidth="0" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Name="EditorHostGrid">
                        <Border Background="{DynamicResource DsBgBrush}"
                                IsVisible="{Binding ShowTextEditor}">
                            <avaloniaEdit:TextEditor Name="Editor"
                                                     FontFamily="JetBrains Mono, Menlo, Monaco, Consolas, Roboto Mono, monospace"
                                                     FontSize="{Binding EditorFontSize}"
                                                     ShowLineNumbers="True"
                                                     WordWrap="False"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Background="{DynamicResource DsBgBrush}"
                                                     Foreground="{DynamicResource DsTextWhiteBrush}" />
                        </Border>

                        <!-- Authentic VS Code Visual Image Viewer -->
                        <studio:StudioImageViewerControl IsVisible="{Binding IsActiveDocumentImage}" />

                        <!-- Rendered Markdown Preview Surface -->
                        <studio:StudioMarkdownPreviewControl IsVisible="{Binding ShowMarkdownPreview}" />

                        <!-- Interactive CSV / TSV Data Table Surface -->
                        <studio:StudioCsvPreviewControl IsVisible="{Binding ShowCsvPreview}" />

                        <!-- Authentic VS Code Git Diff Viewer Surface -->
                        <studio:StudioDiffViewerControl IsVisible="{Binding ShowDiffViewer}" />

                        <!-- Live Debug Hover Data Tip Card -->
                        <editor:DebugHoverDataTipControl Name="DebugHoverTip"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Top"
                                                           IsVisible="False" />

                        <!-- Interactive Collection View Overlay (Data Explorer) -->
                        <visuals:CollectionViewControl Name="CollectionViewOverlay"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        IsVisible="False" />

                        <!-- Text / JSON Value Viewer Overlay -->
                        <visuals:ValueViewerControl Name="ValueViewerOverlay"
                                                     HorizontalAlignment="Center"
                                                     IsVisible="False" />

                        <!-- Dynamic Floating Overlays Host (HUDs, Mini-Inspectors, Adorners) -->
                        <Canvas Name="DynamicOverlaysHost" IsHitTestVisible="True" />
                    </Grid>

                    <!-- Vertical Splitter (Editor vs Right Dock) -->
                    <GridSplitter Grid.Column="1"
                                  Classes="studio-sash"
                                  Width="4"
                                  ResizeDirection="Columns"
                                  Cursor="SizeWestEast"
                                  IsVisible="{Binding ShowRightDeckSplitter}" />

                    <!-- Collapsible Right Tool Deck Host -->
                    <ContentControl Grid.Column="2"
                                    Name="RightDeckContainer"
                                    IsVisible="{Binding ShowRightDeck}" />
                </Grid>

                <!-- Row 3: Horizontal Splitter (Editor vs Bottom Dock) -->
                <GridSplitter Grid.Row="3"
                              Classes="studio-sash"
                              Height="4"
                              ResizeDirection="Rows"
                              Cursor="SizeNorthSouth"
                              IsVisible="{Binding ShowBottomDeckSplitter}" />

                <!-- Row 4: Collapsible Bottom Tool Deck Host -->
                <ContentControl Grid.Row="4"
                                Name="BottomDeckContainer"
                                IsVisible="{Binding ShowBottomDeck}" />
            </Grid>

        </Grid>

        <!-- ============================================================ -->
        <!-- 2. VS CODE STATUS BAR (Bottom 22px Strip)                    -->
        <!-- ============================================================ -->
        <studio:StudioStatusBarControl Grid.Row="1" />

        <!-- ============================================================ -->
        <!-- 3. QUICK OPEN & COMMAND PALETTE OVERLAY MODAL                -->
        <!-- ============================================================ -->
        <overlays:QuickOpenOverlayControl DataContext="{Binding QuickOpen}"
                                          Grid.RowSpan="2"
                                          ZIndex="999"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" />
    </Grid>
</UserControl>
