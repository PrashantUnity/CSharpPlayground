<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             xmlns:views="using:PdfEditorApp.Plugins.CSharpEditor.Views"
             xmlns:services="using:PdfEditorApp.Plugins.CSharpEditor.Services"
             xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="820"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Views.CSharpCodeStudioView"
             x:DataType="vm:CSharpCodeStudioViewModel">

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:ExplorerItemViewModel">
            <StackPanel>
                <!-- Tree Row Item -->
                <Button Command="{Binding ToggleExpandCommand}"
                        Classes="explorer-item-btn"
                        Classes.selected="{Binding IsSelected}"
                        HorizontalAlignment="Stretch">
                    <Button.ContextFlyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="Open" Command="{Binding SelectCommand}">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="FileEyeOutline" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="New Script Here" Command="{Binding RequestNewFileCommand}" IsVisible="{Binding IsManageableDirectory}">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="FilePlusOutline" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="New Folder Here" Command="{Binding RequestNewFolderCommand}" IsVisible="{Binding IsManageableDirectory}">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="FolderPlusOutline" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Rename" Command="{Binding StartRenameCommand}" IsVisible="{Binding !IsExternalGroup}">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="RenameOutline" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Duplicate" Command="{Binding RequestDuplicateCommand}" IsVisible="{Binding !IsDirectory}">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Delete" Command="{Binding RequestDeleteCommand}" IsVisible="{Binding !IsExternalGroup}">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="DeleteOutline" Width="14" Height="14" Foreground="{DynamicResource M3ErrorBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Copy Path" Command="{Binding RequestCopyPathCommand}">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </Button.ContextFlyout>
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="{Binding IndentPadding}">
                        <!-- Col 0: Chevron Expander for Folders -->
                        <Border Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="{Binding ChevronKind}"
                                                        Width="12" Height="12"
                                                        Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        IsVisible="{Binding IsDirectory}" />
                        </Border>

                        <!-- Col 1: Icon (Folder / Script) -->
                        <materialIcons:MaterialIcon Grid.Column="1"
                                                    Kind="{Binding IconKind}"
                                                    Width="15" Height="15"
                                                    Foreground="{Binding IconColor}"
                                                    VerticalAlignment="Center"
                                                    Margin="2,0,6,0" />

                        <!-- Col 2: Name (Normal View) -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Name}"
                                   FontSize="12"
                                   Foreground="{DynamicResource M3OnSurfaceBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding !IsRenaming}" />

                        <!-- Col 2: Rename TextBox (Edit View) -->
                        <TextBox Grid.Column="2"
                                 Text="{Binding EditName, Mode=TwoWay}"
                                 FontSize="11.5"
                                 Height="22"
                                 Padding="4,1"
                                 Margin="0,0,4,0"
                                 IsVisible="{Binding IsRenaming}"
                                 controls:FocusOnTrueBehavior.IsActive="{Binding IsRenaming}"
                                 VerticalAlignment="Center" />

                        <!-- Col 3: Action Buttons (Only visible on hover!) -->
                        <StackPanel Grid.Column="3"
                                    Classes="explorer-row-actions"
                                    Orientation="Horizontal"
                                    Spacing="2"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0">
                            <Button Command="{Binding RequestNewFileCommand}"
                                    Classes="explorer-tool-btn"
                                    Width="19" Height="19"
                                    ToolTip.Tip="New Script Here"
                                    IsVisible="{Binding IsManageableDirectory}">
                                <materialIcons:MaterialIcon Kind="FilePlusOutline" Width="12" Height="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </Button>
                            <Button Command="{Binding RequestNewFolderCommand}"
                                    Classes="explorer-tool-btn"
                                    Width="19" Height="19"
                                    ToolTip.Tip="New Folder Here"
                                    IsVisible="{Binding IsManageableDirectory}">
                                <materialIcons:MaterialIcon Kind="FolderPlusOutline" Width="12" Height="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </Button>
                            <Button Command="{Binding RequestDuplicateCommand}"
                                    Classes="explorer-tool-btn"
                                    Width="19" Height="19"
                                    ToolTip.Tip="Duplicate Script"
                                    IsVisible="{Binding !IsDirectory}">
                                <materialIcons:MaterialIcon Kind="ContentCopy" Width="11" Height="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </Button>
                            <Button Command="{Binding RequestDeleteCommand}"
                                    Classes="explorer-tool-btn delete-tool"
                                    Width="19" Height="19"
                                    ToolTip.Tip="Delete"
                                    IsVisible="{Binding !IsExternalGroup}">
                                <materialIcons:MaterialIcon Kind="DeleteOutline" Width="12" Height="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Recursive Nested Children -->
                <ItemsControl ItemsSource="{Binding Children}"
                              IsVisible="{Binding IsExpanded}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Styles>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <!-- Workspace Tab Styles — flat, rectangular, monochrome-active (color is reserved for
             state elsewhere in this view, e.g. Run=green/Stop=red), matching a real IDE tool-deck tab -->
        <Style Selector="Button.ide-tab-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerSmall}" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ide-tab-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        </Style>
        <Style Selector="Button.ide-tab-btn.active">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        </Style>

        <!-- Flat/dense toolbar buttons — replace the app-wide pill-shaped m3-*-btn family in this
             view only (that shared family stays untouched for the rest of the app). Small rectangular
             shape, no hover-scale, color reserved for state (filled defaults to success/green for Run). -->
        <Style Selector="Button.cs-toolbar-filled, Button.cs-toolbar-tonal, Button.cs-toolbar-outlined">
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerSmall}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.cs-toolbar-filled">
            <Setter Property="Background" Value="{DynamicResource M3SuccessBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSuccessBrush}" />
        </Style>
        <Style Selector="Button.cs-toolbar-filled:pointerover">
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="Button.cs-toolbar-tonal">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.cs-toolbar-tonal:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighestBrush}" />
        </Style>
        <Style Selector="Button.cs-toolbar-outlined">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.cs-toolbar-outlined:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowBrush}" />
        </Style>
        <Style Selector="Button.cs-toolbar-icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerSmall}" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.cs-toolbar-icon:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        </Style>

        <!-- Explorer tree row — same shape as Notebook Studio's own local explorer-item-btn, kept as
             its own local copy here rather than shared, following this codebase's per-view style
             convention. Selection uses M3PrimaryBrush (this view's own blue identity) instead of
             Notebook Studio's amber, so the two Explorers still read as visually distinct. -->
        <Style Selector="Button.explorer-item-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Height" Value="25" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.08" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.explorer-item-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowBrush}" />
        </Style>
        <Style Selector="Button.explorer-item-btn.selected">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}" />
        </Style>

        <!-- Hover Action Buttons: hidden by default, revealed on row hover -->
        <Style Selector="StackPanel.explorer-row-actions">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.explorer-item-btn:pointerover StackPanel.explorer-row-actions">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- Small inline icon buttons used inside explorer rows and the explorer header toolbar -->
        <Style Selector="Button.explorer-tool-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerExtraSmall}" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
        </Style>
        <Style Selector="Button.explorer-tool-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        </Style>
        <Style Selector="Button.explorer-tool-btn.delete-tool:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3ErrorContainerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3ErrorBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource M3SurfaceBrush}">
        <!-- ============================================================ -->
        <!-- 1. TOP HEADER: Navigation, Breadcrumb & Action Bar           -->
        <!-- ============================================================ -->
        <Border Grid.Row="0"
                Background="{DynamicResource M3SurfaceContainerLowBrush}"
                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,7">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <!-- Left: Scripts Hub Button & Breadcrumbs -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{Binding BackToHubCommand}"
                            Classes="cs-toolbar-tonal"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Return to Scripts &amp; Notebooks Hub">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ArrowLeft" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="Scripts Hub" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <materialIcons:MaterialIcon Kind="ChevronRight" Width="16" Height="16" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />

                    <!-- Script Title Badge & Input -->
                    <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerMedium}"
                            Height="32"
                            Padding="10,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="CodeBraces" Width="15" Height="15" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding Script.Title, Mode=TwoWay}"
                                     FontWeight="SemiBold" FontSize="12.5"
                                     Foreground="{DynamicResource M3OnSurfaceBrush}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     MinHeight="0"
                                     Height="28"
                                     Padding="4,0"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     MinWidth="170"
                                     PlaceholderText="Script Title..." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center-Right: Mode Switcher & Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" VerticalAlignment="Center" Margin="0,0,12,0">
                    <!-- Execution Mode Dropdown -->
                    <ComboBox ItemsSource="{Binding LanguageModes}"
                              SelectedIndex="{Binding SelectedLanguageModeIndex, Mode=TwoWay}"
                              FontSize="11.5"
                              Height="32"
                              MinHeight="0"
                              Padding="12,0"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center"
                              CornerRadius="{StaticResource M3ShapeCornerFull}"
                              ToolTip.Tip="Select Execution Mode (Statements, Program, or Expression)" />

                    <!-- Status Pill -->
                    <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                            Height="32"
                            Padding="12,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="AutoFix" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CompilerStatusText}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Action Buttons (Run, Debug, Stepping Controls, Save, Stop) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Save Button -->
                    <Button Command="{Binding SaveCommand}"
                            Classes="cs-toolbar-tonal"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Save Script (Ctrl+S)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="Save" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Debug Toolbar Group (Visible during Active Debugging) -->
                    <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                            Padding="4,2"
                            IsVisible="{Binding IsDebugging}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <!-- Continue (F5) -->
                            <Button Command="{Binding ContinueDebugCommand}"
                                    Classes="cs-toolbar-filled"
                                    Background="{DynamicResource M3PrimaryBrush}"
                                    Foreground="{DynamicResource M3OnPrimaryBrush}"
                                    IsVisible="{Binding IsPaused}"
                                    ToolTip.Tip="Continue Execution (F5)">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Play" Width="14" Height="14" Foreground="{DynamicResource M3OnPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Continue (F5)" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Step Over (F10) -->
                            <Button Command="{Binding StepOverCommand}"
                                    Classes="cs-toolbar-tonal"
                                    IsVisible="{Binding IsPaused}"
                                    ToolTip.Tip="Step Over statement (F10)">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="DebugStepOver" Width="14" Height="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Step Over" FontSize="10.5" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Step Into (F11) -->
                            <Button Command="{Binding StepIntoCommand}"
                                    Classes="cs-toolbar-tonal"
                                    IsVisible="{Binding IsPaused}"
                                    ToolTip.Tip="Step Into statement (F11)">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="DebugStepInto" Width="14" Height="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Step Into" FontSize="10.5" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Restart Debugging -->
                            <Button Command="{Binding RestartDebugCommand}"
                                    Classes="cs-toolbar-icon"
                                    ToolTip.Tip="Restart Debugging (Ctrl+Shift+F5)">
                                <materialIcons:MaterialIcon Kind="Restart" Width="14" Height="14" VerticalAlignment="Center" />
                            </Button>

                            <!-- Stop Debugging -->
                            <Button Command="{Binding StopDebugCommand}"
                                    Classes="cs-toolbar-outlined"
                                    BorderBrush="{DynamicResource M3ErrorBrush}"
                                    Foreground="{DynamicResource M3ErrorBrush}"
                                    ToolTip.Tip="Stop Debugging (Shift+F5)">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Stop" Width="14" Height="14" Foreground="{DynamicResource M3ErrorBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Stop" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Normal Stop Button (Visible during normal execution) -->
                    <Button Command="{Binding StopCommand}"
                            Classes="cs-toolbar-outlined"
                            VerticalAlignment="Center"
                            BorderBrush="{DynamicResource M3ErrorBrush}"
                            Foreground="{DynamicResource M3ErrorBrush}"
                            IsVisible="{Binding IsNormalExecuting}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Stop" Width="15" Height="15" Foreground="{DynamicResource M3ErrorBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Stop" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Debug Button (F5) - Visible when not debugging -->
                    <Button Command="{Binding DebugCodeCommand}"
                            Classes="cs-toolbar-tonal"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding !IsExecuting}"
                            IsVisible="{Binding !IsDebugging}"
                            ToolTip.Tip="Start Interactive Debugging with Breakpoints (F5)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="BugPlay" Width="15" Height="15" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Debug (F5)" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Run Button (Ctrl+F5) - Visible when not debugging -->
                    <Button Command="{Binding RunCodeCommand}"
                            Classes="cs-toolbar-filled"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding !IsExecuting}"
                            IsVisible="{Binding !IsDebugging}"
                            ToolTip.Tip="Run C# Script without Debugging (Ctrl+F5)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Play" Width="15" Height="15" Foreground="{DynamicResource M3OnSuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Run" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- 2. MAIN WORKSPACE: LeetCode-Inspired Split Panels             -->
        <!-- ============================================================ -->
        <Grid Grid.Row="1" ColumnDefinitions="220,4,420,4,*">
            <!-- ======================================================== -->
            <!-- 2X. EXPLORER SIDEBAR: Script/Folder Tree                  -->
            <!-- ======================================================== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Height="36"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,0,6,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="EXPLORER"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <Button Command="{Binding NewScriptCommand}" Classes="explorer-tool-btn" ToolTip.Tip="New Script">
                                    <materialIcons:MaterialIcon Kind="FilePlusOutline" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                                <Button Command="{Binding NewFolderCommand}" Classes="explorer-tool-btn" ToolTip.Tip="New Folder">
                                    <materialIcons:MaterialIcon Kind="FolderPlusOutline" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                                <Button Command="{Binding RefreshExplorerCommand}" Classes="explorer-tool-btn" ToolTip.Tip="Refresh Explorer">
                                    <materialIcons:MaterialIcon Kind="Refresh" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                                <Button Command="{Binding CollapseAllExplorerCommand}" Classes="explorer-tool-btn" ToolTip.Tip="Collapse Folders">
                                    <materialIcons:MaterialIcon Kind="ArrowCollapseVertical" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ExplorerRootItems}" Margin="2,4,2,8" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          Background="{DynamicResource M3OutlineVariantBrush}"
                          ResizeDirection="Columns"
                          Cursor="SizeWestEast" />

            <!-- ======================================================== -->
            <!-- 2A. LEFT PANEL: Description, Problem Notes & References   -->
            <!-- ======================================================== -->
            <Border Grid.Column="2"
                    Background="{DynamicResource M3SurfaceContainerLowBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*">
                    <!-- Left Tab Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource M3SurfaceContainerBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <!-- Tab 0: Description & Notes -->
                            <Button Command="{Binding SetLeftTabCommand}" CommandParameter="0"
                                    Classes="ide-tab-btn"
                                    Classes.active="{Binding SelectedLeftTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="14" Height="14" />
                                    <TextBlock Text="Description &amp; Notes" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Tab 1: Assembly References -->
                            <Button Command="{Binding SetLeftTabCommand}" CommandParameter="1"
                                    Classes="ide-tab-btn"
                                    Classes.active="{Binding SelectedLeftTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=1}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="PackageVariantClosed" Width="14" Height="14" />
                                    <TextBlock Text="References" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Tab 2: Testcases -->
                            <Button Command="{Binding SetLeftTabCommand}" CommandParameter="2"
                                    Classes="ide-tab-btn"
                                    Classes.active="{Binding SelectedLeftTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=2}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="CheckboxMarkedCircleOutline" Width="14" Height="14" />
                                    <TextBlock Text="Testcases" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Left Content Carousel -->
                    <Carousel Grid.Row="1" SelectedIndex="{Binding SelectedLeftTabIndex}">
                        <!-- Content 0: Markdown Notes & Problem Description -->
                        <Grid RowDefinitions="Auto,*">
                            <!-- Character Count & Scratchpad Bar -->
                            <Border Grid.Row="0" Background="{DynamicResource M3SurfaceContainerBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="0,0,0,1" Padding="12,5">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="SCRATCHPAD &amp; DOCUMENTATION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Notes.Length, StringFormat='{}{0} chars'}" FontSize="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Markdown Notes Editor -->
                            <TextBox Grid.Row="1"
                                     Text="{Binding Notes, Mode=TwoWay}"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     FontFamily="Consolas, Menlo, Monaco, Roboto Mono, JetBrains Mono, monospace"
                                     FontSize="12.5"
                                     Foreground="{DynamicResource M3OnSurfaceBrush}"
                                     Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                     BorderThickness="0"
                                     Padding="14,12"
                                     TextWrapping="Wrap"
                                     PlaceholderText="// Write problem statement, requirements, markdown notes, or test plans here..." />
                        </Grid>

                        <!-- Content 1: Assembly References -->
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14,10" Spacing="8">
                                <TextBlock Text="Referenced .NET Runtime &amp; Studio Assemblies"
                                           FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,0,0,4" />

                                <ItemsControl ItemsSource="{Binding References}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AssemblyReferenceViewModel">
                                            <Border Padding="10,6"
                                                    Background="{DynamicResource M3SurfaceContainerBrush}"
                                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                                    Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="PackageVariant" Width="16" Height="16"
                                                                                Foreground="{DynamicResource M3PrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                                        <TextBlock Text="{Binding AssemblyPath}" FontSize="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsEnabled}"
                                                              IsEnabled="{Binding !IsSystem}"
                                                              VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Content 2: LeetCode-Style Test Cases -->
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14,12" Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Test Cases" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Command="{Binding AddTestCaseCommand}"
                                            Classes="cs-toolbar-tonal"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Plus" Width="13" Height="13" VerticalAlignment="Center" />
                                            <TextBlock Text="Add Case" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding TestCases}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:TestCaseItem">
                                            <Border Background="{DynamicResource M3SurfaceContainerBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" CornerRadius="{StaticResource M3ShapeCornerMedium}" Padding="12" Margin="0,0,0,10">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
                                                        <Button Grid.Column="1"
                                                                Command="{Binding $parent[UserControl].((vm:CSharpCodeStudioViewModel)DataContext).RunTestCaseCommand}"
                                                                CommandParameter="{Binding}"
                                                                Classes="cs-toolbar-tonal"
                                                                Background="{DynamicResource M3SuccessContainerBrush}"
                                                                Foreground="{DynamicResource M3OnSuccessContainerBrush}"
                                                                Padding="10,4"
                                                                Height="26"
                                                                MinHeight="0">
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <materialIcons:MaterialIcon Kind="Play" Width="12" Height="12" Foreground="{DynamicResource M3OnSuccessContainerBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="Run" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource M3OnSuccessContainerBrush}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>

                                                    <TextBlock Text="Input:" FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                    <TextBox Text="{Binding Input, Mode=TwoWay}"
                                                             FontFamily="Consolas, monospace" FontSize="11.5"
                                                             Foreground="{DynamicResource M3OnSurfaceBrush}" Background="{DynamicResource M3SurfaceContainerLowestBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                                             Padding="6" CornerRadius="{StaticResource M3ShapeCornerSmall}" />

                                                    <TextBlock Text="Expected Output:" FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                    <TextBox Text="{Binding ExpectedOutput, Mode=TwoWay}"
                                                             FontFamily="Consolas, monospace" FontSize="11.5"
                                                             Foreground="{DynamicResource M3OnSurfaceBrush}" Background="{DynamicResource M3SurfaceContainerLowestBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                                             Padding="6" CornerRadius="{StaticResource M3ShapeCornerSmall}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Carousel>
                </Grid>
            </Border>

            <!-- Column Splitter (Left vs Right) -->
            <GridSplitter Grid.Column="3"
                          Width="4"
                          Background="{DynamicResource M3OutlineVariantBrush}"
                          ResizeDirection="Columns"
                          Cursor="SizeWestEast" />

            <!-- ======================================================== -->
            <!-- 2B. RIGHT PANEL: C# Code Editor + Bottom Tool Deck        -->
            <!-- ======================================================== -->
            <Grid Grid.Column="4" RowDefinitions="Auto,*,4,280">
                <!-- Editor Sub-Toolbar: Folding, Word Wrap, Find, Format -->
                <Border Grid.Row="0"
                        Background="{DynamicResource M3SurfaceContainerLowBrush}"
                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                        BorderThickness="0,0,0,1"
                        Height="32"
                        Padding="10,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Left: File / Language Breadcrumb -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="FileCodeOutline" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                            <TextBlock Text="{Binding Script.Title, FallbackValue='script.csx'}" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource M3SurfaceContainerHighBrush}" CornerRadius="3" Padding="4,1" Margin="4,0,0,0">
                                <TextBlock Text="{Binding CurrentLanguageMode}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}" />
                            </Border>
                        </StackPanel>

                        <!-- Right: Editor Shortcuts & Folding Controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <!-- Fold All -->
                            <Button Command="{Binding FoldAllCommand}"
                                    Classes="cs-toolbar-icon"
                                    ToolTip.Tip="Fold All Code Blocks (Ctrl+Shift+[)">
                                <materialIcons:MaterialIcon Kind="ArrowCollapseVertical" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </Button>

                            <!-- Unfold All -->
                            <Button Command="{Binding UnfoldAllCommand}"
                                    Classes="cs-toolbar-icon"
                                    ToolTip.Tip="Unfold All Code Blocks (Ctrl+Shift+])">
                                <materialIcons:MaterialIcon Kind="ArrowExpandVertical" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </Button>

                            <Rectangle Width="1" Height="14" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="2,0" />

                            <!-- Word Wrap Toggle -->
                            <ToggleButton IsChecked="{Binding IsWordWrap, Mode=TwoWay}"
                                          Classes="cs-toolbar-icon"
                                          ToolTip.Tip="Toggle Word Wrap">
                                <materialIcons:MaterialIcon Kind="Wrap" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </ToggleButton>

                            <!-- Search / Find -->
                            <Button Command="{Binding ToggleSearchCommand}"
                                    Classes="cs-toolbar-icon"
                                    ToolTip.Tip="Find &amp; Replace (Ctrl+F / ⌘F)">
                                <materialIcons:MaterialIcon Kind="Magnify" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </Button>

                            <!-- Format Code -->
                            <Button Command="{Binding FormatCodeCommand}"
                                    Classes="cs-toolbar-icon"
                                    ToolTip.Tip="Format Document (Ctrl+K Ctrl+D)">
                                <materialIcons:MaterialIcon Kind="FormatIndentIncrease" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Upper: High-Performance C# AvaloniaEdit with Debug Hover Data Tip Overlay -->
                <Grid Grid.Row="1" Name="EditorHostGrid">
                    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}">
                        <avaloniaEdit:TextEditor Name="Editor"
                                                 FontFamily="JetBrains Mono, Menlo, Monaco, Consolas, Roboto Mono, monospace"
                                                 FontSize="13"
                                                 ShowLineNumbers="True"
                                                 WordWrap="False"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                 Foreground="{DynamicResource M3OnSurfaceBrush}" />
                    </Border>

                    <!-- Live Debug Hover Data Tip Card -->
                    <controls:DebugHoverDataTipControl Name="DebugHoverTip"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Top"
                                                       IsVisible="False" />
                </Grid>

                <!-- Horizontal Splitter (Editor vs Bottom Deck) -->
                <GridSplitter Grid.Row="2"
                              Height="4"
                              Background="{DynamicResource M3OutlineVariantBrush}"
                              ResizeDirection="Rows"
                              Cursor="SizeNorthSouth"
                              IsVisible="{Binding IsBottomDeckExpanded}" />

                <!-- Lower: Collapsible Tool Deck (Visual Results, Console, Problems, Test Results) -->
                <Border Grid.Row="3"
                        MinHeight="140"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource M3SurfaceContainerLowBrush}"
                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                        BorderThickness="0,1,0,0"
                        IsVisible="{Binding IsBottomDeckExpanded}">
                    <Grid RowDefinitions="Auto,*">
                        <!-- Tool Deck Tab Bar (Results, Console, Problems, Testcases) -->
                        <Border Grid.Row="0" Background="{DynamicResource M3SurfaceContainerBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <!-- Tab 0: Results (.Dump) -->
                                    <Button Command="{Binding SetBottomTabCommand}" CommandParameter="0"
                                            Classes="ide-tab-btn"
                                            Classes.active="{Binding SelectedBottomTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <materialIcons:MaterialIcon Kind="Table" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="Results (.Dump)" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource M3PrimaryBrush}" CornerRadius="{StaticResource M3ShapeCornerFull}" Padding="6,1"
                                                    IsVisible="{Binding DumpResults.Count}">
                                                <TextBlock Text="{Binding DumpResults.Count}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource M3OnPrimaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Button>

                                    <!-- Tab 1: Console Output -->
                                    <Button Command="{Binding SetBottomTabCommand}" CommandParameter="1"
                                            Classes="ide-tab-btn"
                                            Classes.active="{Binding SelectedBottomTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=1}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <materialIcons:MaterialIcon Kind="Console" Width="14" Height="14" />
                                            <TextBlock Text="Console Output" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Tab 2: Problems / Diagnostics -->
                                    <Button Command="{Binding SetBottomTabCommand}" CommandParameter="2"
                                            Classes="ide-tab-btn"
                                            Classes.active="{Binding SelectedBottomTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=2}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="14" Height="14" Foreground="{DynamicResource M3WarningBrush}" />
                                            <TextBlock Text="Problems" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource M3ErrorBrush}" CornerRadius="{StaticResource M3ShapeCornerFull}" Padding="6,1"
                                                    IsVisible="{Binding ErrorCount}">
                                                <TextBlock Text="{Binding ErrorCount}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource M3OnErrorBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Button>

                                    <!-- Tab 3: Test Cases -->
                                    <Button Command="{Binding SetBottomTabCommand}" CommandParameter="3"
                                            Classes="ide-tab-btn"
                                            Classes.active="{Binding SelectedBottomTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=3}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <materialIcons:MaterialIcon Kind="CheckboxMarkedCircleOutline" Width="14" Height="14" />
                                            <TextBlock Text="Test Cases" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Tab 4: Interactive Debugger -->
                                    <Button Command="{Binding SetBottomTabCommand}" CommandParameter="4"
                                            Classes="ide-tab-btn"
                                            Classes.active="{Binding SelectedBottomTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=4}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <materialIcons:MaterialIcon Kind="BugOutline" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="Debugger" VerticalAlignment="Center" />
                                            <!-- Paused badge -->
                                            <Border Background="{DynamicResource M3WarningBrush}" CornerRadius="{StaticResource M3ShapeCornerFull}" Padding="6,1"
                                                    IsVisible="{Binding IsPaused}">
                                                <TextBlock Text="PAUSED" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource M3OnWarningBrush}" />
                                            </Border>
                                            <!-- Breakpoint count badge -->
                                            <Border Background="{DynamicResource M3SurfaceContainerHighestBrush}" CornerRadius="{StaticResource M3ShapeCornerFull}" Padding="6,1"
                                                    IsVisible="{Binding Breakpoints.Count}">
                                                <TextBlock Text="{Binding Breakpoints.Count, StringFormat='{}{0} BPs'}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Right Actions: Clear, Minimizer -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Button Command="{Binding ClearResultsCommand}"
                                            Classes="cs-toolbar-icon"
                                            ToolTip.Tip="Clear Results &amp; Dumps">
                                        <materialIcons:MaterialIcon Kind="TableRemove" Width="15" Height="15" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    </Button>
                                    <Button Command="{Binding ClearConsoleCommand}"
                                            Classes="cs-toolbar-icon"
                                            ToolTip.Tip="Clear Console">
                                        <materialIcons:MaterialIcon Kind="Eraser" Width="15" Height="15" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    </Button>
                                    <Button Command="{Binding ToggleBottomDeckCommand}"
                                            Classes="cs-toolbar-icon"
                                            ToolTip.Tip="Minimize Deck">
                                        <materialIcons:MaterialIcon Kind="ChevronDown" Width="16" Height="16" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Tool Deck Content -->
                        <Carousel Grid.Row="1" SelectedIndex="{Binding SelectedBottomTabIndex}">
                            <!-- Tab 0: Visual Results (.Dump) -->
                            <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}" Padding="12,10">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="12">
                                        <!-- Empty State -->
                                        <Border IsVisible="{Binding !DumpResults.Count}"
                                                Padding="24,30"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="TableLarge" Width="36" Height="36"
                                                                            Foreground="{DynamicResource M3PrimaryBrush}"
                                                                            HorizontalAlignment="Center" />
                                                <TextBlock Text="No Visual Dumps Yet"
                                                           FontSize="13.5" FontWeight="Bold"
                                                           Foreground="{DynamicResource M3OnSurfaceBrush}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="Call .Dump() on any variable, array, collection, or object to inspect it in a rich interactive table."
                                                           FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                           HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="440" />
                                                <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource M3ShapeCornerFull}"
                                                        Padding="12,4"
                                                        HorizontalAlignment="Center">
                                                    <TextBlock Text="Example: int[] digit = [1, 2, 3, 4, 4, 0, 0, 7, 6]; digit.Dump();"
                                                               FontFamily="Consolas, monospace" FontSize="11"
                                                               Foreground="{DynamicResource M3PrimaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Rendered Tables -->
                                        <ItemsControl ItemsSource="{Binding DumpResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:DumpTableResult">
                                                    <views:DumpTableView />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Rendered Rich Outputs: Image / Interactive Control / Object Inspector / Html.
                                             Table-kind entries render nothing here (DumpResults above already shows them). -->
                                        <ItemsControl ItemsSource="{Binding RichOutputs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="services:RichCellOutput">
                                                    <StackPanel Spacing="0">

                                                        <!-- Image -->
                                                        <Border IsVisible="{Binding IsImageKind}"
                                                                Background="#080C11"
                                                                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="8"
                                                                Margin="0,0,0,12"
                                                                HorizontalAlignment="Left">
                                                            <Image Source="{Binding DecodedImage}"
                                                                   MaxHeight="450"
                                                                   Stretch="Uniform"
                                                                   HorizontalAlignment="Center" />
                                                        </Border>

                                                        <!-- Interactive Avalonia UI Control (e.g. Display.Animate / Display.Control) -->
                                                        <Border IsVisible="{Binding IsControlKind}"
                                                                Background="{DynamicResource M3SurfaceContainerLowBrush}"
                                                                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="12,8"
                                                                Margin="0,0,0,12">
                                                            <Grid RowDefinitions="Auto,*">
                                                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                                                                    <materialIcons:MaterialIcon Kind="ApplicationOutline" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                                    <TextBlock Text="Interactive UI Widget" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                                                </StackPanel>
                                                                <ContentControl Grid.Row="1" Content="{Binding InteractiveControl}" HorizontalAlignment="Stretch" />
                                                            </Grid>
                                                        </Border>

                                                        <!-- Object Inspector -->
                                                        <Border IsVisible="{Binding IsInspectorKind}" Margin="0,0,0,12">
                                                            <views:ObjectInspectorView DataContext="{Binding InspectorNode}" />
                                                        </Border>

                                                        <!-- HTML / Markdown -->
                                                        <Border IsVisible="{Binding IsHtmlKind}">
                                                            <views:RichHtmlView DataContext="{Binding HtmlContent}" />
                                                        </Border>

                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- Tab 1: Console Output -->
                            <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}" Padding="12,8">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <TextBox Text="{Binding ConsoleOutput, Mode=OneWay}"
                                             FontFamily="Consolas, Menlo, Monaco, Roboto Mono, JetBrains Mono, monospace"
                                             FontSize="12"
                                             Background="Transparent"
                                             Foreground="{DynamicResource M3PrimaryBrush}"
                                             BorderThickness="0"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Border>

                            <!-- Tab 2: Problems / Diagnostics List -->
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="12,8">
                                    <TextBlock Text="No problems detected. Ready to run."
                                               FontSize="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                               Margin="10"
                                               IsVisible="{Binding !Diagnostics.Count}" />

                                    <ItemsControl ItemsSource="{Binding Diagnostics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DiagnosticItemViewModel">
                                                <Border Background="Transparent"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="8,6">
                                                    <Button Command="{Binding NavigateCommand}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            Padding="0"
                                                            Cursor="Hand">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <materialIcons:MaterialIcon Grid.Column="0"
                                                                                        Kind="{Binding SeverityIconKind}"
                                                                                        Foreground="{Binding SeverityColorHex}"
                                                                                        Width="16" Height="16"
                                                                                        Margin="0,0,8,0"
                                                                                        VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Id}" FontWeight="Bold" FontSize="11.5"
                                                                            Foreground="{Binding SeverityColorHex}" />
                                                                <TextBlock Text="{Binding Message}" FontSize="12"
                                                                            Foreground="{DynamicResource M3OnSurfaceBrush}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding LocationString}"
                                                                        FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                                        VerticalAlignment="Center" Margin="8,0,0,0" />
                                                        </Grid>
                                                    </Button>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Tab 3: Test Cases -->
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14,10" Spacing="10">
                                    <TextBlock Text="Automated Test Cases Runner"
                                               FontSize="12" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    <ItemsControl ItemsSource="{Binding TestCases}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:TestCaseItem">
                                                <Border Background="{DynamicResource M3SurfaceContainerBrush}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                        Padding="12,8"
                                                        Margin="0,0,0,6">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Grid.Column="0" Spacing="4">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                            <TextBlock Text="{Binding Input}" FontSize="11" FontFamily="Consolas, monospace" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                            <TextBlock Text="{Binding ActualOutput}" FontSize="11" FontFamily="Consolas, monospace" Foreground="{DynamicResource M3OnSurfaceBrush}"
                                                                       IsVisible="{Binding ActualOutput, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Command="{Binding $parent[UserControl].((vm:CSharpCodeStudioViewModel)DataContext).RunTestCaseCommand}"
                                                                CommandParameter="{Binding}"
                                                                Classes="cs-toolbar-tonal"
                                                                Height="26"
                                                                VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <materialIcons:MaterialIcon Kind="Play" Width="12" Height="12" VerticalAlignment="Center" />
                                                                <TextBlock Text="Run" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Tab 4: Interactive Debugger (Locals, Watch, Breakpoints, Call Stack, Immediate) -->
                            <Grid ColumnDefinitions="*,4,380" Background="{DynamicResource M3SurfaceContainerLowestBrush}">
                                <!-- Left Column: Locals & Watch Expressions -->
                                <Grid Grid.Column="0" RowDefinitions="*,Auto,140">
                                    <!-- Upper: Locals Variable Inspector -->
                                    <Border Grid.Row="0" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                                        <Grid RowDefinitions="Auto,*">
                                            <!-- Section Header -->
                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <materialIcons:MaterialIcon Kind="CodeBrackets" Width="15" Height="15" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                    <TextBlock Text="LOCALS (VARIABLES IN SCOPE)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                                    <Border Background="{DynamicResource M3SurfaceContainerHighBrush}" CornerRadius="{StaticResource M3ShapeCornerFull}" Padding="6,1" IsVisible="{Binding Locals.Count}">
                                                        <TextBlock Text="{Binding Locals.Count}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Empty State -->
                                            <Border Grid.Row="1" IsVisible="{Binding !Locals.Count}" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                    <materialIcons:MaterialIcon Kind="BugPauseOutline" Width="28" Height="28" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="No active local variables." FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="Start debugging (F5) with breakpoints or step through code (F10) to inspect live state." FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Locals List -->
                                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" IsVisible="{Binding Locals.Count}">
                                                <ItemsControl ItemsSource="{Binding Locals}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:DebugVariableItem">
                                                            <Border Background="{DynamicResource M3SurfaceContainerBrush}"
                                                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                                                    Padding="10,6"
                                                                    Margin="0,0,0,4">
                                                                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="Variable" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                    <Border Grid.Column="2" Background="{DynamicResource M3SurfaceContainerHighBrush}" CornerRadius="4" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                        <TextBlock Text="{Binding TypeName}" FontSize="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                                    </Border>
                                                                    <TextBlock Grid.Column="3" Text="{Binding ValueDisplay}" FontFamily="Consolas, monospace" FontSize="11" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>

                                    <!-- Section Splitter -->
                                    <GridSplitter Grid.Row="1" Height="2" Background="{DynamicResource M3OutlineVariantBrush}" ResizeDirection="Rows" />

                                    <!-- Lower: Watch Expressions -->
                                    <Border Grid.Row="2" Padding="14,8" Background="{DynamicResource M3SurfaceContainerLowBrush}">
                                        <Grid RowDefinitions="Auto,*">
                                            <!-- Watch Header & Input -->
                                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <materialIcons:MaterialIcon Kind="EyeOutline" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                    <TextBlock Text="WATCH" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBox Grid.Column="1" Text="{Binding WatchInputText, Mode=TwoWay}"
                                                         FontFamily="Consolas, monospace" FontSize="11"
                                                         Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                         BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                         BorderThickness="1"
                                                         CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                                         Padding="8,4"
                                                         Height="26" MinHeight="0"
                                                         PlaceholderText="Add watch expression (e.g. environment.Version)...">
                                                    <TextBox.KeyBindings>
                                                        <KeyBinding Gesture="Enter" Command="{Binding AddWatchCommand}" />
                                                    </TextBox.KeyBindings>
                                                </TextBox>
                                                <Button Grid.Column="2" Command="{Binding AddWatchCommand}"
                                                        Classes="cs-toolbar-tonal"
                                                        Height="26" MinHeight="0"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="+ Watch" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </Button>
                                            </Grid>

                                            <!-- Watch List -->
                                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding WatchExpressions}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:WatchExpressionItem">
                                                            <Border Background="{DynamicResource M3SurfaceContainerBrush}"
                                                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                                                    Padding="8,4"
                                                                    Margin="0,0,0,3">
                                                                <Grid ColumnDefinitions="*,Auto,Auto">
                                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Expression}" FontFamily="Consolas, monospace" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
                                                                        <TextBlock Text="=" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding Result}" FontFamily="Consolas, monospace" FontSize="11" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                    <Border Grid.Column="1" Background="{DynamicResource M3SurfaceContainerHighBrush}" CornerRadius="3" Padding="4,1" Margin="6,0" IsVisible="{Binding TypeName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                        <TextBlock Text="{Binding TypeName}" FontSize="9" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                                    </Border>
                                                                    <Button Grid.Column="2"
                                                                            Command="{Binding $parent[UserControl].((vm:CSharpCodeStudioViewModel)DataContext).RemoveWatchCommand}"
                                                                            CommandParameter="{Binding}"
                                                                            Classes="cs-toolbar-icon" Width="20" Height="20"
                                                                            ToolTip.Tip="Remove Watch">
                                                                        <materialIcons:MaterialIcon Kind="Close" Width="11" Height="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Column Splitter -->
                                <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource M3OutlineVariantBrush}" ResizeDirection="Columns" />

                                <!-- Right Column: Breakpoints & Immediate Console -->
                                <Grid Grid.Column="2" RowDefinitions="*,Auto,*">
                                    <!-- Upper Right: Breakpoints List -->
                                    <Border Grid.Row="0" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                                        <Grid RowDefinitions="Auto,*">
                                            <!-- Header & Actions -->
                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <materialIcons:MaterialIcon Kind="CircleMultiple" Width="14" Height="14" Foreground="{DynamicResource M3ErrorBrush}" />
                                                    <TextBlock Text="BREAKPOINTS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                                    <Border Background="{DynamicResource M3SurfaceContainerHighBrush}" CornerRadius="{StaticResource M3ShapeCornerFull}" Padding="6,1" IsVisible="{Binding Breakpoints.Count}">
                                                        <TextBlock Text="{Binding Breakpoints.Count}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource M3ErrorBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <Button Grid.Column="1" Command="{Binding ClearAllBreakpointsCommand}"
                                                        Classes="cs-toolbar-tonal"
                                                        Height="22" MinHeight="0"
                                                        IsVisible="{Binding Breakpoints.Count}"
                                                        ToolTip.Tip="Remove all breakpoints">
                                                    <TextBlock Text="Clear All" FontSize="9.5" FontWeight="Medium" VerticalAlignment="Center" />
                                                </Button>
                                            </Grid>

                                            <!-- Breakpoints list -->
                                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="No breakpoints placed. Click in the editor gutter or press F9 to toggle a breakpoint."
                                                               FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                               IsVisible="{Binding !Breakpoints.Count}"
                                                               TextWrapping="Wrap" Margin="4,8" />

                                                    <ItemsControl ItemsSource="{Binding Breakpoints}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:BreakpointItem">
                                                                <Border Background="{DynamicResource M3SurfaceContainerBrush}"
                                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                                                        Padding="8,4">
                                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                                  Command="{Binding $parent[UserControl].((vm:CSharpCodeStudioViewModel)DataContext).ToggleBreakpointEnabledCommand}"
                                                                                  CommandParameter="{Binding}"
                                                                                  Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                            <materialIcons:MaterialIcon Kind="Circle" Width="10" Height="10" Foreground="{DynamicResource M3ErrorBrush}" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding DisplayText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                        <Button Grid.Column="2"
                                                                                Command="{Binding $parent[UserControl].((vm:CSharpCodeStudioViewModel)DataContext).RemoveBreakpointCommand}"
                                                                                CommandParameter="{Binding}"
                                                                                Classes="cs-toolbar-icon" Width="20" Height="20"
                                                                                ToolTip.Tip="Delete Breakpoint">
                                                                            <materialIcons:MaterialIcon Kind="Close" Width="11" Height="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                                        </Button>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>

                                    <GridSplitter Grid.Row="1" Height="2" Background="{DynamicResource M3OutlineVariantBrush}" ResizeDirection="Rows" />

                                    <!-- Lower Right: Immediate Window Console -->
                                    <Border Grid.Row="2" Padding="12,8" Background="{DynamicResource M3SurfaceContainerLowBrush}">
                                        <Grid RowDefinitions="Auto,*,Auto">
                                            <!-- Header & Clear -->
                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <materialIcons:MaterialIcon Kind="ConsoleLine" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                    <TextBlock Text="IMMEDIATE CONSOLE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Command="{Binding ClearImmediateCommand}"
                                                        Classes="cs-toolbar-icon" Width="20" Height="20"
                                                        ToolTip.Tip="Clear Immediate Console">
                                                    <materialIcons:MaterialIcon Kind="Eraser" Width="12" Height="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                </Button>
                                            </Grid>

                                            <!-- Output history -->
                                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding ImmediateOutput}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" FontFamily="Consolas, monospace" FontSize="10.5" Foreground="{DynamicResource M3PrimaryBrush}" TextWrapping="Wrap" Margin="0,1" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <!-- Input prompt -->
                                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                                <TextBox Grid.Column="0" Text="{Binding ImmediateInputText, Mode=TwoWay}"
                                                         FontFamily="Consolas, monospace" FontSize="11"
                                                         Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                         BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                         BorderThickness="1"
                                                         CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                                         Padding="8,4"
                                                         Height="26" MinHeight="0"
                                                         PlaceholderText="> Evaluate C# expression...">
                                                    <TextBox.KeyBindings>
                                                        <KeyBinding Gesture="Enter" Command="{Binding EvaluateImmediateCommand}" />
                                                    </TextBox.KeyBindings>
                                                </TextBox>
                                                <Button Grid.Column="1" Command="{Binding EvaluateImmediateCommand}"
                                                        Classes="cs-toolbar-tonal"
                                                        Height="26" MinHeight="0"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="Eval" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Carousel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================================================ -->
        <!-- 3. FOOTER STATUS BAR: Console Toggle, Ln/Col, Status        -->
        <!-- ============================================================ -->
        <Border Grid.Row="2"
                Background="{DynamicResource M3SurfaceContainerLowBrush}"
                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,3">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <!-- Left: Console Toggle Button -->
                <Button Grid.Column="0"
                        Command="{Binding ToggleBottomDeckCommand}"
                        Classes="cs-toolbar-tonal"
                        Background="Transparent"
                        BorderThickness="0"
                        Height="24"
                        MinHeight="0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="Console" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Console" FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Center: Elapsed Time -->
                <TextBlock Grid.Column="1" Text="{Binding ExecutionTimeText, StringFormat='{}Execution Time: {0}'}"
                           FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                           Margin="14,0,0,0" VerticalAlignment="Center"
                           IsVisible="{Binding ExecutionTimeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <!-- Right: Ln, Col, Encoding, Language Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CaretLine, StringFormat='{}Ln {0}'}" FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CaretColumn, StringFormat='{}Col {0}'}" FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="UTF-8" FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="C# (.NET 10 Roslyn)" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
