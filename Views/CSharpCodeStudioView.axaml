<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             xmlns:views="using:PdfEditorApp.Plugins.CSharpEditor.Views"
             xmlns:services="using:PdfEditorApp.Plugins.CSharpEditor.Services"
             xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="820"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Views.CSharpCodeStudioView"
             x:DataType="vm:CSharpCodeStudioViewModel">

    <UserControl.Styles>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <StyleInclude Source="avares://CSharpEditorPlugin/Controls/SharedStudioStyles.axaml" />

        <Style Selector="Button.explorer-tool-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerExtraSmall}" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
        </Style>
        <Style Selector="Button.explorer-tool-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto" Background="{DynamicResource M3SurfaceBrush}">
        <!-- ============================================================ -->
        <!-- 1. MAIN WORKSPACE (Activity Bar + SideBar + Splitter + Editor) -->
        <!-- ============================================================ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="{Binding SideBarGridLength, Mode=TwoWay}" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- ======================================================== -->
            <!-- 1A. ACTIVITY BAR (Column 0, 48px fixed)                  -->
            <!-- ======================================================== -->
            <controls:StudioActivityBarControl Grid.Column="0" />

            <!-- ======================================================== -->
            <!-- 1B. PRIMARY SIDEBAR (Column 1, Resizable, Collapsible)   -->
            <!-- ======================================================== -->
            <Border Grid.Column="1"
                    IsVisible="{Binding IsSideBarVisible}"
                    MinWidth="160"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource M3SurfaceContainerLowBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*">
                    <!-- SideBar Header -->
                    <Border Grid.Row="0" Height="36"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,0,8,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding SideBarTitle}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                       VerticalAlignment="Center" />

                            <!-- Explorer Tools (View 0) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                                        IsVisible="{Binding IsExplorerActive}">
                                <Button Command="{Binding NewScriptCommand}" Classes="explorer-tool-btn" ToolTip.Tip="New Script">
                                    <materialIcons:MaterialIcon Kind="FilePlusOutline" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                                <Button Command="{Binding NewFolderCommand}" Classes="explorer-tool-btn" ToolTip.Tip="New Folder">
                                    <materialIcons:MaterialIcon Kind="FolderPlusOutline" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                                <Button Click="OnOpenProjectClick" Classes="explorer-tool-btn" ToolTip.Tip="Open Project or File... (Ctrl+O)">
                                    <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                                <Button Command="{Binding RefreshExplorerCommand}" Classes="explorer-tool-btn" ToolTip.Tip="Refresh Explorer">
                                    <materialIcons:MaterialIcon Kind="Refresh" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                                <Button Command="{Binding CollapseAllExplorerCommand}" Classes="explorer-tool-btn" ToolTip.Tip="Collapse Folders">
                                    <materialIcons:MaterialIcon Kind="ArrowCollapseVertical" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                                <Button Command="{Binding ToggleSideBarCommand}" Classes="explorer-tool-btn" ToolTip.Tip="Hide Primary Side Bar (Ctrl+B)">
                                    <materialIcons:MaterialIcon Kind="ChevronLeft" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                            </StackPanel>

                            <!-- Search Tools (View 1) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                                        IsVisible="{Binding IsSearchActive}">
                                <Button Command="{Binding ExecuteSearchCommand}" Classes="explorer-tool-btn" ToolTip.Tip="Refresh Search">
                                    <materialIcons:MaterialIcon Kind="Refresh" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                                <Button Command="{Binding ToggleSideBarCommand}" Classes="explorer-tool-btn" ToolTip.Tip="Hide Primary Side Bar (Ctrl+B)">
                                    <materialIcons:MaterialIcon Kind="ChevronLeft" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                            </StackPanel>

                            <!-- Debug Tools (View 2) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                                        IsVisible="{Binding IsDebugActive}">
                                <Button Command="{Binding ClearAllBreakpointsCommand}" Classes="explorer-tool-btn" ToolTip.Tip="Clear All Breakpoints" IsVisible="{Binding Breakpoints.Count}">
                                    <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                                <Button Command="{Binding ToggleSideBarCommand}" Classes="explorer-tool-btn" ToolTip.Tip="Hide Primary Side Bar (Ctrl+B)">
                                    <materialIcons:MaterialIcon Kind="ChevronLeft" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                            </StackPanel>

                            <!-- Default Close Button for Views 3-5 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                                        IsVisible="{Binding !IsExplorerActive}">
                                <Button Command="{Binding ToggleSideBarCommand}" Classes="explorer-tool-btn" ToolTip.Tip="Hide Primary Side Bar (Ctrl+B)"
                                        IsVisible="{Binding !IsSearchActive}">
                                    <materialIcons:MaterialIcon Kind="ChevronLeft" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- SideBar Carousel Pages -->
                    <Carousel Grid.Row="1" SelectedIndex="{Binding SelectedActivityBarIndex}">

                        <!-- Page 0: Explorer Tree -->
                        <controls:StudioExplorerPanelControl OpenProjectRequested="OnOpenProjectClick" />

                        <!-- Page 1: Search in Active Script -->
                        <controls:StudioSearchPanelControl />

                        <!-- Page 2: Run & Debug Sidebar Panel -->
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,8" Spacing="10">
                                <!-- Launch Action Buttons -->
                                <StackPanel Spacing="6">
                                    <Button Command="{Binding DebugCodeCommand}" Classes="cs-toolbar-filled"
                                            Background="{DynamicResource M3PrimaryBrush}" Foreground="{DynamicResource M3OnPrimaryBrush}"
                                            IsEnabled="{Binding !IsExecuting}" IsVisible="{Binding !IsDebugging}"
                                            HorizontalAlignment="Stretch" Height="30"
                                            ToolTip.Tip="Start Interactive Debugging (F5)">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="BugPlay" Width="15" Height="15" Foreground="{DynamicResource M3OnPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="Start Debugging (F5)" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding RunCodeCommand}" Classes="cs-toolbar-tonal"
                                            IsEnabled="{Binding !IsExecuting}" IsVisible="{Binding !IsDebugging}"
                                            HorizontalAlignment="Stretch" Height="30"
                                            ToolTip.Tip="Run without Debugging (Ctrl+F5)">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Play" Width="15" Height="15" Foreground="{DynamicResource M3SuccessBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="Run Without Debugging" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Stepping Controls (Visible when active debugging) -->
                                <Border Background="{DynamicResource M3SurfaceContainerHighBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" CornerRadius="6" Padding="6" IsVisible="{Binding IsDebugging}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="DEBUGGING ACTIVE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <Button Command="{Binding ContinueDebugCommand}" Classes="cs-toolbar-filled" Background="{DynamicResource M3PrimaryBrush}" Foreground="{DynamicResource M3OnPrimaryBrush}" IsVisible="{Binding IsPaused}" ToolTip.Tip="Continue (F5)">
                                                <materialIcons:MaterialIcon Kind="Play" Width="14" Height="14" Foreground="{DynamicResource M3OnPrimaryBrush}" />
                                            </Button>
                                            <Button Command="{Binding StepOverCommand}" Classes="cs-toolbar-tonal" IsVisible="{Binding IsPaused}" ToolTip.Tip="Step Over (F10)">
                                                <materialIcons:MaterialIcon Kind="DebugStepOver" Width="14" Height="14" />
                                            </Button>
                                            <Button Command="{Binding StepIntoCommand}" Classes="cs-toolbar-tonal" IsVisible="{Binding IsPaused}" ToolTip.Tip="Step Into (F11)">
                                                <materialIcons:MaterialIcon Kind="DebugStepInto" Width="14" Height="14" />
                                            </Button>
                                            <Button Command="{Binding RestartDebugCommand}" Classes="cs-toolbar-icon" ToolTip.Tip="Restart">
                                                <materialIcons:MaterialIcon Kind="Restart" Width="14" Height="14" />
                                            </Button>
                                            <Button Command="{Binding StopDebugCommand}" Classes="cs-toolbar-outlined" BorderBrush="{DynamicResource M3ErrorBrush}" Foreground="{DynamicResource M3ErrorBrush}" ToolTip.Tip="Stop (Shift+F5)">
                                                <materialIcons:MaterialIcon Kind="Stop" Width="14" Height="14" Foreground="{DynamicResource M3ErrorBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Breakpoints Section -->
                                <Border Background="{DynamicResource M3SurfaceContainerBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="BREAKPOINTS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Background="{DynamicResource M3SurfaceContainerHighBrush}" CornerRadius="6" Padding="5,1" IsVisible="{Binding Breakpoints.Count}">
                                                <TextBlock Text="{Binding Breakpoints.Count}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource M3ErrorBrush}" />
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="No breakpoints. Click the gutter or press F9." FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" IsVisible="{Binding !Breakpoints.Count}" />

                                        <ItemsControl ItemsSource="{Binding Breakpoints}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:BreakpointItem">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                  Command="{Binding $parent[UserControl].((vm:CSharpCodeStudioViewModel)DataContext).ToggleBreakpointEnabledCommand}"
                                                                  CommandParameter="{Binding}" Margin="0,0,4,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayText}" FontSize="11" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                                                        <Button Grid.Column="2" Command="{Binding $parent[UserControl].((vm:CSharpCodeStudioViewModel)DataContext).RemoveBreakpointCommand}" CommandParameter="{Binding}" Classes="explorer-tool-btn" Width="18" Height="18">
                                                            <materialIcons:MaterialIcon Kind="Close" Width="10" Height="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Watch Expressions Section -->
                                <Border Background="{DynamicResource M3SurfaceContainerBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="WATCH EXPRESSIONS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding WatchInputText, Mode=TwoWay}"
                                                     Classes="sidebar-search-box" PlaceholderText="Expression to watch...">
                                                <TextBox.KeyBindings>
                                                    <KeyBinding Gesture="Enter" Command="{Binding AddWatchCommand}" />
                                                </TextBox.KeyBindings>
                                            </TextBox>
                                            <Button Grid.Column="1" Command="{Binding AddWatchCommand}" Classes="cs-toolbar-tonal" Height="28" MinHeight="0" Margin="4,0,0,0">
                                                <materialIcons:MaterialIcon Kind="Plus" Width="13" Height="13" />
                                            </Button>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding WatchExpressions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:WatchExpressionItem">
                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                        <TextBlock Grid.Column="0" Text="{Binding Expression, StringFormat='{}{0}: '}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                        <Button Grid.Column="1" Command="{Binding $parent[UserControl].((vm:CSharpCodeStudioViewModel)DataContext).RemoveWatchCommand}" CommandParameter="{Binding}" Classes="explorer-tool-btn" Width="18" Height="18">
                                                            <materialIcons:MaterialIcon Kind="Close" Width="10" Height="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Page 3: Dependencies & NuGet -->
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,8" Spacing="8">
                                <TextBlock Text="Referenced .NET Runtime &amp; Studio Assemblies"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,0,0,2" />

                                <ItemsControl ItemsSource="{Binding References}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AssemblyReferenceViewModel">
                                            <Border Padding="8,6" Background="{DynamicResource M3SurfaceContainerBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" CornerRadius="{StaticResource M3ShapeCornerSmall}" Margin="0,0,0,4">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="PackageVariant" Width="15" Height="15" Foreground="{DynamicResource M3PrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                                        <TextBlock Text="{Binding AssemblyPath}" FontSize="9.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsEnabled}" IsEnabled="{Binding !IsSystem}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Page 4: Scratchpad & Documentation Notes -->
                        <Grid RowDefinitions="Auto,*">
                            <Border Grid.Row="0" Background="{DynamicResource M3SurfaceContainerBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="0,0,0,1" Padding="10,4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="DOCUMENTATION &amp; NOTES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Notes.Length, StringFormat='{}{0} chars'}" FontSize="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <TextBox Grid.Row="1" Text="{Binding Notes, Mode=TwoWay}"
                                     AcceptsReturn="True" AcceptsTab="True"
                                     FontFamily="Consolas, Menlo, Monaco, monospace" FontSize="12"
                                     Foreground="{DynamicResource M3OnSurfaceBrush}" Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                     BorderThickness="0" Padding="10" TextWrapping="Wrap"
                                     PlaceholderText="// Write requirements, scratchpad notes, or plans here..." />
                        </Grid>

                        <!-- Page 5: Problems & Roslyn Diagnostics -->
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,8" Spacing="6">
                                <TextBlock Text="No problems detected in script."
                                           FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                           Margin="8" IsVisible="{Binding !Diagnostics.Count}" />

                                <ItemsControl ItemsSource="{Binding Diagnostics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DiagnosticItemViewModel">
                                            <Button Command="{Binding NavigateCommand}"
                                                    Background="Transparent" BorderThickness="0"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                    Padding="4" Cursor="Hand">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding SeverityIconKind}" Foreground="{Binding SeverityColorHex}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Top" />
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{DynamicResource M3OnSurfaceBrush}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding LocationString}" FontSize="9.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                    </Carousel>
                </Grid>
            </Border>

            <!-- ======================================================== -->
            <!-- 1C. VERTICAL SPLITTER (Column 2)                         -->
            <!-- ======================================================== -->
            <GridSplitter Grid.Column="2"
                          Width="4"
                          Background="{DynamicResource M3OutlineVariantBrush}"
                          ResizeDirection="Columns"
                          Cursor="SizeWestEast"
                          IsVisible="{Binding IsSideBarVisible}" />

            <!-- ======================================================== -->
            <!-- 1D. EDITOR & BOTTOM TOOL DECK (Column 3)                 -->
            <!-- ======================================================== -->
            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" MinHeight="100" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="{Binding BottomDeckGridLength, Mode=TwoWay}" MinHeight="0" />
                </Grid.RowDefinitions>

                <!-- Row 0: VS Code Editor Tab Bar & Actions Strip -->
                <Border Grid.Row="0"
                        Background="{DynamicResource M3SurfaceContainerLowBrush}"
                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                        BorderThickness="0,0,0,1"
                        Height="35"
                        Padding="0,0,8,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- Scrollable Multi-Tab Document Strip -->
                        <controls:StudioTabBarControl Grid.Column="0" />

                        <!-- Right-Side Editor Action Toolbar -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <!-- Stepping Controls (Visible when active debugging) -->
                            <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding IsDebugging}">
                                <Button Command="{Binding ContinueDebugCommand}" Classes="cs-toolbar-filled" Background="{DynamicResource M3PrimaryBrush}" Foreground="{DynamicResource M3OnPrimaryBrush}" IsVisible="{Binding IsPaused}" ToolTip.Tip="Continue (F5)">
                                    <materialIcons:MaterialIcon Kind="Play" Width="13" Height="13" Foreground="{DynamicResource M3OnPrimaryBrush}" />
                                </Button>
                                <Button Command="{Binding StepOverCommand}" Classes="cs-toolbar-tonal" IsVisible="{Binding IsPaused}" ToolTip.Tip="Step Over (F10)">
                                    <materialIcons:MaterialIcon Kind="DebugStepOver" Width="13" Height="13" />
                                </Button>
                                <Button Command="{Binding StepIntoCommand}" Classes="cs-toolbar-tonal" IsVisible="{Binding IsPaused}" ToolTip.Tip="Step Into (F11)">
                                    <materialIcons:MaterialIcon Kind="DebugStepInto" Width="13" Height="13" />
                                </Button>
                                <Button Command="{Binding RestartDebugCommand}" Classes="cs-toolbar-icon" ToolTip.Tip="Restart Debugging">
                                    <materialIcons:MaterialIcon Kind="Restart" Width="13" Height="13" />
                                </Button>
                                <Button Command="{Binding StopDebugCommand}" Classes="cs-toolbar-outlined" BorderBrush="{DynamicResource M3ErrorBrush}" Foreground="{DynamicResource M3ErrorBrush}" ToolTip.Tip="Stop (Shift+F5)">
                                    <materialIcons:MaterialIcon Kind="Stop" Width="13" Height="13" Foreground="{DynamicResource M3ErrorBrush}" />
                                </Button>
                            </StackPanel>

                            <!-- Normal Stop (Visible during background execution) -->
                            <Button Command="{Binding StopCommand}" Classes="cs-toolbar-outlined" BorderBrush="{DynamicResource M3ErrorBrush}" Foreground="{DynamicResource M3ErrorBrush}" IsVisible="{Binding IsNormalExecuting}" ToolTip.Tip="Stop Execution (Shift+F5)">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <materialIcons:MaterialIcon Kind="Stop" Width="13" Height="13" Foreground="{DynamicResource M3ErrorBrush}" />
                                    <TextBlock Text="Stop" FontSize="11" FontWeight="Bold" />
                                </StackPanel>
                            </Button>

                            <!-- Run Script Button (Normal execution) -->
                            <Button Command="{Binding RunCodeCommand}"
                                    Classes="cs-toolbar-filled"
                                    Background="{DynamicResource M3SuccessBrush}"
                                    Foreground="{DynamicResource M3OnSuccessBrush}"
                                    IsVisible="{Binding !IsExecuting}"
                                    ToolTip.Tip="Run Script (Ctrl+F5)">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <materialIcons:MaterialIcon Kind="Play" Width="13" Height="13" Foreground="{DynamicResource M3OnSuccessBrush}" />
                                    <TextBlock Text="Run" FontSize="11" FontWeight="Bold" />
                                </StackPanel>
                            </Button>

                            <!-- Start Debugging Button -->
                            <Button Command="{Binding DebugCodeCommand}"
                                    Classes="cs-toolbar-tonal"
                                    IsVisible="{Binding !IsExecuting}"
                                    ToolTip.Tip="Start Debugging (F5)">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <materialIcons:MaterialIcon Kind="BugPlayOutline" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                    <TextBlock Text="Debug" FontSize="11" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Rectangle Width="1" Height="16" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="2,0" />

                            <!-- Format Document -->
                            <Button Command="{Binding FormatCodeCommand}" Classes="cs-toolbar-icon" ToolTip.Tip="Format Document (Shift+Alt+F)">
                                <materialIcons:MaterialIcon Kind="FormatAlignLeft" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </Button>

                            <!-- Word Wrap Toggle -->
                            <ToggleButton IsChecked="{Binding IsWordWrap, Mode=TwoWay}" Classes="cs-toolbar-icon" ToolTip.Tip="Toggle Word Wrap">
                                <materialIcons:MaterialIcon Kind="Wrap" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </ToggleButton>

                            <!-- Find & Replace -->
                            <Button Command="{Binding ToggleSearchCommand}" Classes="cs-toolbar-icon" ToolTip.Tip="Find in Editor (Ctrl+F)">
                                <materialIcons:MaterialIcon Kind="Magnify" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </Button>

                            <!-- Toggle Bottom Tool Deck -->
                            <Button Command="{Binding ToggleBottomDeckCommand}" Classes="cs-toolbar-icon" ToolTip.Tip="Toggle Bottom Panel (Ctrl+J)">
                                <materialIcons:MaterialIcon Kind="DockBottom" Width="15" Height="15" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </Button>

                            <!-- Save Script -->
                            <Button Command="{Binding SaveCommand}" Classes="cs-toolbar-icon" ToolTip.Tip="Save Script (Ctrl+S)">
                                <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 1: VS Code Breadcrumbs Bar -->
                <controls:StudioBreadcrumbsControl Grid.Row="1" />

                <!-- Row 2: AvaloniaEdit Code Canvas -->
                <Grid Grid.Row="2" Name="EditorHostGrid">
                    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}">
                        <avaloniaEdit:TextEditor Name="Editor"
                                                 FontFamily="JetBrains Mono, Menlo, Monaco, Consolas, Roboto Mono, monospace"
                                                 FontSize="13"
                                                 ShowLineNumbers="True"
                                                 WordWrap="False"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                 Foreground="{DynamicResource M3OnSurfaceBrush}" />
                    </Border>

                    <!-- Live Debug Hover Data Tip Card -->
                    <controls:DebugHoverDataTipControl Name="DebugHoverTip"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Top"
                                                       IsVisible="False" />
                </Grid>

                <!-- Row 3: Horizontal Splitter (Editor vs Bottom Dock) -->
                <GridSplitter Grid.Row="3"
                              Height="4"
                              Background="{DynamicResource M3OutlineVariantBrush}"
                              ResizeDirection="Rows"
                              Cursor="SizeNorthSouth"
                              IsVisible="{Binding IsBottomDeckExpanded}" />

                <!-- Row 4: Collapsible Bottom Tool Deck -->
                <controls:StudioBottomDeckControl Grid.Row="4"
                                                  IsVisible="{Binding IsBottomDeckExpanded}" />
            </Grid>

        </Grid>

        <!-- ============================================================ -->
        <!-- 2. VS CODE STATUS BAR (Bottom 22px Strip)                    -->
        <!-- ============================================================ -->
        <controls:StudioStatusBarControl Grid.Row="1" />

        <!-- ============================================================ -->
        <!-- 3. QUICK OPEN & COMMAND PALETTE OVERLAY MODAL                -->
        <!-- ============================================================ -->
        <controls:QuickOpenOverlayControl DataContext="{Binding QuickOpen}"
                                          Grid.RowSpan="2"
                                          ZIndex="999"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" />

    </Grid>
</UserControl>
