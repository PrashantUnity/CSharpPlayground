<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="850"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Views.CSharpManagerView"
             x:DataType="vm:CSharpManagerViewModel">

    <UserControl.Resources>
        <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Card Button Reset -->
        <Style Selector="Button.studio-card-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Stretch" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.studio-card-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Starter Template Card -->
        <Style Selector="Border.studio-template-card">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerLarge}" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.studio-card-btn:pointerover Border.studio-template-card">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}" />
        </Style>

        <!-- Workspace Item Row Card -->
        <Style Selector="Border.studio-item-card">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerLarge}" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.studio-card-btn:pointerover Border.studio-item-card">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineBrush}" />
        </Style>

        <!-- Filter Tab Buttons -->
        <Style Selector="Button.studio-filter-tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerFull}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.studio-filter-tab:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        </Style>
        <Style Selector="Button.studio-filter-tab.active">
            <Setter Property="Background" Value="{DynamicResource M3PrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnPrimaryBrush}" />
        </Style>

        <!-- Delete Button Hover -->
        <Style Selector="Button.studio-delete-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerFull}" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.studio-delete-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3ErrorContainerBrush}" />
        </Style>
        <Style Selector="Button.studio-delete-btn:pointerover materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource M3OnErrorContainerBrush}" />
        </Style>

        <!-- Search Input -->
        <Style Selector="TextBox.studio-search-box">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowestBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerFull}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        </Style>
        <Style Selector="TextBox.studio-search-box:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}" />
        </Style>

        <!-- ComboBox Popup & Item Styling -->
        <Style Selector="ComboBox /template/ Border#PopupBorder">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighestBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerMedium}" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerSmall}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        </Style>
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource M3PrimaryContainerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3PrimaryBrush}" />
        </Style>
        <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource M3SecondaryContainerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3PrimaryBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" Margin="32,28,32,48">

            <!-- ============================================================ -->
            <!-- 1. HERO HEADER: Studio Branding, Compiler Status & Actions   -->
            <!-- ============================================================ -->
            <Border BorderThickness="1"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    CornerRadius="{StaticResource M3ShapeCornerLarge}"
                    Background="{DynamicResource M3SurfaceContainerLowBrush}"
                    Padding="26,22">

                <Grid ColumnDefinitions="*,Auto">
                    <!-- Left: Studio Branding & Status Pill -->
                    <StackPanel Grid.Column="0" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <!-- Clean Studio Logo Badge -->
                            <Border Width="48" Height="48"
                                    CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                    Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                    BorderThickness="1">
                                <materialIcons:MaterialIcon Kind="CodeBraces" Width="24" Height="24"
                                                            Foreground="{DynamicResource M3PrimaryBrush}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="C# Code Studio &amp; Notebooks Hub"
                                               FontSize="21" FontWeight="Bold"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}"
                                               VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource M3SurfaceContainerHighBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                                            Height="24"
                                            Padding="8,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text=".NET 10 • C# 13" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Interactive C# scripts, LeetCode algorithm workspaces, and multi-cell notebooks with live Roslyn runtime"
                                           FontSize="12.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Subtle Engine Status Pill -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="62,0,0,0" VerticalAlignment="Center">
                            <Border Background="{DynamicResource M3SurfaceContainerHighBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource M3ShapeCornerFull}"
                                    Height="28"
                                    Padding="12,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource M3SuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Roslyn .NET 10 Engine Active" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Quick Stats & Creation CTAs -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <!-- Scripts Count Capsule -->
                        <Border Background="{DynamicResource M3SurfaceContainerHighBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                Height="36"
                                Padding="14,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="FileCodeOutline" Width="15" Height="15" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TotalScripts, StringFormat='{}{0} Scripts'}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Notebooks Count Capsule -->
                        <Border Background="{DynamicResource M3SurfaceContainerHighBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                Height="36"
                                Padding="14,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="NotebookOutline" Width="15" Height="15" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TotalNotebooks, StringFormat='{}{0} Notebooks'}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Return to FryPDF Home Action Button -->
                        <Button Command="{Binding NavigateToHomeCommand}"
                                Classes="m3-tonal-btn"
                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                Height="36"
                                MinHeight="0"
                                Padding="14,0"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                ToolTip.Tip="Return to FryPDF Home Dashboard (Esc / ⌘W)">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="HomeOutline" Width="16" Height="16" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="FryPDF Home" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Unified + New Script Primary Button -->
                        <Button Command="{Binding CreateNewScriptCommand}"
                                Classes="m3-filled-btn"
                                Background="{DynamicResource M3PrimaryBrush}"
                                Foreground="{DynamicResource M3OnPrimaryBrush}"
                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                Height="36"
                                MinHeight="0"
                                Padding="16,0"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                ToolTip.Tip="Create an empty C# automation script">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="New Script" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Unified + New Notebook Tonal Button -->
                        <Button Command="{Binding CreateNewNotebookCommand}"
                                Classes="m3-tonal-btn"
                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                Height="36"
                                MinHeight="0"
                                Padding="16,0"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                ToolTip.Tip="Create an interactive cell notebook">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="NotebookOutline" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="New Notebook" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- 2. STARTER TEMPLATES GALLERY: Interactive Preset Cards       -->
            <!-- ============================================================ -->
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="LightningBolt" Width="18" Height="18" Foreground="{DynamicResource M3PrimaryBrush}" />
                    <TextBlock Text="Starter Templates" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                    <TextBlock Text="— Click any preset to launch an instant workspace"
                               FontSize="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding StarterTemplates}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:CodeTemplate">
                            <Button Command="{Binding $parent[UserControl].((vm:CSharpManagerViewModel)DataContext).LaunchTemplateCommand}"
                                    CommandParameter="{Binding}"
                                    Classes="studio-card-btn"
                                    Margin="0,0,16,16"
                                    ToolTip.Tip="Click to launch this template workspace">
                                <Border Width="265" Height="165" Classes="studio-template-card">
                                    <Grid RowDefinitions="Auto,*,Auto">
                                        <!-- Header: Icon & Category Chip -->
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Width="36" Height="36"
                                                    CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                                    Background="{Binding AccentBackground}"
                                                    BorderBrush="{Binding AccentBorder}"
                                                    BorderThickness="1">
                                                <materialIcons:MaterialIcon Kind="{Binding IconKind}"
                                                                            Width="18" Height="18"
                                                                            Foreground="{Binding AccentColor}"
                                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Category Badge -->
                                            <Border Grid.Column="2"
                                                    Background="{Binding AccentBackground}"
                                                    BorderBrush="{Binding AccentBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                                    Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CategoryBadge}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{Binding AccentColor}" />
                                            </Border>
                                        </Grid>

                                        <!-- Body: Title & Description -->
                                        <StackPanel Grid.Row="1" Spacing="4" Margin="0,10,0,0">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource M3OnSurfaceBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                       TextWrapping="Wrap"
                                                       MaxLines="2" />
                                        </StackPanel>

                                        <!-- Footer: Tags & Action Cue -->
                                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                            <!-- Tag Pills -->
                                            <ItemsControl Grid.Column="0" ItemsSource="{Binding Tags}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource M3SurfaceContainerHighestBrush}" CornerRadius="{StaticResource M3ShapeCornerSmall}" Padding="5,2">
                                                            <TextBlock Text="{Binding}" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Launch Action Cue -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="Launch" FontSize="11" FontWeight="SemiBold" Foreground="{Binding AccentColor}" />
                                                <materialIcons:MaterialIcon Kind="ArrowRight" Width="13" Height="13" Foreground="{Binding AccentColor}" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ============================================================ -->
            <!-- 3. WORKSPACE ITEMS SECTION: Toolbar, Filters & List Items   -->
            <!-- ============================================================ -->
            <StackPanel Spacing="16">
                <!-- Toolbar: Segmented Filters, Sort & Search Box -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Left: Section Title & Segmented Type Filter -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="FolderMultipleOutline" Width="20" Height="20" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Workspace Items" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                    CornerRadius="{StaticResource M3ShapeCornerFull}"
                                    Height="22"
                                    Padding="8,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding FilteredItems.Count}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- Segmented Pill Filter: [ All | Scripts | Notebooks ] -->
                        <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                Height="36"
                                Padding="3"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <Button Command="{Binding SetSelectedTypeFilterCommand}" CommandParameter="All"
                                        Classes="studio-filter-tab"
                                        Classes.active="{Binding IsAllFilterActive}">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="ViewList" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="All" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SetSelectedTypeFilterCommand}" CommandParameter="Scripts"
                                        Classes="studio-filter-tab"
                                        Classes.active="{Binding IsScriptsFilterActive}">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="FileCodeOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="Scripts" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SetSelectedTypeFilterCommand}" CommandParameter="Notebooks"
                                        Classes="studio-filter-tab"
                                        Classes.active="{Binding IsNotebooksFilterActive}">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="NotebookOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="Notebooks" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right: Sort Selector & Search Bar -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <!-- Sort ComboBox -->
                        <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                Height="36"
                                Padding="8,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="SortVariant" Width="15" Height="15" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="4,0,2,0" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding SortOptions}"
                                          SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Height="28"
                                          MinHeight="0"
                                          Padding="4,0"
                                          FontSize="11.5"
                                          Foreground="{DynamicResource M3OnSurfaceBrush}"
                                          VerticalAlignment="Center"
                                          VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Search Box with Clear Button -->
                        <Border Width="280" Background="{DynamicResource M3SurfaceContainerLowestBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                Height="36"
                                Padding="10,0"
                                VerticalAlignment="Center">
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="Magnify" Width="16" Height="16"
                                                            Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" Margin="2,0,6,0" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding SearchQuery, Mode=TwoWay}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         MinHeight="0"
                                         Height="28"
                                         Padding="0"
                                         FontSize="12"
                                         Foreground="{DynamicResource M3OnSurfaceBrush}"
                                         VerticalAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         PlaceholderText="Search items or category..." />
                                <Button Grid.Column="2"
                                        Command="{Binding ClearSearchCommand}"
                                        IsVisible="{Binding HasSearchQuery}"
                                        Classes="studio-delete-btn"
                                        Width="24"
                                        Height="24"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Cursor="Hand"
                                        ToolTip.Tip="Clear search">
                                    <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="15" Height="15" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Empty State (When Filter/Search produces 0 items) -->
                <Border IsVisible="{Binding !HasFilteredItems}"
                        Background="{DynamicResource M3SurfaceContainerLowBrush}"
                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource M3ShapeCornerLarge}"
                        Padding="32,48"
                        HorizontalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource M3SurfaceContainerHighBrush}" HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="FolderSearchOutline" Width="28" Height="28" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="No workspace items found" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No scripts or notebooks match your current query or category filter."
                                   FontSize="12.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" HorizontalAlignment="Center" />
                        <Button Command="{Binding ResetFiltersCommand}"
                                Classes="m3-tonal-btn"
                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                Padding="16,7"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Refresh" Width="15" Height="15" />
                                <TextBlock Text="Reset Filters &amp; Search" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Cards List (When Items Exist) -->
                <ItemsControl ItemsSource="{Binding FilteredItems}" IsVisible="{Binding HasFilteredItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:WorkspaceItemSummary">
                            <Button Command="{Binding $parent[UserControl].((vm:CSharpManagerViewModel)DataContext).OpenItemCommand}"
                                    CommandParameter="{Binding}"
                                    Classes="studio-card-btn"
                                    ToolTip.Tip="Click anywhere to open in Studio">
                                <Border Classes="studio-item-card">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Leading Distinctive Category Icon -->
                                        <Border Grid.Column="0" Width="40" Height="40"
                                                CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                Background="{Binding IconBackground}"
                                                BorderBrush="{Binding IconBorder}"
                                                BorderThickness="1.5"
                                                Margin="0,0,16,0"
                                                VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="{Binding IconKind}"
                                                                        Width="20" Height="20"
                                                                        Foreground="{Binding IconForeground}"
                                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Main Metadata Block -->
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <!-- Top Line: Title & Semantic Chips -->
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="14.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource M3OnSurfaceBrush}" />

                                                <!-- Kind Badge (Script vs Notebook) -->
                                                <Border Background="{Binding KindBadgeBackground}"
                                                        BorderBrush="{Binding KindBadgeBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                                        Padding="7,2">
                                                    <TextBlock Text="{Binding KindBadgeText}"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{Binding KindBadgeForeground}" />
                                                </Border>

                                                <!-- Category Chip -->
                                                <Border Background="{Binding CategoryBackground}"
                                                        BorderBrush="{Binding CategoryBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                                        Padding="7,2">
                                                    <TextBlock Text="{Binding Category}"
                                                               FontSize="10.5" FontWeight="Medium"
                                                               Foreground="{Binding CategoryForeground}" />
                                                </Border>
                                            </StackPanel>

                                            <!-- Bottom Line: Description, Mode Snippet & Last Modified -->
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="520" />
                                                <TextBlock Text="•" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" FontSize="11" />
                                                <TextBlock Text="{Binding DetailsSnippet}"
                                                           FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                <TextBlock Text="•" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" FontSize="11" />
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <materialIcons:MaterialIcon Kind="ClockOutline" Width="12" Height="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                    <TextBlock Text="{Binding FormattedLastModified}"
                                                               FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Right: Contextual Actions & Open Affordance -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <!-- Delete Button -->
                                            <Button Command="{Binding $parent[UserControl].((vm:CSharpManagerViewModel)DataContext).DeleteItemCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="studio-delete-btn"
                                                    ToolTip.Tip="Delete Item">
                                                <materialIcons:MaterialIcon Kind="DeleteOutline" Width="18" Height="18"
                                                                            Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                            </Button>

                                            <!-- Refined Open Studio Cue -->
                                            <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource M3ShapeCornerFull}"
                                                    Padding="14,6">
                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <TextBlock Text="Open" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                    <materialIcons:MaterialIcon Kind="ArrowRight" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
