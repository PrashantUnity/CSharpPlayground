<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             mc:Ignorable="d" d:DesignWidth="1380" d:DesignHeight="880"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Views.CSharpManagerView"
             x:DataType="vm:CSharpManagerViewModel"
             Background="{DynamicResource DsBgBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CSharpEditorPlugin/Views/CSharpManagerPaletteTokens.axaml" />
            </ResourceDictionary.MergedDictionaries>

        <!-- Template Card in Nexus Style -->
        <DataTemplate x:Key="TemplateCardTemplate" x:DataType="models:CodeTemplate">
            <Button Command="{Binding $parent[UserControl].((vm:CSharpManagerViewModel)DataContext).SelectTemplateCommand}"
                    CommandParameter="{Binding}"
                    Classes="nexus-card-btn"
                    Margin="0,0,16,16">
                <Border Width="240" Height="148" Classes="nexus-glass-card">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <!-- Top: Icon badge + Kind label -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Width="36" Height="36"
                                    CornerRadius="8"
                                    Background="{Binding AccentBackground}"
                                    BorderBrush="{Binding AccentBorder}"
                                    BorderThickness="1">
                                <materialIcons:MaterialIcon Kind="{Binding IconKind}"
                                                            Width="18" Height="18"
                                                            Foreground="{Binding AccentColor}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <Border Grid.Column="2" Background="{DynamicResource DsBgBrush}" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding KindBadgeText}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DsMutedBrush}" />
                            </Border>
                        </Grid>

                        <!-- Body: Title & Description -->
                        <StackPanel Grid.Row="1" Spacing="4" Margin="0,10,0,0">
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource DsTextWhiteBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Title}" />
                            <TextBlock Text="{Binding Description}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource DsMutedBrush}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="2"
                                       ToolTip.Tip="{Binding Description}" />
                        </StackPanel>

                        <!-- Footer: Tags -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="0,8,0,0" ClipToBounds="True">
                            <ItemsControl ItemsSource="{Binding VisibleTags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="nexus-tag-pill">
                                            <TextBlock Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Classes="nexus-tag-pill overflow" IsVisible="{Binding HasOverflowTags}">
                                <TextBlock Text="{Binding OverflowTagLabel}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://CSharpEditorPlugin/Views/CSharpManagerStyles.axaml" />
    </UserControl.Styles>

    <Panel>
        <!-- ============================================================ -->
        <!-- ROOT 2-COLUMN LAYOUT: SIDEBAR + MAIN CONTENT                -->
        <!-- ============================================================ -->
        <Grid ColumnDefinitions="256,*">

            <!-- ============================================================ -->
            <!-- 1. LEFT SIDEBAR (w-64 bg-ds-surface border-r border-ds-border) -->
            <!-- ============================================================ -->
            <controls:HubSidebarControl Grid.Column="0" />

            <!-- ============================================================ -->
            <!-- 2. MAIN CONTENT (main.flex-1 flex flex-col h-full bg-ds-bg)   -->
            <!-- ============================================================ -->
            <Grid Grid.Column="1" RowDefinitions="64,*">

                <!-- Top Header: Search & Sync Bar -->
                <controls:HubTopHeaderControl Grid.Row="0" />

                <!-- Dashboard Scrollable Area -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Panel>
                        <!-- Top-Right Ambient Glow Effect -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="500" Height="380"
                                IsHitTestVisible="False">
                            <Border.Background>
                                <RadialGradientBrush Center="100%,0%" GradientOrigin="100%,0%" RadiusX="100%" RadiusY="100%">
                                    <GradientStop Offset="0" Color="#1A2F81F7" />
                                    <GradientStop Offset="1" Color="#000D1117" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Dashboard Content Max-Width 1120px -->
                        <StackPanel MaxWidth="1120" Margin="32,28,32,48" Spacing="28">

                            <!-- Status Notification Toast Banner -->
                            <Border CornerRadius="8" BorderThickness="1" Padding="14,10" Margin="0,0,0,4"
                                    Background="{DynamicResource DsSurfaceBrush}"
                                    BorderBrush="{DynamicResource DsBorderBrush}"
                                    IsVisible="{Binding HasStatusBannerMessage}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="CheckCircleOutline" Width="18" Height="18"
                                                                Foreground="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                                IsVisible="{Binding !IsStatusBannerError}" />
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline" Width="18" Height="18"
                                                                Foreground="#F85149" VerticalAlignment="Center" Margin="0,0,10,0"
                                                                IsVisible="{Binding IsStatusBannerError}" />
                                    <TextBlock Grid.Column="1" Text="{Binding StatusBannerMessage}" FontSize="12.5" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Command="{Binding DismissStatusBannerCommand}" Classes="nexus-btn-ghost" Width="26" Height="26" Padding="0" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                                    </Button>
                                </Grid>
                            </Border>

                            <controls:HubWelcomeSectionControl />

                            <!-- ============================================================ -->
                            <!-- SECTION 2: PINNED WORKSPACES                                 -->
                            <!-- ============================================================ -->
                            <controls:HubPinnedWorkspacesControl />

                            <!-- ============================================================ -->
                            <!-- SECTION 3: 2-COLUMN SPLIT (RECENT ACTIVITY + SYSTEM STATUS)  -->
                            <!-- ============================================================ -->
                            <Grid ColumnDefinitions="*,28,340">

                                <!-- LEFT COLUMN: RECENT ACTIVITY / TEMPLATES -->
                                <controls:HubWorkspacesPanelControl Grid.Column="0" />

                                <!-- RIGHT COLUMN: SYSTEM STATUS, RESOURCE USAGE & SHORTCUTS -->
                                <controls:HubSystemStatusPanelControl Grid.Column="2" />

                            </Grid>

                        </StackPanel>
                    </Panel>
                </ScrollViewer>

            </Grid>

        </Grid>

        <!-- ================================================================ -->
        <!-- "New Script" / "New Notebook" location dialog                    -->
        <!-- ================================================================ -->
        <!-- ================================================================ -->
        <!-- "New Script" / "New Notebook" location dialog                    -->
        <!-- ================================================================ -->
        <controls:HubCreateItemDialogControl />

    </Panel>
</UserControl>
