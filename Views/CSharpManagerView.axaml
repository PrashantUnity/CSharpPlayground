<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1380" d:DesignHeight="880"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Views.CSharpManagerView"
             x:DataType="vm:CSharpManagerViewModel"
             Background="{DynamicResource DsBgBrush}">

    <UserControl.Resources>
        <!-- Modern Developer Dashboard Palette (Nexus / GitHub Dark) -->
        <SolidColorBrush x:Key="DsBgBrush" Color="#0D1117" />
        <SolidColorBrush x:Key="DsSurfaceBrush" Color="#161B22" />
        <SolidColorBrush x:Key="DsSurfaceHoverBrush" Color="#21262D" />
        <SolidColorBrush x:Key="DsSurfaceHighBrush" Color="#1C2128" />
        <SolidColorBrush x:Key="DsBorderBrush" Color="#30363D" />
        <SolidColorBrush x:Key="DsBorderSubtleBrush" Color="#21262D" />
        <SolidColorBrush x:Key="DsTextBrush" Color="#C9D1D9" />
        <SolidColorBrush x:Key="DsTextWhiteBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="DsMutedBrush" Color="#8B949E" />
        <SolidColorBrush x:Key="DsPrimaryBrush" Color="#2F81F7" />
        <SolidColorBrush x:Key="DsPrimaryHoverBrush" Color="#1F6FEB" />
        <SolidColorBrush x:Key="DsPrimarySubtleBrush" Color="#1A2F81F7" />
        <SolidColorBrush x:Key="DsJupyterBrush" Color="#E34C26" />
        <SolidColorBrush x:Key="DsJupyterSubtleBrush" Color="#26E34C26" />
        <SolidColorBrush x:Key="DsLinqBrush" Color="#238636" />
        <SolidColorBrush x:Key="DsLinqSubtleBrush" Color="#26238636" />
        <SolidColorBrush x:Key="DsGreenBrush" Color="#2EA043" />
        <SolidColorBrush x:Key="DsGlassBgBrush" Color="#E6161B22" />

        <!-- Template Card in Nexus Style -->
        <DataTemplate x:Key="TemplateCardTemplate" x:DataType="models:CodeTemplate">
            <Button Command="{Binding $parent[UserControl].((vm:CSharpManagerViewModel)DataContext).SelectTemplateCommand}"
                    CommandParameter="{Binding}"
                    Classes="nexus-card-btn"
                    Margin="0,0,16,16">
                <Border Width="240" Height="148" Classes="nexus-glass-card">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <!-- Top: Icon badge + Kind label -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Width="36" Height="36"
                                    CornerRadius="8"
                                    Background="{Binding AccentBackground}"
                                    BorderBrush="{Binding AccentBorder}"
                                    BorderThickness="1">
                                <materialIcons:MaterialIcon Kind="{Binding IconKind}"
                                                            Width="18" Height="18"
                                                            Foreground="{Binding AccentColor}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <Border Grid.Column="2" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1"
                                    CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding KindBadgeText}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#8B949E" />
                            </Border>
                        </Grid>

                        <!-- Body: Title & Description -->
                        <StackPanel Grid.Row="1" Spacing="4" Margin="0,10,0,0">
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold" FontSize="13"
                                       Foreground="#FFFFFF"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Title}" />
                            <TextBlock Text="{Binding Description}"
                                       FontSize="11.5"
                                       Foreground="#8B949E"
                                       TextWrapping="Wrap"
                                       MaxLines="2" />
                        </StackPanel>

                        <!-- Footer: Tags -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="0,8,0,0" ClipToBounds="True">
                            <ItemsControl ItemsSource="{Binding VisibleTags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="nexus-tag-pill">
                                            <TextBlock Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Classes="nexus-tag-pill overflow" IsVisible="{Binding HasOverflowTags}">
                                <TextBlock Text="{Binding OverflowTagLabel}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Card Button Reset -->
        <Style Selector="Button.nexus-card-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Stretch" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.nexus-card-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Glass Card Base -->
        <Style Selector="Border.nexus-glass-card">
            <Setter Property="Background" Value="{DynamicResource DsGlassBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nexus-card-btn:pointerover Border.nexus-glass-card">
            <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryBrush}" />
            <Setter Property="Background" Value="#21262D" />
            <Setter Property="RenderTransform" Value="translateY(-2px)" />
        </Style>

        <!-- Sidebar Nav Button -->
        <Style Selector="Button.nexus-nav-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource DsMutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nexus-nav-item:pointerover">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.nexus-nav-item.active">
            <Setter Property="Background" Value="{DynamicResource DsPrimarySubtleBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DsPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Primary Action Button (New Notebook) -->
        <Style Selector="Button.nexus-btn-primary">
            <Setter Property="Background" Value="{DynamicResource DsPrimaryBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryHoverBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nexus-btn-primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource DsPrimaryHoverBrush}" />
        </Style>

        <!-- Surface Action Button (New Script) -->
        <Style Selector="Button.nexus-btn-surface">
            <Setter Property="Background" Value="{DynamicResource DsSurfaceBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nexus-btn-surface:pointerover">
            <Setter Property="Background" Value="#21262D" />
            <Setter Property="BorderBrush" Value="{DynamicResource DsMutedBrush}" />
        </Style>

        <!-- Ghost Icon Button -->
        <Style Selector="Button.nexus-btn-ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nexus-btn-ghost:pointerover">
            <Setter Property="Background" Value="#252C36" />
        </Style>

        <!-- Nexus Input TextBox -->
        <Style Selector="TextBox.nexus-input">
            <Setter Property="Background" Value="#0D1117" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="#2F81F7" />
            <Setter Property="SelectionBrush" Value="{DynamicResource DsPrimarySubtleBrush}" />
        </Style>
        <Style Selector="TextBox.nexus-input:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryBrush}" />
            <Setter Property="Background" Value="#0D1117" />
        </Style>
        <Style Selector="TextBox.nexus-input:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource DsMutedBrush}" />
        </Style>

        <!-- Flyout & ContextMenu Styles for GitHub Dark / Nexus Theme -->
        <Style Selector="FlyoutPresenter">
            <Setter Property="Background" Value="#161B22" />
            <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background" Value="#161B22" />
            <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="#161B22" />
            <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource DsTextBrush}" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style Selector="MenuItem:pointerover">
            <Setter Property="Background" Value="#21262D" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Tag Pill -->
        <Style Selector="Border.nexus-tag-pill">
            <Setter Property="Background" Value="#21262D" />
            <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
        <Style Selector="Border.nexus-tag-pill TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource DsMutedBrush}" />
        </Style>
        <Style Selector="Border.nexus-tag-pill.overflow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Table Row Button -->
        <Style Selector="Border.nexus-table-row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource DsBorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nexus-card-btn:pointerover Border.nexus-table-row">
            <Setter Property="Background" Value="#1AFFFFFF" />
        </Style>

        <!-- Segmented Tab Pill (Dashboard View Switcher) -->
        <Style Selector="Button.nexus-tab-pill">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="9999" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Foreground" Value="{DynamicResource DsMutedBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nexus-tab-pill:pointerover">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.nexus-tab-pill.active">
            <Setter Property="Background" Value="#21262D" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Category Filter Chip -->
        <Style Selector="Button.nexus-filter-chip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9999" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Foreground" Value="{DynamicResource DsMutedBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nexus-filter-chip:pointerover">
            <Setter Property="Background" Value="#161B22" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.nexus-filter-chip.active">
            <Setter Property="Background" Value="{DynamicResource DsPrimarySubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DsPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Pulsing Status Dot Animation -->
        <Style Selector="Border.status-pulse-dot">
            <Style.Animations>
                <Animation Duration="0:0:2.0" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1.0" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1.0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- ============================================================ -->
        <!-- ROOT 2-COLUMN LAYOUT: SIDEBAR + MAIN CONTENT                -->
        <!-- ============================================================ -->
        <Grid ColumnDefinitions="256,*">

            <!-- ============================================================ -->
            <!-- 1. LEFT SIDEBAR (w-64 bg-ds-surface border-r border-ds-border) -->
            <!-- ============================================================ -->
            <Border Grid.Column="0"
                    Background="{DynamicResource DsSurfaceBrush}"
                    BorderBrush="{DynamicResource DsBorderBrush}"
                    BorderThickness="0,0,1,0"
                    ZIndex="20">
                <Grid RowDefinitions="64,*,Auto">

                    <!-- Sidebar Header: Brand Logo & Title -->
                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource DsBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="20,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                            <!-- Gradient Icon Container -->
                            <Border Width="32" Height="32" CornerRadius="8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Offset="0" Color="#2F81F7" />
                                        <GradientStop Offset="1" Color="#7C3AED" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <materialIcons:MaterialIcon Kind="HexagonOutline"
                                                            Width="18" Height="18"
                                                            Foreground="#FFFFFF"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Brand Name -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="FryPDF" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                                <TextBlock Text="Studio" FontSize="13" Foreground="{DynamicResource DsMutedBrush}" Margin="5,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Sidebar Main Nav Items -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="2" Margin="12,16,12,16">

                            <!-- MENU Section Label -->
                            <TextBlock Text="MENU"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DsMutedBrush}"
                                       Margin="12,4,12,8" />

                            <!-- Home / Workspace Overview -->
                            <Button Command="{Binding SetSelectedTypeFilterCommand}" CommandParameter="All"
                                    Classes="nexus-nav-item"
                                    Classes.active="{Binding IsWorkspaceAllNavActive}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="Home" Width="18" Height="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Home" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- All Projects -->
                            <Button Command="{Binding SetSelectedTypeFilterCommand}" CommandParameter="All"
                                    Classes="nexus-nav-item">
                                <Grid ColumnDefinitions="Auto,*">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="FolderMultipleOutline" Width="18" Height="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="All Projects" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Jupyter / C# Notebooks -->
                            <Button Command="{Binding SetSelectedTypeFilterCommand}" CommandParameter="Notebooks"
                                    Classes="nexus-nav-item"
                                    Classes.active="{Binding IsNotebooksNavActive}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="NotebookOutline" Width="18" Height="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Notebooks" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="{DynamicResource DsBorderBrush}" CornerRadius="10" Padding="7,1.5">
                                        <TextBlock Text="{Binding TotalNotebooks}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DsTextBrush}" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- LINQ / C# Scripts -->
                            <Button Command="{Binding SetSelectedTypeFilterCommand}" CommandParameter="Scripts"
                                    Classes="nexus-nav-item"
                                    Classes.active="{Binding IsScriptsNavActive}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="CodeBraces" Width="18" Height="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="C# Scripts" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="{DynamicResource DsBorderBrush}" CornerRadius="10" Padding="7,1.5">
                                        <TextBlock Text="{Binding TotalScripts}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DsTextBrush}" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Pinned Workspaces -->
                            <Button Command="{Binding SetSelectedTypeFilterCommand}" CommandParameter="Pinned"
                                    Classes="nexus-nav-item"
                                    Classes.active="{Binding IsPinnedFilterActive}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="PinOutline" Width="18" Height="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Pinned" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="{DynamicResource DsBorderBrush}" CornerRadius="10" Padding="7,1.5">
                                        <TextBlock Text="{Binding PinnedCount}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DsTextBrush}" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Starter Templates -->
                            <Button Command="{Binding SetSelectedNavSectionCommand}" CommandParameter="Templates"
                                    Classes="nexus-nav-item"
                                    Classes.active="{Binding IsTemplatesSectionActive}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="LightningBoltOutline" Width="18" Height="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Templates" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="{DynamicResource DsBorderBrush}" CornerRadius="10" Padding="7,1.5">
                                        <TextBlock Text="{Binding StarterTemplates.Count}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DsTextBrush}" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Open Existing Project from Disk -->
                            <Button Click="OnOpenProjectFileClick"
                                    Classes="nexus-nav-item"
                                    ToolTip.Tip="Open existing project or document from disk (Ctrl+O / ⌘O)">
                                <Grid ColumnDefinitions="Auto,*">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="FolderOpenOutline" Width="18" Height="18" Foreground="#E3B341" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Open Project..." Margin="12,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- ENVIRONMENTS Section Label -->
                            <TextBlock Text="ENVIRONMENTS"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DsMutedBrush}"
                                       Margin="12,22,12,8" />

                            <!-- Data Connections / Document APIs -->
                            <Button Classes="nexus-nav-item" IsHitTestVisible="False">
                                <Grid ColumnDefinitions="Auto,*">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="DatabaseOutline" Width="18" Height="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Document APIs" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Roslyn .NET 10 Kernel -->
                            <Button Classes="nexus-nav-item" IsHitTestVisible="False">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="Cpu64Bit" Width="18" Height="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text=".NET 10 Kernels" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Width="7" Height="7" CornerRadius="3.5" Background="{DynamicResource DsGreenBrush}" Classes="status-pulse-dot" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sidebar Bottom Actions: Settings, Return to FryPDF & User Profile -->
                    <Border Grid.Row="2"
                            BorderBrush="{DynamicResource DsBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16">
                        <StackPanel Spacing="10">
                            <!-- Return to FryPDF Home -->
                            <Button Command="{Binding NavigateToHomeCommand}"
                                    Classes="nexus-nav-item"
                                    ToolTip.Tip="Return to FryPDF Studio Home (Esc / ⌘W)">
                                <Grid ColumnDefinitions="Auto,*">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="HomeOutline" Width="18" Height="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="FryPDF Studio" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- User Profile Row -->
                            <Border Background="#1C2128"
                                    BorderBrush="{DynamicResource DsBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,8">
                                <Grid ColumnDefinitions="Auto,*">
                                    <!-- User Avatar Circle -->
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                            Background="#2F81F7" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1">
                                        <TextBlock Text="FD" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- User Text -->
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Developer" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        <TextBlock Text="Local .NET 10" FontSize="11" Foreground="{DynamicResource DsMutedBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- 2. MAIN CONTENT (main.flex-1 flex flex-col h-full bg-ds-bg)   -->
            <!-- ============================================================ -->
            <Grid Grid.Column="1" RowDefinitions="64,*">

                <!-- Top Header: Search & Sync Bar -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="32,0">
                    <Grid ColumnDefinitions="*,Auto">

                        <!-- Global Search Box -->
                        <Border Grid.Column="0"
                                MaxWidth="580"
                                HorizontalAlignment="Left"
                                Background="#161B22"
                                BorderBrush="{DynamicResource DsBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="38"
                                Padding="12,0"
                                VerticalAlignment="Center">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="Magnify" Width="18" Height="18"
                                                            Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding SearchQuery, Mode=TwoWay}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         MinHeight="0" Height="28" Padding="0"
                                         FontSize="13"
                                         Foreground="#FFFFFF"
                                         VerticalAlignment="Center" VerticalContentAlignment="Center"
                                         PlaceholderText="Search notebooks, scripts, or connections (Ctrl+K)" />
                                <Button Grid.Column="2"
                                        Command="{Binding ClearSearchCommand}"
                                        IsVisible="{Binding HasSearchQuery}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4"
                                        Cursor="Hand"
                                        ToolTip.Tip="Clear search">
                                    <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="16" Height="16" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                                <!-- Ctrl+K Badge -->
                                <Border Grid.Column="3" Background="{DynamicResource DsBorderBrush}" CornerRadius="4" Padding="5,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <TextBlock Text="Ctrl" FontSize="10" FontFamily="JetBrains Mono,Consolas" Foreground="{DynamicResource DsMutedBrush}" />
                                        <TextBlock Text="K" FontSize="10" FontFamily="JetBrains Mono,Consolas" Foreground="{DynamicResource DsMutedBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Right Actions: Bell & Sync Button -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <!-- Bell Button -->
                            <Button Background="Transparent" BorderThickness="0" Padding="6" Cursor="Hand" ToolTip.Tip="Notifications">
                                <Panel>
                                    <materialIcons:MaterialIcon Kind="BellOutline" Width="20" Height="20" Foreground="{DynamicResource DsMutedBrush}" />
                                    <Border Width="7" Height="7" CornerRadius="3.5" Background="{DynamicResource DsPrimaryBrush}"
                                            BorderBrush="{DynamicResource DsBgBrush}" BorderThickness="1"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0" />
                                </Panel>
                            </Button>

                            <!-- Sync Button -->
                            <Button Command="{Binding RefreshWorkspaceCommand}"
                                    Classes="nexus-btn-surface"
                                    Height="36" Padding="14,0"
                                    ToolTip.Tip="Reload workspace items from disk">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="CloudUploadOutline" Width="17" Height="17" VerticalAlignment="Center" />
                                    <TextBlock Text="Sync" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                    </Grid>
                </Border>

                <!-- Dashboard Scrollable Area -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Panel>
                        <!-- Top-Right Ambient Glow Effect -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="500" Height="380"
                                IsHitTestVisible="False">
                            <Border.Background>
                                <RadialGradientBrush Center="100%,0%" GradientOrigin="100%,0%" RadiusX="100%" RadiusY="100%">
                                    <GradientStop Offset="0" Color="#1A2F81F7" />
                                    <GradientStop Offset="1" Color="#000D1117" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Dashboard Content Max-Width 1120px -->
                        <StackPanel MaxWidth="1120" Margin="32,28,32,48" Spacing="28">

                            <!-- Status Notification Toast Banner -->
                            <Border CornerRadius="8" BorderThickness="1" Padding="14,10" Margin="0,0,0,4"
                                    Background="#161B22"
                                    BorderBrush="{DynamicResource DsBorderBrush}"
                                    IsVisible="{Binding HasStatusBannerMessage}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="CheckCircleOutline" Width="18" Height="18"
                                                                Foreground="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                                IsVisible="{Binding !IsStatusBannerError}" />
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline" Width="18" Height="18"
                                                                Foreground="#F85149" VerticalAlignment="Center" Margin="0,0,10,0"
                                                                IsVisible="{Binding IsStatusBannerError}" />
                                    <TextBlock Grid.Column="1" Text="{Binding StatusBannerMessage}" FontSize="12.5" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Command="{Binding DismissStatusBannerCommand}" Classes="nexus-btn-ghost" Width="26" Height="26" Padding="0" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- ============================================================ -->
                            <!-- SECTION 1: WELCOME & QUICK ACTIONS                           -->
                            <!-- ============================================================ -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Welcome back, Developer" FontSize="26" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                    <TextBlock Text="Pick up where you left off, open an existing project, or start a new workspace." FontSize="13" Foreground="{DynamicResource DsMutedBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <!-- New Notebook (Primary Blue) -->
                                    <Button Command="{Binding CreateNewNotebookCommand}"
                                            Classes="nexus-btn-primary"
                                            ToolTip.Tip="Create an interactive cell notebook">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="New Notebook" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- New Script (Surface Button) -->
                                    <Button Command="{Binding CreateNewScriptCommand}"
                                            Classes="nexus-btn-surface"
                                            ToolTip.Tip="Create a new C# automation script">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="FileCodeOutline" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="New Script" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Open Project / Document (Surface Dropdown) -->
                                    <Button Name="OpenProjectButton"
                                            Classes="nexus-btn-surface"
                                            ToolTip.Tip="Open existing project, file, or folder from disk (Ctrl+O / ⌘O)">
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuItem Header="Open Project / Document File..." Click="OnOpenProjectFileClick">
                                                    <MenuItem.Icon>
                                                        <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="16" Height="16" Foreground="{DynamicResource DsPrimaryBrush}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Open Project Folder..." Click="OnOpenProjectFolderClick">
                                                    <MenuItem.Icon>
                                                        <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" Foreground="#E3B341" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" Foreground="#E3B341" VerticalAlignment="Center" />
                                            <TextBlock Text="Open..." VerticalAlignment="Center" />
                                            <materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- ============================================================ -->
                            <!-- SECTION 2: PINNED WORKSPACES                                 -->
                            <!-- ============================================================ -->
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Pin" Width="16" Height="16" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="PINNED WORKSPACES" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource DsSurfaceHighBrush}" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1"
                                                CornerRadius="10" Padding="7,1.5" VerticalAlignment="Center" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding PinnedCount}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DsTextBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Quick access shortcuts" FontSize="11" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*,*,*">

                                    <!-- ============================================================ -->
                                    <!-- CARD 1: PINNED WORKSPACE 1 / EMPTY SLOT 1                   -->
                                    <!-- ============================================================ -->
                                    <Panel Grid.Column="0" Margin="0,0,8,0">
                                        <!-- 1A. Pinned Item 1 Active Card -->
                                        <Border Classes="nexus-glass-card" Height="175" IsVisible="{Binding HasPinnedItem1}">
                                            <Panel>
                                                <!-- Main Click Target (Opens Document) -->
                                                <Button Command="{Binding OpenPinnedItem1Command}"
                                                        Classes="nexus-card-btn"
                                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="16,14">
                                                    <Grid RowDefinitions="Auto,*,Auto">
                                                        <!-- Header: Icon & Runtime Badge -->
                                                        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" Margin="0,0,60,0">
                                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                                                    Background="#1E1E1E" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1"
                                                                    VerticalAlignment="Center">
                                                                <Panel>
                                                                    <materialIcons:MaterialIcon Kind="NotebookOutline" Width="20" Height="20"
                                                                                                Foreground="{DynamicResource DsJupyterBrush}"
                                                                                                IsVisible="{Binding PinnedItem1.IsNotebook}"
                                                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    <TextBlock Text="C#" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DsGreenBrush}"
                                                                               IsVisible="{Binding PinnedItem1.IsScript}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Panel>
                                                            </Border>

                                                            <Border Grid.Column="1" Background="{DynamicResource DsBgBrush}" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1"
                                                                    CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <Panel>
                                                                    <TextBlock Text=".NET 10" FontSize="10" Foreground="{DynamicResource DsMutedBrush}"
                                                                               IsVisible="{Binding PinnedItem1.IsNotebook}" />
                                                                    <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding PinnedItem1.IsScript}">
                                                                        <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                                                                        <TextBlock Text="Roslyn C# 13" FontSize="10" Foreground="{DynamicResource DsMutedBrush}" />
                                                                    </StackPanel>
                                                                </Panel>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Body: Title & Monospace Path -->
                                                        <StackPanel Grid.Row="1" Spacing="4" Margin="0,12,0,0">
                                                            <TextBlock Text="{Binding PinnedItem1.Title}"
                                                                       FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="{Binding PinnedItem1.Title}" />
                                                            <TextBlock Text="{Binding PinnedItem1.DisplayLocation}"
                                                                       FontSize="10.5" FontFamily="JetBrains Mono,Consolas" Foreground="{DynamicResource DsMutedBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <!-- Footer: Clock Ago & Open Cue -->
                                                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                <materialIcons:MaterialIcon Kind="ClockOutline" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                                                <TextBlock Text="{Binding PinnedItem1.FormattedLastModified}" FontSize="11" Foreground="{DynamicResource DsMutedBrush}" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <TextBlock Text="Open" FontSize="11" Foreground="{DynamicResource DsPrimaryBrush}" FontWeight="Medium" />
                                                                <materialIcons:MaterialIcon Kind="ArrowRight" Width="13" Height="13" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                </Button>

                                                <!-- Top-Right Actions: Quick Unpin Button & Options Menu -->
                                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Orientation="Horizontal" Spacing="2" Margin="0,12,12,0">
                                                    <Button Command="{Binding UnpinItemCommand}" CommandParameter="{Binding PinnedItem1}"
                                                            Classes="nexus-btn-ghost" Width="28" Height="28"
                                                            ToolTip.Tip="Unpin workspace">
                                                        <materialIcons:MaterialIcon Kind="PinOffOutline" Width="15" Height="15" Foreground="{DynamicResource DsMutedBrush}" />
                                                    </Button>
                                                    <Button Classes="nexus-btn-ghost" Width="28" Height="28"
                                                            ToolTip.Tip="Options">
                                                        <Button.Flyout>
                                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                <MenuItem Header="Open in Studio" Command="{Binding OpenPinnedItem1Command}">
                                                                    <MenuItem.Icon>
                                                                        <materialIcons:MaterialIcon Kind="OpenInNew" Width="16" Height="16" Foreground="{DynamicResource DsPrimaryBrush}" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="Unpin Workspace" Command="{Binding UnpinItemCommand}" CommandParameter="{Binding PinnedItem1}">
                                                                    <MenuItem.Icon>
                                                                        <materialIcons:MaterialIcon Kind="PinOffOutline" Width="16" Height="16" Foreground="{DynamicResource DsMutedBrush}" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <Separator />
                                                                <MenuItem Header="Delete Workspace" Command="{Binding DeleteItemCommand}" CommandParameter="{Binding PinnedItem1}">
                                                                    <MenuItem.Icon>
                                                                        <materialIcons:MaterialIcon Kind="DeleteOutline" Width="16" Height="16" Foreground="#F85149" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                        <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="18" Height="18" Foreground="{DynamicResource DsMutedBrush}" />
                                                    </Button>
                                                </StackPanel>
                                            </Panel>
                                        </Border>

                                        <!-- 1B. Empty Pinned Slot 1 Placeholder -->
                                        <Button Classes="nexus-card-btn" Height="175" IsVisible="{Binding !HasPinnedItem1}">
                                            <Button.Flyout>
                                                <Flyout Placement="BottomEdgeAlignedLeft">
                                                    <Border Width="340" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10" Padding="14">
                                                        <StackPanel Spacing="12">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <StackPanel Grid.Column="0" Spacing="2">
                                                                    <TextBlock Text="Pin a Workspace" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" />
                                                                    <TextBlock Text="Select a document to pin to Slot 1" FontSize="11" Foreground="{DynamicResource DsMutedBrush}" />
                                                                </StackPanel>
                                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Pin" Width="18" Height="18" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                                            </Grid>
                                                            <Border Height="1" Background="{DynamicResource DsBorderBrush}" />
                                                            <StackPanel Spacing="6" IsVisible="{Binding HasUnpinnedItems}">
                                                                <TextBlock Text="AVAILABLE WORKSPACES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DsMutedBrush}" />
                                                                <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                                    <ItemsControl ItemsSource="{Binding UnpinnedItems}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="models:WorkspaceItemSummary">
                                                                                <Button Command="{Binding $parent[UserControl].((vm:CSharpManagerViewModel)DataContext).PinItemCommand}"
                                                                                        CommandParameter="{Binding}"
                                                                                        Classes="nexus-card-btn" Margin="0,2">
                                                                                    <Border Background="#0D1117" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1"
                                                                                            CornerRadius="6" Padding="10,8">
                                                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                                                            <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding IconKind}" Width="16" Height="16"
                                                                                                                        Foreground="{Binding IconForeground}"
                                                                                                                        VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                                                                           TextTrimming="CharacterEllipsis" />
                                                                                                <TextBlock Text="{Binding DisplayLocation}" FontSize="10" FontFamily="JetBrains Mono,Consolas" Foreground="{DynamicResource DsMutedBrush}"
                                                                                                           TextTrimming="CharacterEllipsis" />
                                                                                            </StackPanel>
                                                                                            <materialIcons:MaterialIcon Grid.Column="2" Kind="PinOutline" Width="15" Height="15" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                </Button>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </ScrollViewer>
                                                            </StackPanel>
                                                            <Border Background="#0D1117" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12"
                                                                    IsVisible="{Binding !HasUnpinnedItems}">
                                                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                                    <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="20" Height="20" Foreground="{DynamicResource DsGreenBrush}" HorizontalAlignment="Center" />
                                                                    <TextBlock Text="All workspaces are pinned" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </Flyout>
                                            </Button.Flyout>
                                            <Border Classes="nexus-glass-card" Height="175">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                                    <Border Width="40" Height="40" CornerRadius="20"
                                                            Background="{DynamicResource DsSurfaceBrush}"
                                                            BorderBrush="{DynamicResource DsBorderBrush}"
                                                            BorderThickness="1"
                                                            HorizontalAlignment="Center">
                                                        <materialIcons:MaterialIcon Kind="PinOutline" Width="20" Height="20" Foreground="{DynamicResource DsMutedBrush}"
                                                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="Pin a workspace" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource DsTextBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="Click to select workspace" FontSize="11" Foreground="{DynamicResource DsMutedBrush}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </Panel>

                                    <!-- ============================================================ -->
                                    <!-- CARD 2: PINNED WORKSPACE 2 / EMPTY SLOT 2                   -->
                                    <!-- ============================================================ -->
                                    <Panel Grid.Column="1" Margin="4,0,4,0">
                                        <!-- 2A. Pinned Item 2 Active Card -->
                                        <Border Classes="nexus-glass-card" Height="175" IsVisible="{Binding HasPinnedItem2}">
                                            <Panel>
                                                <!-- Main Click Target (Opens Document) -->
                                                <Button Command="{Binding OpenPinnedItem2Command}"
                                                        Classes="nexus-card-btn"
                                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="16,14">
                                                    <Grid RowDefinitions="Auto,*,Auto">
                                                        <!-- Header: Icon & Runtime Badge -->
                                                        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" Margin="0,0,60,0">
                                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                                                    Background="#1E1E1E" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1"
                                                                    VerticalAlignment="Center">
                                                                <Panel>
                                                                    <materialIcons:MaterialIcon Kind="NotebookOutline" Width="20" Height="20"
                                                                                                Foreground="{DynamicResource DsJupyterBrush}"
                                                                                                IsVisible="{Binding PinnedItem2.IsNotebook}"
                                                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    <TextBlock Text="C#" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DsGreenBrush}"
                                                                               IsVisible="{Binding PinnedItem2.IsScript}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Panel>
                                                            </Border>

                                                            <Border Grid.Column="1" Background="{DynamicResource DsBgBrush}" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1"
                                                                    CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <Panel>
                                                                    <TextBlock Text=".NET 10" FontSize="10" Foreground="{DynamicResource DsMutedBrush}"
                                                                               IsVisible="{Binding PinnedItem2.IsNotebook}" />
                                                                    <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding PinnedItem2.IsScript}">
                                                                        <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                                                                        <TextBlock Text="Roslyn C# 13" FontSize="10" Foreground="{DynamicResource DsMutedBrush}" />
                                                                    </StackPanel>
                                                                </Panel>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Body: Title & Monospace Path -->
                                                        <StackPanel Grid.Row="1" Spacing="4" Margin="0,12,0,0">
                                                            <TextBlock Text="{Binding PinnedItem2.Title}"
                                                                       FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="{Binding PinnedItem2.Title}" />
                                                            <TextBlock Text="{Binding PinnedItem2.DisplayLocation}"
                                                                       FontSize="10.5" FontFamily="JetBrains Mono,Consolas" Foreground="{DynamicResource DsMutedBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <!-- Footer: Clock Ago & Open Cue -->
                                                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                <materialIcons:MaterialIcon Kind="ClockOutline" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                                                <TextBlock Text="{Binding PinnedItem2.FormattedLastModified}" FontSize="11" Foreground="{DynamicResource DsMutedBrush}" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <TextBlock Text="Open" FontSize="11" Foreground="{DynamicResource DsPrimaryBrush}" FontWeight="Medium" />
                                                                <materialIcons:MaterialIcon Kind="ArrowRight" Width="13" Height="13" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                </Button>

                                                <!-- Top-Right Actions: Quick Unpin Button & Options Menu -->
                                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Orientation="Horizontal" Spacing="2" Margin="0,12,12,0">
                                                    <Button Command="{Binding UnpinItemCommand}" CommandParameter="{Binding PinnedItem2}"
                                                            Classes="nexus-btn-ghost" Width="28" Height="28"
                                                            ToolTip.Tip="Unpin workspace">
                                                        <materialIcons:MaterialIcon Kind="PinOffOutline" Width="15" Height="15" Foreground="{DynamicResource DsMutedBrush}" />
                                                    </Button>
                                                    <Button Classes="nexus-btn-ghost" Width="28" Height="28"
                                                            ToolTip.Tip="Options">
                                                        <Button.Flyout>
                                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                <MenuItem Header="Open in Studio" Command="{Binding OpenPinnedItem2Command}">
                                                                    <MenuItem.Icon>
                                                                        <materialIcons:MaterialIcon Kind="OpenInNew" Width="16" Height="16" Foreground="{DynamicResource DsPrimaryBrush}" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="Unpin Workspace" Command="{Binding UnpinItemCommand}" CommandParameter="{Binding PinnedItem2}">
                                                                    <MenuItem.Icon>
                                                                        <materialIcons:MaterialIcon Kind="PinOffOutline" Width="16" Height="16" Foreground="{DynamicResource DsMutedBrush}" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <Separator />
                                                                <MenuItem Header="Delete Workspace" Command="{Binding DeleteItemCommand}" CommandParameter="{Binding PinnedItem2}">
                                                                    <MenuItem.Icon>
                                                                        <materialIcons:MaterialIcon Kind="DeleteOutline" Width="16" Height="16" Foreground="#F85149" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                        <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="18" Height="18" Foreground="{DynamicResource DsMutedBrush}" />
                                                    </Button>
                                                </StackPanel>
                                            </Panel>
                                        </Border>

                                        <!-- 2B. Empty Pinned Slot 2 Placeholder -->
                                        <Button Classes="nexus-card-btn" Height="175" IsVisible="{Binding !HasPinnedItem2}">
                                            <Button.Flyout>
                                                <Flyout Placement="BottomEdgeAlignedLeft">
                                                    <Border Width="340" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10" Padding="14">
                                                        <StackPanel Spacing="12">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <StackPanel Grid.Column="0" Spacing="2">
                                                                    <TextBlock Text="Pin a Workspace" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" />
                                                                    <TextBlock Text="Select a document to pin to Slot 2" FontSize="11" Foreground="{DynamicResource DsMutedBrush}" />
                                                                </StackPanel>
                                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Pin" Width="18" Height="18" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                                            </Grid>
                                                            <Border Height="1" Background="{DynamicResource DsBorderBrush}" />
                                                            <StackPanel Spacing="6" IsVisible="{Binding HasUnpinnedItems}">
                                                                <TextBlock Text="AVAILABLE WORKSPACES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DsMutedBrush}" />
                                                                <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                                    <ItemsControl ItemsSource="{Binding UnpinnedItems}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="models:WorkspaceItemSummary">
                                                                                <Button Command="{Binding $parent[UserControl].((vm:CSharpManagerViewModel)DataContext).PinItemCommand}"
                                                                                        CommandParameter="{Binding}"
                                                                                        Classes="nexus-card-btn" Margin="0,2">
                                                                                    <Border Background="#0D1117" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1"
                                                                                            CornerRadius="6" Padding="10,8">
                                                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                                                            <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding IconKind}" Width="16" Height="16"
                                                                                                                        Foreground="{Binding IconForeground}"
                                                                                                                        VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                                                                           TextTrimming="CharacterEllipsis" />
                                                                                                <TextBlock Text="{Binding DisplayLocation}" FontSize="10" FontFamily="JetBrains Mono,Consolas" Foreground="{DynamicResource DsMutedBrush}"
                                                                                                           TextTrimming="CharacterEllipsis" />
                                                                                            </StackPanel>
                                                                                            <materialIcons:MaterialIcon Grid.Column="2" Kind="PinOutline" Width="15" Height="15" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                </Button>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </ScrollViewer>
                                                            </StackPanel>
                                                            <Border Background="#0D1117" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12"
                                                                    IsVisible="{Binding !HasUnpinnedItems}">
                                                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                                    <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="20" Height="20" Foreground="{DynamicResource DsGreenBrush}" HorizontalAlignment="Center" />
                                                                    <TextBlock Text="All workspaces are pinned" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </Flyout>
                                            </Button.Flyout>
                                            <Border Classes="nexus-glass-card" Height="175">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                                    <Border Width="40" Height="40" CornerRadius="20"
                                                            Background="{DynamicResource DsSurfaceBrush}"
                                                            BorderBrush="{DynamicResource DsBorderBrush}"
                                                            BorderThickness="1"
                                                            HorizontalAlignment="Center">
                                                        <materialIcons:MaterialIcon Kind="Plus" Width="20" Height="20" Foreground="{DynamicResource DsMutedBrush}"
                                                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="Pin a second workspace" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource DsTextBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="Add quick access shortcut" FontSize="11" Foreground="{DynamicResource DsMutedBrush}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </Panel>

                                    <!-- ============================================================ -->
                                    <!-- CARD 3: PINNED WORKSPACE 3 / EMPTY SLOT 3                   -->
                                    <!-- ============================================================ -->
                                    <Panel Grid.Column="2" Margin="8,0,0,0">
                                        <!-- 3A. Pinned Item 3 Active Card -->
                                        <Border Classes="nexus-glass-card" Height="175" IsVisible="{Binding HasPinnedItem3}">
                                            <Panel>
                                                <!-- Main Click Target (Opens Document) -->
                                                <Button Command="{Binding OpenPinnedItem3Command}"
                                                        Classes="nexus-card-btn"
                                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="16,14">
                                                    <Grid RowDefinitions="Auto,*,Auto">
                                                        <!-- Header: Icon & Runtime Badge -->
                                                        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" Margin="0,0,60,0">
                                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                                                    Background="#1E1E1E" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1"
                                                                    VerticalAlignment="Center">
                                                                <Panel>
                                                                    <materialIcons:MaterialIcon Kind="NotebookOutline" Width="20" Height="20"
                                                                                                Foreground="{DynamicResource DsJupyterBrush}"
                                                                                                IsVisible="{Binding PinnedItem3.IsNotebook}"
                                                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    <TextBlock Text="C#" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DsGreenBrush}"
                                                                               IsVisible="{Binding PinnedItem3.IsScript}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Panel>
                                                            </Border>

                                                            <Border Grid.Column="1" Background="{DynamicResource DsBgBrush}" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1"
                                                                    CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <Panel>
                                                                    <TextBlock Text=".NET 10" FontSize="10" Foreground="{DynamicResource DsMutedBrush}"
                                                                               IsVisible="{Binding PinnedItem3.IsNotebook}" />
                                                                    <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding PinnedItem3.IsScript}">
                                                                        <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                                                                        <TextBlock Text="Roslyn C# 13" FontSize="10" Foreground="{DynamicResource DsMutedBrush}" />
                                                                    </StackPanel>
                                                                </Panel>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Body: Title & Monospace Path -->
                                                        <StackPanel Grid.Row="1" Spacing="4" Margin="0,12,0,0">
                                                            <TextBlock Text="{Binding PinnedItem3.Title}"
                                                                       FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="{Binding PinnedItem3.Title}" />
                                                            <TextBlock Text="{Binding PinnedItem3.DisplayLocation}"
                                                                       FontSize="10.5" FontFamily="JetBrains Mono,Consolas" Foreground="{DynamicResource DsMutedBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <!-- Footer: Clock Ago & Open Cue -->
                                                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                <materialIcons:MaterialIcon Kind="ClockOutline" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                                                <TextBlock Text="{Binding PinnedItem3.FormattedLastModified}" FontSize="11" Foreground="{DynamicResource DsMutedBrush}" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <TextBlock Text="Open" FontSize="11" Foreground="{DynamicResource DsPrimaryBrush}" FontWeight="Medium" />
                                                                <materialIcons:MaterialIcon Kind="ArrowRight" Width="13" Height="13" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                </Button>

                                                <!-- Top-Right Actions: Quick Unpin Button & Options Menu -->
                                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Orientation="Horizontal" Spacing="2" Margin="0,12,12,0">
                                                    <Button Command="{Binding UnpinItemCommand}" CommandParameter="{Binding PinnedItem3}"
                                                            Classes="nexus-btn-ghost" Width="28" Height="28"
                                                            ToolTip.Tip="Unpin workspace">
                                                        <materialIcons:MaterialIcon Kind="PinOffOutline" Width="15" Height="15" Foreground="{DynamicResource DsMutedBrush}" />
                                                    </Button>
                                                    <Button Classes="nexus-btn-ghost" Width="28" Height="28"
                                                            ToolTip.Tip="Options">
                                                        <Button.Flyout>
                                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                <MenuItem Header="Open in Studio" Command="{Binding OpenPinnedItem3Command}">
                                                                    <MenuItem.Icon>
                                                                        <materialIcons:MaterialIcon Kind="OpenInNew" Width="16" Height="16" Foreground="{DynamicResource DsPrimaryBrush}" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="Unpin Workspace" Command="{Binding UnpinItemCommand}" CommandParameter="{Binding PinnedItem3}">
                                                                    <MenuItem.Icon>
                                                                        <materialIcons:MaterialIcon Kind="PinOffOutline" Width="16" Height="16" Foreground="{DynamicResource DsMutedBrush}" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <Separator />
                                                                <MenuItem Header="Delete Workspace" Command="{Binding DeleteItemCommand}" CommandParameter="{Binding PinnedItem3}">
                                                                    <MenuItem.Icon>
                                                                        <materialIcons:MaterialIcon Kind="DeleteOutline" Width="16" Height="16" Foreground="#F85149" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                        <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="18" Height="18" Foreground="{DynamicResource DsMutedBrush}" />
                                                    </Button>
                                                </StackPanel>
                                            </Panel>
                                        </Border>

                                        <!-- 3B. Empty Pinned Slot 3 Placeholder / Starter Templates Flyout -->
                                        <Button Classes="nexus-card-btn" Height="175" IsVisible="{Binding !HasPinnedItem3}">
                                            <Button.Flyout>
                                                <Flyout Placement="BottomEdgeAlignedRight">
                                                    <Border Width="340" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10" Padding="14">
                                                        <StackPanel Spacing="12">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <StackPanel Grid.Column="0" Spacing="2">
                                                                    <TextBlock Text="Pin a Workspace" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" />
                                                                    <TextBlock Text="Pin documents to your quick access header" FontSize="11" Foreground="{DynamicResource DsMutedBrush}" />
                                                                </StackPanel>
                                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Pin" Width="18" Height="18" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                                            </Grid>

                                                            <Border Height="1" Background="{DynamicResource DsBorderBrush}" />

                                                            <!-- If there are unpinned items -->
                                                            <StackPanel Spacing="6" IsVisible="{Binding HasUnpinnedItems}">
                                                                <TextBlock Text="AVAILABLE WORKSPACES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DsMutedBrush}" />
                                                                <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                                    <ItemsControl ItemsSource="{Binding UnpinnedItems}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="models:WorkspaceItemSummary">
                                                                                <Button Command="{Binding $parent[UserControl].((vm:CSharpManagerViewModel)DataContext).PinItemCommand}"
                                                                                        CommandParameter="{Binding}"
                                                                                        Classes="nexus-card-btn"
                                                                                        Margin="0,2">
                                                                                    <Border Background="#0D1117" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1"
                                                                                            CornerRadius="6" Padding="10,8">
                                                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                                                            <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding IconKind}" Width="16" Height="16"
                                                                                                                        Foreground="{Binding IconForeground}"
                                                                                                                        VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                                                                           TextTrimming="CharacterEllipsis" />
                                                                                                <TextBlock Text="{Binding DisplayLocation}" FontSize="10" FontFamily="JetBrains Mono,Consolas" Foreground="{DynamicResource DsMutedBrush}"
                                                                                                           TextTrimming="CharacterEllipsis" />
                                                                                            </StackPanel>
                                                                                            <materialIcons:MaterialIcon Grid.Column="2" Kind="PinOutline" Width="15" Height="15" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                </Button>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </ScrollViewer>
                                                            </StackPanel>

                                                            <!-- If all items are pinned -->
                                                            <Border Background="#0D1117" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12"
                                                                    IsVisible="{Binding !HasUnpinnedItems}">
                                                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                                    <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="20" Height="20" Foreground="{DynamicResource DsGreenBrush}" HorizontalAlignment="Center" />
                                                                    <TextBlock Text="All workspaces are pinned" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                                </StackPanel>
                                                            </Border>

                                                            <Border Height="1" Background="{DynamicResource DsBorderBrush}" />

                                                            <!-- Quick Creation & Templates Shortcuts -->
                                                            <StackPanel Spacing="6">
                                                                <Button Command="{Binding SetActiveDashboardViewCommand}" CommandParameter="Templates"
                                                                        Classes="nexus-btn-surface" Height="34" Padding="10,0">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                        <materialIcons:MaterialIcon Kind="LightningBoltOutline" Width="15" Height="15" Foreground="{DynamicResource DsPrimaryBrush}" />
                                                                        <TextBlock Text="Explore Starter Templates" FontSize="11.5" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </Flyout>
                                            </Button.Flyout>
                                            <Border Classes="nexus-glass-card" Height="175">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                                    <Border Width="40" Height="40" CornerRadius="20"
                                                            Background="{DynamicResource DsSurfaceBrush}"
                                                            BorderBrush="{DynamicResource DsBorderBrush}"
                                                            BorderThickness="1"
                                                            HorizontalAlignment="Center">
                                                        <materialIcons:MaterialIcon Kind="Plus" Width="20" Height="20" Foreground="{DynamicResource DsMutedBrush}"
                                                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="Pin a workspace" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource DsTextBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="Add third quick access slot" FontSize="11" Foreground="{DynamicResource DsMutedBrush}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </Panel>

                                </Grid>
                            </StackPanel>

                            <!-- ============================================================ -->
                            <!-- SECTION 3: 2-COLUMN SPLIT (RECENT ACTIVITY + SYSTEM STATUS)  -->
                            <!-- ============================================================ -->
                            <Grid ColumnDefinitions="*,28,340">

                                <!-- LEFT COLUMN: RECENT ACTIVITY / TEMPLATES -->
                                <StackPanel Grid.Column="0" Spacing="16">

                                    <!-- Dashboard Navigation & View Switcher (Workspaces vs Starter Templates) -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Segmented Tab Pill: [ Workspaces (N) ] [ Starter Templates (N) ] -->
                                        <Border Grid.Column="0" Background="#161B22" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1"
                                                CornerRadius="9999" Padding="3">
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <Button Command="{Binding SetActiveDashboardViewCommand}" CommandParameter="Workspaces"
                                                        Classes="nexus-tab-pill"
                                                        Classes.active="{Binding IsWorkspacesTabActive}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <materialIcons:MaterialIcon Kind="FileTreeOutline" Width="15" Height="15" VerticalAlignment="Center" />
                                                        <TextBlock Text="Workspaces" VerticalAlignment="Center" />
                                                        <Border Background="{DynamicResource DsBorderBrush}" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding AllItems.Count}" FontSize="10" FontWeight="Bold" />
                                                        </Border>
                                                    </StackPanel>
                                                </Button>

                                                <Button Command="{Binding SetActiveDashboardViewCommand}" CommandParameter="Templates"
                                                        Classes="nexus-tab-pill"
                                                        Classes.active="{Binding IsTemplatesTabActive}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <materialIcons:MaterialIcon Kind="LightningBoltOutline" Width="15" Height="15" VerticalAlignment="Center" />
                                                        <TextBlock Text="Starter Templates" VerticalAlignment="Center" />
                                                        <Border Background="{DynamicResource DsBorderBrush}" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding StarterTemplates.Count}" FontSize="10" FontWeight="Bold" />
                                                        </Border>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- ======================================================== -->
                                    <!-- 3A. WORKSPACES RECENT ACTIVITY VIEW                     -->
                                    <!-- ======================================================== -->
                                    <StackPanel Spacing="12" IsVisible="{Binding IsWorkspacesTabActive}">

                                        <!-- Header: Title & Category Filter Chips -->
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="History" Width="16" Height="16" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="RECENT WORKSPACES" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Segmented Category Filter Chips -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <!-- All Chip -->
                                                <Button Command="{Binding SetSelectedTypeFilterCommand}" CommandParameter="All"
                                                        Classes="nexus-filter-chip"
                                                        Classes.active="{Binding IsAllFilterActive}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                        <TextBlock Text="All" />
                                                        <TextBlock Text="{Binding AllItems.Count}" FontSize="10" Opacity="0.7" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Notebooks Chip -->
                                                <Button Command="{Binding SetSelectedTypeFilterCommand}" CommandParameter="Notebooks"
                                                        Classes="nexus-filter-chip"
                                                        Classes.active="{Binding IsNotebooksFilterActive}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                        <TextBlock Text="Notebooks" />
                                                        <TextBlock Text="{Binding TotalNotebooks}" FontSize="10" Opacity="0.7" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Scripts Chip -->
                                                <Button Command="{Binding SetSelectedTypeFilterCommand}" CommandParameter="Scripts"
                                                        Classes="nexus-filter-chip"
                                                        Classes.active="{Binding IsScriptsFilterActive}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                        <TextBlock Text="Scripts" />
                                                        <TextBlock Text="{Binding TotalScripts}" FontSize="10" Opacity="0.7" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Pinned Chip -->
                                                <Button Command="{Binding SetSelectedTypeFilterCommand}" CommandParameter="Pinned"
                                                        Classes="nexus-filter-chip"
                                                        Classes.active="{Binding IsPinnedFilterActive}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                        <materialIcons:MaterialIcon Kind="Pin" Width="12" Height="12" VerticalAlignment="Center" />
                                                        <TextBlock Text="Pinned" />
                                                        <TextBlock Text="{Binding PinnedCount}" FontSize="10" Opacity="0.7" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Inline Search & Filter Bar -->
                                        <Border Background="#161B22" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Height="36" Padding="10,0">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="Magnify" Width="16" Height="16" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBox Grid.Column="1" Text="{Binding SearchQuery, Mode=TwoWay}"
                                                         Background="Transparent" BorderThickness="0"
                                                         MinHeight="0" Height="28" Padding="0"
                                                         FontSize="12.5" Foreground="#FFFFFF"
                                                         VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                         PlaceholderText="Filter workspaces by title, location path, or tags..." />
                                                <Button Grid.Column="2" Command="{Binding ClearSearchCommand}"
                                                        IsVisible="{Binding HasSearchQuery}"
                                                        Classes="nexus-btn-ghost" Width="24" Height="24" Padding="0" VerticalAlignment="Center">
                                                    <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="15" Height="15" Foreground="{DynamicResource DsMutedBrush}" />
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <!-- Glass Table Box -->
                                        <Border Background="{DynamicResource DsSurfaceBrush}"
                                                BorderBrush="{DynamicResource DsBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                ClipToBounds="True">
                                            <StackPanel>
                                                <!-- Table Header (12 Columns equivalent) -->
                                                <Border Background="#1C2128"
                                                        BorderBrush="{DynamicResource DsBorderBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="18,10">
                                                    <Grid ColumnDefinitions="6*,3*,3*,Auto">
                                                        <TextBlock Grid.Column="0" Text="NAME &amp; WORKSPACE" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource DsMutedBrush}" Margin="34,0,0,0" />
                                                        <TextBlock Grid.Column="1" Text="TYPE" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource DsMutedBrush}" />
                                                        <TextBlock Grid.Column="2" Text="MODIFIED" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource DsMutedBrush}" HorizontalAlignment="Right" />
                                                        <Border Grid.Column="3" Width="38" />
                                                    </Grid>
                                                </Border>

                                                <!-- Empty State when 0 filtered items -->
                                                <Border IsVisible="{Binding !HasFilteredItems}" Padding="32,48">
                                                    <StackPanel HorizontalAlignment="Center" Spacing="12">
                                                        <Border Width="52" Height="52" CornerRadius="26" Background="#21262D" HorizontalAlignment="Center">
                                                            <materialIcons:MaterialIcon Kind="FolderSearchOutline" Width="26" Height="26" Foreground="{DynamicResource DsMutedBrush}"
                                                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Text="No workspace items found" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Try clearing search keywords, switching filters, or open an existing project from disk." FontSize="12" Foreground="{DynamicResource DsMutedBrush}" HorizontalAlignment="Center" />
                                                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,6,0,0">
                                                            <Button Command="{Binding ResetFiltersCommand}"
                                                                    Classes="nexus-btn-surface"
                                                                    IsVisible="{Binding HasSearchQuery}">
                                                                <TextBlock Text="Reset Search &amp; Filters" />
                                                            </Button>
                                                            <Button Click="OnOpenProjectFileClick"
                                                                    Classes="nexus-btn-primary">
                                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                    <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" VerticalAlignment="Center" />
                                                                    <TextBlock Text="Open Existing Project..." VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Table Items List -->
                                                <ItemsControl ItemsSource="{Binding FilteredItems}" IsVisible="{Binding HasFilteredItems}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Spacing="0" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.DataTemplates>
                                                        <!-- Solution & External Workspace Group Header (Visual Studio & Rider Style) -->
                                                        <DataTemplate x:DataType="vm:WorkspaceGroupHeaderViewModel">
                                                            <Border Background="#161B22"
                                                                    BorderBrush="{DynamicResource DsBorderBrush}"
                                                                    BorderThickness="0,1,0,1"
                                                                    Padding="18,10"
                                                                    Margin="0,2,0,0">
                                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                    <!-- Col 0: Solution Icon + Title, Project Tag & Path -->
                                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                                        <Border Width="28" Height="28" CornerRadius="6"
                                                                                Background="#1C2128" BorderBrush="{DynamicResource DsPrimaryBrush}" BorderThickness="1"
                                                                                VerticalAlignment="Center">
                                                                            <materialIcons:MaterialIcon Kind="FolderMultipleOutline" Width="16" Height="16"
                                                                                                        Foreground="{DynamicResource DsPrimaryBrush}"
                                                                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                                                                <Border Background="#1A2F81F7" BorderBrush="#332F81F7" BorderThickness="1" CornerRadius="4" Padding="5,1">
                                                                                    <TextBlock Text="WORKSPACE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource DsPrimaryBrush}" />
                                                                                </Border>
                                                                            </StackPanel>
                                                                            <TextBlock Text="{Binding FolderPath}" FontSize="10.5" FontFamily="JetBrains Mono,Consolas"
                                                                                       Foreground="{DynamicResource DsMutedBrush}" TextTrimming="CharacterEllipsis"
                                                                                       ToolTip.Tip="{Binding FolderPath}" />
                                                                        </StackPanel>
                                                                    </StackPanel>

                                                                    <!-- Col 2: Solution Document Count -->
                                                                    <Border Grid.Column="2" Background="#21262D" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1"
                                                                            CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
                                                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                            <materialIcons:MaterialIcon Kind="FileDocumentMultipleOutline" Width="12" Height="12" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding SubtitleText}" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource DsTextBrush}" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>

                                                        <!-- Standard Workspace Document Item Row (1-Click Launch) -->
                                                        <DataTemplate x:DataType="models:WorkspaceItemSummary">
                                                            <Button Command="{Binding $parent[UserControl].((vm:CSharpManagerViewModel)DataContext).OpenItemCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Classes="nexus-card-btn">
                                                                <Button.ContextMenu>
                                                                    <ContextMenu>
                                                                        <MenuItem Header="Open in Studio"
                                                                                  Command="{Binding $parent[UserControl].((vm:CSharpManagerViewModel)DataContext).OpenItemCommand}"
                                                                                  CommandParameter="{Binding}">
                                                                            <MenuItem.Icon>
                                                                                <materialIcons:MaterialIcon Kind="OpenInNew" Width="16" Height="16" Foreground="{DynamicResource DsPrimaryBrush}" />
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                        <MenuItem Header="Pin / Unpin Workspace"
                                                                                  Command="{Binding $parent[UserControl].((vm:CSharpManagerViewModel)DataContext).TogglePinCommand}"
                                                                                  CommandParameter="{Binding}">
                                                                            <MenuItem.Icon>
                                                                                <materialIcons:MaterialIcon Kind="Pin" Width="16" Height="16" Foreground="{DynamicResource DsPrimaryBrush}" />
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                        <Separator />
                                                                        <MenuItem Header="Delete Workspace"
                                                                                  Command="{Binding $parent[UserControl].((vm:CSharpManagerViewModel)DataContext).DeleteItemCommand}"
                                                                                  CommandParameter="{Binding}">
                                                                            <MenuItem.Icon>
                                                                                <materialIcons:MaterialIcon Kind="DeleteOutline" Width="16" Height="16" Foreground="#F85149" />
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                    </ContextMenu>
                                                                </Button.ContextMenu>
                                                                <Border Classes="nexus-table-row">
                                                                    <Grid ColumnDefinitions="6*,3*,3*,Auto">

                                                                        <!-- Col 0: Icon + Title, Pin Badge & Folder -->
                                                                        <Grid Grid.Column="0" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                                                            <materialIcons:MaterialIcon Grid.Column="0"
                                                                                                        Kind="{Binding IconKind}"
                                                                                                        Width="18" Height="18"
                                                                                                        Foreground="{Binding IconForeground}"
                                                                                                        VerticalAlignment="Center"
                                                                                                        Margin="0,0,14,0" />
                                                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                    <materialIcons:MaterialIcon Kind="SubdirectoryArrowRight" Width="13" Height="13"
                                                                                                                Foreground="{DynamicResource DsMutedBrush}"
                                                                                                                IsVisible="{Binding IsExternal}"
                                                                                                                VerticalAlignment="Center"
                                                                                                                Margin="0,0,2,0" />
                                                                                    <TextBlock Text="{Binding Title}"
                                                                                               FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource DsTextBrush}"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               ToolTip.Tip="{Binding Title}" />
                                                                                    <materialIcons:MaterialIcon Kind="Pin" Width="13" Height="13"
                                                                                                                Foreground="{DynamicResource DsPrimaryBrush}"
                                                                                                                IsVisible="{Binding IsPinned}"
                                                                                                                VerticalAlignment="Center"
                                                                                                                ToolTip.Tip="Pinned to Header" />
                                                                                </StackPanel>
                                                                                <TextBlock Text="{Binding DisplayLocation}"
                                                                                            FontSize="10.5" FontFamily="JetBrains Mono,Consolas" Foreground="{DynamicResource DsMutedBrush}"
                                                                                            TextTrimming="CharacterEllipsis"
                                                                                            ToolTip.Tip="{Binding DisplayLocationTooltip}" />
                                                                            </StackPanel>
                                                                        </Grid>

                                                                        <!-- Col 1: Type Pill -->
                                                                        <Border Grid.Column="1"
                                                                                Background="#0D1117"
                                                                                BorderBrush="{DynamicResource DsBorderBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="4"
                                                                                Padding="7,2"
                                                                                HorizontalAlignment="Left"
                                                                                VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding KindBadgeText}" FontSize="10.5" Foreground="{DynamicResource DsMutedBrush}" />
                                                                        </Border>

                                                                        <!-- Col 2: Modified Relative Date -->
                                                                        <TextBlock Grid.Column="2"
                                                                                   Text="{Binding FormattedLastModified}"
                                                                                   FontSize="12" Foreground="{DynamicResource DsMutedBrush}"
                                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />

                                                                        <!-- Col 3: Row Actions (Pin Toggle + Delete + Open Cue) -->
                                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                            <!-- Pin Toggle Button -->
                                                                            <Button Command="{Binding $parent[UserControl].((vm:CSharpManagerViewModel)DataContext).TogglePinCommand}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Classes="nexus-btn-ghost"
                                                                                    Width="28" Height="28" Padding="0"
                                                                                    VerticalAlignment="Center"
                                                                                    Cursor="Hand">
                                                                                <Panel>
                                                                                    <materialIcons:MaterialIcon Kind="Pin" Width="16" Height="16"
                                                                                                                Foreground="{DynamicResource DsPrimaryBrush}"
                                                                                                                IsVisible="{Binding IsPinned}"
                                                                                                                ToolTip.Tip="Unpin from top workspaces" />
                                                                                    <materialIcons:MaterialIcon Kind="PinOutline" Width="16" Height="16"
                                                                                                                Foreground="{DynamicResource DsMutedBrush}"
                                                                                                                IsVisible="{Binding !IsPinned}"
                                                                                                                ToolTip.Tip="Pin to top workspaces" />
                                                                                </Panel>
                                                                            </Button>

                                                                            <!-- Delete Button -->
                                                                            <Button Command="{Binding $parent[UserControl].((vm:CSharpManagerViewModel)DataContext).DeleteItemCommand}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Classes="nexus-btn-ghost"
                                                                                    Width="28" Height="28" Padding="0"
                                                                                    VerticalAlignment="Center"
                                                                                    Cursor="Hand"
                                                                                    ToolTip.Tip="Delete Workspace">
                                                                                <materialIcons:MaterialIcon Kind="DeleteOutline" Width="16" Height="16" Foreground="{DynamicResource DsMutedBrush}" />
                                                                            </Button>

                                                                            <!-- Direct Open Cue -->
                                                                            <materialIcons:MaterialIcon Kind="ChevronRight" Width="16" Height="16" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                                                        </StackPanel>

                                                                    </Grid>
                                                                </Border>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.DataTemplates>
                                                </ItemsControl>

                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- ======================================================== -->
                                    <!-- 3B. STARTER TEMPLATES GALLERY VIEW                      -->
                                    <!-- ======================================================== -->
                                    <StackPanel Spacing="24" IsVisible="{Binding IsTemplatesTabActive}">
                                        <!-- Script Templates Group -->
                                        <StackPanel Spacing="12">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="C# Automation Scripts" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                                <TextBlock Text="— runs top to bottom" FontSize="12" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding ScriptTemplates}" ItemTemplate="{StaticResource TemplateCardTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Notebook Templates Group -->
                                        <StackPanel Spacing="12">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Interactive C# Notebooks" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                                <TextBlock Text="— multi-cell interactive exploration" FontSize="12" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding NotebookTemplates}" ItemTemplate="{StaticResource TemplateCardTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>

                                </StackPanel>

                                <!-- RIGHT COLUMN: SYSTEM STATUS, RESOURCE USAGE & SHORTCUTS -->
                                <StackPanel Grid.Column="2" Spacing="16">

                                    <!-- Card 1: Studio Environment & System Health -->
                                    <Border Classes="nexus-glass-card" Padding="16">
                                        <StackPanel Spacing="12">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <materialIcons:MaterialIcon Kind="Cpu64Bit" Width="16" Height="16" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="STUDIO ENVIRONMENT" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Roslyn & .NET 10 Status -->
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6"
                                                        Background="{DynamicResource DsPrimarySubtleBrush}">
                                                    <materialIcons:MaterialIcon Kind="CodeTags" Width="16" Height="16" Foreground="{DynamicResource DsPrimaryBrush}"
                                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RoslynEngineTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                                    <TextBlock Text="{Binding RoslynEngineStatus}" FontSize="10.5" Foreground="{DynamicResource DsMutedBrush}" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Width="8" Height="8" CornerRadius="4" Background="{DynamicResource DsGreenBrush}" Classes="status-pulse-dot" VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Storage Engine Status -->
                                            <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding LibraryRootPath}">
                                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6"
                                                        Background="{DynamicResource DsLinqSubtleBrush}">
                                                    <materialIcons:MaterialIcon Kind="DatabaseOutline" Width="16" Height="16" Foreground="{DynamicResource DsGreenBrush}"
                                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StorageEngineTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                                    <TextBlock Text="{Binding StorageEngineStatus}" FontSize="10.5" Foreground="{DynamicResource DsMutedBrush}" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Width="8" Height="8" CornerRadius="4" Background="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                                            </Grid>

                                            <Border Height="1" Background="{DynamicResource DsBorderBrush}" Margin="0,2" />

                                            <!-- Mini Resource Usage Meters -->
                                            <StackPanel Spacing="8">
                                                <!-- Memory Meter -->
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="Process Memory" FontSize="10.5" Foreground="{DynamicResource DsMutedBrush}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding MemoryUsageText}" FontSize="10.5" FontFamily="JetBrains Mono,Consolas" Foreground="{DynamicResource DsTextBrush}" />
                                                    </Grid>
                                                    <Border Height="4" CornerRadius="2" Background="{DynamicResource DsBgBrush}">
                                                        <ProgressBar Value="{Binding MemoryUsagePercent}" Minimum="0" Maximum="100"
                                                                     Height="4" Foreground="{DynamicResource DsPrimaryBrush}" Background="Transparent" BorderThickness="0" CornerRadius="2" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- Storage Meter -->
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="Library Storage" FontSize="10.5" Foreground="{DynamicResource DsMutedBrush}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding StorageUsageText}" FontSize="10.5" FontFamily="JetBrains Mono,Consolas" Foreground="{DynamicResource DsTextBrush}" />
                                                    </Grid>
                                                    <Border Height="4" CornerRadius="2" Background="{DynamicResource DsBgBrush}">
                                                        <ProgressBar Value="{Binding StorageUsagePercent}" Minimum="0" Maximum="100"
                                                                     Height="4" Foreground="{DynamicResource DsJupyterBrush}" Background="Transparent" BorderThickness="0" CornerRadius="2" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 2: Quick Keyboard Shortcuts -->
                                    <Border Classes="nexus-glass-card" Padding="16">
                                        <StackPanel Spacing="12">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <materialIcons:MaterialIcon Kind="KeyboardOutline" Width="16" Height="16" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="KEYBOARD SHORTCUTS" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <StackPanel Spacing="8">
                                                <!-- Shortcut 1: New Notebook -->
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="New Notebook" FontSize="11.5" Foreground="{DynamicResource DsTextBrush}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Background="#21262D" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="Ctrl+N" FontSize="10" FontFamily="JetBrains Mono,Consolas" Foreground="{DynamicResource DsMutedBrush}" />
                                                    </Border>
                                                </Grid>

                                                <!-- Shortcut 2: Open Project -->
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="Open Project / File" FontSize="11.5" Foreground="{DynamicResource DsTextBrush}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Background="#21262D" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="Ctrl+O" FontSize="10" FontFamily="JetBrains Mono,Consolas" Foreground="{DynamicResource DsMutedBrush}" />
                                                    </Border>
                                                </Grid>

                                                <!-- Shortcut 3: Run / Execute -->
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="Execute / Run Cell" FontSize="11.5" Foreground="{DynamicResource DsTextBrush}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Background="#21262D" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="Shift+Enter" FontSize="10" FontFamily="JetBrains Mono,Consolas" Foreground="{DynamicResource DsMutedBrush}" />
                                                    </Border>
                                                </Grid>

                                                <!-- Shortcut 4: Toggle Side Bar -->
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="Toggle Side Bar" FontSize="11.5" Foreground="{DynamicResource DsTextBrush}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Background="#21262D" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="Ctrl+B" FontSize="10" FontFamily="JetBrains Mono,Consolas" Foreground="{DynamicResource DsMutedBrush}" />
                                                    </Border>
                                                </Grid>

                                                <!-- Shortcut 5: Toggle Bottom Deck -->
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="Toggle Terminal / Deck" FontSize="11.5" Foreground="{DynamicResource DsTextBrush}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Background="#21262D" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="Ctrl+J" FontSize="10" FontFamily="JetBrains Mono,Consolas" Foreground="{DynamicResource DsMutedBrush}" />
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 3: Quick Template Launch (when a template is selected) -->
                                    <Border Classes="nexus-glass-card" Padding="16" IsVisible="{Binding IsShowingTemplate}">
                                        <StackPanel Spacing="10">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <materialIcons:MaterialIcon Kind="LightningBoltOutline" Width="16" Height="16" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="SELECTED TEMPLATE" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <TextBlock Text="{Binding SelectedTemplate.Title}" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SelectedTemplate.Description}" FontSize="11.5" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" MaxLines="3" />

                                            <Button Command="{Binding LaunchTemplateCommand}"
                                                    CommandParameter="{Binding SelectedTemplate}"
                                                    Classes="nexus-btn-primary"
                                                    HorizontalAlignment="Stretch"
                                                    Margin="0,4,0,0">
                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                    <TextBlock Text="Launch Template" />
                                                    <materialIcons:MaterialIcon Kind="ArrowRight" Width="15" Height="15" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>

                            </Grid>

                        </StackPanel>
                    </Panel>
                </ScrollViewer>

            </Grid>

        </Grid>

        <!-- ================================================================ -->
        <!-- "New Script" / "New Notebook" location dialog                    -->
        <!-- ================================================================ -->
        <!-- ================================================================ -->
        <!-- "New Script" / "New Notebook" location dialog                    -->
        <!-- ================================================================ -->
        <Border IsVisible="{Binding IsCreatePromptOpen}"
                Background="#B3000000"
                ZIndex="100">
            <Border Width="460"
                    Background="{DynamicResource DsSurfaceBrush}"
                    BorderBrush="{DynamicResource DsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    BoxShadow="0 24 64 #90000000"
                    Padding="24,22"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="18">

                    <!-- Modal Header -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Type Icon Badge -->
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Panel>
                                <!-- Notebook Badge -->
                                <Border Background="{DynamicResource DsJupyterSubtleBrush}" CornerRadius="8"
                                        IsVisible="{Binding IsCreatingNotebook}">
                                    <materialIcons:MaterialIcon Kind="NotebookOutline" Width="19" Height="19"
                                                                Foreground="{DynamicResource DsJupyterBrush}"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <!-- Script Badge -->
                                <Border Background="{DynamicResource DsLinqSubtleBrush}" CornerRadius="8"
                                        IsVisible="{Binding IsCreatingScript}">
                                    <TextBlock Text="C#" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DsGreenBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Panel>
                        </Border>

                        <!-- Title & Subtitle -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding CreatePromptTitle}" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            <TextBlock Text="Set a document title and select workspace folder." FontSize="11" Foreground="{DynamicResource DsMutedBrush}" />
                        </StackPanel>

                        <!-- Close (X) Button -->
                        <Button Grid.Column="2" Command="{Binding CancelCreatePromptCommand}"
                                Classes="nexus-btn-ghost" Width="30" Height="30" Padding="0"
                                VerticalAlignment="Center" ToolTip.Tip="Cancel and close">
                            <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource DsMutedBrush}" />
                        </Button>
                    </Grid>

                    <!-- Subtle Header Divider -->
                    <Border Height="1" Background="{DynamicResource DsBorderBrush}" Margin="0,2,0,2" />

                    <!-- Field 1: Document Name -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="DOCUMENT NAME" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DsMutedBrush}" />
                        <TextBox Text="{Binding NewItemName, Mode=TwoWay}"
                                 Classes="nexus-input">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding ConfirmCreateCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                    </StackPanel>

                    <!-- Field 2: Workspace Location -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="WORKSPACE LOCATION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DsMutedBrush}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <!-- Location Path Display -->
                            <Border Grid.Column="0"
                                    Background="#0D1117"
                                    BorderBrush="{DynamicResource DsBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Height="38" Padding="12,0" Margin="0,0,8,0">
                                <Grid ColumnDefinitions="Auto,*">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="FolderOutline" Width="16" Height="16"
                                                                Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedFolderDisplay}"
                                               FontSize="12.5" Foreground="#FFFFFF" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding SelectedFolderDisplay}" />
                                </Grid>
                            </Border>

                            <!-- Browse Button -->
                            <Button Grid.Column="1" Name="BrowseFolderButton" Click="OnBrowseFolderClick"
                                    Classes="nexus-btn-surface" Height="38" Padding="14,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Browse..." VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Location Warning Callout (if picked outside library root) -->
                        <Border Background="#1C1811" BorderBrush="#D29922" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,4,0,0"
                                IsVisible="{Binding LocationWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Grid ColumnDefinitions="Auto,*">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline" Width="16" Height="16" Foreground="#D29922" VerticalAlignment="Top" Margin="0,1,8,0" />
                                <TextBlock Grid.Column="1" Text="{Binding LocationWarning}" FontSize="11" Foreground="#E3B341" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Actions Footer -->
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,6,0,0">
                        <Button Grid.Column="1" Command="{Binding CancelCreatePromptCommand}"
                                Classes="nexus-btn-surface" Height="38" Padding="18,0" Margin="0,0,10,0">
                            <TextBlock Text="Cancel" VerticalAlignment="Center" />
                        </Button>
                        <Button Grid.Column="2" Command="{Binding ConfirmCreateCommand}"
                                Classes="nexus-btn-primary" Height="38" Padding="20,0">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Plus" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="Create" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

    </Panel>
</UserControl>
