<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             mc:Ignorable="d" d:DesignWidth="1380" d:DesignHeight="880"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Views.CSharpManagerView"
             x:DataType="vm:CSharpManagerViewModel"
             Background="{DynamicResource DsBgBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CSharpEditorPlugin/Views/CSharpManagerPaletteTokens.axaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://CSharpEditorPlugin/Views/CSharpManagerStyles.axaml" />
    </UserControl.Styles>

    <Panel>
        <!-- ============================================================ -->
        <!-- ROOT 2-COLUMN LAYOUT: SIDEBAR + MAIN CONTENT                -->
        <!-- ============================================================ -->
        <!-- ============================================================ -->
        <!-- ROOT 3-COLUMN LAYOUT: SIDEBAR + MAIN CANVAS + STICKY RIGHT RAIL -->
        <!-- ============================================================ -->
        <Grid ColumnDefinitions="256,*,Auto">

            <!-- ============================================================ -->
            <!-- 1. LEFT SIDEBAR (w-64 bg-ds-surface border-r border-ds-border) -->
            <!-- ============================================================ -->
            <controls:HubSidebarControl Grid.Column="0" />

            <!-- ============================================================ -->
            <!-- 2. MAIN CONTENT (Center canvas, dynamic width)               -->
            <!-- ============================================================ -->
            <Grid Grid.Column="1" RowDefinitions="64,*">

                <!-- Top Header: Search & Sync Bar -->
                <controls:HubTopHeaderControl Grid.Row="0" />

                <!-- Dashboard Content Area (ScrollViewer + Floating Overlay) -->
                <Panel Grid.Row="1">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <Panel>
                            <!-- Top-Right Ambient Glow Effect -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Width="500" Height="380"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <RadialGradientBrush Center="100%,0%" GradientOrigin="100%,0%" RadiusX="100%" RadiusY="100%">
                                        <GradientStop Offset="0" Color="#1A2F81F7" />
                                        <GradientStop Offset="1" Color="#000D1117" />
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Dashboard Content (Fills 100% of available canvas across all displays) -->
                            <StackPanel Margin="32,28,32,48" Spacing="28" HorizontalAlignment="Stretch">

                                <!-- Status Notification Toast Banner -->
                                <Border CornerRadius="8" BorderThickness="1" Padding="14,10" Margin="0,0,0,4"
                                        Background="{DynamicResource DsSurfaceBrush}"
                                        BorderBrush="{DynamicResource DsBorderBrush}"
                                        IsVisible="{Binding HasStatusBannerMessage}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <materialIcons:MaterialIcon Grid.Column="0" Kind="CheckCircleOutline" Width="18" Height="18"
                                                                    Foreground="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                                    IsVisible="{Binding !IsStatusBannerError}" />
                                        <materialIcons:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline" Width="18" Height="18"
                                                                    Foreground="#F85149" VerticalAlignment="Center" Margin="0,0,10,0"
                                                                    IsVisible="{Binding IsStatusBannerError}" />
                                        <TextBlock Grid.Column="1" Text="{Binding StatusBannerMessage}" FontSize="12.5" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Command="{Binding DismissStatusBannerCommand}" Classes="nexus-btn-ghost" Width="26" Height="26" Padding="0" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- SECTION 1: WELCOME & HERO BANNER -->
                                <controls:HubWelcomeSectionControl />

                                <!-- SECTION 2: PINNED WORKSPACES -->
                                <controls:HubPinnedWorkspacesControl IsVisible="{Binding IsWorkspacesTabActive}" />

                                <!-- SECTION 3: RECENT WORKSPACES / STARTER TEMPLATES GALLERY -->
                                <controls:HubWorkspacesPanelControl />

                            </StackPanel>
                        </Panel>
                    </ScrollViewer>

                    <!-- Sticky Floating Template Action Deck -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,24"
                            IsVisible="{Binding IsShowingTemplate}"
                            Background="{DynamicResource DsSurfaceBrush}"
                            BorderBrush="{DynamicResource DsPrimaryBrush}"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Padding="16,10"
                            BoxShadow="0 10 32 0 #77000000">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                            </Transitions>
                        </Border.Transitions>
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" VerticalAlignment="Center">
                            <!-- Template Icon Badge -->
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                    Background="{Binding SelectedTemplate.AccentBackground}"
                                    BorderBrush="{Binding SelectedTemplate.AccentBorder}"
                                    BorderThickness="1"
                                    Margin="0,0,12,0" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="{Binding SelectedTemplate.IconKind}"
                                                            Width="18" Height="18"
                                                            Foreground="{Binding SelectedTemplate.AccentColor}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Template Title & Details -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,32,0" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding SelectedTemplate.Title}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource DsBgBrush}" BorderBrush="{DynamicResource DsBorderBrush}" BorderThickness="1"
                                            Height="18" MinHeight="18" CornerRadius="4" Padding="6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedTemplate.KindBadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DsMutedBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0,1,0,0" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedTemplate.Description}" FontSize="11.5" Foreground="{DynamicResource DsMutedBrush}" MaxWidth="480" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Panel Grid.Column="2" MinWidth="16" />

                            <!-- Dismiss Selection Button -->
                            <Button Grid.Column="3" Command="{Binding ClearSelectedTemplateCommand}"
                                    Classes="nexus-btn-ghost"
                                    Margin="0,0,10,0"
                                    Padding="12,8"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Dismiss" FontSize="12.5" Foreground="{DynamicResource DsMutedBrush}" />
                            </Button>

                            <!-- Launch Template Primary Button -->
                            <Button Grid.Column="4" Command="{Binding LaunchTemplateCommand}"
                                    CommandParameter="{Binding SelectedTemplate}"
                                    Classes="nexus-btn-primary"
                                    Padding="18,9"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="RocketLaunchOutline" Width="16" Height="16" />
                                    <TextBlock Text="Launch Template" FontWeight="SemiBold" FontSize="13" />
                                    <materialIcons:MaterialIcon Kind="ArrowRight" Width="14" Height="14" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Panel>

            </Grid>

            <!-- ============================================================ -->
            <!-- 3. STICKY RIGHT RAIL: SYSTEM STATUS & ENVIRONMENT (340px)    -->
            <!-- ============================================================ -->
            <Border Grid.Column="2"
                    Width="340"
                    Background="{DynamicResource DsSurfaceBrush}"
                    BorderBrush="{DynamicResource DsBorderBrush}"
                    BorderThickness="1,0,0,0"
                    IsVisible="{Binding IsSystemStatusRailVisible}">
                <Grid RowDefinitions="64,*">
                    <!-- Sticky Rail Header matching Top Header height (64px) -->
                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource DsBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="20,0">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="TuneVertical" Width="16" Height="16" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="SYSTEM &amp; RUNTIME" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Command="{Binding ToggleSystemStatusRailCommand}"
                                    Classes="nexus-btn-ghost"
                                    Width="26" Height="26" Padding="0"
                                    ToolTip.Tip="Collapse System Rail">
                                <materialIcons:MaterialIcon Kind="ChevronRight" Width="16" Height="16" Foreground="{DynamicResource DsMutedBrush}" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Sticky Rail Body (Independent Scroll) -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="20,20,20,32">
                        <controls:HubSystemStatusPanelControl />
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>

        <!-- ================================================================ -->
        <!-- "New Script" / "New Notebook" location dialog                    -->
        <!-- ================================================================ -->
        <controls:HubCreateItemDialogControl />

        <!-- ================================================================ -->
        <!-- STUDIO LOADING OVERLAY POPUP                                     -->
        <!-- ================================================================ -->
        <controls:StudioLoadingOverlayControl IsLoading="{Binding IsLoading}"
                                              LoadingTitle="{Binding LoadingTitle}"
                                              LoadingSubtitle="{Binding LoadingSubtitle}"
                                              ZIndex="1000"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />

    </Panel>
</UserControl>
