<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1300" d:DesignHeight="850"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Views.CSharpManagerView"
             x:DataType="vm:CSharpManagerViewModel">

    <UserControl.Resources>
        <!-- Shared card for both Script and Notebook template groups (see nav rail / center content) -->
        <DataTemplate x:Key="TemplateCardTemplate" x:DataType="models:CodeTemplate">
            <Button Command="{Binding $parent[UserControl].((vm:CSharpManagerViewModel)DataContext).SelectTemplateCommand}"
                    CommandParameter="{Binding}"
                    Classes="studio-card-btn"
                    Margin="0,0,14,14">
                <Border Width="228" Height="136" Classes="studio-template-card">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <!-- Header: Icon only — Kind is taught by section grouping, CategoryBadge lives in the inspector now -->
                        <Border Grid.Row="0" Width="34" Height="34" HorizontalAlignment="Left"
                                CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                Background="{Binding AccentBackground}"
                                BorderBrush="{Binding AccentBorder}"
                                BorderThickness="1">
                            <materialIcons:MaterialIcon Kind="{Binding IconKind}"
                                                        Width="17" Height="17"
                                                        Foreground="{Binding AccentColor}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Body: Title & Description -->
                        <StackPanel Grid.Row="1" Spacing="4" Margin="0,10,0,0">
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource M3OnSurfaceBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Title}" />
                            <TextBlock Text="{Binding Description}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                       TextWrapping="Wrap"
                                       MaxLines="2" />
                        </StackPanel>

                        <!-- Footer: capped tags only — no Launch cue here anymore, selecting a card opens
                             its full detail (including the complete tag list) in the inspector panel instead -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="0,8,0,0" ClipToBounds="True">
                            <ItemsControl ItemsSource="{Binding VisibleTags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="studio-tag-pill">
                                            <TextBlock Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Classes="studio-tag-pill overflow" IsVisible="{Binding HasOverflowTags}">
                                <TextBlock Text="{Binding OverflowTagLabel}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Card Button Reset -->
        <Style Selector="Button.studio-card-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Stretch" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.studio-card-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Starter Template Card (elevates + lifts slightly on hover — "pick me", a launcher tile) -->
        <Style Selector="Border.studio-template-card">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerLarge}" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.studio-card-btn:pointerover Border.studio-template-card">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}" />
            <Setter Property="RenderTransform" Value="translateY(-2px)" />
            <Setter Property="BoxShadow" Value="{StaticResource M3ElevationLevel2}" />
        </Style>

        <!-- Workspace Item Row — a divided table row, not a card: flat background, single bottom
             rule, square corners. Reads as one continuous list rather than a stack of separate tiles. -->
        <Style Selector="Border.studio-item-card">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerNone}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.studio-card-btn:pointerover Border.studio-item-card">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        </Style>

        <!-- Tag Pill (capped on cards; the full list is shown in the inspector) -->
        <Style Selector="Border.studio-tag-pill">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighestBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerSmall}" />
            <Setter Property="Padding" Value="5,2" />
        </Style>
        <Style Selector="Border.studio-tag-pill TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
        </Style>
        <Style Selector="Border.studio-tag-pill.overflow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Nav Rail Entries -->
        <Style Selector="Button.studio-nav-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerMedium}" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.studio-nav-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        </Style>
        <Style Selector="Button.studio-nav-item.active">
            <Setter Property="Background" Value="{DynamicResource M3PrimaryContainerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3PrimaryBrush}" />
        </Style>
        <Style Selector="Border.studio-nav-count">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighestBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerFull}" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.studio-nav-count TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Filter Tab Buttons (kept for compatibility with any other reuse; no longer used directly
             on this page now that type-filtering lives in the nav rail, but left intact/unused-here
             rather than removed, since removing a style block is not part of this pass's scope) -->
        <Style Selector="Button.studio-filter-tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerFull}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.studio-filter-tab:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        </Style>
        <Style Selector="Button.studio-filter-tab.active">
            <Setter Property="Background" Value="{DynamicResource M3PrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnPrimaryBrush}" />
        </Style>

        <!-- Delete Button Hover -->
        <Style Selector="Button.studio-delete-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerFull}" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.studio-delete-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3ErrorContainerBrush}" />
        </Style>
        <Style Selector="Button.studio-delete-btn:pointerover materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource M3OnErrorContainerBrush}" />
        </Style>

        <!-- Search Input -->
        <Style Selector="TextBox.studio-search-box">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowestBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerFull}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        </Style>
        <Style Selector="TextBox.studio-search-box:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}" />
        </Style>

        <!-- ComboBox Popup & Item Styling -->
        <Style Selector="ComboBox /template/ Border#PopupBorder">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighestBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerMedium}" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerSmall}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        </Style>
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource M3PrimaryContainerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3PrimaryBrush}" />
        </Style>
        <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource M3SecondaryContainerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3PrimaryBrush}" />
        </Style>

        <!-- Engine status "live" dot — gentle breathing pulse, purely decorative -->
        <Style Selector="Border.status-pulse-dot">
            <Style.Animations>
                <Animation Duration="0:0:1.6" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1.0" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1.0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="32,28,32,28">

        <!-- ============================================================ -->
        <!-- 1. HERO HEADER: Studio Branding, Compiler Status & Actions   -->
        <!-- ============================================================ -->
        <Border Grid.Row="0"
                BorderThickness="1"
                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                CornerRadius="{StaticResource M3ShapeCornerLarge}"
                Background="{DynamicResource M3SurfaceContainerLowBrush}"
                Padding="26,22">

            <Grid ColumnDefinitions="*,Auto">
                <!-- Left: Studio Branding & Status Pill -->
                <StackPanel Grid.Column="0" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <!-- Clean Studio Logo Badge -->
                        <Border Width="48" Height="48"
                                CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                BorderThickness="1">
                            <materialIcons:MaterialIcon Kind="CodeBraces" Width="24" Height="24"
                                                        Foreground="{DynamicResource M3PrimaryBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="C# Code Studio &amp; Notebooks Hub"
                                           FontSize="21" FontWeight="Bold"
                                           Foreground="{DynamicResource M3OnSurfaceBrush}"
                                           VerticalAlignment="Center" />
                                <Border Background="{DynamicResource M3SurfaceContainerHighBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource M3ShapeCornerFull}"
                                        Height="24"
                                        Padding="8,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text=".NET 10 • C# 13" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Interactive C# scripts, LeetCode algorithm workspaces, and multi-cell notebooks with live Roslyn runtime"
                                       FontSize="12.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Subtle Engine Status Pill -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="62,0,0,0" VerticalAlignment="Center">
                        <Border Background="{DynamicResource M3SurfaceContainerHighBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                Height="28"
                                Padding="12,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource M3SuccessBrush}" VerticalAlignment="Center" Classes="status-pulse-dot" />
                                <TextBlock Text="Roslyn .NET 10 Engine Active" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Quick Stats & Creation CTAs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- Scripts Count Capsule (click jumps straight to that filter in the workspace) -->
                    <Button Command="{Binding SetSelectedTypeFilterCommand}" CommandParameter="Scripts"
                            Classes="m3-tonal-btn"
                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                            Height="36" MinHeight="0" Padding="14,0"
                            VerticalAlignment="Center" VerticalContentAlignment="Center"
                            Cursor="Hand"
                            ToolTip.Tip="View all Scripts">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="FileCodeOutline" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TotalScripts, StringFormat='{}{0} Scripts'}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Notebooks Count Capsule -->
                    <Button Command="{Binding SetSelectedTypeFilterCommand}" CommandParameter="Notebooks"
                            Classes="m3-tonal-btn"
                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                            Height="36" MinHeight="0" Padding="14,0"
                            VerticalAlignment="Center" VerticalContentAlignment="Center"
                            Cursor="Hand"
                            ToolTip.Tip="View all Notebooks">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="NotebookOutline" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TotalNotebooks, StringFormat='{}{0} Notebooks'}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="22" Background="{DynamicResource M3OutlineVariantBrush}" Margin="2,0" />

                    <!-- Return to FryPDF Home Action Button -->
                    <Button Command="{Binding NavigateToHomeCommand}"
                            Classes="m3-tonal-btn"
                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                            Height="36"
                            MinHeight="0"
                            Padding="14,0"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            Cursor="Hand"
                            ToolTip.Tip="Return to FryPDF Home Dashboard (Esc / ⌘W)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="HomeOutline" Width="16" Height="16" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="FryPDF Home" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Unified + New Script Primary Button -->
                    <Button Command="{Binding CreateNewScriptCommand}"
                            Classes="m3-filled-btn"
                            Background="{DynamicResource M3PrimaryBrush}"
                            Foreground="{DynamicResource M3OnPrimaryBrush}"
                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                            Height="36"
                            MinHeight="0"
                            Padding="16,0"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            Cursor="Hand"
                            ToolTip.Tip="Create an empty C# automation script">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="New Script" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Unified + New Notebook Tonal Button -->
                    <Button Command="{Binding CreateNewNotebookCommand}"
                            Classes="m3-tonal-btn"
                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                            Height="36"
                            MinHeight="0"
                            Padding="16,0"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            Cursor="Hand"
                            ToolTip.Tip="Create an interactive cell notebook">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="NotebookOutline" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="New Notebook" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- 2. BODY: Nav Rail | Center Content | Inspector               -->
        <!-- ============================================================ -->
        <Grid Grid.Row="1" ColumnDefinitions="216,*,300" Margin="0,20,0,0">

            <!-- ──────────────────────── NAV RAIL ──────────────────────── -->
            <Border Grid.Column="0"
                    Background="{DynamicResource M3SurfaceContainerLowBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource M3ShapeCornerLarge}"
                    Padding="10"
                    Margin="0,0,16,0">
                <ScrollViewer>
                    <StackPanel Spacing="2">
                        <Button Command="{Binding SetSelectedTypeFilterCommand}" CommandParameter="All"
                                Classes="studio-nav-item" Classes.active="{Binding IsWorkspaceAllNavActive}">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="ViewList" Width="16" Height="16" />
                                <TextBlock Text="Your Workspace" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SetSelectedTypeFilterCommand}" CommandParameter="Scripts"
                                Classes="studio-nav-item" Classes.active="{Binding IsScriptsNavActive}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="FileCodeOutline" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Scripts" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Classes="studio-nav-count">
                                    <TextBlock Text="{Binding TotalScripts}" />
                                </Border>
                            </Grid>
                        </Button>
                        <Button Command="{Binding SetSelectedTypeFilterCommand}" CommandParameter="Notebooks"
                                Classes="studio-nav-item" Classes.active="{Binding IsNotebooksNavActive}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="NotebookOutline" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Notebooks" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Classes="studio-nav-count">
                                    <TextBlock Text="{Binding TotalNotebooks}" />
                                </Border>
                            </Grid>
                        </Button>

                        <Border Height="1" Background="{DynamicResource M3OutlineVariantBrush}" Margin="8,10" />

                        <Button Command="{Binding SetSelectedNavSectionCommand}" CommandParameter="Templates"
                                Classes="studio-nav-item" Classes.active="{Binding IsTemplatesSectionActive}">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="LightningBoltOutline" Width="16" Height="16" />
                                <TextBlock Text="Templates" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ──────────────────────── CENTER CONTENT ──────────────────────── -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="0,0,16,0">

                <!-- Workspace toolbar: section title/count + sort + search (no type filter here anymore — that's the nav rail's job) -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16" IsVisible="{Binding IsWorkspaceSectionActive}">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="FolderMultipleOutline" Width="20" Height="20" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Your Workspace" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                Height="22" Padding="8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FilteredItemCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <!-- Search Box with Clear Button -->
                        <Border Width="280" Background="{DynamicResource M3SurfaceContainerLowestBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                Height="36" Padding="10,0" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="Magnify" Width="16" Height="16"
                                                            Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" Margin="2,0,6,0" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding SearchQuery, Mode=TwoWay}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         MinHeight="0" Height="28" Padding="0"
                                         FontSize="12"
                                         Foreground="{DynamicResource M3OnSurfaceBrush}"
                                         VerticalAlignment="Center" VerticalContentAlignment="Center"
                                         PlaceholderText="Search items or category..." />
                                <Button Grid.Column="2"
                                        Command="{Binding ClearSearchCommand}"
                                        IsVisible="{Binding HasSearchQuery}"
                                        Classes="studio-delete-btn"
                                        Width="24" Height="24" Padding="0"
                                        VerticalAlignment="Center" VerticalContentAlignment="Center"
                                        Cursor="Hand"
                                        ToolTip.Tip="Clear search">
                                    <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="15" Height="15" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Sort ComboBox -->
                        <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                Height="36" Padding="8,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="SortVariant" Width="15" Height="15" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="4,0,2,0" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding SortOptions}"
                                          SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Height="28" MinHeight="0" Padding="4,0"
                                          FontSize="11.5"
                                          Foreground="{DynamicResource M3OnSurfaceBrush}"
                                          VerticalAlignment="Center" VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Templates header -->
                <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16" IsVisible="{Binding IsTemplatesSectionActive}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="LightningBolt" Width="18" Height="18" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Starter Templates" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Pick a starting point — select a card to preview it, then Launch from the panel on the right. Nothing is created until you do."
                               FontSize="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- Workspace content -->
                        <StackPanel Spacing="16" IsVisible="{Binding IsWorkspaceSectionActive}">
                            <!-- Empty State (When Filter/Search produces 0 items) -->
                            <Border IsVisible="{Binding !HasFilteredItems}"
                                    Background="{DynamicResource M3SurfaceContainerLowBrush}"
                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource M3ShapeCornerLarge}"
                                    Padding="32,48"
                                    HorizontalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                    <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource M3SurfaceContainerHighBrush}" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="FolderSearchOutline" Width="28" Height="28" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="No workspace items found" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="No scripts or notebooks match your current query or category filter."
                                               FontSize="12.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" HorizontalAlignment="Center" />
                                    <Button Command="{Binding ResetFiltersCommand}"
                                            Classes="m3-tonal-btn"
                                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                                            Padding="16,7"
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Center"
                                            Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <materialIcons:MaterialIcon Kind="Refresh" Width="15" Height="15" />
                                            <TextBlock Text="Reset Filters &amp; Search" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Items Table (When Items Exist) -->
                            <Border IsVisible="{Binding HasFilteredItems}"
                                    Background="{DynamicResource M3SurfaceContainerLowBrush}"
                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource M3ShapeCornerLarge}"
                                    ClipToBounds="True">
                            <StackPanel>
                            <Grid ColumnDefinitions="Auto,*,Auto,44" Margin="12,8">
                                <TextBlock Grid.Column="1" Text="NAME" FontSize="9.5" FontWeight="Bold" Opacity="0.7"
                                           Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="52,0,0,0" />
                                <TextBlock Grid.Column="2" Text="TYPE · MODIFIED" FontSize="9.5" FontWeight="Bold" Opacity="0.7"
                                           Foreground="{DynamicResource M3OnSurfaceVariantBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource M3OutlineVariantBrush}" />
                            <ItemsControl ItemsSource="{Binding FilteredItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="0" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:WorkspaceItemSummary">
                                        <Button Command="{Binding $parent[UserControl].((vm:CSharpManagerViewModel)DataContext).SelectWorkspaceItemCommand}"
                                                CommandParameter="{Binding}"
                                                Classes="studio-card-btn">
                                            <Border Classes="studio-item-card">
                                                <Grid ColumnDefinitions="Auto,*,Auto,44">
                                                    <!-- Leading Icon -->
                                                    <Border Grid.Column="0" Width="38" Height="38"
                                                            CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                            Background="{Binding IconBackground}"
                                                            BorderBrush="{Binding IconBorder}"
                                                            BorderThickness="1.5"
                                                            Margin="0,0,14,0"
                                                            VerticalAlignment="Center">
                                                        <materialIcons:MaterialIcon Kind="{Binding IconKind}"
                                                                                    Width="19" Height="19"
                                                                                    Foreground="{Binding IconForeground}"
                                                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Title / Description (ellipsized, wrap-safe) -->
                                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource M3OnSurfaceBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="{Binding Title}" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <!-- Kind Badge + Timestamp — own column, so it lines up directly under
                                                         the "TYPE · MODIFIED" header instead of hiding in a nested sub-column -->
                                                    <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Border Background="{Binding KindBadgeBackground}"
                                                                BorderBrush="{Binding KindBadgeBorder}"
                                                                BorderThickness="1"
                                                                CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                                                Padding="7,2"
                                                                HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding KindBadgeText}"
                                                                       FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{Binding KindBadgeForeground}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding FormattedLastModified}"
                                                                   FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                                   HorizontalAlignment="Right" />
                                                    </StackPanel>

                                                    <!-- Delete -->
                                                    <Button Grid.Column="3"
                                                            Command="{Binding $parent[UserControl].((vm:CSharpManagerViewModel)DataContext).DeleteItemCommand}"
                                                            CommandParameter="{Binding}"
                                                            Classes="studio-delete-btn"
                                                            Margin="10,0,0,0"
                                                            VerticalAlignment="Center"
                                                            ToolTip.Tip="Delete Item">
                                                        <materialIcons:MaterialIcon Kind="DeleteOutline" Width="17" Height="17"
                                                                                    Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Templates content, grouped by Kind -->
                        <StackPanel Spacing="20" IsVisible="{Binding IsTemplatesSectionActive}">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Script templates" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    <TextBlock Text="— runs once, top to bottom" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Opacity="0.75" VerticalAlignment="Center" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding ScriptTemplates}" ItemTemplate="{StaticResource TemplateCardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Notebook templates" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    <TextBlock Text="— multi-cell, stateful across cells" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Opacity="0.75" VerticalAlignment="Center" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding NotebookTemplates}" ItemTemplate="{StaticResource TemplateCardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ──────────────────────── INSPECTOR ──────────────────────── -->
            <Border Grid.Column="2"
                    Background="{DynamicResource M3SurfaceContainerLowBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource M3ShapeCornerLarge}"
                    Padding="18">
                <Grid>
                    <!-- Empty state: also the one home for the Script-vs-Notebook primer, shown only
                         when there's nothing else on screen to look at. -->
                    <StackPanel IsVisible="{Binding !HasSelection}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="240">
                        <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource M3SurfaceContainerHighBrush}" HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="CursorDefaultClickOutline" Width="26" Height="26" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Nothing selected yet" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock Text="Select a template or a workspace item to see its details here."
                                   FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        <Border Background="{DynamicResource M3SurfaceContainerHighBrush}" CornerRadius="{StaticResource M3ShapeCornerMedium}" Padding="12,10" Margin="0,10,0,0">
                            <TextBlock Text="Scripts run once, top to bottom, like a console app. Notebooks are multi-cell — each cell keeps its own output and shares state with the others."
                                       FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" TextAlignment="Left" />
                        </Border>
                    </StackPanel>

                    <!-- Template detail. Split across three elements deliberately: IsVisible must stay
                         on an element whose DataContext is still the ViewModel (not re-scoped), and
                         x:DataType must stay on an element that isn't ALSO the one setting DataContext
                         — combining any of these two concerns on the same element makes the compiler
                         resolve that element's OWN bindings against the wrong type. -->
                    <Border IsVisible="{Binding IsShowingTemplate}">
                        <ScrollViewer DataContext="{Binding SelectedTemplate}">
                        <StackPanel Spacing="12" x:DataType="models:CodeTemplate">
                            <Border Width="44" Height="44"
                                    CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                    Background="{Binding AccentBackground}"
                                    BorderBrush="{Binding AccentBorder}"
                                    BorderThickness="1">
                                <materialIcons:MaterialIcon Kind="{Binding IconKind}" Width="22" Height="22" Foreground="{Binding AccentColor}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" TextWrapping="Wrap" />
                            <Border Background="{Binding AccentBackground}" BorderBrush="{Binding AccentBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource M3ShapeCornerSmall}" Padding="8,3" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding CategoryBadge}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding AccentColor}" />
                            </Border>
                            <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />

                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="studio-tag-pill" Margin="0,0,4,4">
                                            <TextBlock Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Command="{Binding $parent[UserControl].((vm:CSharpManagerViewModel)DataContext).LaunchTemplateCommand}"
                                    CommandParameter="{Binding}"
                                    Classes="m3-filled-btn"
                                    Background="{DynamicResource M3PrimaryBrush}"
                                    Foreground="{DynamicResource M3OnPrimaryBrush}"
                                    CornerRadius="{StaticResource M3ShapeCornerFull}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Height="40" Padding="16,0" Margin="0,4,0,0"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="Launch" FontSize="13" FontWeight="SemiBold" />
                                    <materialIcons:MaterialIcon Kind="ArrowRight" Width="15" Height="15" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Workspace item detail (same three-element split, see comment above) -->
                    <Border IsVisible="{Binding IsShowingItem}">
                        <ScrollViewer DataContext="{Binding SelectedWorkspaceItem}">
                        <StackPanel Spacing="12" x:DataType="models:WorkspaceItemSummary">
                            <Border Width="44" Height="44"
                                    CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                    Background="{Binding IconBackground}"
                                    BorderBrush="{Binding IconBorder}"
                                    BorderThickness="1.5">
                                <materialIcons:MaterialIcon Kind="{Binding IconKind}" Width="22" Height="22" Foreground="{Binding IconForeground}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Background="{Binding KindBadgeBackground}" BorderBrush="{Binding KindBadgeBorder}" BorderThickness="1"
                                        CornerRadius="{StaticResource M3ShapeCornerSmall}" Padding="7,2">
                                    <TextBlock Text="{Binding KindBadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding KindBadgeForeground}" />
                                </Border>
                                <Border Background="{Binding CategoryBackground}" BorderBrush="{Binding CategoryBorder}" BorderThickness="1"
                                        CornerRadius="{StaticResource M3ShapeCornerSmall}" Padding="7,2">
                                    <TextBlock Text="{Binding Category}" FontSize="10.5" FontWeight="Medium" Foreground="{Binding CategoryForeground}" />
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />

                            <StackPanel Spacing="6" Margin="0,4,0,0">
                                <TextBlock Text="{Binding DetailsSnippet}" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <materialIcons:MaterialIcon Kind="ClockOutline" Width="12" Height="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    <TextBlock Text="{Binding FormattedLastModified}" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding FolderPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <materialIcons:MaterialIcon Kind="FolderOutline" Width="12" Height="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    <TextBlock Text="{Binding FolderPath}" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <Button Command="{Binding $parent[UserControl].((vm:CSharpManagerViewModel)DataContext).OpenItemCommand}"
                                    CommandParameter="{Binding}"
                                    Classes="m3-filled-btn"
                                    Background="{DynamicResource M3PrimaryBrush}"
                                    Foreground="{DynamicResource M3OnPrimaryBrush}"
                                    CornerRadius="{StaticResource M3ShapeCornerFull}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Height="40" Padding="16,0" Margin="0,4,0,0"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="Open" FontSize="13" FontWeight="SemiBold" />
                                    <materialIcons:MaterialIcon Kind="ArrowRight" Width="15" Height="15" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
