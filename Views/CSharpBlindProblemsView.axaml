<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             xmlns:blindProblems="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.BlindProblems"
             xmlns:blindProblems1="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.BlindProblems"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="880"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Views.CSharpBlindProblemsView"
             x:DataType="blindProblems:CSharpBlindProblemsViewModel"
             Background="{DynamicResource DsBgBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CSharpEditorPlugin/Styles/Tokens/StudioPaletteTokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>


    <Panel>
        <!-- Top-Right Ambient Glow Effect (Blind 75 Trophy Amber Tint) -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="500" Height="360"
                IsHitTestVisible="False"
                Background="{DynamicResource DsBlindAmbientGlowBrush}" />

        <Grid RowDefinitions="Auto,Auto,Auto,*">
            <!-- 1. Top Header Bar (Search, Difficulty, Shuffle) -->
            <blindProblems1:BlindProblemsTopBarControl Grid.Row="0" />

            <!-- 2. Category Filter Bar (Horizontal Pill Chips) -->
            <blindProblems1:BlindProblemsCategoryBarControl Grid.Row="1" />

            <!-- 3. Progress Statistics & Status Filter Bar -->
            <blindProblems1:BlindProblemsStatsControl Grid.Row="2" />

            <!-- 4. Problem Table & Detail Flyout -->
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                <!-- Problem Table -->
                <blindProblems1:BlindProblemsTableControl Grid.Column="0" />

                <!-- Problem Detail Drawer -->
                <blindProblems1:BlindProblemDetailFlyoutControl Grid.Column="1"
                                                          IsVisible="{Binding IsDetailFlyoutOpen}" />
            </Grid>
        </Grid>
    </Panel>
</UserControl>
