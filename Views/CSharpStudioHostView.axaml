<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             xmlns:common="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.Common"
             xmlns:common1="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Common"
             xmlns:studio="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Studio"
             xmlns:ai="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.AI"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Views.CSharpStudioHostView"
             x:DataType="common:CSharpStudioHostViewModel"
             Background="{DynamicResource M3SurfaceBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <CornerRadius x:Key="M3ShapeCornerFull">9999</CornerRadius>
            <CornerRadius x:Key="M3ShapeCornerMedium">12</CornerRadius>
            <CornerRadius x:Key="M3ShapeCornerSmall">8</CornerRadius>
        </ResourceDictionary>
    </UserControl.Resources>

    <Panel>
        <!-- Studio Host Active Page: each page's view is built once, on first visit (see the code-behind for which view
             shows which view model), then only shown or hidden. -->
        <common1:KeepAlivePageHost x:Name="PageHost" Page="{Binding CurrentPage}" />

        <!-- App-Wide Floating AI Agent & Composer Overlay (Available throughout all pages) -->
        <ai:StudioFloatingComposerControl DataContext="{Binding AiComposer}"
                                          ZIndex="998" />

        <!-- Top-level Studio Loading Overlay (page transitions, engine warmup, external projects) -->
        <studio:StudioLoadingOverlayControl IsLoading="{Binding IsLoading}"
                                              LoadingTitle="{Binding LoadingTitle}"
                                              LoadingSubtitle="{Binding LoadingSubtitle}"
                                              ZIndex="1000"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
    </Panel>
</UserControl>
