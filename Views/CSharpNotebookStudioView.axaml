<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             xmlns:views="using:PdfEditorApp.Plugins.CSharpEditor.Views"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="850"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Views.CSharpNotebookStudioView"
             x:DataType="vm:CSharpNotebookStudioViewModel">

    <UserControl.Resources>
        <ResourceDictionary>
            <CornerRadius x:Key="M3ShapeCornerFull">9999</CornerRadius>
            <CornerRadius x:Key="M3ShapeCornerMedium">12</CornerRadius>
            <CornerRadius x:Key="M3ShapeCornerSmall">8</CornerRadius>
            <CornerRadius x:Key="NotebookTabTopRadius">4,4,0,0</CornerRadius>
            <!-- Canonical Jupyter-style amber accent — the one hex used for every notebook-identity
                 accent (active tab, selected explorer row, breadcrumb folder), replacing four
                 slightly-different hardcoded ambers that had drifted apart over time. -->
            <SolidColorBrush x:Key="NotebookAmberBrush" Color="#D97706" />
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <StyleInclude Source="avares://CSharpEditorPlugin/Controls/SharedStudioStyles.axaml" />

        <!-- Explorer selection accent override for Notebook -->
        <Style Selector="Button.explorer-item-btn.selected">
            <Setter Property="BorderBrush" Value="{StaticResource NotebookAmberBrush}" />
        </Style>

        <!-- Document Studio Tab Item -->
        <Style Selector="Border.studio-tab-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="CornerRadius" Value="{StaticResource NotebookTabTopRadius}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.studio-tab-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        </Style>
        <Style Selector="Border.studio-tab-item.active">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
        </Style>
        <Style Selector="Border.studio-tab-item TextBlock.tab-title">
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Border.studio-tab-item.active TextBlock.tab-title">
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <!-- Notebook Toolbar Action Buttons -->
        <Style Selector="Button.nb-action-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerExtraSmall}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nb-action-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3PrimaryBrush}" />
        </Style>
        <Style Selector="Button.nb-action-btn:pointerover materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource M3PrimaryBrush}" />
        </Style>

        <!-- Cell Hover Action Icons -->
        <Style Selector="Button.cell-tool-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerExtraSmall}" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
        </Style>
        <Style Selector="Button.cell-tool-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        </Style>
        <Style Selector="Button.cell-tool-btn.delete-tool:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3ErrorContainerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3ErrorBrush}" />
        </Style>
        <Style Selector="Button.cell-tool-btn.delete-tool:pointerover materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource M3ErrorBrush}" />
        </Style>

        <!-- Gutter Run Play Button -->
        <Style Selector="Button.gutter-run-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerExtraSmall}" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Button.gutter-run-btn:pointerover">
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        </Style>

        <!-- Gutter Menu Button -->
        <Style Selector="Button.gutter-menu-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerExtraSmall}" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="18" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Button.gutter-menu-btn:pointerover">
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        </Style>

        <!-- Unified Notebook Cell Card (Sleek dark container, no harsh cyan outline) -->
        <Style Selector="Border.notebook-cell-card">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowestBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.notebook-cell-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineBrush}" />
        </Style>
        <Style Selector="Border.notebook-cell-card.active">
            <Setter Property="BorderBrush" Value="{DynamicResource M3SurfaceContainerHighestBrush}" />
        </Style>

        <!-- Between-Cell Interactive Insertion Divider -->
        <Style Selector="Border.cell-insert-divider">
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="56,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.cell-insert-divider StackPanel.insert-pill-group">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.cell-insert-divider:pointerover StackPanel.insert-pill-group">
            <Setter Property="Opacity" Value="1.0" />
        </Style>
        <Style Selector="Border.cell-insert-divider Rectangle.divider-line">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.cell-insert-divider:pointerover Rectangle.divider-line">
            <Setter Property="Opacity" Value="1.0" />
        </Style>

        <Style Selector="Button.insert-cell-pill">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerFull}" />
            <Setter Property="Height" Value="20" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.insert-cell-pill:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighestBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3PrimaryBrush}" />
        </Style>

        <!-- Floating Cell Action Capsule (Pinned Top-Right, reveals on hover or cell active) -->
        <Style Selector="Border.cell-floating-toolbar">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.notebook-cell-card:pointerover Border.cell-floating-toolbar">
            <Setter Property="Opacity" Value="1.0" />
        </Style>
        <Style Selector="Border.notebook-cell-card.active Border.cell-floating-toolbar">
            <Setter Property="Opacity" Value="1.0" />
        </Style>
        <Style Selector="Border.cell-floating-toolbar:pointerover">
            <Setter Property="Opacity" Value="1.0" />
        </Style>


        <!-- Collapsed Input & Output Banners -->
        <Style Selector="Border.notebook-collapsed-banner">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowestBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerExtraSmall}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.notebook-collapsed-banner:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}" />
        </Style>

        <Style Selector="Border.notebook-collapsed-output-banner">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowestBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerExtraSmall}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.notebook-collapsed-output-banner:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}" />
        </Style>

        <!-- Collapsed Banner Button (Makes entire banner clickable) -->
        <Style Selector="Button.collapsed-banner-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerExtraSmall}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Gutter Fold Button -->
        <Style Selector="Button.gutter-fold-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerExtraSmall}" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.gutter-fold-btn:pointerover">
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        </Style>

        <!-- Scrolled Output ScrollViewer -->
        <Style Selector="ScrollViewer.notebook-output-scroll.scrolled">
            <Setter Property="MaxHeight" Value="360" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto" Background="{DynamicResource M3SurfaceBrush}">

        <!-- ============================================================ -->
        <!-- ROW 0: MAIN WORKSPACE (EXPLORER SIDEBAR + SPLITTER + STUDIO) -->
        <!-- ============================================================ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="{Binding SideBarGridLength, Mode=TwoWay}" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- ======================================================== -->
            <!-- ZONE 1: ACTIVITY BAR (Column 0, 48px fixed)              -->
            <!-- ======================================================== -->
            <Border Grid.Column="0"
                    Width="48"
                    Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="*,Auto">
                    <!-- Top Activity Tool Buttons -->
                    <StackPanel Grid.Row="0" Spacing="0">
                        <!-- Explorer (0) -->
                        <Button Command="{Binding SelectActivityBarItemCommand}" CommandParameter="0"
                                Classes="activity-bar-btn"
                                Classes.active="{Binding IsExplorerActive}"
                                ToolTip.Tip="Explorer (Ctrl+Shift+E)">
                            <materialIcons:MaterialIcon Kind="FolderMultipleOutline" Width="20" Height="20" />
                        </Button>

                        <!-- Outline (1) -->
                        <Button Command="{Binding SelectActivityBarItemCommand}" CommandParameter="1"
                                Classes="activity-bar-btn"
                                Classes.active="{Binding IsOutlineActive}"
                                ToolTip.Tip="Notebook Outline">
                            <materialIcons:MaterialIcon Kind="FormatListBulleted" Width="20" Height="20" />
                        </Button>

                        <!-- Live Variables (2) -->
                        <Button Command="{Binding SelectActivityBarItemCommand}" CommandParameter="2"
                                Classes="activity-bar-btn"
                                Classes.active="{Binding IsVariablesActive}"
                                ToolTip.Tip="Live Variables">
                            <Grid>
                                <materialIcons:MaterialIcon Kind="CodeBraces" Width="20" Height="20" />
                                <Border Background="{DynamicResource M3PrimaryBrush}" CornerRadius="7"
                                        Height="14" MinWidth="14" Padding="3,0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0"
                                        IsVisible="{Binding Variables.Count}">
                                    <TextBlock Text="{Binding Variables.Count}" FontSize="8.5" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                               Foreground="{DynamicResource M3OnPrimaryBrush}" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Search (3) -->
                        <Button Command="{Binding SelectActivityBarItemCommand}" CommandParameter="3"
                                Classes="activity-bar-btn"
                                Classes.active="{Binding IsSearchActive}"
                                ToolTip.Tip="Search Cells &amp; Code">
                            <materialIcons:MaterialIcon Kind="Magnify" Width="20" Height="20" />
                        </Button>
                    </StackPanel>

                    <!-- Bottom Utility Buttons -->
                    <StackPanel Grid.Row="1" Spacing="0" Margin="0,0,0,4">
                        <!-- Return to Scripts Hub -->
                        <Button Command="{Binding BackToHubCommand}"
                                Classes="activity-bar-btn"
                                ToolTip.Tip="Return to Scripts &amp; Notebooks Hub">
                            <materialIcons:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================================================== -->
            <!-- ZONE 2: PRIMARY SIDEBAR (Column 1, Resizable, Collapsible) -->
            <!-- ======================================================== -->
            <Border Grid.Column="1"
                    IsVisible="{Binding IsSideBarVisible}"
                    MinWidth="160"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource M3SurfaceContainerLowBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*">
                    <!-- SideBar Header -->
                    <Border Grid.Row="0" Height="36"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,0,8,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding SideBarTitle}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                       VerticalAlignment="Center" />

                            <!-- Context actions for Explorer (View 0) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                                        IsVisible="{Binding IsExplorerActive}">
                                <Button Command="{Binding NewFileCommand}" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="New Notebook (.frynb)">
                                    <materialIcons:MaterialIcon Kind="FilePlusOutline" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                                <Button Command="{Binding NewFolderCommand}" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="New Folder">
                                    <materialIcons:MaterialIcon Kind="FolderPlusOutline" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                                <Button Click="OnOpenProjectClick" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="Open Project or File... (Ctrl+O)">
                                    <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                                <Button Command="{Binding RefreshExplorerCommand}" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="Refresh Explorer">
                                    <materialIcons:MaterialIcon Kind="Refresh" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                                <Button Command="{Binding CollapseAllExplorerCommand}" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="Collapse Folders">
                                    <materialIcons:MaterialIcon Kind="ArrowCollapseVertical" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                                <Button Command="{Binding ToggleSideBarCommand}" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="Hide Primary Side Bar (Ctrl+B)">
                                    <materialIcons:MaterialIcon Kind="ChevronLeft" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                            </StackPanel>

                            <!-- Collapse Button for Non-Explorer views -->
                            <Button Grid.Column="1" Command="{Binding ToggleSideBarCommand}" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="Hide Primary Side Bar (Ctrl+B)"
                                    IsVisible="{Binding !IsExplorerActive}">
                                <materialIcons:MaterialIcon Kind="ChevronLeft" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- SideBar Body Panels -->
                    <Panel Grid.Row="1">
                        <!-- 1. EXPLORER VIEW (Index 0) -->
                        <controls:StudioExplorerPanelControl IsVisible="{Binding IsExplorerActive}" OpenProjectRequested="OnOpenProjectClick" />


                        <!-- 2. OUTLINE VIEW (Index 1) -->
                        <Grid IsVisible="{Binding IsOutlineActive}" RowDefinitions="Auto,*">
                            <Border Grid.Row="0" Background="{DynamicResource M3SurfaceContainerLowBrush}" Height="28" Padding="12,0">
                                <TextBlock Text="{Binding Cells.Count, StringFormat='{}CELLS ({0})'}"
                                           FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                           VerticalAlignment="Center" />
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Cells}" Margin="4,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NotebookCellViewModel">
                                            <Button Command="{Binding $parent[UserControl].((vm:CSharpNotebookStudioViewModel)DataContext).SelectCellFromOutlineCommand}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="2,0,0,0"
                                                    BorderBrush="Transparent"
                                                    Classes.selected="{Binding IsSelected}"
                                                    HorizontalAlignment="Stretch"
                                                    Height="28"
                                                    Padding="6,0"
                                                    Cursor="Hand">
                                                <Grid ColumnDefinitions="Auto,Auto,*">
                                                    <materialIcons:MaterialIcon Grid.Column="0"
                                                                                Kind="CodeBraces"
                                                                                Width="13" Height="13"
                                                                                Foreground="{DynamicResource M3PrimaryBrush}"
                                                                                IsVisible="{Binding IsCodeCell}"
                                                                                VerticalAlignment="Center"
                                                                                Margin="0,0,6,0" />
                                                    <materialIcons:MaterialIcon Grid.Column="0"
                                                                                Kind="FormatHeaderPound"
                                                                                Width="13" Height="13"
                                                                                Foreground="{DynamicResource M3TertiaryBrush}"
                                                                                IsVisible="{Binding IsMarkdownCell}"
                                                                                VerticalAlignment="Center"
                                                                                Margin="0,0,6,0" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ExecutionBadgeText}"
                                                               FontSize="10.5" FontWeight="Bold"
                                                               Foreground="{DynamicResource M3PrimaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,6,0"
                                                               IsVisible="{Binding IsCodeCell}" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding MarkdownTitle}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource M3OnSurfaceBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding IsMarkdownCell}" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Source}"
                                                               FontSize="11"
                                                               FontFamily="Consolas, monospace"
                                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding IsCodeCell}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- 3. LIVE VARIABLES VIEW (Index 2) -->
                        <Grid IsVisible="{Binding IsVariablesActive}" RowDefinitions="Auto,*">
                            <Border Grid.Row="0" Background="{DynamicResource M3SurfaceContainerLowBrush}" Height="28" Padding="12,0">
                                <TextBlock Text="{Binding Variables.Count, StringFormat='{}LIVE VARIABLES ({0})'}"
                                           FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                           VerticalAlignment="Center" />
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Variables}" Margin="8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:NotebookVariableInfo">
                                            <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,6"
                                                    Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                                        <TextBlock Text="{Binding TypeName}" FontSize="10" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ValueDisplay}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- 4. SEARCH VIEW (Index 3) -->
                        <Grid IsVisible="{Binding IsSearchActive}" RowDefinitions="Auto,Auto,*">
                            <Border Grid.Row="0" Padding="10,8">
                                <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                                         PlaceholderText="Search cells &amp; code..."
                                         Classes="sidebar-search-box" />
                            </Border>
                            <Border Grid.Row="1" Padding="12,2,12,6">
                                <TextBlock Text="{Binding SearchResultsCount, StringFormat='{}{0} matching cells'}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </Border>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FilteredCells}" Margin="4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NotebookCellViewModel">
                                            <Button Command="{Binding $parent[UserControl].((vm:CSharpNotebookStudioViewModel)DataContext).SelectCellFromOutlineCommand}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Stretch"
                                                    Padding="8,6"
                                                    Cursor="Hand">
                                                <StackPanel Spacing="3">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <materialIcons:MaterialIcon Kind="CodeBraces" Width="12" Height="12" Foreground="{DynamicResource M3PrimaryBrush}" IsVisible="{Binding IsCodeCell}" />
                                                        <materialIcons:MaterialIcon Kind="FormatHeaderPound" Width="12" Height="12" Foreground="{DynamicResource M3TertiaryBrush}" IsVisible="{Binding IsMarkdownCell}" />
                                                        <TextBlock Text="{Binding ExecutionBadgeText}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource M3PrimaryBrush}" IsVisible="{Binding IsCodeCell}" />
                                                        <TextBlock Text="{Binding LanguageTag}" FontSize="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Source}" FontSize="11" FontFamily="Consolas, monospace" Foreground="{DynamicResource M3OnSurfaceBrush}" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Panel>
                </Grid>
            </Border>

            <!-- ======================================================== -->
            <!-- VERTICAL GRID SPLITTER (Column 2)                        -->
            <!-- ======================================================== -->
            <GridSplitter Grid.Column="2"
                          Width="1"
                          Background="{DynamicResource M3OutlineVariantBrush}"
                          ResizeDirection="Columns"
                          Cursor="SizeWestEast"
                          IsVisible="{Binding IsSideBarVisible}" />

            <!-- ======================================================== -->
            <!-- ZONE 3: MAIN NOTEBOOK STUDIO CANVAS (Column 3)           -->
            <!-- ======================================================== -->
            <Grid Grid.Column="3" RowDefinitions="Auto,Auto,Auto,*">

                <!-- ==================================================== -->
                <!-- ROW 0: DOCUMENT TAB BAR (36px)                       -->
                <!-- ==================================================== -->
                <Border Grid.Row="0"
                        Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                        BorderThickness="0,0,0,1"
                        Height="36"
                        Padding="6,0,10,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- Left: Scrollable Tabs Strip -->
                        <ScrollViewer Grid.Column="0"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom">
                                <ItemsControl ItemsSource="{Binding Tabs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NotebookTabViewModel">
                                            <!-- Tab Item -->
                                            <Border Classes="studio-tab-item"
                                                    Classes.active="{Binding IsActive}"
                                                    Height="31"
                                                    VerticalAlignment="Bottom"
                                                    Background="Transparent"
                                                    PointerPressed="OnTabPointerPressed">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Close" Command="{Binding CloseTabCommand}">
                                                            <MenuItem.Icon>
                                                                <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Close Others" Command="{Binding CloseOthersCommand}">
                                                            <MenuItem.Icon>
                                                                <materialIcons:MaterialIcon Kind="CloseBoxMultipleOutline" Width="14" Height="14" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Close to the Right" Command="{Binding CloseToTheRightCommand}">
                                                            <MenuItem.Icon>
                                                                <materialIcons:MaterialIcon Kind="ArrowRightBoldOutline" Width="14" Height="14" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Close All" Command="{Binding CloseAllCommand}">
                                                            <MenuItem.Icon>
                                                                <materialIcons:MaterialIcon Kind="CloseOctagonOutline" Width="14" Height="14" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator />
                                                        <MenuItem Header="Copy Path" Command="{Binding CopyPathCommand}">
                                                            <MenuItem.Icon>
                                                                <materialIcons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Reveal in Explorer" Command="{Binding RevealInExplorerCommand}">
                                                            <MenuItem.Icon>
                                                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="14" Height="14" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid RowDefinitions="2,*">
                                                    <!-- Top active accent line -->
                                                    <Border Grid.Row="0"
                                                            Height="2"
                                                            Background="{StaticResource NotebookAmberBrush}"
                                                            IsVisible="{Binding IsActive}"
                                                            CornerRadius="2,2,0,0" />
                                                    <Button Grid.Row="1"
                                                            Command="{Binding SelectTabCommand}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="10,0,6,0"
                                                            Cursor="Hand"
                                                            VerticalAlignment="Stretch">
                                                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                            <!-- Orange Notebook Icon -->
                                                            <materialIcons:MaterialIcon Kind="{Binding IconKind}" Width="14" Height="14" Foreground="{Binding IconColor}" VerticalAlignment="Center" />
                                                            <!-- Tab Title -->
                                                            <TextBlock Classes="tab-title"
                                                                       Text="{Binding Title}"
                                                                       FontSize="12"
                                                                       VerticalAlignment="Center" />
                                                            <!-- Unsaved Dot Indicator -->
                                                            <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource M3PrimaryBrush}" IsVisible="{Binding IsModified}" VerticalAlignment="Center" />
                                                            <!-- Close Tab Button -->
                                                            <Button Command="{Binding CloseTabCommand}"
                                                                    Classes="cell-tool-btn"
                                                                    Width="18" Height="18"
                                                                    Margin="2,0,0,0"
                                                                    ToolTip.Tip="Close Tab">
                                                                <materialIcons:MaterialIcon Kind="Close" Width="11" Height="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- New Tab Button (+) -->
                                <Button Command="{Binding NewNotebookTabCommand}"
                                        Classes="cell-tool-btn"
                                        Width="24" Height="24"
                                        Margin="4,0,0,4"
                                        VerticalAlignment="Bottom"
                                        ToolTip.Tip="New Notebook (Ctrl+N)">
                                    <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Right: Actions (Hub) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Command="{Binding BackToHubCommand}"
                                    Classes="nb-action-btn"
                                    ToolTip.Tip="Return to Scripts &amp; Notebooks Hub">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="ArrowLeft" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    <TextBlock Text="Hub" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================================================== -->
                <!-- ROW 1: DEDICATED BREADCRUMB STRIP (26px)             -->
                <!-- ==================================================== -->
                <Border Grid.Row="1"
                        Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                        BorderThickness="0,0,0,1"
                        Height="26"
                        Padding="16,0">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" VerticalAlignment="Center">
                        <!-- Segment 1: Folder -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="FolderOutline" Width="13" Height="13" Foreground="{StaticResource NotebookAmberBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BreadcrumbFolder}" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Chevron 1 -->
                        <materialIcons:MaterialIcon Grid.Column="1" Kind="ChevronRight" Width="12" Height="12" Foreground="{DynamicResource M3OutlineBrush}" VerticalAlignment="Center" Margin="5,0" />

                        <!-- Segment 2: Document -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="{Binding ActiveTab.IconKind}" Width="13" Height="13" Foreground="{Binding ActiveTab.IconColor}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BreadcrumbDocument}" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Chevron 2 -->
                        <materialIcons:MaterialIcon Grid.Column="3" Kind="ChevronRight" Width="12" Height="12" Foreground="{DynamicResource M3OutlineBrush}" VerticalAlignment="Center" Margin="5,0" />

                        <!-- Segment 3: Active Cell Chip -->
                        <Border Grid.Column="4"
                                Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,1"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="{Binding ActiveCellTypeIcon}" Width="11" Height="11" Foreground="{Binding ActiveCellTypeColor}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveCellBadgeText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource M3OnSurfaceBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="400" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ==================================================== -->
                <!-- ROW 2: PROFESSIONAL ACTION TOOLBAR (38px)            -->
                <!-- ==================================================== -->
                <Border Grid.Row="2"
                        Background="{DynamicResource M3SurfaceContainerLowBrush}"
                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                        BorderThickness="0,0,0,1"
                        Height="38"
                        Padding="14,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Left: Core Actions -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <!-- Segmented Pill for Cell Creation (+ Code & + Markdown) -->
                            <Border Background="{DynamicResource M3SurfaceContainerBrush}"
                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource M3ShapeCornerExtraSmall}"
                                    Padding="2"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <!-- + Code -->
                                    <Button Command="{Binding AddCodeCellCommand}" Classes="nb-action-btn" Height="26" Padding="8,0" ToolTip.Tip="Add Code Cell (Ctrl+Shift+Enter)">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Plus" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="Code" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- + Markdown -->
                                    <Button Command="{Binding AddMarkdownCellCommand}" Classes="nb-action-btn" Height="26" Padding="8,0" ToolTip.Tip="Add Markdown Cell">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Plus" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="Markdown" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Rectangle Width="1" Height="18" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="6,0" VerticalAlignment="Center" />

                            <!-- Run All -->
                            <Button Command="{Binding RunAllCellsCommand}" IsEnabled="{Binding !IsExecuting}" Classes="nb-action-btn" ToolTip.Tip="Run All Cells (Linear Sequence)">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Play" Width="13" Height="13" Foreground="{DynamicResource M3SuccessBrush}" />
                                    <TextBlock Text="Run All" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Restart Kernel -->
                            <Button Command="{Binding RestartKernelCommand}" Classes="nb-action-btn" ToolTip.Tip="Restart Kernel &amp; Reset Variables">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Restart" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    <TextBlock Text="Restart" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Clear All Outputs -->
                            <Button Command="{Binding ClearAllOutputsCommand}" Classes="nb-action-btn" ToolTip.Tip="Clear All Cell Outputs">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="CloseBoxOutline" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    <TextBlock Text="Clear Outputs" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Collapse / View Options Dropdown -->
                            <Button Classes="nb-action-btn" ToolTip.Tip="Collapse or Expand Cells and Outputs">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuItem Header="Collapse All Inputs" Command="{Binding CollapseAllInputsCommand}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="UnfoldLessHorizontal" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Expand All Inputs" Command="{Binding ExpandAllInputsCommand}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="UnfoldMoreHorizontal" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Collapse All Outputs" Command="{Binding CollapseAllOutputsCommand}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="ArrowCollapseVertical" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Expand All Outputs" Command="{Binding ExpandAllOutputsCommand}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="ArrowExpandVertical" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Collapse All Cells" Command="{Binding CollapseAllCellsCommand}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="FolderOutline" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Expand All Cells" Command="{Binding ExpandAllCellsCommand}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Fold All Code Blocks (Ctrl+Shift+[)" Command="{Binding FoldAllCodeBlocksCommand}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="ArrowCollapseVertical" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Unfold All Code Blocks (Ctrl+Shift+])" Command="{Binding UnfoldAllCodeBlocksCommand}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="ArrowExpandVertical" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Format All Code Cells (Ctrl+K Ctrl+D)" Command="{Binding FormatAllCodeCellsCommand}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="FormatIndentIncrease" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="ArrowCollapseVertical" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    <TextBlock Text="Collapse" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                    <materialIcons:MaterialIcon Kind="MenuDown" Width="11" Height="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Rectangle Width="1" Height="18" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="6,0" VerticalAlignment="Center" />

                            <!-- Outline Toggle -->
                            <Button Command="{Binding ToggleOutlineCommand}" Classes="nb-action-btn" ToolTip.Tip="Toggle Notebook Outline">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="FormatListBulleted" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    <TextBlock Text="Outline" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Variables Toggle -->
                            <Button Command="{Binding ToggleVariableInspectorCommand}" Classes="nb-action-btn" ToolTip.Tip="Toggle Live Variable Inspector">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="CodeBraces" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                    <TextBlock Text="Variables" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource M3PrimaryBrush}" CornerRadius="8" Height="16" MinWidth="16" Padding="4,0" VerticalAlignment="Center" Margin="2,0,0,0">
                                        <TextBlock Text="{Binding Variables.Count}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource M3OnPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <!-- Save -->
                            <Button Command="{Binding SaveCommand}" Classes="nb-action-btn" ToolTip.Tip="Save Notebook (Ctrl+S)">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    <TextBlock Text="Save" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Right: Kernel Indicator Badge -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

                            <!-- Kernel Indicator Pill (.NET (C#)) -->
                            <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                    Height="26"
                                    Padding="10,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="FlaskOutline" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding KernelName}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}"
                                               VerticalAlignment="Center" />
                                    <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource M3SuccessBrush}" VerticalAlignment="Center" Margin="2,0,0,0" ToolTip.Tip="Kernel: Ready" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================================================== -->
                <!-- ROW 3: MAIN NOTEBOOK CANVAS                          -->
                <!-- ==================================================== -->
                <Grid Grid.Row="3">
                    <!-- Active Canvas (Visible when HasActiveTab) -->
                    <Grid IsVisible="{Binding HasActiveTab}">

                    <!-- Notebook Canvas ScrollViewer -->
                    <ScrollViewer x:Name="NotebookCanvasScrollViewer"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="0" Margin="24,16,24,48" HorizontalAlignment="Stretch">

                            <!-- Top Insert Divider (before first cell) -->
                            <Border Classes="cell-insert-divider" Margin="56,0,0,8">
                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <Rectangle Classes="divider-line" Height="1" Fill="{DynamicResource M3OutlineVariantBrush}" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                                    <StackPanel Classes="insert-pill-group" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Command="{Binding AddCellAboveCommand}"
                                                Classes="insert-cell-pill" ToolTip.Tip="Insert Code Cell at Beginning">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="Plus" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                <TextBlock Text="Code" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding AddMarkdownCellCommand}"
                                                Classes="insert-cell-pill" ToolTip.Tip="Insert Markdown Cell at Beginning">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="Plus" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                <TextBlock Text="Markdown" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Cells List -->
                            <ItemsControl ItemsSource="{Binding Cells}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NotebookCellViewModel">
                                        <StackPanel Spacing="0">
                                            <!-- 2-Column IDE Cell Layout: Col 0 = Gutter, Col 1 = Unified Cell Card -->
                                            <Grid ColumnDefinitions="56,*" Margin="0,0,0,0">
                                                <!-- COLUMN 0: LEFT GUTTER (Aligned with Line 1) -->
                                                <StackPanel Grid.Column="0" Spacing="2" HorizontalAlignment="Right" Margin="0,4,8,0">
                                                    <!-- Row 1: Gutter Input Fold, Run Button & Execution Badge -->
                                                    <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
                                                        <Button Command="{Binding ToggleInputCollapseCommand}"
                                                                Classes="gutter-fold-btn"
                                                                ToolTip.Tip="{Binding ToggleInputCollapseTooltip}">
                                                            <Panel Width="10" Height="10">
                                                                <materialIcons:MaterialIcon Kind="ChevronDown" IsVisible="{Binding !IsInputCollapsed}" Width="10" Height="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <materialIcons:MaterialIcon Kind="ChevronRight" IsVisible="{Binding IsInputCollapsed}" Width="10" Height="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Panel>
                                                        </Button>

                                                        <!-- Gutter Run Button (Code Cells) -->
                                                        <Button Command="{Binding RunCellCommand}"
                                                                Classes="gutter-run-btn"
                                                                Width="16" Height="16"
                                                                IsVisible="{Binding IsCodeCell}"
                                                                ToolTip.Tip="Execute Cell (Ctrl+Enter)">
                                                            <materialIcons:MaterialIcon Kind="Play" Width="10" Height="10" Foreground="{DynamicResource M3SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Button>

                                                        <!-- Execution Badge [1] (Code Cells) -->
                                                        <TextBlock Text="{Binding ExecutionBadgeText}"
                                                                   FontFamily="Consolas, Menlo, Monaco, Cascadia Code, monospace"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding StatusBadgeForeground}"
                                                                   VerticalAlignment="Center"
                                                                   IsVisible="{Binding IsCodeCell}" />
                                                    </StackPanel>

                                                    <!-- Row 2: Execution Duration: ✓ 0.1s -->
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="2"
                                                                HorizontalAlignment="Right"
                                                                IsVisible="{Binding ExecutionDurationShortText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                        <materialIcons:MaterialIcon Kind="Check" Width="10" Height="10" Foreground="{DynamicResource M3SuccessBrush}" IsVisible="{Binding !HasError}" VerticalAlignment="Center" />
                                                        <materialIcons:MaterialIcon Kind="Close" Width="10" Height="10" Foreground="{DynamicResource M3ErrorBrush}" IsVisible="{Binding HasError}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding ExecutionDurationShortText}"
                                                                   FontSize="9"
                                                                   Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <!-- Row 3: Gutter Output Fold Button (Visible when cell has output) -->
                                                    <Button Command="{Binding ToggleOutputCollapseCommand}"
                                                            Classes="gutter-fold-btn"
                                                            IsVisible="{Binding HasOutput}"
                                                            ToolTip.Tip="{Binding ToggleOutputCollapseTooltip}"
                                                            HorizontalAlignment="Right"
                                                            Margin="0,2,0,0">
                                                        <Panel Width="10" Height="10">
                                                            <materialIcons:MaterialIcon Kind="ChevronDown" IsVisible="{Binding !IsOutputCollapsed}" Width="10" Height="10" Foreground="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <materialIcons:MaterialIcon Kind="ChevronRight" IsVisible="{Binding IsOutputCollapsed}" Width="10" Height="10" Foreground="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Panel>
                                                    </Button>
                                                </StackPanel>

                                                <!-- COLUMN 1: UNIFIED CELL CARD -->
                                                <Border Grid.Column="1"
                                                        Classes="notebook-cell-card"
                                                        Classes.active="{Binding IsSelected}">
                                                    <Grid>
                                                        <!-- 3px Left Vertical Accent Focus Indicator -->
                                                        <Border Width="3"
                                                                Background="{DynamicResource M3PrimaryBrush}"
                                                                CornerRadius="4,0,0,4"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Stretch"
                                                                IsVisible="{Binding IsSelected}" />

                                                        <StackPanel Margin="6,0,0,0">
                                                            <!-- Code / Markdown Editor Box (Visible when !IsInputCollapsed) -->
                                                            <Grid IsVisible="{Binding IsInputVisible}">
                                                                <!-- Editor Content -->
                                                                <Panel Margin="6,4,6,4">
                                                                    <!-- C# Syntax Highlighted Code Editor -->
                                                                    <controls:BindableTextEditor IsVisible="{Binding IsCodeCell}"
                                                                                                 TextContent="{Binding Source, Mode=TwoWay}"
                                                                                                 ExecuteCommand="{Binding RunCellCommand}"
                                                                                                 ExecuteAndNextCommand="{Binding RunCellAndSelectNextCommand}"
                                                                                                 MinHeight="24"
                                                                                                 FontSize="13" />

                                                                    <!-- Markdown View (Rendered Header & Notes) -->
                                                                    <StackPanel IsVisible="{Binding IsViewingMarkdown}" Spacing="6" Margin="8,6">
                                                                        <TextBlock Text="{Binding MarkdownTitle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                                                        <TextBlock Text="{Binding MarkdownBody}" FontSize="12.5" LineHeight="19" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                                                                    </StackPanel>

                                                                    <!-- Markdown Edit Mode -->
                                                                    <TextBox IsVisible="{Binding IsEditingMarkdown}"
                                                                             Text="{Binding Source, Mode=TwoWay}"
                                                                             AcceptsReturn="True"
                                                                             AcceptsTab="True"
                                                                             Background="Transparent"
                                                                             BorderThickness="0"
                                                                             MinHeight="24"
                                                                             FontSize="13"
                                                                             Foreground="{DynamicResource M3OnSurfaceBrush}"
                                                                             PlaceholderText="Write markdown documentation (# Header, notes)..."
                                                                             TextWrapping="Wrap" />
                                                                </Panel>

                                                                <!-- Floating Action Bar & Language Tag (Top Right Overlay) -->
                                                                <Border Classes="cell-floating-toolbar"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Top"
                                                                        Margin="0,4,6,0"
                                                                        Padding="4,2">
                                                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                                                        <!-- Language Tag Chip (C# / MD) -->
                                                                        <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                                                                CornerRadius="3"
                                                                                Padding="5,1"
                                                                                VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding LanguageTag}"
                                                                                       FontSize="10"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                                        </Border>

                                                                        <!-- Markdown preview/edit toggle button (if markdown cell) -->
                                                                        <Button Command="{Binding ToggleMarkdownPreviewCommand}"
                                                                                Classes="cell-tool-btn"
                                                                                Width="NaN"
                                                                                Height="20"
                                                                                Padding="5,0"
                                                                                IsVisible="{Binding IsMarkdownCell}">
                                                                            <TextBlock Text="{Binding MarkdownPreviewButtonText}" FontSize="10" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                                        </Button>

                                                                        <!-- Thin Separator -->
                                                                        <Rectangle Width="1" Height="12" Fill="{DynamicResource M3OutlineVariantBrush}" VerticalAlignment="Center" Margin="1,0" />

                                                                        <!-- Fold Code in Cell -->
                                                                        <Button Command="{Binding FoldAllCodeCommand}"
                                                                                Classes="cell-tool-btn"
                                                                                Width="20" Height="20"
                                                                                IsVisible="{Binding IsCodeCell}"
                                                                                ToolTip.Tip="Fold Code Blocks (Ctrl+Shift+[)">
                                                                            <materialIcons:MaterialIcon Kind="ArrowCollapseVertical" Width="11" Height="11" />
                                                                        </Button>

                                                                        <!-- Unfold Code in Cell -->
                                                                        <Button Command="{Binding UnfoldAllCodeCommand}"
                                                                                Classes="cell-tool-btn"
                                                                                Width="20" Height="20"
                                                                                IsVisible="{Binding IsCodeCell}"
                                                                                ToolTip.Tip="Unfold Code Blocks (Ctrl+Shift+])">
                                                                            <materialIcons:MaterialIcon Kind="ArrowExpandVertical" Width="11" Height="11" />
                                                                        </Button>

                                                                        <!-- Format Code in Cell -->
                                                                        <Button Command="{Binding FormatCodeCommand}"
                                                                                Classes="cell-tool-btn"
                                                                                Width="20" Height="20"
                                                                                IsVisible="{Binding IsCodeCell}"
                                                                                ToolTip.Tip="Format Code (Ctrl+K Ctrl+D)">
                                                                            <materialIcons:MaterialIcon Kind="FormatIndentIncrease" Width="11" Height="11" />
                                                                        </Button>

                                                                        <!-- Collapse Input Action -->
                                                                        <Button Command="{Binding ToggleInputCollapseCommand}"
                                                                                Classes="cell-tool-btn"
                                                                                Width="20" Height="20"
                                                                                ToolTip.Tip="Collapse Cell Input">
                                                                            <materialIcons:MaterialIcon Kind="ChevronUp" Width="12" Height="12" />
                                                                        </Button>

                                                                        <!-- Run Action -->
                                                                        <Button Command="{Binding RunCellCommand}"
                                                                                Classes="cell-tool-btn"
                                                                                Width="20" Height="20"
                                                                                IsVisible="{Binding IsCodeCell}"
                                                                                ToolTip.Tip="Execute Cell (Ctrl+Enter)">
                                                                            <materialIcons:MaterialIcon Kind="Play" Width="12" Height="12" Foreground="{DynamicResource M3SuccessBrush}" />
                                                                        </Button>

                                                                        <!-- Split / Add Below -->
                                                                        <Button Command="{Binding AddCodeBelowCommand}"
                                                                                Classes="cell-tool-btn"
                                                                                Width="20" Height="20"
                                                                                ToolTip.Tip="Insert Code Cell Below">
                                                                            <materialIcons:MaterialIcon Kind="Plus" Width="12" Height="12" />
                                                                        </Button>

                                                                        <!-- Move Up -->
                                                                        <Button Command="{Binding MoveUpCommand}"
                                                                                Classes="cell-tool-btn"
                                                                                Width="20" Height="20"
                                                                                ToolTip.Tip="Move Cell Up">
                                                                            <materialIcons:MaterialIcon Kind="ArrowUp" Width="12" Height="12" />
                                                                        </Button>

                                                                        <!-- Move Down -->
                                                                        <Button Command="{Binding MoveDownCommand}"
                                                                                Classes="cell-tool-btn"
                                                                                Width="20" Height="20"
                                                                                ToolTip.Tip="Move Cell Down">
                                                                            <materialIcons:MaterialIcon Kind="ArrowDown" Width="12" Height="12" />
                                                                        </Button>

                                                                        <!-- Delete Cell -->
                                                                        <Button Command="{Binding DeleteCommand}"
                                                                                Classes="cell-tool-btn delete-tool"
                                                                                Width="20" Height="20"
                                                                                ToolTip.Tip="Delete Cell">
                                                                            <materialIcons:MaterialIcon Kind="DeleteOutline" Width="12" Height="12" />
                                                                        </Button>

                                                                        <!-- More Options Menu Flyout -->
                                                                        <Button Classes="cell-tool-btn"
                                                                                Width="20" Height="20"
                                                                                ToolTip.Tip="More Options">
                                                                            <Button.Flyout>
                                                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                                    <MenuItem Header="Run Cell" Command="{Binding RunCellCommand}" IsVisible="{Binding IsCodeCell}">
                                                                                        <MenuItem.Icon>
                                                                                            <materialIcons:MaterialIcon Kind="Play" Width="14" Height="14" Foreground="{DynamicResource M3SuccessBrush}" />
                                                                                        </MenuItem.Icon>
                                                                                    </MenuItem>
                                                                                    <MenuItem Header="Clear Output" Command="{Binding ClearOutputCommand}">
                                                                                        <MenuItem.Icon>
                                                                                            <materialIcons:MaterialIcon Kind="DeleteSweepOutline" Width="14" Height="14" />
                                                                                        </MenuItem.Icon>
                                                                                    </MenuItem>
                                                                                    <Separator />
                                                                                    <MenuItem Header="{Binding ToggleInputCollapseText}" Command="{Binding ToggleInputCollapseCommand}">
                                                                                        <MenuItem.Icon>
                                                                                            <materialIcons:MaterialIcon Kind="UnfoldLessHorizontal" Width="14" Height="14" />
                                                                                        </MenuItem.Icon>
                                                                                    </MenuItem>
                                                                                    <MenuItem Header="{Binding ToggleOutputCollapseText}" Command="{Binding ToggleOutputCollapseCommand}" IsVisible="{Binding HasOutput}">
                                                                                        <MenuItem.Icon>
                                                                                            <materialIcons:MaterialIcon Kind="ArrowCollapseVertical" Width="14" Height="14" />
                                                                                        </MenuItem.Icon>
                                                                                    </MenuItem>
                                                                                    <MenuItem Header="{Binding ToggleOutputScrolledText}" Command="{Binding ToggleOutputScrolledCommand}" IsVisible="{Binding HasOutput}">
                                                                                        <MenuItem.Icon>
                                                                                            <materialIcons:MaterialIcon Kind="FormatLineSpacing" Width="14" Height="14" />
                                                                                        </MenuItem.Icon>
                                                                                    </MenuItem>
                                                                                    <MenuItem Header="{Binding ToggleCellCollapseText}" Command="{Binding ToggleCellCollapseCommand}">
                                                                                        <MenuItem.Icon>
                                                                                            <materialIcons:MaterialIcon Kind="FolderOutline" Width="14" Height="14" />
                                                                                        </MenuItem.Icon>
                                                                                    </MenuItem>
                                                                                    <Separator IsVisible="{Binding IsCodeCell}" />
                                                                                    <MenuItem Header="Fold Code Blocks (Ctrl+Shift+[)" Command="{Binding FoldAllCodeCommand}" IsVisible="{Binding IsCodeCell}">
                                                                                        <MenuItem.Icon>
                                                                                            <materialIcons:MaterialIcon Kind="ArrowCollapseVertical" Width="14" Height="14" />
                                                                                        </MenuItem.Icon>
                                                                                    </MenuItem>
                                                                                    <MenuItem Header="Unfold Code Blocks (Ctrl+Shift+])" Command="{Binding UnfoldAllCodeCommand}" IsVisible="{Binding IsCodeCell}">
                                                                                        <MenuItem.Icon>
                                                                                            <materialIcons:MaterialIcon Kind="ArrowExpandVertical" Width="14" Height="14" />
                                                                                        </MenuItem.Icon>
                                                                                    </MenuItem>
                                                                                    <MenuItem Header="Format Code (Ctrl+K Ctrl+D)" Command="{Binding FormatCodeCommand}" IsVisible="{Binding IsCodeCell}">
                                                                                        <MenuItem.Icon>
                                                                                            <materialIcons:MaterialIcon Kind="FormatIndentIncrease" Width="14" Height="14" />
                                                                                        </MenuItem.Icon>
                                                                                    </MenuItem>
                                                                                    <Separator />
                                                                                    <MenuItem Header="Insert Code Below" Command="{Binding AddCodeBelowCommand}">
                                                                                        <MenuItem.Icon>
                                                                                            <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" />
                                                                                        </MenuItem.Icon>
                                                                                    </MenuItem>
                                                                                    <MenuItem Header="Insert Markdown Below" Command="{Binding AddMarkdownBelowCommand}">
                                                                                        <MenuItem.Icon>
                                                                                            <materialIcons:MaterialIcon Kind="FormatHeaderPound" Width="14" Height="14" />
                                                                                        </MenuItem.Icon>
                                                                                    </MenuItem>
                                                                                    <Separator />
                                                                                    <MenuItem Header="Move Up" Command="{Binding MoveUpCommand}">
                                                                                        <MenuItem.Icon>
                                                                                            <materialIcons:MaterialIcon Kind="ArrowUp" Width="14" Height="14" />
                                                                                        </MenuItem.Icon>
                                                                                    </MenuItem>
                                                                                    <MenuItem Header="Move Down" Command="{Binding MoveDownCommand}">
                                                                                        <MenuItem.Icon>
                                                                                            <materialIcons:MaterialIcon Kind="ArrowDown" Width="14" Height="14" />
                                                                                        </MenuItem.Icon>
                                                                                    </MenuItem>
                                                                                    <Separator />
                                                                                    <MenuItem Header="Delete Cell" Command="{Binding DeleteCommand}">
                                                                                        <MenuItem.Icon>
                                                                                            <materialIcons:MaterialIcon Kind="DeleteOutline" Width="14" Height="14" Foreground="{DynamicResource M3ErrorBrush}" />
                                                                                        </MenuItem.Icon>
                                                                                    </MenuItem>
                                                                                </MenuFlyout>
                                                                            </Button.Flyout>
                                                                            <TextBlock Text="..." FontSize="10" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>

                                                            <!-- Collapsed Input Placeholder Banner (Visible when IsInputCollapsed) -->
                                                            <Border Classes="notebook-collapsed-banner" IsVisible="{Binding IsInputCollapsed}">
                                                                <Button Command="{Binding ToggleInputCollapseCommand}"
                                                                        Classes="collapsed-banner-btn"
                                                                        ToolTip.Tip="Click to expand cell input"
                                                                        HorizontalAlignment="Stretch">
                                                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                                        <materialIcons:MaterialIcon Grid.Column="0"
                                                                                                    Kind="ChevronRight"
                                                                                                    Width="14" Height="14"
                                                                                                    Foreground="{DynamicResource M3PrimaryBrush}"
                                                                                                    VerticalAlignment="Center"
                                                                                                    Margin="0,0,6,0" />

                                                                        <Border Grid.Column="1"
                                                                                Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                                                                CornerRadius="3"
                                                                                Padding="5,1"
                                                                                VerticalAlignment="Center"
                                                                                Margin="0,0,8,0">
                                                                            <TextBlock Text="{Binding LanguageTag}"
                                                                                       FontSize="10"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                                        </Border>

                                                                        <TextBlock Grid.Column="2"
                                                                                   Text="{Binding InputCollapsedSummaryText}"
                                                                                   FontSize="11.5"
                                                                                   FontFamily="Consolas, Menlo, Monaco, Cascadia Code, monospace"
                                                                                   Foreground="{DynamicResource M3OnSurfaceBrush}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   VerticalAlignment="Center" />

                                                                        <Border Grid.Column="3"
                                                                                Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                                                                CornerRadius="3"
                                                                                Padding="6,2"
                                                                                VerticalAlignment="Center">
                                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                                <materialIcons:MaterialIcon Kind="UnfoldMoreHorizontal" Width="12" Height="12" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
                                                                                <TextBlock Text="Expand Input" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Grid>
                                                                </Button>
                                                            </Border>

                                                            <!-- INLINE OUTPUT STREAM (Inside Card) -->
                                                            <StackPanel Spacing="4" Margin="4,4,4,8" IsVisible="{Binding HasOutput}">
                                                                <!-- Subtle separator between input and output -->
                                                                <Rectangle Height="1" Fill="{DynamicResource M3OutlineVariantBrush}" Opacity="0.4" Margin="0,0,0,4" />

                                                                <!-- Collapsed Output Banner -->
                                                                <Border Classes="notebook-collapsed-output-banner"
                                                                        IsVisible="{Binding IsOutputCollapsedBarVisible}">
                                                                    <Button Command="{Binding ToggleOutputCollapseCommand}"
                                                                            Classes="collapsed-banner-btn"
                                                                            ToolTip.Tip="Click to expand cell output"
                                                                            HorizontalAlignment="Stretch">
                                                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                                            <materialIcons:MaterialIcon Grid.Column="0"
                                                                                                        Kind="ChevronRight"
                                                                                                        Width="14" Height="14"
                                                                                                        Foreground="{DynamicResource M3PrimaryBrush}"
                                                                                                        VerticalAlignment="Center"
                                                                                                        Margin="0,0,6,0" />

                                                                            <materialIcons:MaterialIcon Grid.Column="1"
                                                                                                        Kind="Console"
                                                                                                        Width="14" Height="14"
                                                                                                        Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                                                                        VerticalAlignment="Center"
                                                                                                        Margin="0,0,8,0" />

                                                                            <TextBlock Grid.Column="2"
                                                                                       Text="{Binding OutputCollapsedSummaryText}"
                                                                                       FontSize="11.5"
                                                                                       Foreground="{DynamicResource M3OnSurfaceBrush}"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       VerticalAlignment="Center" />

                                                                            <Border Grid.Column="3"
                                                                                    Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                                                                    CornerRadius="3"
                                                                                    Padding="6,2"
                                                                                    VerticalAlignment="Center">
                                                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                                    <materialIcons:MaterialIcon Kind="ArrowExpandVertical" Width="12" Height="12" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
                                                                                    <TextBlock Text="Expand Output" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </Grid>
                                                                    </Button>
                                                                </Border>

                                                                <!-- Active Output Stream Container (Visible when IsOutputVisible) -->
                                                                <StackPanel Spacing="4" IsVisible="{Binding IsOutputVisible}">
                                                                    <!-- Output Control Bar -->
                                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,1,0,2">
                                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                            <materialIcons:MaterialIcon Kind="Console" Width="12" Height="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                                                            <TextBlock Text="Output" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                                            <Button Command="{Binding ToggleOutputScrolledCommand}"
                                                                                    Classes="cell-tool-btn"
                                                                                    Width="20" Height="20"
                                                                                    ToolTip.Tip="{Binding OutputScrolledTooltip}">
                                                                                <Panel Width="12" Height="12">
                                                                                    <materialIcons:MaterialIcon Kind="FormatLineSpacing" IsVisible="{Binding IsOutputScrolled}" Width="12" Height="12" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                                                    <materialIcons:MaterialIcon Kind="UnfoldMoreHorizontal" IsVisible="{Binding !IsOutputScrolled}" Width="12" Height="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                                                </Panel>
                                                                            </Button>
                                                                            <Button Command="{Binding ToggleOutputCollapseCommand}"
                                                                                    Classes="cell-tool-btn"
                                                                                    Width="20" Height="20"
                                                                                    ToolTip.Tip="Collapse Output">
                                                                                <materialIcons:MaterialIcon Kind="ChevronUp" Width="12" Height="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                                            </Button>
                                                                            <Button Command="{Binding ClearOutputCommand}"
                                                                                    Classes="cell-tool-btn"
                                                                                    Width="20" Height="20"
                                                                                    ToolTip.Tip="Clear Output">
                                                                                <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Grid>

                                                                    <!-- Output Elements -->
                                                                    <ScrollViewer Classes="notebook-output-scroll"
                                                                                  Classes.scrolled="{Binding IsOutputScrolled}">
                                                                        <StackPanel Spacing="6">
                                                                            <!-- 1. Interactive Object Inspector Tree -->
                                                                            <Border IsVisible="{Binding HasInspectorOutput}" Margin="0,1,0,3">
                                                                                <views:ObjectInspectorView DataContext="{Binding InspectorNode}" />
                                                                            </Border>

                                                                            <!-- 2. Dark Terminal Card for Console Stdout Output -->
                                                                            <Border Background="#080C10"
                                                                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="6"
                                                                                    Padding="10,8"
                                                                                    IsVisible="{Binding OutputText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                                <TextBox Text="{Binding OutputText, Mode=OneWay}"
                                                                                         FontFamily="Consolas, Menlo, Monaco, Cascadia Code, monospace"
                                                                                         FontSize="12"
                                                                                         Foreground="{DynamicResource M3OnSurfaceBrush}"
                                                                                         Background="Transparent"
                                                                                         BorderThickness="0"
                                                                                         Padding="0"
                                                                                         IsReadOnly="True"
                                                                                         TextWrapping="Wrap" />
                                                                            </Border>

                                                                            <!-- 3. Tabular Output (.Dump()) -->
                                                                            <Border IsVisible="{Binding HasTableOutput}">
                                                                                <views:DumpTableView DataContext="{Binding TableResult}" />
                                                                            </Border>

                                                                            <!-- 4. Rendered Graphic / Image Output -->
                                                                            <Border IsVisible="{Binding HasImageOutput}"
                                                                                    Background="{DynamicResource M3SurfaceContainerLowBrush}"
                                                                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="6"
                                                                                    Padding="10">
                                                                                <Grid RowDefinitions="Auto,*">
                                                                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8" VerticalAlignment="Center">
                                                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                                            <materialIcons:MaterialIcon Kind="ImageOutline" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                                                            <TextBlock Text="Rendered Graphic" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                                                                        </StackPanel>
                                                                                        <Border Grid.Column="1" HorizontalAlignment="Left" Margin="8,0,0,0"
                                                                                                Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                                                                                CornerRadius="4" Padding="6,1">
                                                                                            <TextBlock Text="{Binding ImageDimensionsText}" FontSize="10" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                                                        </Border>
                                                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                                            <Button Command="{Binding CopyImageCommand}" Classes="cell-tool-btn" Width="24" Height="24" ToolTip.Tip="Copy Image">
                                                                                                <materialIcons:MaterialIcon Kind="ContentCopy" Width="12" Height="12" />
                                                                                            </Button>
                                                                                            <Button Command="{Binding SaveImageCommand}" Classes="cell-tool-btn" Width="24" Height="24" ToolTip.Tip="Save PNG">
                                                                                                <materialIcons:MaterialIcon Kind="DownloadOutline" Width="12" Height="12" />
                                                                                            </Button>
                                                                                        </StackPanel>
                                                                                    </Grid>
                                                                                    <Border Grid.Row="1"
                                                                                            Background="#080C11"
                                                                                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                                                            BorderThickness="1"
                                                                                            CornerRadius="4"
                                                                                            Padding="8"
                                                                                            HorizontalAlignment="Stretch">
                                                                                        <Image Source="{Binding ImageOutputBitmap}"
                                                                                               MaxHeight="450"
                                                                                               Stretch="Uniform"
                                                                                               HorizontalAlignment="Center"
                                                                                               VerticalAlignment="Center" />
                                                                                    </Border>
                                                                                </Grid>
                                                                            </Border>

                                                                            <!-- 5. Interactive Avalonia UI Control -->
                                                                            <Border IsVisible="{Binding HasInteractiveControl}"
                                                                                    Background="{DynamicResource M3SurfaceContainerLowBrush}"
                                                                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="6"
                                                                                    Padding="12,8">
                                                                                <Grid RowDefinitions="Auto,*">
                                                                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6" VerticalAlignment="Center">
                                                                                        <materialIcons:MaterialIcon Kind="ApplicationOutline" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                                                        <TextBlock Text="Interactive UI Widget" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                                                                    </StackPanel>
                                                                                    <ContentControl Grid.Row="1" Content="{Binding InteractiveControl}" HorizontalAlignment="Stretch" />
                                                                                </Grid>
                                                                            </Border>

                                                                            <!-- 5b. Interactive Control Placeholder -->
                                                                            <Border IsVisible="{Binding InteractiveControlPlaceholderVisible}"
                                                                                    Background="{DynamicResource M3SurfaceContainerLowBrush}"
                                                                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="6"
                                                                                    Padding="12,10">
                                                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                                    <materialIcons:MaterialIcon Kind="ReloadAlert" Width="16" Height="16" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                                                    <TextBlock Text="Interactive widget / animation not restored — re-run this cell to bring it back."
                                                                                               FontSize="11.5"
                                                                                               FontStyle="Italic"
                                                                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                                                               TextWrapping="Wrap" />
                                                                                </StackPanel>
                                                                            </Border>

                                                                            <!-- 6. HTML / Markdown Rich Output -->
                                                                            <Border IsVisible="{Binding HasHtmlContent}"
                                                                                    Background="{DynamicResource M3SurfaceContainerLowBrush}"
                                                                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="6"
                                                                                    Padding="12,8">
                                                                                <Grid RowDefinitions="Auto,*">
                                                                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6" VerticalAlignment="Center">
                                                                                        <materialIcons:MaterialIcon Kind="LanguageHtml5" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                                                        <TextBlock Text="HTML / Markdown Output" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                                                                    </StackPanel>
                                                                                    <views:RichHtmlView Grid.Row="1" DataContext="{Binding HtmlContent}" />
                                                                                    </Grid>
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </ScrollViewer>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>

                                            <!-- Between-Cell Interactive Insertion Divider -->
                                            <Border Classes="cell-insert-divider">
                                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                    <Rectangle Classes="divider-line" Height="1" Fill="{DynamicResource M3OutlineVariantBrush}" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                                                    <StackPanel Classes="insert-pill-group" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Button Command="{Binding $parent[UserControl].((vm:CSharpNotebookStudioViewModel)DataContext).InsertCodeCellAfterCommand}"
                                                                CommandParameter="{Binding}"
                                                                Classes="insert-cell-pill" ToolTip.Tip="Insert Code Cell Below">
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <materialIcons:MaterialIcon Kind="Plus" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                                <TextBlock Text="Code" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Command="{Binding $parent[UserControl].((vm:CSharpNotebookStudioViewModel)DataContext).InsertMarkdownCellAfterCommand}"
                                                                CommandParameter="{Binding}"
                                                                Classes="insert-cell-pill" ToolTip.Tip="Insert Markdown Cell Below">
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <materialIcons:MaterialIcon Kind="Plus" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                                <TextBlock Text="Markdown" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>
                    </Grid>

                <!-- 2. Empty State (Visible when HasNoTabs) -->
                <Border IsVisible="{Binding HasNoTabs}"
                        Background="{DynamicResource M3SurfaceBrush}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="440">
                        <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource M3SurfaceContainerHighBrush}" HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="NotebookOutline" Width="32" Height="32" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="No Open Notebooks" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Open a notebook from the Explorer sidebar or click below to create a new notebook."
                                       FontSize="12.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Button Command="{Binding NewNotebookTabCommand}"
                                Background="{DynamicResource M3PrimaryBrush}"
                                Foreground="{DynamicResource M3OnPrimaryBrush}"
                                CornerRadius="9999"
                                Height="34"
                                Padding="18,0"
                                HorizontalAlignment="Center"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Plus" Width="15" Height="15" Foreground="{DynamicResource M3OnPrimaryBrush}" />
                                <TextBlock Text="New Notebook" FontSize="12.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>

        <!-- ============================================================ -->
        <!-- ROW 1: STATUS BAR FOOTER                                     -->
        <!-- ============================================================ -->
        <Border Grid.Row="1"
                Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                BorderThickness="0,1,0,0"
                Height="24"
                Padding="12,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left: Kernel status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource M3SuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CompilerStatusText}" FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: Metadata & Kernel Indicator -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Cells.Count, StringFormat='{}Cell {0}'}" FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding KernelName}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource M3SuccessBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- QUICK OPEN & COMMAND PALETTE OVERLAY MODAL                   -->
        <!-- ============================================================ -->
        <controls:QuickOpenOverlayControl DataContext="{Binding QuickOpen}"
                                          Grid.RowSpan="2"
                                          ZIndex="999"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" />
    </Grid>
</UserControl>
