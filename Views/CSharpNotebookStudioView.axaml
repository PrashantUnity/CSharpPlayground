<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             xmlns:views="using:PdfEditorApp.Plugins.CSharpEditor.Views"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="850"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Views.CSharpNotebookStudioView"
             x:DataType="vm:CSharpNotebookStudioViewModel">

    <UserControl.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="M3SurfaceBrush" Color="#0D1117" />
            <SolidColorBrush x:Key="M3SurfaceContainerLowestBrush" Color="#080C11" />
            <SolidColorBrush x:Key="M3SurfaceContainerLowBrush" Color="#121720" />
            <SolidColorBrush x:Key="M3SurfaceContainerBrush" Color="#171D27" />
            <SolidColorBrush x:Key="M3SurfaceContainerHighBrush" Color="#1E2633" />
            <SolidColorBrush x:Key="M3SurfaceContainerHighestBrush" Color="#263142" />
            <SolidColorBrush x:Key="M3PrimaryBrush" Color="#75D59A" />
            <SolidColorBrush x:Key="M3OnPrimaryBrush" Color="#00391C" />
            <SolidColorBrush x:Key="M3PrimaryContainerBrush" Color="#00522B" />
            <SolidColorBrush x:Key="M3OnPrimaryContainerBrush" Color="#92F2B5" />
            <SolidColorBrush x:Key="M3SecondaryContainerBrush" Color="#22304A" />
            <SolidColorBrush x:Key="M3OnSecondaryContainerBrush" Color="#D3E3FD" />
            <SolidColorBrush x:Key="M3OnSurfaceBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="M3OnSurfaceVariantBrush" Color="#94A3B8" />
            <SolidColorBrush x:Key="M3OutlineBrush" Color="#475569" />
            <SolidColorBrush x:Key="M3OutlineVariantBrush" Color="#252E3E" />
            <SolidColorBrush x:Key="M3SuccessBrush" Color="#22C55E" />
            <SolidColorBrush x:Key="M3ErrorBrush" Color="#F87171" />
            <SolidColorBrush x:Key="M3ErrorContainerBrush" Color="#450A0A" />
            <CornerRadius x:Key="M3ShapeCornerFull">9999</CornerRadius>
            <CornerRadius x:Key="M3ShapeCornerMedium">12</CornerRadius>
            <CornerRadius x:Key="M3ShapeCornerSmall">8</CornerRadius>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <!-- Explorer Tree Item Button -->
        <Style Selector="Button.explorer-item-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.explorer-item-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        </Style>
        <Style Selector="Button.explorer-item-btn.selected">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        </Style>

        <!-- Explorer Section Header Button -->
        <Style Selector="Button.explorer-section-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.explorer-section-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        </Style>

        <!-- Notebook Toolbar Action Buttons -->
        <Style Selector="Button.nb-action-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nb-action-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3PrimaryBrush}" />
        </Style>
        <Style Selector="Button.nb-action-btn:pointerover materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource M3PrimaryBrush}" />
        </Style>

        <!-- Cell Hover Action Icons -->
        <Style Selector="Button.cell-tool-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
        </Style>
        <Style Selector="Button.cell-tool-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        </Style>
        <Style Selector="Button.cell-tool-btn.delete-tool:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3ErrorContainerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3ErrorBrush}" />
        </Style>
        <Style Selector="Button.cell-tool-btn.delete-tool:pointerover materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource M3ErrorBrush}" />
        </Style>

        <!-- Gutter Run Play Button -->
        <Style Selector="Button.gutter-run-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Button.gutter-run-btn:pointerover">
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        </Style>

        <!-- Gutter Menu Button -->
        <Style Selector="Button.gutter-menu-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="18" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Button.gutter-menu-btn:pointerover">
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        </Style>

        <!-- Editor Box Border Focus / Selection -->
        <Style Selector="Border.notebook-editor-box">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowestBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.notebook-editor-box:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto" Background="{DynamicResource M3SurfaceBrush}">

        <!-- ============================================================ -->
        <!-- ROW 0: MAIN WORKSPACE (EXPLORER SIDEBAR + SPLITTER + STUDIO) -->
        <!-- ============================================================ -->
        <Grid Grid.Row="0" ColumnDefinitions="240,1,*">

            <!-- ======================================================== -->
            <!-- COLUMN 0: LEFT EXPLORER SIDEBAR                          -->
            <!-- ======================================================== -->
            <Border Grid.Column="0"
                    IsVisible="{Binding IsExplorerOpen}"
                    Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,Auto,*">

                    <!-- 1. Top Header: EXPLORER ... -->
                    <Border Grid.Row="0"
                            Height="36"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,0,8,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="EXPLORER"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Classes="cell-tool-btn"
                                    Width="22" Height="22"
                                    ToolTip.Tip="Explorer Options">
                                <TextBlock Text="..." FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 2. Workspace Root Row: ⌵ SKIASHARP + 5 Actions -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource M3SurfaceContainerLowBrush}"
                            Height="28"
                            Padding="10,0,6,0">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button Grid.Column="0"
                                    Command="{Binding ToggleWorkspaceExpandCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Cursor="Hand"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding WorkspaceExpansionArrow}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding WorkspaceName}"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Hover / Action Buttons -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <Button Command="{Binding NewFileCommand}" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="New Notebook (.frynb)">
                                    <materialIcons:MaterialIcon Kind="FilePlusOutline" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                                <Button Command="{Binding NewFolderCommand}" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="New Folder">
                                    <materialIcons:MaterialIcon Kind="FolderPlusOutline" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                                <Button Command="{Binding DeleteSelectedExplorerItemCommand}" Classes="cell-tool-btn delete-tool" Width="20" Height="20" ToolTip.Tip="Delete Selected Item">
                                    <materialIcons:MaterialIcon Kind="DeleteOutline" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                                <Button Command="{Binding RefreshExplorerCommand}" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="Refresh Explorer">
                                    <materialIcons:MaterialIcon Kind="Refresh" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                                <Button Command="{Binding CollapseAllExplorerCommand}" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="Collapse Folders">
                                    <materialIcons:MaterialIcon Kind="ArrowCollapseVertical" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 3. Folder & File Tree View -->
                    <ScrollViewer Grid.Row="2"
                                  IsVisible="{Binding IsWorkspaceExpanded}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ExplorerRootItems}" Margin="4,4,4,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExplorerItemViewModel">
                                    <StackPanel>
                                        <!-- Root Item Row (e.g. assets, Code, docs, etc.) -->
                                        <Button Command="{Binding ToggleExpandCommand}"
                                                Classes="explorer-item-btn"
                                                Classes.selected="{Binding IsSelected}"
                                                HorizontalAlignment="Stretch">
                                            <Button.ContextFlyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                                    <MenuItem Header="New File Here" Command="{Binding RequestNewFileCommand}" IsVisible="{Binding IsDirectory}">
                                                        <MenuItem.Icon>
                                                            <materialIcons:MaterialIcon Kind="FilePlusOutline" Width="14" Height="14" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="New Folder Here" Command="{Binding RequestNewFolderCommand}" IsVisible="{Binding IsDirectory}">
                                                        <MenuItem.Icon>
                                                            <materialIcons:MaterialIcon Kind="FolderPlusOutline" Width="14" Height="14" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator IsVisible="{Binding IsDirectory}" />
                                                    <MenuItem Header="Rename" Command="{Binding StartRenameCommand}">
                                                        <MenuItem.Icon>
                                                            <materialIcons:MaterialIcon Kind="RenameOutline" Width="14" Height="14" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Delete" Command="{Binding RequestDeleteCommand}">
                                                        <MenuItem.Icon>
                                                            <materialIcons:MaterialIcon Kind="DeleteOutline" Width="14" Height="14" Foreground="{DynamicResource M3ErrorBrush}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </MenuFlyout>
                                            </Button.ContextFlyout>
                                            <Grid ColumnDefinitions="14,18,*,Auto" Margin="4,0">
                                                <!-- Arrow -->
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding ExpansionArrow}"
                                                           FontSize="9.5"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center" />
                                                <!-- Icon -->
                                                <materialIcons:MaterialIcon Grid.Column="1"
                                                                            Kind="{Binding IconKind}"
                                                                            Width="14"
                                                                            Height="14"
                                                                            Foreground="{Binding IconColor}"
                                                                            VerticalAlignment="Center" />
                                                <!-- Name (Normal View) -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Name}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource M3OnSurfaceBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="6,0,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding !IsRenaming}" />

                                                <!-- Rename TextBox (Edit View) -->
                                                <TextBox Grid.Column="2"
                                                         Text="{Binding EditName, Mode=TwoWay}"
                                                         FontSize="11.5"
                                                         Height="22"
                                                         Padding="4,1"
                                                         Margin="4,0,0,0"
                                                         IsVisible="{Binding IsRenaming}"
                                                         VerticalAlignment="Center" />

                                                <!-- Hover Action Buttons: Delete -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                    <Button Command="{Binding RequestDeleteCommand}"
                                                            Classes="cell-tool-btn delete-tool"
                                                            Width="18" Height="18"
                                                            ToolTip.Tip="Delete">
                                                        <materialIcons:MaterialIcon Kind="DeleteOutline" Width="12" Height="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <!-- Nested Children (e.g. Document Automation Notebook.frynb under Code) -->
                                        <ItemsControl ItemsSource="{Binding Children}"
                                                      IsVisible="{Binding IsExpanded}"
                                                      Margin="14,0,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ExplorerItemViewModel">
                                                    <Button Command="{Binding SelectCommand}"
                                                            Classes="explorer-item-btn"
                                                            Classes.selected="{Binding IsSelected}"
                                                            HorizontalAlignment="Stretch">
                                                        <Button.ContextFlyout>
                                                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                                                <MenuItem Header="Rename" Command="{Binding StartRenameCommand}">
                                                                    <MenuItem.Icon>
                                                                        <materialIcons:MaterialIcon Kind="RenameOutline" Width="14" Height="14" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="Delete" Command="{Binding RequestDeleteCommand}">
                                                                    <MenuItem.Icon>
                                                                        <materialIcons:MaterialIcon Kind="DeleteOutline" Width="14" Height="14" Foreground="{DynamicResource M3ErrorBrush}" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                            </MenuFlyout>
                                                        </Button.ContextFlyout>
                                                        <Grid ColumnDefinitions="14,18,*,Auto" Margin="4,0">
                                                            <!-- Arrow (blank for files) -->
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding ExpansionArrow}"
                                                                       FontSize="9.5"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Center" />
                                                            <!-- File Icon (e.g. Orange Notebook) -->
                                                            <materialIcons:MaterialIcon Grid.Column="1"
                                                                                        Kind="{Binding IconKind}"
                                                                                        Width="14"
                                                                                        Height="14"
                                                                                        Foreground="{Binding IconColor}"
                                                                                        VerticalAlignment="Center" />
                                                            <!-- File Name (Normal View) -->
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding Name}"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource M3OnSurfaceBrush}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="6,0,0,0"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       IsVisible="{Binding !IsRenaming}" />

                                                            <!-- Rename TextBox (Edit View) -->
                                                            <TextBox Grid.Column="2"
                                                                     Text="{Binding EditName, Mode=TwoWay}"
                                                                     FontSize="11.5"
                                                                     Height="22"
                                                                     Padding="4,1"
                                                                     Margin="4,0,0,0"
                                                                     IsVisible="{Binding IsRenaming}"
                                                                     VerticalAlignment="Center" />

                                                            <!-- Hover Action Buttons: Delete -->
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                                <Button Command="{Binding RequestDeleteCommand}"
                                                                        Classes="cell-tool-btn delete-tool"
                                                                        Width="18" Height="18"
                                                                        ToolTip.Tip="Delete">
                                                                    <materialIcons:MaterialIcon Kind="DeleteOutline" Width="12" Height="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ======================================================== -->
            <!-- COLUMN 1: VERTICAL GRID SPLITTER                         -->
            <!-- ======================================================== -->
            <GridSplitter Grid.Column="1"
                          Width="1"
                          Background="{DynamicResource M3OutlineVariantBrush}"
                          ResizeDirection="Columns"
                          Cursor="SizeWestEast"
                          IsVisible="{Binding IsExplorerOpen}" />

            <!-- ======================================================== -->
            <!-- COLUMN 2: MAIN NOTEBOOK STUDIO CANVAS                    -->
            <!-- ======================================================== -->
            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">

                <!-- ==================================================== -->
                <!-- ROW 0: DOCUMENT TAB BAR                              -->
                <!-- ==================================================== -->
                <Border Grid.Row="0"
                        Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                        BorderThickness="0,0,0,1"
                        Height="36"
                        Padding="10,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Left: Notebook Tab -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Background="{DynamicResource M3SurfaceContainerLowBrush}"
                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                    BorderThickness="1,1,1,0"
                                    CornerRadius="6,6,0,0"
                                    Height="31"
                                    Padding="12,0"
                                    VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <!-- Orange Jupyter / Notebook Icon -->
                                    <materialIcons:MaterialIcon Kind="NotebookOutline" Width="14" Height="14" Foreground="#D97706" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DocumentTabTitle}"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}"
                                               VerticalAlignment="Center" />
                                    <!-- Close Tab Action -->
                                    <Button Command="{Binding BackToHubCommand}"
                                            Classes="cell-tool-btn"
                                            Width="18" Height="18"
                                            Margin="4,0,0,0"
                                            ToolTip.Tip="Close Notebook (Return to Hub)">
                                        <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right: Actions (Settings, Split, Menu, Hub) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Classes="cell-tool-btn" Width="24" Height="24" ToolTip.Tip="Settings">
                                <materialIcons:MaterialIcon Kind="CogOutline" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </Button>
                            <Button Classes="cell-tool-btn" Width="24" Height="24" ToolTip.Tip="Split Editor Right">
                                <materialIcons:MaterialIcon Kind="DockRight" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </Button>
                            <Button Classes="cell-tool-btn" Width="24" Height="24" ToolTip.Tip="More Editor Actions">
                                <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </Button>
                            <Rectangle Width="1" Height="14" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="2,0" />
                            <Button Command="{Binding BackToHubCommand}"
                                    Classes="nb-action-btn"
                                    ToolTip.Tip="Return to Scripts &amp; Notebooks Hub">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="ArrowLeft" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    <TextBlock Text="Hub" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================================================== -->
                <!-- ROW 1: BREADCRUMBS & NOTEBOOK ACTIONS TOOLBAR        -->
                <!-- ==================================================== -->
                <Border Grid.Row="1"
                        Background="{DynamicResource M3SurfaceContainerLowBrush}"
                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,6">
                    <Grid RowDefinitions="Auto,Auto">
                        <!-- Breadcrumbs: Code > codefrydev.ipynb > C# ... -->
                        <TextBlock Grid.Row="0"
                                   Text="{Binding BreadcrumbText}"
                                   FontSize="11.5"
                                   FontFamily="Consolas, Menlo, Cascadia Code, Inter, monospace"
                                   Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                   Margin="0,0,0,6"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Notebook Action Bar (+ Code, + Markdown, Colab, Run All, Restart, Clear All Outputs, Outline, Kernel) -->
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
                            <!-- Left: Core Notebook Actions -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <!-- + Code -->
                                <Button Command="{Binding AddCodeCellCommand}" Classes="nb-action-btn" ToolTip.Tip="Add Code Cell (Ctrl+Shift+Enter)">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Plus" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                        <TextBlock Text="Code" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>

                                <!-- + Markdown -->
                                <Button Command="{Binding AddMarkdownCellCommand}" Classes="nb-action-btn" ToolTip.Tip="Add Markdown Cell">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Plus" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                        <TextBlock Text="Markdown" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <Rectangle Width="1" Height="16" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="4,0" />

                                <!-- Colab Link / Mode -->
                                <Button Classes="nb-action-btn" ToolTip.Tip="Open or Sync with Google Colab / Remote">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Infinity" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                        <TextBlock Text="Colab" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <Rectangle Width="1" Height="16" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="4,0" />

                                <!-- Run All -->
                                <Button Command="{Binding RunAllCellsCommand}" IsEnabled="{Binding !IsExecuting}" Classes="nb-action-btn" ToolTip.Tip="Run All Cells (Linear Sequence)">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Play" Width="13" Height="13" Foreground="{DynamicResource M3SuccessBrush}" />
                                        <TextBlock Text="Run All" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <!-- Restart Kernel -->
                                <Button Command="{Binding RestartKernelCommand}" Classes="nb-action-btn" ToolTip.Tip="Restart Kernel &amp; Reset Variables">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Restart" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                        <TextBlock Text="Restart" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <!-- Clear All Outputs -->
                                <Button Command="{Binding ClearAllOutputsCommand}" Classes="nb-action-btn" ToolTip.Tip="Clear All Cell Outputs">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="CloseBoxOutline" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                        <TextBlock Text="Clear All Outputs" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <Rectangle Width="1" Height="16" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="4,0" />

                                <!-- Outline Toggle -->
                                <Button Command="{Binding ToggleOutlineCommand}" Classes="nb-action-btn" ToolTip.Tip="Toggle Notebook Outline">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="FormatListBulleted" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                        <TextBlock Text="Outline" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <!-- Variables Toggle -->
                                <Button Command="{Binding ToggleVariableInspectorCommand}" Classes="nb-action-btn" ToolTip.Tip="Toggle Live Variable Inspector">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="CodeBraces" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                        <TextBlock Text="Variables" FontSize="12" />
                                        <Border Background="{DynamicResource M3PrimaryBrush}" CornerRadius="9" Padding="4,0" Margin="2,0,0,0">
                                            <TextBlock Text="{Binding Variables.Count}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource M3OnPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Button>

                                <!-- Save -->
                                <Button Command="{Binding SaveCommand}" Classes="nb-action-btn" ToolTip.Tip="Save Notebook (Ctrl+S)">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                        <TextBlock Text="Save" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Right: Kernel Indicator Badge (.NET (C#)) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Height="26"
                                        Padding="8,0"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="FlaskOutline" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding KernelName}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource M3OnSurfaceBrush}"
                                                   VerticalAlignment="Center" />
                                        <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource M3SuccessBrush}" VerticalAlignment="Center" Margin="2,0,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ==================================================== -->
                <!-- ROW 2: MAIN NOTEBOOK CANVAS                          -->
                <!-- ==================================================== -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto">

                    <!-- Notebook Canvas ScrollViewer -->
                    <ScrollViewer Grid.Column="0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" Margin="24,20,24,48" HorizontalAlignment="Stretch">

                            <!-- Cells List -->
                            <ItemsControl ItemsSource="{Binding Cells}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NotebookCellViewModel">
                                        <!-- 2-Column IDE Cell Layout: Col 0 = Gutter, Col 1 = Editor & Output -->
                                        <Grid ColumnDefinitions="56,*" Margin="0,0,0,18">

                                            <!-- ======================================== -->
                                            <!-- COLUMN 0: LEFT GUTTER                    -->
                                            <!-- ======================================== -->
                                            <StackPanel Grid.Column="0" Spacing="4" HorizontalAlignment="Right" Margin="0,2,10,0">
                                                <!-- Execution Count: [1], [2], [*] -->
                                                <TextBlock Text="{Binding ExecutionBadgeText}"
                                                           FontFamily="Consolas, Menlo, Monaco, Cascadia Code, monospace"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding StatusBadgeForeground}"
                                                           HorizontalAlignment="Right"
                                                           IsVisible="{Binding IsCodeCell}" />

                                                <!-- Execution Duration / Success Pill: ✓ 0.7s -->
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="3"
                                                            HorizontalAlignment="Right"
                                                            IsVisible="{Binding ExecutionDurationShortText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <!-- Green Checkmark on success -->
                                                    <materialIcons:MaterialIcon Kind="Check" Width="12" Height="12" Foreground="{DynamicResource M3SuccessBrush}" IsVisible="{Binding !HasError}" VerticalAlignment="Center" />
                                                    <!-- Red Cross on error -->
                                                    <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="{DynamicResource M3ErrorBrush}" IsVisible="{Binding HasError}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ExecutionDurationShortText}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Play / Run Cell Gutter Button -->
                                                <Button Command="{Binding RunCellCommand}"
                                                        Classes="gutter-run-btn"
                                                        HorizontalAlignment="Right"
                                                        IsVisible="{Binding IsCodeCell}"
                                                        ToolTip.Tip="Execute Cell (Ctrl+Enter)">
                                                    <materialIcons:MaterialIcon Kind="Play" Width="12" Height="12" Foreground="{DynamicResource M3SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Button>

                                                <!-- Cell Context Actions Ellipsis (...) -->
                                                <Button Classes="gutter-menu-btn"
                                                        HorizontalAlignment="Right"
                                                        ToolTip.Tip="Cell Options">
                                                    <Button.Flyout>
                                                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                                            <MenuItem Header="Run Cell" Command="{Binding RunCellCommand}" IsVisible="{Binding IsCodeCell}">
                                                                <MenuItem.Icon>
                                                                    <materialIcons:MaterialIcon Kind="Play" Width="14" Height="14" Foreground="{DynamicResource M3SuccessBrush}" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Clear Output" Command="{Binding ClearOutputCommand}">
                                                                <MenuItem.Icon>
                                                                    <materialIcons:MaterialIcon Kind="DeleteSweepOutline" Width="14" Height="14" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator />
                                                            <MenuItem Header="Insert Code Below" Command="{Binding AddCodeBelowCommand}">
                                                                <MenuItem.Icon>
                                                                    <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Insert Markdown Below" Command="{Binding AddMarkdownBelowCommand}">
                                                                <MenuItem.Icon>
                                                                    <materialIcons:MaterialIcon Kind="FormatHeaderPound" Width="14" Height="14" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator />
                                                            <MenuItem Header="Move Up" Command="{Binding MoveUpCommand}">
                                                                <MenuItem.Icon>
                                                                    <materialIcons:MaterialIcon Kind="ArrowUp" Width="14" Height="14" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Move Down" Command="{Binding MoveDownCommand}">
                                                                <MenuItem.Icon>
                                                                    <materialIcons:MaterialIcon Kind="ArrowDown" Width="14" Height="14" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator />
                                                            <MenuItem Header="Delete Cell" Command="{Binding DeleteCommand}">
                                                                <MenuItem.Icon>
                                                                    <materialIcons:MaterialIcon Kind="DeleteOutline" Width="14" Height="14" Foreground="{DynamicResource M3ErrorBrush}" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                    <TextBlock Text="..." FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Button>
                                            </StackPanel>

                                            <!-- ======================================== -->
                                            <!-- COLUMN 1: CELL EDITOR & INLINE OUTPUT    -->
                                            <!-- ======================================== -->
                                            <StackPanel Grid.Column="1" Spacing="6">

                                                <!-- Code / Markdown Editor Box with Floating Action Bar -->
                                                <Border Classes="notebook-editor-box">
                                                    <Grid RowDefinitions="Auto,*,Auto">

                                                        <!-- Floating Action Bar (Top Right) -->
                                                        <StackPanel Grid.Row="0"
                                                                    Orientation="Horizontal"
                                                                    HorizontalAlignment="Right"
                                                                    Spacing="2"
                                                                    Margin="0,4,6,0">
                                                            <!-- Run Action -->
                                                            <Button Command="{Binding RunCellCommand}"
                                                                    Classes="cell-tool-btn"
                                                                    IsVisible="{Binding IsCodeCell}"
                                                                    ToolTip.Tip="Execute Cell (Ctrl+Enter)">
                                                                <materialIcons:MaterialIcon Kind="Play" Width="13" Height="13" Foreground="{DynamicResource M3SuccessBrush}" />
                                                            </Button>

                                                            <!-- Split / Add Below -->
                                                            <Button Command="{Binding AddCodeBelowCommand}"
                                                                    Classes="cell-tool-btn"
                                                                    ToolTip.Tip="Insert Code Cell Below">
                                                                <materialIcons:MaterialIcon Kind="Plus" Width="13" Height="13" />
                                                            </Button>

                                                            <!-- Move Up -->
                                                            <Button Command="{Binding MoveUpCommand}"
                                                                    Classes="cell-tool-btn"
                                                                    ToolTip.Tip="Move Cell Up">
                                                                <materialIcons:MaterialIcon Kind="ArrowUp" Width="13" Height="13" />
                                                            </Button>

                                                            <!-- Move Down -->
                                                            <Button Command="{Binding MoveDownCommand}"
                                                                    Classes="cell-tool-btn"
                                                                    ToolTip.Tip="Move Cell Down">
                                                                <materialIcons:MaterialIcon Kind="ArrowDown" Width="13" Height="13" />
                                                            </Button>

                                                            <!-- Delete Cell -->
                                                            <Button Command="{Binding DeleteCommand}"
                                                                    Classes="cell-tool-btn delete-tool"
                                                                    ToolTip.Tip="Delete Cell">
                                                                <materialIcons:MaterialIcon Kind="DeleteOutline" Width="13" Height="13" />
                                                            </Button>
                                                        </StackPanel>

                                                        <!-- Editor Content (Code or Markdown) -->
                                                        <Panel Grid.Row="1" Margin="6,2,6,4">
                                                            <!-- C# Syntax Highlighted Code Editor -->
                                                            <controls:BindableTextEditor IsVisible="{Binding IsCodeCell}"
                                                                                         TextContent="{Binding Source, Mode=TwoWay}"
                                                                                         ExecuteCommand="{Binding RunCellCommand}"
                                                                                         MinHeight="60"
                                                                                         FontSize="13" />

                                                            <!-- Markdown View (Rendered Header & Notes) -->
                                                            <StackPanel IsVisible="{Binding IsViewingMarkdown}" Spacing="6" Margin="10,6">
                                                                <TextBlock Text="{Binding MarkdownTitle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                                                <TextBlock Text="{Binding MarkdownBody}" FontSize="12.5" LineHeight="19" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                                                            </StackPanel>

                                                            <!-- Markdown Edit Mode -->
                                                            <TextBox IsVisible="{Binding IsEditingMarkdown}"
                                                                     Text="{Binding Source, Mode=TwoWay}"
                                                                     AcceptsReturn="True"
                                                                     AcceptsTab="True"
                                                                     Background="Transparent"
                                                                     BorderThickness="0"
                                                                     MinHeight="60"
                                                                     FontSize="13"
                                                                     Foreground="{DynamicResource M3OnSurfaceBrush}"
                                                                     PlaceholderText="Write markdown documentation (# Header, notes)..."
                                                                     TextWrapping="Wrap" />
                                                        </Panel>

                                                        <!-- Bottom Bar: Language Tag Chip (Bottom Right, e.g. "C#") -->
                                                        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="10,0,10,6">
                                                            <!-- Left: Markdown toggle button (if markdown cell) -->
                                                            <Button Grid.Column="0"
                                                                    Command="{Binding ToggleMarkdownPreviewCommand}"
                                                                    Classes="cell-tool-btn"
                                                                    Width="NaN"
                                                                    Height="20"
                                                                    Padding="6,0"
                                                                    IsVisible="{Binding IsMarkdownCell}">
                                                                <TextBlock Text="{Binding MarkdownPreviewButtonText}" FontSize="10" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                            </Button>

                                                            <!-- Right: Language Chip (C# / Markdown) -->
                                                            <Border Grid.Column="2"
                                                                    Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="3"
                                                                    Padding="6,1">
                                                                <TextBlock Text="{Binding LanguageTag}"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                            </Border>
                                                        </Grid>
                                                    </Grid>
                                                </Border>

                                                <!-- ============================================================ -->
                                                <!-- INLINE OUTPUT STREAM (Directly underneath, flush with editor) -->
                                                <!-- ============================================================ -->
                                                <StackPanel Spacing="6" Margin="0,3,0,0" IsVisible="{Binding HasOutput}">

                                                    <!-- 1. Interactive Object Inspector Tree (▼ Submission#16+People) -->
                                                    <Border IsVisible="{Binding HasInspectorOutput}" Margin="0,1,0,3">
                                                        <views:ObjectInspectorView DataContext="{Binding InspectorNode}" />
                                                    </Border>

                                                    <!-- 2. Plain Console Stdout Text Output (e.g. test is test, [ 1, 3, 4, ... ]) -->
                                                    <TextBox Text="{Binding OutputText, Mode=OneWay}"
                                                             FontFamily="Consolas, Menlo, Monaco, Cascadia Code, monospace"
                                                             FontSize="12"
                                                             Foreground="{DynamicResource M3OnSurfaceBrush}"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             Padding="0"
                                                             IsReadOnly="True"
                                                             TextWrapping="Wrap"
                                                             IsVisible="{Binding OutputText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                                    <!-- 3. Tabular Output (.Dump()) -->
                                                    <Border IsVisible="{Binding HasTableOutput}">
                                                        <views:DumpTableView DataContext="{Binding TableResult}" />
                                                    </Border>

                                                    <!-- 4. Rendered Graphic / Image Output -->
                                                    <Border IsVisible="{Binding HasImageOutput}"
                                                            Background="{DynamicResource M3SurfaceContainerLowBrush}"
                                                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="10">
                                                        <Grid RowDefinitions="Auto,*">
                                                            <!-- Image Output Header -->
                                                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8" VerticalAlignment="Center">
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                    <materialIcons:MaterialIcon Kind="ImageOutline" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                                    <TextBlock Text="Rendered Graphic" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                                                </StackPanel>

                                                                <Border Grid.Column="1" HorizontalAlignment="Left" Margin="8,0,0,0"
                                                                        Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                                                        CornerRadius="4" Padding="6,1">
                                                                    <TextBlock Text="{Binding ImageDimensionsText}" FontSize="10" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                                </Border>

                                                                <!-- Image Actions: Copy & Save -->
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                    <Button Command="{Binding CopyImageCommand}" Classes="cell-tool-btn" Width="24" Height="24" ToolTip.Tip="Copy Image">
                                                                        <materialIcons:MaterialIcon Kind="ContentCopy" Width="12" Height="12" />
                                                                    </Button>
                                                                    <Button Command="{Binding SaveImageCommand}" Classes="cell-tool-btn" Width="24" Height="24" ToolTip.Tip="Save PNG">
                                                                        <materialIcons:MaterialIcon Kind="DownloadOutline" Width="12" Height="12" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- Image Canvas -->
                                                            <Border Grid.Row="1"
                                                                    Background="#080C11"
                                                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="8"
                                                                    HorizontalAlignment="Stretch">
                                                                <Image Source="{Binding ImageOutputBitmap}"
                                                                       MaxHeight="450"
                                                                       Stretch="Uniform"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <!-- 5. Interactive Avalonia UI Control -->
                                                    <Border IsVisible="{Binding HasInteractiveControl}"
                                                            Background="{DynamicResource M3SurfaceContainerLowBrush}"
                                                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="12,8">
                                                        <Grid RowDefinitions="Auto,*">
                                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6" VerticalAlignment="Center">
                                                                <materialIcons:MaterialIcon Kind="ApplicationOutline" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                                <TextBlock Text="Interactive UI Widget" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                                            </StackPanel>
                                                            <ContentControl Grid.Row="1" Content="{Binding InteractiveControl}" HorizontalAlignment="Stretch" />
                                                        </Grid>
                                                    </Border>

                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Collapsible Variable Inspector Drawer -->
                    <Border Grid.Column="1"
                            Width="320"
                            IsVisible="{Binding IsVariableInspectorOpen}"
                            Background="{DynamicResource M3SurfaceContainerLowBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1,0,0,0">
                        <Grid RowDefinitions="Auto,*">
                            <!-- Drawer Header -->
                            <Border Grid.Row="0"
                                    Background="{DynamicResource M3SurfaceContainerBrush}"
                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="CodeBraces" Width="15" Height="15" Foreground="{DynamicResource M3PrimaryBrush}" />
                                        <TextBlock Text="Live Variables" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Command="{Binding ToggleVariableInspectorCommand}"
                                            Classes="cell-tool-btn">
                                        <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Variables List -->
                            <ScrollViewer Grid.Row="1">
                                <ItemsControl ItemsSource="{Binding Variables}" Margin="8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:NotebookVariableInfo">
                                            <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,6"
                                                    Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                                        <TextBlock Text="{Binding TypeName}" FontSize="10" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ValueDisplay}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Collapsible Outline Drawer -->
                    <Border Grid.Column="1"
                            Width="280"
                            IsVisible="{Binding IsOutlineOpen}"
                            Background="{DynamicResource M3SurfaceContainerLowBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1,0,0,0">
                        <Grid RowDefinitions="Auto,*">
                            <!-- Drawer Header -->
                            <Border Grid.Row="0"
                                    Background="{DynamicResource M3SurfaceContainerBrush}"
                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="FormatListBulleted" Width="15" Height="15" Foreground="{DynamicResource M3PrimaryBrush}" />
                                        <TextBlock Text="Notebook Outline" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Command="{Binding ToggleOutlineCommand}"
                                            Classes="cell-tool-btn">
                                        <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Cells Outline Items -->
                            <ScrollViewer Grid.Row="1">
                                <ItemsControl ItemsSource="{Binding Cells}" Margin="8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NotebookCellViewModel">
                                            <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,6"
                                                    Margin="0,0,0,4">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Grid.Column="0" Text="{Binding ExecutionBadgeText}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource M3PrimaryBrush}" Margin="0,0,6,0" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding MarkdownTitle}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource M3OnSurfaceBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               IsVisible="{Binding IsMarkdownCell}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Source}"
                                                               FontSize="11"
                                                               FontFamily="Consolas, monospace"
                                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               IsVisible="{Binding IsCodeCell}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============================================================ -->
        <!-- ROW 1: STATUS BAR FOOTER                                     -->
        <!-- ============================================================ -->
        <Border Grid.Row="1"
                Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                BorderThickness="0,1,0,0"
                Height="24"
                Padding="12,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left: Launchpad, Error/Warning counts, Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="RocketLaunchOutline" Width="12" Height="12" Foreground="{DynamicResource M3PrimaryBrush}" />
                        <TextBlock Text="Launchpad" FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="12" Height="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                        <TextBlock Text="0" FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                        <materialIcons:MaterialIcon Kind="AlertOutline" Width="12" Height="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                        <TextBlock Text="0" FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource M3SuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CompilerStatusText}" FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: Metadata & Kernel Indicator -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Spaces: 4" FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Cells.Count, StringFormat='{}Cell {0}'}" FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="AccessPoint" Width="12" Height="12" Foreground="{DynamicResource M3PrimaryBrush}" />
                        <TextBlock Text="Go Live" FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="Check" Width="12" Height="12" Foreground="{DynamicResource M3SuccessBrush}" />
                        <TextBlock Text="Prettier" FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding KernelName}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource M3SuccessBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
