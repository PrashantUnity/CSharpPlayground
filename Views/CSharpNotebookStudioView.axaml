<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             xmlns:views="using:PdfEditorApp.Plugins.CSharpEditor.Views"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="850"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Views.CSharpNotebookStudioView"
             x:DataType="vm:CSharpNotebookStudioViewModel">

    <UserControl.Resources>
        <ResourceDictionary>
            <CornerRadius x:Key="M3ShapeCornerFull">9999</CornerRadius>
            <CornerRadius x:Key="M3ShapeCornerMedium">12</CornerRadius>
            <CornerRadius x:Key="M3ShapeCornerSmall">8</CornerRadius>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:ExplorerItemViewModel">
            <StackPanel>
                <!-- Tree Row Item -->
                <Button Command="{Binding ToggleExpandCommand}"
                        Classes="explorer-item-btn"
                        Classes.selected="{Binding IsSelected}"
                        HorizontalAlignment="Stretch">
                    <Button.ContextFlyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="Open" Command="{Binding SelectCommand}">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="FileEyeOutline" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="New Notebook Here" Command="{Binding RequestNewFileCommand}" IsVisible="{Binding IsDirectory}">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="FilePlusOutline" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="New Folder Here" Command="{Binding RequestNewFolderCommand}" IsVisible="{Binding IsDirectory}">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="FolderPlusOutline" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Rename" Command="{Binding StartRenameCommand}">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="RenameOutline" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Duplicate" Command="{Binding RequestDuplicateCommand}" IsVisible="{Binding !IsDirectory}">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Delete" Command="{Binding RequestDeleteCommand}">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="DeleteOutline" Width="14" Height="14" Foreground="{DynamicResource M3ErrorBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Copy Path" Command="{Binding RequestCopyPathCommand}">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </Button.ContextFlyout>
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="{Binding IndentPadding}">
                        <!-- Col 0: Chevron Expander for Folders (ChevronDown / ChevronRight) -->
                        <Border Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="{Binding ChevronKind}"
                                                        Width="12" Height="12"
                                                        Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        IsVisible="{Binding IsDirectory}" />
                        </Border>

                        <!-- Col 1: Icon (Folder / Notebook / C#) -->
                        <materialIcons:MaterialIcon Grid.Column="1"
                                                    Kind="{Binding IconKind}"
                                                    Width="15" Height="15"
                                                    Foreground="{Binding IconColor}"
                                                    VerticalAlignment="Center"
                                                    Margin="2,0,6,0" />

                        <!-- Col 2: Name (Normal View) -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Name}"
                                   FontSize="12"
                                   Foreground="{DynamicResource M3OnSurfaceBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding !IsRenaming}" />

                        <!-- Col 2: Rename TextBox (Edit View) -->
                        <TextBox Grid.Column="2"
                                 Text="{Binding EditName, Mode=TwoWay}"
                                 FontSize="11.5"
                                 Height="22"
                                 Padding="4,1"
                                 Margin="0,0,4,0"
                                 IsVisible="{Binding IsRenaming}"
                                 controls:FocusOnTrueBehavior.IsActive="{Binding IsRenaming}"
                                 VerticalAlignment="Center" />

                        <!-- Col 3: Action Buttons (Only visible on hover!) -->
                        <StackPanel Grid.Column="3"
                                    Classes="explorer-row-actions"
                                    Orientation="Horizontal"
                                    Spacing="2"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0">
                            <!-- Folder actions on hover -->
                            <Button Command="{Binding RequestNewFileCommand}"
                                    Classes="cell-tool-btn"
                                    Width="19" Height="19"
                                    ToolTip.Tip="New Notebook Here"
                                    IsVisible="{Binding IsDirectory}">
                                <materialIcons:MaterialIcon Kind="FilePlusOutline" Width="12" Height="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </Button>
                            <Button Command="{Binding RequestNewFolderCommand}"
                                    Classes="cell-tool-btn"
                                    Width="19" Height="19"
                                    ToolTip.Tip="New Folder Here"
                                    IsVisible="{Binding IsDirectory}">
                                <materialIcons:MaterialIcon Kind="FolderPlusOutline" Width="12" Height="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </Button>
                            <!-- File actions on hover -->
                            <Button Command="{Binding RequestDuplicateCommand}"
                                    Classes="cell-tool-btn"
                                    Width="19" Height="19"
                                    ToolTip.Tip="Duplicate Notebook"
                                    IsVisible="{Binding !IsDirectory}">
                                <materialIcons:MaterialIcon Kind="ContentCopy" Width="11" Height="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </Button>
                            <Button Command="{Binding RequestDeleteCommand}"
                                    Classes="cell-tool-btn delete-tool"
                                    Width="19" Height="19"
                                    ToolTip.Tip="Delete">
                                <materialIcons:MaterialIcon Kind="DeleteOutline" Width="12" Height="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Recursive Nested Children -->
                <ItemsControl ItemsSource="{Binding Children}"
                              IsVisible="{Binding IsExpanded}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Styles>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <!-- Explorer Tree Item Button -->
        <Style Selector="Button.explorer-item-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Height" Value="25" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.08" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.explorer-item-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowBrush}" />
        </Style>
        <Style Selector="Button.explorer-item-btn.selected">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
            <Setter Property="BorderBrush" Value="#E36C28" />
        </Style>

        <!-- Hover Action Buttons: Hidden by default, revealed on row hover -->
        <Style Selector="StackPanel.explorer-row-actions">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.explorer-item-btn:pointerover StackPanel.explorer-row-actions">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- Explorer Section Header Actions: Hidden by default, revealed on header hover -->
        <Style Selector="StackPanel.explorer-header-actions">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.explorer-section-header:pointerover StackPanel.explorer-header-actions">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- Explorer Section Header Button -->
        <Style Selector="Button.explorer-section-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.explorer-section-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        </Style>

        <!-- Document Studio Tab Item -->
        <Style Selector="Border.studio-tab-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="CornerRadius" Value="6,6,0,0" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.studio-tab-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        </Style>
        <Style Selector="Border.studio-tab-item.active">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
        </Style>
        <Style Selector="Border.studio-tab-item TextBlock.tab-title">
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Border.studio-tab-item.active TextBlock.tab-title">
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <!-- Notebook Toolbar Action Buttons -->
        <Style Selector="Button.nb-action-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nb-action-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3PrimaryBrush}" />
        </Style>
        <Style Selector="Button.nb-action-btn:pointerover materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource M3PrimaryBrush}" />
        </Style>

        <!-- Cell Hover Action Icons -->
        <Style Selector="Button.cell-tool-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
        </Style>
        <Style Selector="Button.cell-tool-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        </Style>
        <Style Selector="Button.cell-tool-btn.delete-tool:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3ErrorContainerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3ErrorBrush}" />
        </Style>
        <Style Selector="Button.cell-tool-btn.delete-tool:pointerover materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource M3ErrorBrush}" />
        </Style>

        <!-- Gutter Run Play Button -->
        <Style Selector="Button.gutter-run-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Button.gutter-run-btn:pointerover">
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        </Style>

        <!-- Gutter Menu Button -->
        <Style Selector="Button.gutter-menu-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="18" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Button.gutter-menu-btn:pointerover">
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        </Style>

        <!-- Editor Box Border Focus / Selection -->
        <Style Selector="Border.notebook-editor-box">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowestBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.notebook-editor-box:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineBrush}" />
        </Style>
        <Style Selector="Border.notebook-editor-box:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}" />
        </Style>

        <!-- Floating Cell Action Capsule (Pinned Top-Right) -->
        <Style Selector="Border.cell-floating-toolbar">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowestBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.notebook-editor-box:pointerover Border.cell-floating-toolbar">
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        </Style>
        <Style Selector="Border.notebook-editor-box:focus-within Border.cell-floating-toolbar">
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto" Background="{DynamicResource M3SurfaceBrush}">

        <!-- ============================================================ -->
        <!-- ROW 0: MAIN WORKSPACE (EXPLORER SIDEBAR + SPLITTER + STUDIO) -->
        <!-- ============================================================ -->
        <Grid Grid.Row="0" ColumnDefinitions="240,1,*">

            <!-- ======================================================== -->
            <!-- COLUMN 0: LEFT EXPLORER SIDEBAR                          -->
            <!-- ======================================================== -->
            <Border Grid.Column="0"
                    IsVisible="{Binding IsExplorerOpen}"
                    Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,Auto,*">

                    <!-- 1. Top Header: EXPLORER ... -->
                    <Border Grid.Row="0"
                            Height="36"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,0,8,0">
                        <TextBlock Text="EXPLORER"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- 2. Workspace Root Row: ▾ SKIASHARP + 4 Actions -->
                    <Border Grid.Row="1"
                            Classes="explorer-section-header"
                            Background="{DynamicResource M3SurfaceContainerLowBrush}"
                            Height="28"
                            Padding="10,0,6,0">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button Grid.Column="0"
                                    Command="{Binding ToggleWorkspaceExpandCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Cursor="Hand"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="ChevronDown" IsVisible="{Binding IsWorkspaceExpanded}" Width="12" Height="12" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                                    <materialIcons:MaterialIcon Kind="ChevronRight" IsVisible="{Binding !IsWorkspaceExpanded}" Width="12" Height="12" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding WorkspaceName}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Clean VS Code Header Actions -->
                            <StackPanel Grid.Column="2" Classes="explorer-header-actions" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <Button Command="{Binding NewFileCommand}" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="New Notebook (.frynb)">
                                    <materialIcons:MaterialIcon Kind="FilePlusOutline" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                                <Button Command="{Binding NewFolderCommand}" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="New Folder">
                                    <materialIcons:MaterialIcon Kind="FolderPlusOutline" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                                <Button Command="{Binding RefreshExplorerCommand}" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="Refresh Explorer">
                                    <materialIcons:MaterialIcon Kind="Refresh" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                                <Button Command="{Binding CollapseAllExplorerCommand}" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="Collapse Folders">
                                    <materialIcons:MaterialIcon Kind="ArrowCollapseVertical" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 3. Folder & File Tree View (Arbitrary recursive depth via ExplorerItemViewModel DataTemplate) -->
                    <ScrollViewer Grid.Row="2"
                                  IsVisible="{Binding IsWorkspaceExpanded}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ExplorerRootItems}" Margin="2,4,2,8" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ======================================================== -->
            <!-- COLUMN 1: VERTICAL GRID SPLITTER                         -->
            <!-- ======================================================== -->
            <GridSplitter Grid.Column="1"
                          Width="1"
                          Background="{DynamicResource M3OutlineVariantBrush}"
                          ResizeDirection="Columns"
                          Cursor="SizeWestEast"
                          IsVisible="{Binding IsExplorerOpen}" />

            <!-- ======================================================== -->
            <!-- COLUMN 2: MAIN NOTEBOOK STUDIO CANVAS                    -->
            <!-- ======================================================== -->
            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*">

                <!-- ==================================================== -->
                <!-- ROW 0: DOCUMENT TAB BAR (36px)                       -->
                <!-- ==================================================== -->
                <Border Grid.Row="0"
                        Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                        BorderThickness="0,0,0,1"
                        Height="36"
                        Padding="6,0,10,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- Left: Scrollable Tabs Strip -->
                        <ScrollViewer Grid.Column="0"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom">
                                <ItemsControl ItemsSource="{Binding Tabs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NotebookTabViewModel">
                                            <!-- Tab Item -->
                                            <Border Classes="studio-tab-item"
                                                    Classes.active="{Binding IsActive}"
                                                    Height="31"
                                                    VerticalAlignment="Bottom">
                                                <Grid RowDefinitions="2,*">
                                                    <!-- Top active accent line -->
                                                    <Border Grid.Row="0"
                                                            Height="2"
                                                            Background="#F59E0B"
                                                            IsVisible="{Binding IsActive}"
                                                            CornerRadius="2,2,0,0" />
                                                    <Button Grid.Row="1"
                                                            Command="{Binding SelectTabCommand}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="10,0,6,0"
                                                            Cursor="Hand"
                                                            VerticalAlignment="Stretch">
                                                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                            <!-- Orange Notebook Icon -->
                                                            <materialIcons:MaterialIcon Kind="{Binding IconKind}" Width="14" Height="14" Foreground="{Binding IconColor}" VerticalAlignment="Center" />
                                                            <!-- Tab Title -->
                                                            <TextBlock Classes="tab-title"
                                                                       Text="{Binding Title}"
                                                                       FontSize="12"
                                                                       VerticalAlignment="Center" />
                                                            <!-- Unsaved Dot Indicator -->
                                                            <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource M3PrimaryBrush}" IsVisible="{Binding IsModified}" VerticalAlignment="Center" />
                                                            <!-- Close Tab Button -->
                                                            <Button Command="{Binding CloseTabCommand}"
                                                                    Classes="cell-tool-btn"
                                                                    Width="18" Height="18"
                                                                    Margin="2,0,0,0"
                                                                    ToolTip.Tip="Close Tab">
                                                                <materialIcons:MaterialIcon Kind="Close" Width="11" Height="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- New Tab Button (+) -->
                                <Button Command="{Binding NewNotebookTabCommand}"
                                        Classes="cell-tool-btn"
                                        Width="24" Height="24"
                                        Margin="4,0,0,4"
                                        VerticalAlignment="Bottom"
                                        ToolTip.Tip="New Notebook (Ctrl+N)">
                                    <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Button>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Right: Actions (Hub) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Command="{Binding BackToHubCommand}"
                                    Classes="nb-action-btn"
                                    ToolTip.Tip="Return to Scripts &amp; Notebooks Hub">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="ArrowLeft" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    <TextBlock Text="Hub" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================================================== -->
                <!-- ROW 1: DEDICATED BREADCRUMB STRIP (26px)             -->
                <!-- ==================================================== -->
                <Border Grid.Row="1"
                        Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                        BorderThickness="0,0,0,1"
                        Height="26"
                        Padding="16,0">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" VerticalAlignment="Center">
                        <!-- Segment 1: Folder -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="FolderOutline" Width="13" Height="13" Foreground="#DDA764" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BreadcrumbFolder}" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Chevron 1 -->
                        <materialIcons:MaterialIcon Grid.Column="1" Kind="ChevronRight" Width="12" Height="12" Foreground="{DynamicResource M3OutlineBrush}" VerticalAlignment="Center" Margin="5,0" />

                        <!-- Segment 2: Document -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="{Binding ActiveTab.IconKind}" Width="13" Height="13" Foreground="{Binding ActiveTab.IconColor}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BreadcrumbDocument}" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Chevron 2 -->
                        <materialIcons:MaterialIcon Grid.Column="3" Kind="ChevronRight" Width="12" Height="12" Foreground="{DynamicResource M3OutlineBrush}" VerticalAlignment="Center" Margin="5,0" />

                        <!-- Segment 3: Active Cell Chip -->
                        <Border Grid.Column="4"
                                Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,1"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="{Binding ActiveCellTypeIcon}" Width="11" Height="11" Foreground="{Binding ActiveCellTypeColor}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveCellBadgeText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource M3OnSurfaceBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="400" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ==================================================== -->
                <!-- ROW 2: PROFESSIONAL ACTION TOOLBAR (38px)            -->
                <!-- ==================================================== -->
                <Border Grid.Row="2"
                        Background="{DynamicResource M3SurfaceContainerLowBrush}"
                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                        BorderThickness="0,0,0,1"
                        Height="38"
                        Padding="14,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Left: Core Actions -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <!-- Segmented Pill for Cell Creation (+ Code & + Markdown) -->
                            <Border Background="{DynamicResource M3SurfaceContainerBrush}"
                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="2"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <!-- + Code -->
                                    <Button Command="{Binding AddCodeCellCommand}" Classes="nb-action-btn" Height="26" Padding="8,0" ToolTip.Tip="Add Code Cell (Ctrl+Shift+Enter)">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Plus" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="Code" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- + Markdown -->
                                    <Button Command="{Binding AddMarkdownCellCommand}" Classes="nb-action-btn" Height="26" Padding="8,0" ToolTip.Tip="Add Markdown Cell">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Plus" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="Markdown" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Rectangle Width="1" Height="18" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="6,0" VerticalAlignment="Center" />

                            <!-- Run All -->
                            <Button Command="{Binding RunAllCellsCommand}" IsEnabled="{Binding !IsExecuting}" Classes="nb-action-btn" ToolTip.Tip="Run All Cells (Linear Sequence)">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Play" Width="13" Height="13" Foreground="{DynamicResource M3SuccessBrush}" />
                                    <TextBlock Text="Run All" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Restart Kernel -->
                            <Button Command="{Binding RestartKernelCommand}" Classes="nb-action-btn" ToolTip.Tip="Restart Kernel &amp; Reset Variables">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Restart" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    <TextBlock Text="Restart" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Clear All Outputs -->
                            <Button Command="{Binding ClearAllOutputsCommand}" Classes="nb-action-btn" ToolTip.Tip="Clear All Cell Outputs">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="CloseBoxOutline" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    <TextBlock Text="Clear Outputs" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Rectangle Width="1" Height="18" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="6,0" VerticalAlignment="Center" />

                            <!-- Outline Toggle -->
                            <Button Command="{Binding ToggleOutlineCommand}" Classes="nb-action-btn" ToolTip.Tip="Toggle Notebook Outline">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="FormatListBulleted" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    <TextBlock Text="Outline" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Variables Toggle -->
                            <Button Command="{Binding ToggleVariableInspectorCommand}" Classes="nb-action-btn" ToolTip.Tip="Toggle Live Variable Inspector">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="CodeBraces" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                    <TextBlock Text="Variables" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource M3PrimaryBrush}" CornerRadius="8" Height="16" MinWidth="16" Padding="4,0" VerticalAlignment="Center" Margin="2,0,0,0">
                                        <TextBlock Text="{Binding Variables.Count}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource M3OnPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <!-- Save -->
                            <Button Command="{Binding SaveCommand}" Classes="nb-action-btn" ToolTip.Tip="Save Notebook (Ctrl+S)">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    <TextBlock Text="Save" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Right: Kernel Indicator Badge -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

                            <!-- Kernel Indicator Pill (.NET (C#)) -->
                            <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9999"
                                    Height="26"
                                    Padding="10,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="FlaskOutline" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding KernelName}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}"
                                               VerticalAlignment="Center" />
                                    <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource M3SuccessBrush}" VerticalAlignment="Center" Margin="2,0,0,0" ToolTip.Tip="Kernel: Ready" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================================================== -->
                <!-- ROW 3: MAIN NOTEBOOK CANVAS                          -->
                <!-- ==================================================== -->
                <Grid Grid.Row="3">
                    <!-- Active Canvas (Visible when HasActiveTab) -->
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasActiveTab}">

                    <!-- Notebook Canvas ScrollViewer -->
                    <ScrollViewer Grid.Column="0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" Margin="24,20,24,48" HorizontalAlignment="Stretch">

                            <!-- Cells List -->
                            <ItemsControl ItemsSource="{Binding Cells}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NotebookCellViewModel">
                                        <!-- 2-Column IDE Cell Layout: Col 0 = Gutter, Col 1 = Editor & Output -->
                                        <Grid ColumnDefinitions="56,*" Margin="0,0,0,14">

                                            <!-- ======================================== -->
                                            <!-- COLUMN 0: LEFT GUTTER                    -->
                                            <!-- ======================================== -->
                                            <StackPanel Grid.Column="0" Spacing="2" HorizontalAlignment="Right" Margin="0,3,8,0">
                                                <!-- Row 1: Gutter Run Button & Execution Badge: ▶ [1] -->
                                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right" IsVisible="{Binding IsCodeCell}">
                                                    <Button Command="{Binding RunCellCommand}"
                                                            Classes="gutter-run-btn"
                                                            Width="16" Height="16"
                                                            ToolTip.Tip="Execute Cell (Ctrl+Enter)">
                                                        <materialIcons:MaterialIcon Kind="Play" Width="10" Height="10" Foreground="{DynamicResource M3SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                    <TextBlock Text="{Binding ExecutionBadgeText}"
                                                               FontFamily="Consolas, Menlo, Monaco, Cascadia Code, monospace"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding StatusBadgeForeground}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Row 2: Execution Duration: ✓ 0.1s -->
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="2"
                                                            HorizontalAlignment="Right"
                                                            IsVisible="{Binding ExecutionDurationShortText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <!-- Green Checkmark on success -->
                                                    <materialIcons:MaterialIcon Kind="Check" Width="10" Height="10" Foreground="{DynamicResource M3SuccessBrush}" IsVisible="{Binding !HasError}" VerticalAlignment="Center" />
                                                    <!-- Red Cross on error -->
                                                    <materialIcons:MaterialIcon Kind="Close" Width="10" Height="10" Foreground="{DynamicResource M3ErrorBrush}" IsVisible="{Binding HasError}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ExecutionDurationShortText}"
                                                               FontSize="9"
                                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- ======================================== -->
                                            <!-- COLUMN 1: CELL EDITOR & INLINE OUTPUT    -->
                                            <!-- ======================================== -->
                                            <StackPanel Grid.Column="1" Spacing="6">

                                                <!-- Code / Markdown Editor Box with Overlay Action Bar (No Dead Space) -->
                                                <Border Classes="notebook-editor-box">
                                                    <Grid>
                                                        <!-- Editor Content (Code or Markdown) -->
                                                        <Panel Margin="4,2,4,2">
                                                            <!-- C# Syntax Highlighted Code Editor -->
                                                            <controls:BindableTextEditor IsVisible="{Binding IsCodeCell}"
                                                                                         TextContent="{Binding Source, Mode=TwoWay}"
                                                                                         ExecuteCommand="{Binding RunCellCommand}"
                                                                                         ExecuteAndNextCommand="{Binding RunCellAndSelectNextCommand}"
                                                                                         MinHeight="22"
                                                                                         FontSize="13" />

                                                            <!-- Markdown View (Rendered Header & Notes) -->
                                                            <StackPanel IsVisible="{Binding IsViewingMarkdown}" Spacing="6" Margin="8,4">
                                                                <TextBlock Text="{Binding MarkdownTitle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                                                <TextBlock Text="{Binding MarkdownBody}" FontSize="12.5" LineHeight="19" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                                                            </StackPanel>

                                                            <!-- Markdown Edit Mode -->
                                                            <TextBox IsVisible="{Binding IsEditingMarkdown}"
                                                                     Text="{Binding Source, Mode=TwoWay}"
                                                                     AcceptsReturn="True"
                                                                     AcceptsTab="True"
                                                                     Background="Transparent"
                                                                     BorderThickness="0"
                                                                     MinHeight="22"
                                                                     FontSize="13"
                                                                     Foreground="{DynamicResource M3OnSurfaceBrush}"
                                                                     PlaceholderText="Write markdown documentation (# Header, notes)..."
                                                                     TextWrapping="Wrap" />
                                                        </Panel>

                                                        <!-- Floating Action Bar & Language Tag (Top Right Overlay) -->
                                                        <Border Classes="cell-floating-toolbar"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                Margin="0,2,4,0"
                                                                Padding="3,1">
                                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                                <!-- Language Tag Chip (C# / Markdown) -->
                                                                <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                                                        CornerRadius="3"
                                                                        Padding="5,1"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding LanguageTag}"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                                </Border>

                                                                <!-- Markdown preview/edit toggle button (if markdown cell) -->
                                                                <Button Command="{Binding ToggleMarkdownPreviewCommand}"
                                                                        Classes="cell-tool-btn"
                                                                        Width="NaN"
                                                                        Height="20"
                                                                        Padding="5,0"
                                                                        IsVisible="{Binding IsMarkdownCell}">
                                                                    <TextBlock Text="{Binding MarkdownPreviewButtonText}" FontSize="10" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                                </Button>

                                                                <!-- Thin Separator -->
                                                                <Rectangle Width="1" Height="12" Fill="{DynamicResource M3OutlineVariantBrush}" VerticalAlignment="Center" Margin="1,0" />

                                                                <!-- Run Action -->
                                                                <Button Command="{Binding RunCellCommand}"
                                                                        Classes="cell-tool-btn"
                                                                        Width="20" Height="20"
                                                                        IsVisible="{Binding IsCodeCell}"
                                                                        ToolTip.Tip="Execute Cell (Ctrl+Enter)">
                                                                    <materialIcons:MaterialIcon Kind="Play" Width="12" Height="12" Foreground="{DynamicResource M3SuccessBrush}" />
                                                                </Button>

                                                                <!-- Split / Add Below -->
                                                                <Button Command="{Binding AddCodeBelowCommand}"
                                                                        Classes="cell-tool-btn"
                                                                        Width="20" Height="20"
                                                                        ToolTip.Tip="Insert Code Cell Below">
                                                                    <materialIcons:MaterialIcon Kind="Plus" Width="12" Height="12" />
                                                                </Button>

                                                                <!-- Move Up -->
                                                                <Button Command="{Binding MoveUpCommand}"
                                                                        Classes="cell-tool-btn"
                                                                        Width="20" Height="20"
                                                                        ToolTip.Tip="Move Cell Up">
                                                                    <materialIcons:MaterialIcon Kind="ArrowUp" Width="12" Height="12" />
                                                                </Button>

                                                                <!-- Move Down -->
                                                                <Button Command="{Binding MoveDownCommand}"
                                                                        Classes="cell-tool-btn"
                                                                        Width="20" Height="20"
                                                                        ToolTip.Tip="Move Cell Down">
                                                                    <materialIcons:MaterialIcon Kind="ArrowDown" Width="12" Height="12" />
                                                                </Button>

                                                                <!-- Delete Cell -->
                                                                <Button Command="{Binding DeleteCommand}"
                                                                        Classes="cell-tool-btn delete-tool"
                                                                        Width="20" Height="20"
                                                                        ToolTip.Tip="Delete Cell">
                                                                    <materialIcons:MaterialIcon Kind="DeleteOutline" Width="12" Height="12" />
                                                                </Button>

                                                                <!-- More Options Menu Flyout -->
                                                                <Button Classes="cell-tool-btn"
                                                                        Width="20" Height="20"
                                                                        ToolTip.Tip="More Options">
                                                                    <Button.Flyout>
                                                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                            <MenuItem Header="Run Cell" Command="{Binding RunCellCommand}" IsVisible="{Binding IsCodeCell}">
                                                                                <MenuItem.Icon>
                                                                                    <materialIcons:MaterialIcon Kind="Play" Width="14" Height="14" Foreground="{DynamicResource M3SuccessBrush}" />
                                                                                </MenuItem.Icon>
                                                                            </MenuItem>
                                                                            <MenuItem Header="Clear Output" Command="{Binding ClearOutputCommand}">
                                                                                <MenuItem.Icon>
                                                                                    <materialIcons:MaterialIcon Kind="DeleteSweepOutline" Width="14" Height="14" />
                                                                                </MenuItem.Icon>
                                                                            </MenuItem>
                                                                            <Separator />
                                                                            <MenuItem Header="Insert Code Below" Command="{Binding AddCodeBelowCommand}">
                                                                                <MenuItem.Icon>
                                                                                    <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" />
                                                                                </MenuItem.Icon>
                                                                            </MenuItem>
                                                                            <MenuItem Header="Insert Markdown Below" Command="{Binding AddMarkdownBelowCommand}">
                                                                                <MenuItem.Icon>
                                                                                    <materialIcons:MaterialIcon Kind="FormatHeaderPound" Width="14" Height="14" />
                                                                                </MenuItem.Icon>
                                                                            </MenuItem>
                                                                            <Separator />
                                                                            <MenuItem Header="Move Up" Command="{Binding MoveUpCommand}">
                                                                                <MenuItem.Icon>
                                                                                    <materialIcons:MaterialIcon Kind="ArrowUp" Width="14" Height="14" />
                                                                                </MenuItem.Icon>
                                                                            </MenuItem>
                                                                            <MenuItem Header="Move Down" Command="{Binding MoveDownCommand}">
                                                                                <MenuItem.Icon>
                                                                                    <materialIcons:MaterialIcon Kind="ArrowDown" Width="14" Height="14" />
                                                                                </MenuItem.Icon>
                                                                            </MenuItem>
                                                                            <Separator />
                                                                            <MenuItem Header="Delete Cell" Command="{Binding DeleteCommand}">
                                                                                <MenuItem.Icon>
                                                                                    <materialIcons:MaterialIcon Kind="DeleteOutline" Width="14" Height="14" Foreground="{DynamicResource M3ErrorBrush}" />
                                                                                </MenuItem.Icon>
                                                                            </MenuItem>
                                                                        </MenuFlyout>
                                                                    </Button.Flyout>
                                                                    <TextBlock Text="..." FontSize="10" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- ============================================================ -->
                                                <!-- INLINE OUTPUT STREAM (Directly underneath, flush with editor) -->
                                                <!-- ============================================================ -->
                                                <StackPanel Spacing="6" Margin="0,3,0,0" IsVisible="{Binding HasOutput}">

                                                    <!-- 1. Interactive Object Inspector Tree (▼ Submission#16+People) -->
                                                    <Border IsVisible="{Binding HasInspectorOutput}" Margin="0,1,0,3">
                                                        <views:ObjectInspectorView DataContext="{Binding InspectorNode}" />
                                                    </Border>

                                                    <!-- 2. Plain Console Stdout Text Output (e.g. test is test, [ 1, 3, 4, ... ]) -->
                                                    <TextBox Text="{Binding OutputText, Mode=OneWay}"
                                                             FontFamily="Consolas, Menlo, Monaco, Cascadia Code, monospace"
                                                             FontSize="12"
                                                             Foreground="{DynamicResource M3OnSurfaceBrush}"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             Padding="0"
                                                             IsReadOnly="True"
                                                             TextWrapping="Wrap"
                                                             IsVisible="{Binding OutputText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                                    <!-- 3. Tabular Output (.Dump()) -->
                                                    <Border IsVisible="{Binding HasTableOutput}">
                                                        <views:DumpTableView DataContext="{Binding TableResult}" />
                                                    </Border>

                                                    <!-- 4. Rendered Graphic / Image Output -->
                                                    <Border IsVisible="{Binding HasImageOutput}"
                                                            Background="{DynamicResource M3SurfaceContainerLowBrush}"
                                                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="10">
                                                        <Grid RowDefinitions="Auto,*">
                                                            <!-- Image Output Header -->
                                                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8" VerticalAlignment="Center">
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                    <materialIcons:MaterialIcon Kind="ImageOutline" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                                    <TextBlock Text="Rendered Graphic" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                                                </StackPanel>

                                                                <Border Grid.Column="1" HorizontalAlignment="Left" Margin="8,0,0,0"
                                                                        Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                                                        CornerRadius="4" Padding="6,1">
                                                                    <TextBlock Text="{Binding ImageDimensionsText}" FontSize="10" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                                </Border>

                                                                <!-- Image Actions: Copy & Save -->
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                    <Button Command="{Binding CopyImageCommand}" Classes="cell-tool-btn" Width="24" Height="24" ToolTip.Tip="Copy Image">
                                                                        <materialIcons:MaterialIcon Kind="ContentCopy" Width="12" Height="12" />
                                                                    </Button>
                                                                    <Button Command="{Binding SaveImageCommand}" Classes="cell-tool-btn" Width="24" Height="24" ToolTip.Tip="Save PNG">
                                                                        <materialIcons:MaterialIcon Kind="DownloadOutline" Width="12" Height="12" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- Image Canvas -->
                                                            <Border Grid.Row="1"
                                                                    Background="#080C11"
                                                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="8"
                                                                    HorizontalAlignment="Stretch">
                                                                <Image Source="{Binding ImageOutputBitmap}"
                                                                       MaxHeight="450"
                                                                       Stretch="Uniform"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <!-- 5. Interactive Avalonia UI Control -->
                                                    <Border IsVisible="{Binding HasInteractiveControl}"
                                                            Background="{DynamicResource M3SurfaceContainerLowBrush}"
                                                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="12,8">
                                                        <Grid RowDefinitions="Auto,*">
                                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6" VerticalAlignment="Center">
                                                                <materialIcons:MaterialIcon Kind="ApplicationOutline" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                                <TextBlock Text="Interactive UI Widget" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                                            </StackPanel>
                                                            <ContentControl Grid.Row="1" Content="{Binding InteractiveControl}" HorizontalAlignment="Stretch" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- 5b. Interactive Control Placeholder — the live control itself can't be
                                                         serialized, so a reloaded notebook shows this instead until the cell is re-run -->
                                                    <Border IsVisible="{Binding InteractiveControlPlaceholderVisible}"
                                                            Background="{DynamicResource M3SurfaceContainerLowBrush}"
                                                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="12,10">
                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <materialIcons:MaterialIcon Kind="ReloadAlert" Width="16" Height="16" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                            <TextBlock Text="Interactive widget / animation not restored — re-run this cell to bring it back."
                                                                       FontSize="11.5"
                                                                       FontStyle="Italic"
                                                                       Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 6. HTML / Markdown Rich Output -->
                                                    <Border IsVisible="{Binding HasHtmlContent}"
                                                            Background="{DynamicResource M3SurfaceContainerLowBrush}"
                                                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="12,8">
                                                        <Grid RowDefinitions="Auto,*">
                                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6" VerticalAlignment="Center">
                                                                <materialIcons:MaterialIcon Kind="LanguageHtml5" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                                <TextBlock Text="HTML / Markdown Output" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                                            </StackPanel>
                                                            <views:RichHtmlView Grid.Row="1" DataContext="{Binding HtmlContent}" />
                                                        </Grid>
                                                    </Border>

                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Collapsible Variable Inspector Drawer -->
                    <Border Grid.Column="1"
                            Width="320"
                            IsVisible="{Binding IsVariableInspectorOpen}"
                            Background="{DynamicResource M3SurfaceContainerLowBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1,0,0,0">
                        <Grid RowDefinitions="Auto,*">
                            <!-- Drawer Header -->
                            <Border Grid.Row="0"
                                    Background="{DynamicResource M3SurfaceContainerBrush}"
                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="CodeBraces" Width="15" Height="15" Foreground="{DynamicResource M3PrimaryBrush}" />
                                        <TextBlock Text="Live Variables" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Command="{Binding ToggleVariableInspectorCommand}"
                                            Classes="cell-tool-btn">
                                        <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Variables List -->
                            <ScrollViewer Grid.Row="1">
                                <ItemsControl ItemsSource="{Binding Variables}" Margin="8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:NotebookVariableInfo">
                                            <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,6"
                                                    Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                                        <TextBlock Text="{Binding TypeName}" FontSize="10" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ValueDisplay}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Collapsible Outline Drawer -->
                    <Border Grid.Column="1"
                            Width="280"
                            IsVisible="{Binding IsOutlineOpen}"
                            Background="{DynamicResource M3SurfaceContainerLowBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1,0,0,0">
                        <Grid RowDefinitions="Auto,*">
                            <!-- Drawer Header -->
                            <Border Grid.Row="0"
                                    Background="{DynamicResource M3SurfaceContainerBrush}"
                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="FormatListBulleted" Width="15" Height="15" Foreground="{DynamicResource M3PrimaryBrush}" />
                                        <TextBlock Text="Notebook Outline" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Command="{Binding ToggleOutlineCommand}"
                                            Classes="cell-tool-btn">
                                        <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Cells Outline Items -->
                            <ScrollViewer Grid.Row="1">
                                <ItemsControl ItemsSource="{Binding Cells}" Margin="8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NotebookCellViewModel">
                                            <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,6"
                                                    Margin="0,0,0,4">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Grid.Column="0" Text="{Binding ExecutionBadgeText}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource M3PrimaryBrush}" Margin="0,0,6,0" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding MarkdownTitle}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource M3OnSurfaceBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               IsVisible="{Binding IsMarkdownCell}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Source}"
                                                               FontSize="11"
                                                               FontFamily="Consolas, monospace"
                                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               IsVisible="{Binding IsCodeCell}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 2. Empty State (Visible when HasNoTabs) -->
                <Border IsVisible="{Binding HasNoTabs}"
                        Background="{DynamicResource M3SurfaceBrush}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="440">
                        <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource M3SurfaceContainerHighBrush}" HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="NotebookOutline" Width="32" Height="32" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="No Open Notebooks" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Open a notebook from the Explorer sidebar or click below to create a new notebook."
                                       FontSize="12.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Button Command="{Binding NewNotebookTabCommand}"
                                Background="{DynamicResource M3PrimaryBrush}"
                                Foreground="{DynamicResource M3OnPrimaryBrush}"
                                CornerRadius="9999"
                                Height="34"
                                Padding="18,0"
                                HorizontalAlignment="Center"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Plus" Width="15" Height="15" Foreground="{DynamicResource M3OnPrimaryBrush}" />
                                <TextBlock Text="New Notebook" FontSize="12.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>

        <!-- ============================================================ -->
        <!-- ROW 1: STATUS BAR FOOTER                                     -->
        <!-- ============================================================ -->
        <Border Grid.Row="1"
                Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                BorderThickness="0,1,0,0"
                Height="24"
                Padding="12,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left: Kernel status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource M3SuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CompilerStatusText}" FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: Metadata & Kernel Indicator -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Cells.Count, StringFormat='{}Cell {0}'}" FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding KernelName}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource M3SuccessBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
