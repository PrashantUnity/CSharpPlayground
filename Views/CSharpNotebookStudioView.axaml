<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="850"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Views.CSharpNotebookStudioView"
             x:DataType="vm:CSharpNotebookStudioViewModel">

    <UserControl.Styles>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <!-- Cell Card Hover & Transitions -->
        <Style Selector="Border.notebook-cell-card">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerMedium}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.notebook-cell-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineBrush}" />
        </Style>

        <!-- Cell Run Circular Button -->
        <Style Selector="Button.cell-run-btn">
            <Setter Property="Background" Value="{DynamicResource M3SuccessContainerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3SuccessBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerFull}" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.cell-run-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SuccessBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3SuccessBrush}" />
        </Style>

        <!-- Cell Action Icons -->
        <Style Selector="Button.cell-action-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerSmall}" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
        </Style>
        <Style Selector="Button.cell-action-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        </Style>

        <!-- Delete Action -->
        <Style Selector="Button.cell-delete-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerSmall}" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
        </Style>
        <Style Selector="Button.cell-delete-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3ErrorContainerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3ErrorBrush}" />
        </Style>
        <Style Selector="Button.cell-delete-btn:pointerover materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource M3ErrorBrush}" />
        </Style>

        <!-- Title Editor Input -->
        <Style Selector="TextBox.notebook-title-box">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.notebook-title-box:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource M3SurfaceBrush}">

        <!-- ============================================================ -->
        <!-- 1. TOP STUDIO TOOLBAR & UNIFIED WORKSPACE ACTIONS             -->
        <!-- ============================================================ -->
        <Border Grid.Row="0"
                Background="{DynamicResource M3SurfaceContainerLowBrush}"
                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,9">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left: Back Navigation & Notebook Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Command="{Binding BackToHubCommand}"
                            Classes="m3-tonal-btn"
                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                            Height="32"
                            MinHeight="0"
                            Padding="12,0"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            Cursor="Hand"
                            ToolTip.Tip="Return to Scripts &amp; Notebooks Hub">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ArrowLeft" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="Scripts Hub" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <materialIcons:MaterialIcon Kind="ChevronRight" Width="16" Height="16" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />

                    <!-- Seamless Editable Notebook Title -->
                    <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerMedium}"
                            Height="32"
                            Padding="10,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="NotebookOutline" Width="16" Height="16" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding Notebook.Title, Mode=TwoWay}"
                                     Classes="notebook-title-box"
                                     MinWidth="190"
                                     PlaceholderText="Notebook Title..." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center: Stats & Compiler Status Capsule -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" VerticalAlignment="Center">
                    <!-- Total Cells Pill -->
                    <Border Background="{DynamicResource M3SurfaceContainerHighBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                            Height="32"
                            Padding="12,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="LayersOutline" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Cells.Count, StringFormat='{}{0} Cells'}"
                                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Compiler Engine Status -->
                    <Border Background="{DynamicResource M3SurfaceContainerHighBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                            Height="32"
                            Padding="12,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource M3SuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CompilerStatusText}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Workspace Actions Toolbar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- + Code Cell Action -->
                    <Button Command="{Binding AddCodeCellCommand}"
                            Classes="m3-filled-btn"
                            Background="{DynamicResource M3PrimaryBrush}"
                            Foreground="{DynamicResource M3OnPrimaryBrush}"
                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                            Height="32"
                            MinHeight="0"
                            Padding="12,0"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            Cursor="Hand"
                            ToolTip.Tip="Add a new C# code cell">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" Foreground="{DynamicResource M3OnPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Code" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- + Markdown Note Action -->
                    <Button Command="{Binding AddMarkdownCellCommand}"
                            Classes="m3-tonal-btn"
                            Background="{DynamicResource M3SurfaceContainerHighBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            Foreground="{DynamicResource M3OnSurfaceBrush}"
                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                            Height="32"
                            MinHeight="0"
                            Padding="12,0"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            Cursor="Hand"
                            ToolTip.Tip="Add documentation markdown note">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="FormatHeaderPound" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Note" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Clear Outputs -->
                    <Button Command="{Binding ClearAllOutputsCommand}"
                            Classes="m3-icon-btn"
                            Width="32"
                            Height="32"
                            MinWidth="0"
                            MinHeight="0"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            ToolTip.Tip="Clear all cell execution outputs">
                        <materialIcons:MaterialIcon Kind="DeleteSweepOutline" Width="17" Height="17" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Button>

                    <!-- Save Notebook -->
                    <Button Command="{Binding SaveCommand}"
                            Classes="m3-tonal-btn"
                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                            Height="32"
                            MinHeight="0"
                            Padding="12,0"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            Cursor="Hand"
                            ToolTip.Tip="Save Notebook (Ctrl+S)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="14" Height="14" VerticalAlignment="Center" />
                            <TextBlock Text="Save" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Primary Run All Button -->
                    <Button Command="{Binding RunAllCellsCommand}"
                            Classes="m3-filled-btn"
                            Background="{DynamicResource M3PrimaryBrush}"
                            Foreground="{DynamicResource M3OnPrimaryBrush}"
                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                            Height="32"
                            MinHeight="0"
                            Padding="16,0"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            IsEnabled="{Binding !IsExecuting}"
                            Cursor="Hand"
                            ToolTip.Tip="Run all code cells in sequence">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="PlayBoxMultipleOutline" Width="15" Height="15" Foreground="{DynamicResource M3OnPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Run All" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- 2. MAIN NOTEBOOK CANVAS: Centered Interactive Cells          -->
        <!-- ============================================================ -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Margin="0,24,0,48" MaxWidth="1020" HorizontalAlignment="Center" Width="1020">

                <!-- Dynamic Cells List -->
                <ItemsControl ItemsSource="{Binding Cells}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NotebookCellViewModel">
                            <Border Classes="notebook-cell-card" Margin="0,0,0,16">
                                <Grid RowDefinitions="Auto,Auto,Auto">

                                    <!-- Cell Header Bar -->
                                    <Border Grid.Row="0"
                                            Background="{DynamicResource M3SurfaceContainerBrush}"
                                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                            BorderThickness="0,0,0,1"
                                            CornerRadius="{StaticResource M3ShapeTopRoundedMedium}"
                                            Padding="12,7">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <!-- Left: Run Button, Execution Badge, Cell Type Chip -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <!-- Run Circular Button (Code Cells only) -->
                                                <Button Command="{Binding RunCellCommand}"
                                                        Classes="cell-run-btn"
                                                        IsVisible="{Binding IsCodeCell}"
                                                        VerticalAlignment="Center"
                                                        ToolTip.Tip="Execute this cell (Ctrl+Enter)">
                                                    <materialIcons:MaterialIcon Kind="Play" Width="13" Height="13" Foreground="{DynamicResource M3OnSuccessContainerBrush}" Margin="1,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Button>

                                                <!-- Execution Counter Badge -->
                                                <Border Background="{Binding StatusBadgeBackground}"
                                                        BorderBrush="{Binding StatusBadgeBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                                        Height="26"
                                                        Padding="8,0"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding IsCodeCell}">
                                                    <TextBlock Text="{Binding ExecutionBadgeText}"
                                                               FontFamily="Consolas, Cascadia Code, monospace"
                                                               FontSize="11" FontWeight="Bold"
                                                               Foreground="{Binding StatusBadgeForeground}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center" />
                                                </Border>

                                                <!-- Semantic Type Chip -->
                                                <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                                        Height="26"
                                                        Padding="8,0"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding IsCodeCell}">
                                                    <TextBlock Text="C# Code" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Markdown Chip -->
                                                <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                                        Height="26"
                                                        Padding="8,0"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding IsMarkdownCell}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                        <materialIcons:MaterialIcon Kind="FormatHeaderPound" Width="12" Height="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="Markdown Note" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Execution Duration Timing -->
                                                <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                                        Height="26"
                                                        Padding="8,0"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding ExecutionTimeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <materialIcons:MaterialIcon Kind="Check" Width="11" Height="11" Foreground="{DynamicResource M3SuccessBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding ExecutionTimeText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Right: Actions (View/Edit, Move Up/Down, Convert, Delete) -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <!-- Markdown Preview / Edit Toggle -->
                                                <Button Command="{Binding ToggleMarkdownPreviewCommand}"
                                                        Classes="cell-action-btn"
                                                        IsVisible="{Binding IsMarkdownCell}"
                                                        VerticalAlignment="Center"
                                                        ToolTip.Tip="Toggle Markdown Preview / Edit Mode">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <materialIcons:MaterialIcon Kind="PencilOutline" Width="13" Height="13" IsVisible="{Binding IsViewingMarkdown}" VerticalAlignment="Center" />
                                                        <materialIcons:MaterialIcon Kind="EyeOutline" Width="13" Height="13" IsVisible="{Binding IsEditingMarkdown}" VerticalAlignment="Center" />
                                                        <TextBlock Text="Edit" FontSize="11" IsVisible="{Binding IsViewingMarkdown}" VerticalAlignment="Center" />
                                                        <TextBlock Text="Preview" FontSize="11" IsVisible="{Binding IsEditingMarkdown}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Convert Code/Markdown -->
                                                <Button Command="{Binding ToggleTypeCommand}"
                                                        Classes="cell-action-btn"
                                                        Width="26"
                                                        Height="26"
                                                        Padding="0"
                                                        VerticalAlignment="Center"
                                                        ToolTip.Tip="Toggle between Code and Markdown">
                                                    <materialIcons:MaterialIcon Kind="SwapHorizontal" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Button>

                                                <!-- Move Up -->
                                                <Button Command="{Binding MoveUpCommand}"
                                                        Classes="cell-action-btn"
                                                        Width="26"
                                                        Height="26"
                                                        Padding="0"
                                                        VerticalAlignment="Center"
                                                        ToolTip.Tip="Move Cell Up">
                                                    <materialIcons:MaterialIcon Kind="ArrowUp" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Button>

                                                <!-- Move Down -->
                                                <Button Command="{Binding MoveDownCommand}"
                                                        Classes="cell-action-btn"
                                                        Width="26"
                                                        Height="26"
                                                        Padding="0"
                                                        VerticalAlignment="Center"
                                                        ToolTip.Tip="Move Cell Down">
                                                    <materialIcons:MaterialIcon Kind="ArrowDown" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Button>

                                                <!-- Delete Cell -->
                                                <Button Command="{Binding DeleteCommand}"
                                                        Classes="cell-delete-btn"
                                                        Width="26"
                                                        Height="26"
                                                        Padding="0"
                                                        VerticalAlignment="Center"
                                                        ToolTip.Tip="Delete this cell">
                                                    <materialIcons:MaterialIcon Kind="DeleteOutline" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Cell Body: Code Editor OR Markdown Display -->
                                    <Panel Grid.Row="1">
                                        <!-- Code Cell: Syntax Highlighted Editor -->
                                        <Border IsVisible="{Binding IsCodeCell}"
                                                Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                Margin="8,8,8,8"
                                                Padding="4,4">
                                            <controls:BindableTextEditor TextContent="{Binding Source, Mode=TwoWay}"
                                                                         ExecuteCommand="{Binding RunCellCommand}"
                                                                         MinHeight="85"
                                                                         FontSize="13" />
                                        </Border>

                                        <!-- Markdown Cell (Preview Mode) -->
                                        <Border IsVisible="{Binding IsViewingMarkdown}"
                                                Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                Margin="8,8,8,8"
                                                Padding="18,14">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{Binding MarkdownTitle}"
                                                           FontSize="16" FontWeight="Bold"
                                                           Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                                <TextBlock Text="{Binding MarkdownBody}"
                                                           FontSize="13" LineHeight="20"
                                                           Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Markdown Cell (Edit Mode) -->
                                        <Border IsVisible="{Binding IsEditingMarkdown}"
                                                Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                Margin="8,8,8,8"
                                                Padding="12,10">
                                            <TextBox Text="{Binding Source, Mode=TwoWay}"
                                                     AcceptsReturn="True"
                                                     AcceptsTab="True"
                                                     FontFamily="Inter, Segoe UI, Roboto, sans-serif"
                                                     FontSize="13"
                                                     Foreground="{DynamicResource M3OnSurfaceBrush}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     MinHeight="75"
                                                     PlaceholderText="Write markdown documentation (# Header, notes)..."
                                                     TextWrapping="Wrap" />
                                        </Border>
                                    </Panel>

                                    <!-- Inline Developer Console Output (Underneath) -->
                                    <Border Grid.Row="2"
                                            Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                            BorderThickness="0,1,0,0"
                                            CornerRadius="{StaticResource M3ShapeBottomRoundedMedium}"
                                            Padding="14,10"
                                            IsVisible="{Binding HasOutput}">
                                        <Grid RowDefinitions="Auto,*">
                                            <!-- Console Header -->
                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <materialIcons:MaterialIcon Kind="ConsoleLine" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                                    <TextBlock Text="Console Output" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                </StackPanel>

                                                <!-- Console Output Actions: Copy & Clear -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <Button Command="{Binding CopyOutputCommand}"
                                                            Classes="cell-action-btn"
                                                            ToolTip.Tip="Copy output text to clipboard">
                                                        <materialIcons:MaterialIcon Kind="ContentCopy" Width="13" Height="13" />
                                                    </Button>
                                                    <Button Command="{Binding ClearOutputCommand}"
                                                            Classes="cell-action-btn"
                                                            ToolTip.Tip="Clear Output">
                                                        <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="14" Height="14" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Output Text Monospace Display -->
                                            <TextBox Grid.Row="1"
                                                     Text="{Binding OutputText, Mode=OneWay}"
                                                     FontFamily="Consolas, Menlo, Monaco, JetBrains Mono, monospace"
                                                     FontSize="12"
                                                     Foreground="{Binding StatusBadgeForeground}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     IsReadOnly="True"
                                                     TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ============================================================ -->
                <!-- Inline Add-Cell Action Block (Right below the last cell!)    -->
                <!-- ============================================================ -->
                <Border Background="{DynamicResource M3SurfaceContainerLowBrush}"
                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource M3ShapeCornerLarge}"
                        Padding="18,14">
                    <Grid ColumnDefinitions="*,Auto,*">
                        <Rectangle Grid.Column="0" Height="1" Fill="{DynamicResource M3OutlineVariantBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Button Command="{Binding AddCodeCellCommand}"
                                    Classes="m3-filled-btn"
                                    Background="{DynamicResource M3PrimaryBrush}"
                                    Foreground="{DynamicResource M3OnPrimaryBrush}"
                                    CornerRadius="{StaticResource M3ShapeCornerFull}"
                                    Height="36"
                                    MinHeight="0"
                                    Padding="16,0"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Plus" Width="15" Height="15" Foreground="{DynamicResource M3OnPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Add Code Cell" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3OnPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding AddMarkdownCellCommand}"
                                    Classes="m3-tonal-btn"
                                    Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource M3ShapeCornerFull}"
                                    Height="36"
                                    MinHeight="0"
                                    Padding="16,0"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="FormatHeaderPound" Width="15" Height="15" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Add Markdown Note" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Rectangle Grid.Column="2" Height="1" Fill="{DynamicResource M3OutlineVariantBrush}" VerticalAlignment="Center" Margin="16,0,0,0" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================ -->
        <!-- 3. SLIM DEVELOPER STATUS BAR FOOTER                          -->
        <!-- ============================================================ -->
        <Border Grid.Row="2"
                Background="{DynamicResource M3SurfaceContainerLowBrush}"
                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,6">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="7" Height="7" CornerRadius="4" Background="{DynamicResource M3SuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Roslyn .NET 10 Runtime Engine" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                    <TextBlock Text="•" Foreground="{DynamicResource M3OutlineBrush}" Margin="4,0" />
                    <TextBlock Text="Interactive C# 13 Statements" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Cells.Count, StringFormat='{}{0} Interactive Cells'}" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                    <TextBlock Text="•" Foreground="{DynamicResource M3OutlineBrush}" Margin="4,0" />
                    <TextBlock Text="In-Memory JIT Execution" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
