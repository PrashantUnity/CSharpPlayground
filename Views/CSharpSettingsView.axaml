<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             xmlns:settings="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.Settings"
             xmlns:settings1="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Settings"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Views.CSharpSettingsView"
             x:DataType="settings:CSharpSettingsViewModel"
             Background="{DynamicResource DsBgBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CSharpEditorPlugin/Views/CSharpManagerPaletteTokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://CSharpEditorPlugin/Views/CSharpManagerStyles.axaml" />
        <StyleInclude Source="avares://CSharpEditorPlugin/Controls/SharedStudioStyles.axaml" />
    </UserControl.Styles>

    <Grid RowDefinitions="54,*">
        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- 1. TOP HEADER BAR (54px)                                       -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource DsSurfaceBrush}"
                BorderBrush="{DynamicResource DsBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <!-- Back Button -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{Binding BackToPreviousCommand}"
                            Classes="snippet-action-btn"
                            ToolTip.Tip="Return (Esc)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ArrowLeft" Width="15" Height="15" Foreground="{DynamicResource DsMutedBrush}" />
                            <TextBlock Text="Back" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="20" Fill="{DynamicResource DsBorderBrush}" Margin="4,0" />
                </StackPanel>

                <!-- Page Title & Badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="8,0,16,0">
                    <Border Width="30" Height="30" CornerRadius="6"
                            Background="{DynamicResource DsPrimarySubtleBrush}"
                            BorderBrush="{DynamicResource DsPrimaryBorderSubtleBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="CogOutline" Width="17" Height="17" Foreground="{DynamicResource DsPrimaryBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Settings &amp; Environment Setup" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource DsPrimarySubtleBrush}" BorderBrush="{DynamicResource DsPrimaryBorderSubtleBrush}" BorderThickness="1"
                            Height="20" MinHeight="20" CornerRadius="10" Padding="8,0" VerticalAlignment="Center">
                        <TextBlock Text="VS Code Ergonomics" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource DsPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                    </Border>
                </StackPanel>

                <!-- Status / Notification Pill (when saving or error) -->
                <Border Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource DsSurfaceHighBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="12,4"
                        IsVisible="{Binding HasStatusMessage}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="15" Height="15" Foreground="{DynamicResource DsGreenBrush}" />
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Foreground="{DynamicResource DsTextBrush}" VerticalAlignment="Center" />
                        <Button Command="{Binding DismissNotificationCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Margin="4,0,0,0">
                            <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="{DynamicResource DsMutedBrush}" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Action Buttons: Reset & Apply -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Command="{Binding ResetDefaultsCommand}"
                            Classes="cs-toolbar-outlined"
                            ToolTip.Tip="Reset all settings to default values">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Restore" Width="14" Height="14" />
                            <TextBlock Text="Reset Defaults" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ApplyCommand}"
                            Classes="cs-toolbar-filled"
                            ToolTip.Tip="Save and apply configuration">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Check" Width="15" Height="15" />
                            <TextBlock Text="Apply" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- 2. MASTER-DETAIL BODY                                          -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" ColumnDefinitions="250,1,*">
            <!-- LEFT NAVIGATION RAIL -->
            <Border Grid.Column="0"
                    Background="{DynamicResource DsSurfaceBrush}"
                    BorderBrush="{DynamicResource DsBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*">
                    <!-- Search Input Box -->
                    <Border Grid.Row="0" Padding="12,12,12,8">
                        <TextBox Text="{Binding SearchQuery, Mode=TwoWay}"
                                 PlaceholderText="Search settings &amp; runtimes…"
                                 Classes="nexus-search-input"
                                 FontSize="12" Height="32">
                            <TextBox.InnerLeftContent>
                                <materialIcons:MaterialIcon Kind="Magnify" Width="16" Height="16" Margin="8,0,0,0" Foreground="{DynamicResource DsMutedBrush}" />
                            </TextBox.InnerLeftContent>
                        </TextBox>
                    </Border>

                    <!-- Category Items & Languages Subtree -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="3" Margin="8,4">
                            <!-- Category: Languages & Runtimes -->
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="Languages"
                                    Classes="doc-nav-item"
                                    Classes.active="{Binding IsLanguagesCategoryActive}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="TuneVariant" Width="17" Height="17" VerticalAlignment="Center" Foreground="{DynamicResource DsPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="Languages &amp; Runtimes" FontSize="12.5" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Sub-items: Each registered language -->
                            <StackPanel Spacing="2" Margin="16,2,0,8" IsVisible="{Binding IsLanguagesCategoryActive}">
                                <ItemsControl ItemsSource="{Binding FilteredLanguages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="settings:LanguageSettingItemViewModel">
                                            <Button Command="{Binding ((settings:CSharpSettingsViewModel)DataContext).SelectLanguageItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue={x:Null}}"
                                                    CommandParameter="{Binding}"
                                                    Classes="doc-nav-item"
                                                    Classes.active="{Binding IsSelected}"
                                                    Margin="0,1">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding IconKind}" Width="16" Height="16" Foreground="{Binding AccentHex}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    <Ellipse Grid.Column="2" Width="6" Height="6" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Category: Editor & Formatting -->
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="Editor"
                                    Classes="doc-nav-item"
                                    Classes.active="{Binding IsEditorCategoryActive}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="CodeBraces" Width="17" Height="17" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Editor &amp; Formatting" FontSize="12.5" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Category: Execution & Terminal -->
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="Execution"
                                    Classes="doc-nav-item"
                                    Classes.active="{Binding IsExecutionCategoryActive}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="Console" Width="17" Height="17" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Execution &amp; Terminal" FontSize="12.5" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Category: Keymap Reference -->
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="Keymap"
                                    Classes="doc-nav-item"
                                    Classes.active="{Binding IsKeymapCategoryActive}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="KeyboardOutline" Width="17" Height="17" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Keymap &amp; Shortcuts" FontSize="12.5" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- SPLITTER BORDER -->
            <Rectangle Grid.Column="1" Fill="{DynamicResource DsBorderBrush}" Width="1" />

            <!-- RIGHT DETAIL CANVAS -->
            <Border Grid.Column="2" Background="{DynamicResource DsBgBrush}">
                <Panel>
                    <!-- Detail for Languages & Runtimes -->
                    <Panel IsVisible="{Binding IsLanguagesCategoryActive}">
                        <settings1:LanguageEnvironmentSettingControl
                            DataContext="{Binding SelectedLanguage}" />
                    </Panel>

                    <!-- Detail for Editor & Formatting -->
                    <settings1:EditorSettingsSectionControl
                        IsVisible="{Binding IsEditorCategoryActive}" />

                    <!-- Detail for Execution & Terminal -->
                    <settings1:ExecutionSettingsSectionControl
                        IsVisible="{Binding IsExecutionCategoryActive}" />

                    <!-- Detail for Keymap Reference -->
                    <settings1:KeymapSettingsSectionControl
                        IsVisible="{Binding IsKeymapCategoryActive}" />
                </Panel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
