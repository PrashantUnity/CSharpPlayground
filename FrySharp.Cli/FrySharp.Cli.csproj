<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>frysharp</AssemblyName>
    <RootNamespace>FrySharp.Cli</RootNamespace>
    <PackageId>CodeFryDev.FrySharp.Cli</PackageId>
    <Version>1.0.0</Version>
    <Description>FrySharp from the command line: run scripts, and run the sidecar for the VS Code extension</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>frysharp</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
    <ProjectReference Include="..\FrySharp.Core\FrySharp.Core.csproj" />
    <ProjectReference Include="..\FrySharp.Sidecar\FrySharp.Sidecar.csproj" />
  </ItemGroup>
</Project>
